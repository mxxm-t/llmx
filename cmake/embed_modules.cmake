# llmx_embed_modules(TARGET NAME SYMBOL FILE [SYMBOL FILE]...): links each compiled kernel module FILE into TARGET as the bytes of the C symbol SYMBOL, followed by a zero byte.
# The bytes go in through the assembler's .incbin, so no compiler parses a module as an array initializer, whose memory grew past the build container's with the int16 module (docs/src/backends-gpu.md).
# MSVC has no inline assembly, so on Windows the same directives go in a COFF object that LLMX_EMBED_ASSEMBLER, a clang, assembles.
function(llmx_embed_modules target name)
    if(WIN32 AND NOT LLMX_EMBED_ASSEMBLER)
        message(FATAL_ERROR "llmx_embed_modules needs LLMX_EMBED_ASSEMBLER on Windows")
    endif()
    set(body "")
    if(NOT WIN32)
        set(body "// Generated by llmx_embed_modules (cmake/embed_modules.cmake): the kernel modules as linked bytes.\n")
    endif()
    set(files)
    set(args ${ARGN})
    list(LENGTH args n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} symbol)
        list(GET args ${j} file)
        if(WIN32)
            string(APPEND body ".section .rdata,\"dr\"\n.balign 64\n.globl ${symbol}\n${symbol}:\n.incbin \"${file}\"\n.byte 0\n")
        else()
            string(APPEND body "asm(\".section .rodata\\n.balign 64\\n.globl ${symbol}\\n.hidden ${symbol}\\n${symbol}:\\n.incbin \\\"${file}\\\"\\n.byte 0\\n.previous\");\n")
        endif()
        list(APPEND files ${file})
    endforeach()
    if(WIN32)
        set(asm ${CMAKE_CURRENT_BINARY_DIR}/generated/${name}_modules.s)
        set(obj ${CMAKE_CURRENT_BINARY_DIR}/generated/${name}_modules.obj)
        file(GENERATE OUTPUT ${asm} CONTENT "${body}")
        add_custom_command(OUTPUT ${obj}
            COMMAND ${LLMX_EMBED_ASSEMBLER} --target=x86_64-pc-windows-msvc -c ${asm} -o ${obj}
            DEPENDS ${asm} ${files}
            COMMENT "embed ${name} modules"
            VERBATIM)
        set_source_files_properties(${obj} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
        target_sources(${target} PRIVATE ${obj})
        return()
    endif()
    set(src ${CMAKE_CURRENT_BINARY_DIR}/generated/${name}_modules.cpp)
    file(GENERATE OUTPUT ${src} CONTENT "${body}")
    set_source_files_properties(${src} PROPERTIES GENERATED TRUE OBJECT_DEPENDS "${files}")
    target_sources(${target} PRIVATE ${src})
endfunction()
