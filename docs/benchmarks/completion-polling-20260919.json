  "stress": "pool lifecycle/publication stress passed: 64000 jobs",
  "activation_witness": "POLL WITNESS calls=15746 iterations=1562167 completed=4392 exhausted=11354",
  "numerical_scope": "Timing runs require finite logits, matching top1 and printed sum. Stress checks publication/lifecycle. No full HF gate was run for the rejected candidate.",
  "stress_source": "#include <iostream>\n#include <chrono>\n#include <thread>\n#include \"backends/cpu/cpu_backend.hpp\"\nint main() {\n    backend::CpuBackend b;\n    size_t jobs=0;\n    for(int round=0;round<8;++round) {\n        for(int nt:{1,2,6,16}) {\n            b.set_threads(nt);\n            std::vector<unsigned> slots(nt,0);\n            for(unsigned epoch=1;epoch<=2000;++epoch) {\n                b.run_parallel([&](int worker) {\n                    if(worker==nt-1 && epoch%127==0)\n                        std::this_thread::sleep_for(std::chrono::milliseconds(1));\n                    else if((worker+epoch)%7==0) std::this_thread::yield();\n                    slots[worker]=epoch;\n                });\n                for(unsigned value:slots) if(value!=epoch) return 2;\n                ++jobs;\n            }\n        }\n    }\n    std::cout<<\"pool lifecycle/publication stress passed: \"<<jobs<<\" jobs\\n\";\n}\n"
