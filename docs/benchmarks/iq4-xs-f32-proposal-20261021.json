  "producer_source": "import gc\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nsys.path[:0]=['/w/tools','/w/tests']\nimport torch\nimport transformers\nimport numpy\nimport calibrate_dtype as calibration\nfrom f32 import TEXTS\n\nassert (torch.__version__,transformers.__version__,numpy.__version__)==('2.5.1+cpu','4.55.2','2.2.6')\ntorch.set_num_threads(1)\nreport=dict(status='proposal only; not installed in a consumer',family='iq4-xs',method='Original fixed F32 logit margin plus the worst routing-stable HF F32 full-forward versus one-token cached-forward final-logit discrepancy, across existing family_models. No llmx candidate output is read. NLL remains unchanged.',base_logit_margin=2e-5,nll_budget_unchanged=1e-5,versions=[torch.__version__,transformers.__version__,numpy.__version__],seeds=[12345]+list(calibration.SEEDS),runs=[])\nreport['sources']={n:hashlib.sha256((Path('/w')/n).read_bytes()).hexdigest() for n in ('tools/calibrate_dtype.py','tools/gen_baseline.py','tests/iq4_xs.py','tests/block_fixture.py')}\ndef routes(trace):\n    rows={}\n    for call in trace:\n        rows.setdefault(call['router'],[]).extend(call['experts'])\n    return rows\nfor model,identity in calibration.family_models('iq4-xs'):\n    trace=[]\n    hooks=calibration.routing_hooks(model,trace)\n    row=dict(identity,cases=[],routing_stable=True)\n    try:\n        with torch.inference_mode():\n            for index,text in enumerate(TEXTS):\n                ids=torch.tensor([list(text.encode('ascii'))])\n                trace.clear()\n                full=model(ids,use_cache=False).logits[0,-1]\n                original=routes(trace)\n                if identity['seed']==12345:\n                    name='baseline_iq4_xs_split.json' if identity['split'] else 'baseline_iq4_xs.json'\n                    doc=json.loads((Path('/w/tests/data')/name).read_text())\n                    fixture=next(f for f in doc['fixtures'] if f['name']==identity['fixture'])\n                    assert identity['weights_sha256']==fixture['weights_sha256'] and identity['packed_sha256']==fixture['packed_sha256']\n                    assert torch.equal(full,torch.tensor(fixture['cases'][index]['logits']))\n                trace.clear()\n                cache=None\n                for pos in range(ids.shape[1]):\n                    result=model(ids[:,pos:pos+1],past_key_values=cache,use_cache=True)\n                    cache=result.past_key_values\n                final=result.logits[0,-1]\n                stable=original==routes(trace)\n                error=float((full-final).abs().max())\n                assert torch.isfinite(full).all() and torch.isfinite(final).all()\n                row['cases'].append(dict(text=text,logit_error=error,routing_stable=stable))\n                row['routing_stable'] &= stable\n                del cache,result,full,final\n    finally:\n        for hook in hooks:\n            hook.remove()\n    row['status']='accepted' if row['routing_stable'] else 'refused'\n    row['max_logit_error']=max(c['logit_error'] for c in row['cases'])\n    report['runs'].append(row)\n    Path('/out/proposal.json').write_text(json.dumps(report,indent=2)+'\\n')\n    print(json.dumps({k:v for k,v in row.items() if k not in ('cases','config')}),flush=True)\n    del model\n    gc.collect()\nassert len(report['runs'])==30\nassert all(r['routing_stable'] for r in report['runs'] if r['seed']==12345)\nreport['max_reference_discrepancy']=max(r['max_logit_error'] for r in report['runs'] if r['routing_stable'])\nreport['proposed_logit_budget']=report['base_logit_margin']+report['max_reference_discrepancy']\nreport['complete']=True\nPath('/out/proposal.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in report.items() if k not in ('runs','sources')}),flush=True)\n",
