diff --git a/tools/perf_matmul_probe.cpp b/tools/perf_matmul_probe.cpp
new file mode 100644
index 0000000..9186f3f
--- /dev/null
+++ b/tools/perf_matmul_probe.cpp
@@ -0,0 +1,263 @@
+// Probe tool (research/server-perf-probe, never merged): an 8B pass's matmuls through the decode path and through the prompt tile, and whether the tile gives a row the same bits whatever shares its call.
+// time MODEL DEVICE ITERS COLS: wall ms of every layer's projections as the model groups them, and the head, at each column count, decode rows (extent 1) against tile rows (extent max(n, 64)) and tile rows at extent 64.
+//   With LLMX_PROBE_DIAG=1 the backend timestamps each dispatch and the tool prints each kernel's device ms per pass as well.
+// check MODEL DEVICE LAYER: for layer LAYER's projections and the head, each column of a tile call against the same column in a call of its own, over widths, orders, extents and calls mixing decode rows.
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+#include "backends/vulkan/vulkan_backend.hpp"
+#include "format/gguf.hpp"
+
+namespace {
+
+struct Tensor {
+    std::string name;
+    uint32_t type;
+    size_t nin, nout;
+    backend::BufferPtr buf;
+};
+
+std::vector<backend::RowRun> g_runs;
+backend::RowRuns runs(std::vector<backend::RowRun> r) {
+    g_runs = std::move(r);
+    return backend::RowRuns{g_runs.data(), g_runs.size()};
+}
+backend::RowRuns one(size_t n, size_t extent) { return runs({backend::RowRun{n, extent}}); }
+
+const char* kNames[] = {"attn_q.weight", "attn_k.weight", "attn_v.weight", "attn_output.weight", "ffn_gate.weight", "ffn_up.weight", "ffn_down.weight"};
+
+const char* type_name(uint32_t t) {
+    switch (t) {
+    case 0: return "F32";
+    case 1: return "F16";
+    case 2: return "Q4_0";
+    case 3: return "Q4_1";
+    case 8: return "Q8_0";
+    case 12: return "Q4_K";
+    case 13: return "Q5_K";
+    case 14: return "Q6_K";
+    default: return "?";
+    }
+}
+
+} // namespace
+
+static int run(int argc, char** argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: %s time|check MODEL [device] [iters|layer] [cols,...]\n", argv[0]);
+        return 2;
+    }
+    const std::string mode = argv[1], path = argv[2];
+    const int device = argc > 3 ? std::atoi(argv[3]) : 0;
+    const int arg4 = argc > 4 ? std::atoi(argv[4]) : (mode == "time" ? 10 : 0);
+    std::vector<size_t> cols = {1, 8, 16, 32, 64, 128};
+    if (argc > 5) {
+        cols.clear();
+        std::string s = argv[5];
+        for (size_t at = 0; at < s.size();) {
+            size_t e = s.find(',', at);
+            if (e == std::string::npos) e = s.size();
+            cols.push_back((size_t)std::atoi(s.substr(at, e - at).c_str()));
+            at = e + 1;
+        }
+    }
+    const char* diag = std::getenv("LLMX_PROBE_DIAG");
+    const bool timed = diag && *diag == '1';
+    gguf::GGUFModel m = gguf::read_gguf(path);
+    gguf::map_payload(m);
+    auto bp = backend::make_vulkan_backend(device, timed);
+    backend::Backend& b = *bp;
+    std::printf("device %s, %s\n", backend::vulkan_device_name(b).c_str(), path.c_str());
+
+    std::map<std::string, size_t> index;
+    for (size_t i = 0; i < m.tensors.size(); ++i) index[m.tensors[i].name] = i;
+    const auto adopt = [&](const std::string& name) {
+        auto it = index.find(name);
+        if (it == index.end()) throw std::runtime_error("no tensor " + name);
+        const auto& t = m.tensors[it->second];
+        Tensor x{name, t.type, (size_t)t.ne[0], (size_t)t.ne[1], nullptr};
+        x.buf = b.adopt(m.tensor_data(it->second), m.tensor_bytes(it->second));
+        return x;
+    };
+    const std::string head_name = index.count("output.weight") ? "output.weight" : "token_embd.weight";
+
+    const size_t NC = 160;
+    size_t maxin = 12288, maxout = 151936;
+    std::vector<float> xs(NC * maxin);
+    std::mt19937 rng(20260928);
+    for (float& v : xs) v = float((rng() >> 8) * (4.0 / 16777216.0) - 2.0);
+    const auto xb = b.adopt(xs.data(), xs.size() * sizeof(float));
+
+    if (mode == "time") {
+        int layers = 0;
+        while (index.count("blk." + std::to_string(layers) + ".attn_q.weight")) ++layers;
+        std::vector<std::vector<Tensor>> L(layers);
+        std::map<std::string, int> type_count;
+        for (int l = 0; l < layers; ++l)
+            for (const char* n : kNames) {
+                L[l].push_back(adopt("blk." + std::to_string(l) + "." + n));
+                type_count[std::string(n) + " " + type_name(L[l].back().type)]++;
+            }
+        const Tensor h = adopt(head_name);
+        type_count[std::string("head ") + type_name(h.type)]++;
+        for (const auto& kv : type_count) std::printf("tensors %s x%d\n", kv.first.c_str(), kv.second);
+        std::printf("layers %d, head %zu x %zu %s\n", layers, h.nin, h.nout, type_name(h.type));
+        const size_t NB = 128;
+        const auto qo = b.alloc(NB * 4096 * 4), ko = b.alloc(NB * 1024 * 4), vo = b.alloc(NB * 1024 * 4);
+        const auto go = b.alloc(NB * 12288 * 4), uo = b.alloc(NB * 12288 * 4), yo = b.alloc(NB * 4096 * 4), ho = b.alloc(NB * maxout * 4);
+        // One pass's matmuls: q, k, v as one group, o added into the residual, gate and up as one group, down added, then the head; `ext` 0 takes decode rows.
+        const auto pass = [&](size_t n, size_t ext) {
+            const backend::RowRun r{n, ext ? ext : 1};
+            const backend::RowRuns rr{&r, 1};
+            for (int l = 0; l < layers; ++l) {
+                const auto& t = L[l];
+                b.matmul_group({{t[0].type, {t[0].buf.get(), 0}, {qo.get(), 0}, t[0].nout}, {t[1].type, {t[1].buf.get(), 0}, {ko.get(), 0}, t[1].nout},
+                                {t[2].type, {t[2].buf.get(), 0}, {vo.get(), 0}, t[2].nout}},
+                               {xb.get(), 0}, t[0].nin, n, rr);
+                b.matmul_add(t[3].type, {t[3].buf.get(), 0}, {xb.get(), 0}, {yo.get(), 0}, t[3].nin, t[3].nout, n, rr);
+                b.matmul_group({{t[4].type, {t[4].buf.get(), 0}, {go.get(), 0}, t[4].nout}, {t[5].type, {t[5].buf.get(), 0}, {uo.get(), 0}, t[5].nout}},
+                               {xb.get(), 0}, t[4].nin, n, rr);
+                b.matmul_add(t[6].type, {t[6].buf.get(), 0}, {xb.get(), 0}, {yo.get(), 0}, t[6].nin, t[6].nout, n, rr);
+            }
+            b.matmul_logits(h.type, {h.buf.get(), 0}, {xb.get(), 0}, {ho.get(), 0}, h.nin, h.nout, n, rr);
+        };
+        for (size_t n : cols) {
+            if (n > NB) continue;
+            const size_t exts[3] = {0, std::max<size_t>(n, 64), 64};
+            const char* names[3] = {"decode", "tile", "tile64"};
+            for (int p = 0; p < 3; ++p) {
+                if (p == 2 && n <= 64) continue;   // the same as tile
+                pass(n, exts[p]);
+                b.sync();
+                if (timed) backend::vulkan_kernel_times(b);
+                const auto t0 = std::chrono::steady_clock::now();
+                for (int i = 0; i < arg4; ++i) pass(n, exts[p]);
+                b.sync();
+                const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / arg4;
+                std::printf("time n=%zu %s pass-matmuls %.2f ms\n", n, names[p], ms);
+                if (timed)
+                    for (const auto& kt : backend::vulkan_kernel_times(b))
+                        if (kt.second > 0) std::printf("  kernel n=%zu %s %s %.3f ms/pass\n", n, names[p], kt.first.c_str(), kt.second / arg4);
+                std::fflush(stdout);
+            }
+        }
+        return 0;
+    }
+
+    // check
+    std::vector<Tensor> ts;
+    for (const char* n : kNames) ts.push_back(adopt("blk." + std::to_string(arg4) + "." + n));
+    ts.push_back(adopt(head_name));
+    for (const Tensor& t : ts) std::printf("tensor %s %s %zu x %zu\n", t.name.c_str(), type_name(t.type), t.nin, t.nout);
+    const auto yb = b.alloc(NC * maxout * sizeof(float));
+    const auto xp = b.alloc(NC * maxin * sizeof(float));
+    // Y = W X for the columns of X at xoff, under `rr`, read back.
+    const auto mm = [&](const Tensor& t, backend::BufferPtr X, size_t n, backend::RowRuns rr, std::vector<float>& out) {
+        if (t.name == head_name) b.matmul_logits(t.type, {t.buf.get(), 0}, {X.get(), 0}, {yb.get(), 0}, t.nin, t.nout, n, rr);
+        else b.matmul(t.type, {t.buf.get(), 0}, {X.get(), 0}, {yb.get(), 0}, t.nin, t.nout, n, rr);
+        b.sync();
+        out.resize(n * t.nout);
+        b.read(*yb, 0, out.data(), out.size() * sizeof(float));
+    };
+    const std::vector<size_t> widths = {1, 2, 3, 5, 8, 13, 16, 17, 31, 32, 33, 48, 63, 64, 65, 100, 128, 129, 160};
+    size_t total_bad = 0;
+    for (const Tensor& t : ts) {
+        for (size_t E : {size_t(64), size_t(512)}) {
+            // Each column alone through the tile at extent E.
+            std::vector<float> alone(NC * t.nout), got, dec1(NC * t.nout);
+            for (size_t c = 0; c < NC; ++c) {
+                std::vector<float> o;
+                b.write(*xp, 0, xs.data() + c * t.nin, t.nin * sizeof(float));
+                mm(t, xp, 1, one(1, E), o);
+                std::memcpy(alone.data() + c * t.nout, o.data(), t.nout * sizeof(float));
+                if (E == 64) {
+                    mm(t, xp, 1, one(1, 1), o);
+                    std::memcpy(dec1.data() + c * t.nout, o.data(), t.nout * sizeof(float));
+                }
+            }
+            size_t bad = 0, compared = 0;
+            for (size_t n : widths) {
+                b.write(*xp, 0, xs.data(), n * t.nin * sizeof(float));
+                mm(t, xp, n, one(n, E), got);
+                for (size_t c = 0; c < n; ++c, ++compared)
+                    if (std::memcmp(got.data() + c * t.nout, alone.data() + c * t.nout, t.nout * sizeof(float))) {
+                        if (++bad <= 3) std::printf("  MISMATCH %s E=%zu n=%zu column %zu\n", t.name.c_str(), E, n, c);
+                    }
+                // The same columns in reverse order.
+                std::vector<float> rev(n * t.nin);
+                for (size_t c = 0; c < n; ++c) std::memcpy(rev.data() + c * t.nin, xs.data() + (n - 1 - c) * t.nin, t.nin * sizeof(float));
+                b.write(*xp, 0, rev.data(), rev.size() * sizeof(float));
+                mm(t, xp, n, one(n, E), got);
+                for (size_t c = 0; c < n; ++c, ++compared)
+                    if (std::memcmp(got.data() + c * t.nout, alone.data() + (n - 1 - c) * t.nout, t.nout * sizeof(float))) {
+                        if (++bad <= 3) std::printf("  MISMATCH reversed %s E=%zu n=%zu column %zu\n", t.name.c_str(), E, n, c);
+                    }
+            }
+            // Decode rows (extent 1) first, then tile rows, in one call: each part against its columns alone.
+            size_t mixed_bad = 0, mixed = 0;
+            for (size_t a : {size_t(1), size_t(7), size_t(16), size_t(40)})
+                for (size_t k : {size_t(1), size_t(17), size_t(64), size_t(100)}) {
+                    if (a + k > NC) continue;
+                    b.write(*xp, 0, xs.data(), (a + k) * t.nin * sizeof(float));
+                    mm(t, xp, a + k, runs({backend::RowRun{a, 1}, backend::RowRun{a + k, E}}), got);
+                    for (size_t c = 0; c < a + k; ++c, ++mixed) {
+                        const float* ref = (c < a && E == 64) ? dec1.data() + c * t.nout : alone.data() + c * t.nout;
+                        if (c < a && E != 64) continue;
+                        if (std::memcmp(got.data() + c * t.nout, ref, t.nout * sizeof(float))) {
+                            if (++mixed_bad <= 3) std::printf("  MISMATCH mixed %s E=%zu decode %zu tile %zu column %zu\n", t.name.c_str(), E, a, k, c);
+                        }
+                    }
+                }
+            total_bad += bad + mixed_bad;
+            std::printf("check %s %s E=%zu: tile columns differing from alone %zu of %zu, mixed calls %zu of %zu\n", t.name.c_str(), type_name(t.type), E,
+                        bad, compared, mixed_bad, mixed);
+            if (E == 64) {
+                // How far the tile's column is from the decode kernel's (informational: a row that switched kernels by batch would move this much).
+                size_t diff = 0;
+                double maxrel = 0;
+                for (size_t c = 0; c < NC; ++c) {
+                    bool d = false;
+                    for (size_t o = 0; o < t.nout; ++o) {
+                        const float u = alone[c * t.nout + o], v = dec1[c * t.nout + o];
+                        if (u != v) {
+                            d = true;
+                            maxrel = std::max(maxrel, (double)std::fabs(u - v) / std::max(1e-6, (double)std::fabs(v)));
+                        }
+                    }
+                    diff += d;
+                }
+                std::printf("check %s %s tile(E=64) against decode kernel: %zu of %zu columns differ, max relative difference %.3g\n", t.name.c_str(),
+                            type_name(t.type), diff, NC, maxrel);
+            }
+        }
+        // Extent 64 against extent 512 for the same column alone: the split follows the extent.
+        std::vector<float> a64, a512;
+        b.write(*xp, 0, xs.data(), t.nin * sizeof(float));
+        mm(t, xp, 1, one(1, 64), a64);
+        mm(t, xp, 1, one(1, 512), a512);
+        std::printf("check %s %s extent 64 against 512 alone: %s\n", t.name.c_str(), type_name(t.type),
+                    std::memcmp(a64.data(), a512.data(), a64.size() * sizeof(float)) ? "differ" : "same bits");
+        std::fflush(stdout);
+    }
+    std::printf("check total mismatches %zu\n", total_bad);
+    return total_bad ? 1 : 0;
+}
+
+int main(int argc, char** argv) {
+    try {
+        return run(argc, argv);
+    } catch (const std::exception& e) {
+        std::fflush(stdout);
+        std::fprintf(stderr, "error: %s\n", e.what());
+        return 1;
+    }
+}
