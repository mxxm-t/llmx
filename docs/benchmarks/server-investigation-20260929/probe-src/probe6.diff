index 0000000..8d81a81
--- /dev/null
+++ b/src/backends/vulkan/shaders/matmul_dtile4.comp
@@ -0,0 +1,199 @@
+#version 450
+// Probe only (never merged): the integer-dot tile's arithmetic (matmul_tile_q.comp) in the shape of a row kernel, fourth form: 8 lanes a row, no shared memory.
+// Each output is the tile's: per quant block, the exact integer dot of the row's 32 weights with the column's 8-bit activations, then the tile's float formula for the type, summed over the blocks in order within the call's part, the parts added by matmul_reduce.comp as the tile's are.
+// A group of 8 lanes takes one row and 8 consecutive blocks a step, lane j block k0 + j whole, so a step's weight reads are contiguous; lane j forms its block's integer dot for each of the COLS (up to 8) columns.
+// In round s every lane of the group takes block s's scale values and each column's dot by shuffles within the group, keeping column j's on lane j, which adds its column over the blocks in order with the tile's own expression.
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+#extension GL_EXT_control_flow_attributes : require
+#include "q.glsl"
+layout(local_size_x = 256) in;
+layout(constant_id = 0) const uint COLS = 8;
+layout(push_constant) uniform P {
+    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
+    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
+    uint per; uint order0; uint xrow;
+} p;
+layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
+layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
+layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
+layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
+layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
+uint pi = 0u;
+
+uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
+void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
+    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
+    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
+    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
+}
+
+void main() {
+    uint tid = gl_LocalInvocationID.x;
+    uint wg = gl_WorkGroupID.x;
+    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
+    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
+    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
+    uint g = tid / 8u, j = tid - g * 8u;
+    uint lane0 = gl_SubgroupInvocationID & ~7u;
+    uint row = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * 32u + g;
+    uint ncg = (p.nbatch + COLS - 1u) / COLS;
+    uint part = gl_WorkGroupID.y / ncg;
+    uint col_base = (gl_WorkGroupID.y - part * ncg) * COLS;
+    uint nblk = p.nin / 32u;
+    uint xtab = p.xrow * p.nin / 8u;
+    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
+    uint parts = (nblk + p.kper - 1u) / p.kper;
+    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
+    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
+    bool rin = row < nout;
+    uint wr = rin ? row : 0u;
+    uint mycol = min(col_base + j, p.nbatch - 1u);
+    float acc = 0.0;
+    for (uint k0 = kbeg; k0 < kend; k0 += 8u) {
+        uint nb = min(8u, kend - k0);
+        uint kb = min(k0 + j, kend - 1u);
+        uint v[8];
+        vec4 sv;
+#if defined(LLMX_Q8)
+        {
+            uint ob = (wr * nblk + kb) * Q8_0_BYTES;
+            bool str = (ob & 3u) == 0u;
+            uint base = (ob + 2u) >> 2u;
+            uint qv[9];
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) qv[m] = ws[pi].w32[base + m];
+            qv[8] = ws[pi].w32[str ? base + 8u : base - 1u];
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) v[m] = str ? (qv[m] >> 16u) | (qv[m + 1u] << 16u) : qv[m];
+            sv = vec4(unpackHalf2x16(str ? qv[0] : qv[8] >> 16u).x, 0.0, 0.0, 0.0);
