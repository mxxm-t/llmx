new file mode 100644
index 0000000..3d477a0
--- /dev/null
+++ b/src/core/probe_trace.hpp
@@ -0,0 +1,68 @@
+#pragma once
+// Probe only (research/server-perf-probe, never merged): a timeline of the server's scheduler thread and each device's dispatches, written to $LLMX_PROBE_TRACE.
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace probe {
+
+// One record: type 0 a host interval on the scheduler thread, type 1 a dispatch on device `dev` (kind the kernel variant, a its tag), both in CLOCK_MONOTONIC nanoseconds.
+struct Rec {
+    uint8_t type, dev;
+    uint16_t kind;
+    uint32_t a, b, c;
+    uint64_t t0, t1;
+};
+static_assert(sizeof(Rec) == 32, "record layout");
+
+enum Kind : uint16_t {
+    ROUND = 1, FORM = 2, STAGE = 3, WAIT_TICKET = 4, WAIT_SLOT = 5, WAIT_STAGING = 6, WRITE = 7, LOGITS_WAIT = 8,
+    COPY = 9, SAMPLE = 10, RETIRE = 11, READING = 12, SUBMIT = 13, FLUSH = 14, ROOM = 15, CALIB = 16,
+    POOL_RUN = 17, DRAW_COPY = 18, DRAW_SAMPLE = 19, STEP = 20
+};
+
+inline bool on = false;
+inline uint32_t tag = 0xffffffffu;   // (formed pass & 0xffffff) << 8 | stage, for the dispatches recorded now
+inline std::vector<Rec> recs;
+// Integer-dot tile calls of at most this many columns take the decode-tile kernel (shaders/matmul_dtile.comp); 0 never. $LLMX_PROBE_DTILE sets it for a server, the probe tool directly.
+inline size_t dtile_max = [] {
+    const char* e = std::getenv("LLMX_PROBE_DTILE");
+    return e ? (size_t)std::strtoul(e, nullptr, 10) : (size_t)0;
+}();
+// Quant blocks a part sums in integer-dot tile calls split for one column tile, tile and decode tile alike; 0 keeps the tile's own split. $LLMX_PROBE_DTILE_KPER sets it.
+inline size_t dtile_kper = [] {
+    const char* e = std::getenv("LLMX_PROBE_DTILE_KPER");
+    return e ? (size_t)std::strtoul(e, nullptr, 10) : (size_t)0;
+}();
+// With $LLMX_PROBE_DECODE_EXTENT set, attention views of one query row keep the per-row kernel whatever their extent.
+inline bool decode_rows_narrow = std::getenv("LLMX_PROBE_DECODE_EXTENT") != nullptr;
+// Which decode-tile kernel: 1 shaders/matmul_dtile.comp, 2 (the default) shaders/matmul_dtile2.comp; $LLMX_PROBE_DTILE_V sets it.
+inline int dtile_version = [] {
+    const char* e = std::getenv("LLMX_PROBE_DTILE_V");
+    return e ? std::atoi(e) : 2;
+}();
+
+inline const char* path() {
+    static const char* p = std::getenv("LLMX_PROBE_TRACE");
+    return p && *p ? p : nullptr;
+}
+inline uint64_t now_ns() {
+    return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline void host(uint16_t kind, uint64_t t0, uint64_t t1, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0, uint8_t dev = 0) {
+    if (on) recs.push_back(Rec{0, dev, kind, a, b, c, t0, t1});
+}
+inline void flush() {
+    if (!on || !path() || recs.empty()) return;
+    const uint64_t t0 = now_ns();
+    if (FILE* f = std::fopen(path(), "ab")) {
+        std::fwrite(recs.data(), sizeof(Rec), recs.size(), f);
+        std::fclose(f);
+    }
+    recs.clear();
+    host(FLUSH, t0, now_ns());
+}
+
+} // namespace probe
