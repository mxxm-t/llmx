+                float d = a0, cc = xc.x;
+                precise float pp = d * cc * float(mine);
+                acc += pp;
+#elif defined(LLMX_Q6)
+                acc += xc.x * (a0 * float(mine.x) + a1 * float(mine.y));
+#else
+                acc += a0 * xc.x * float(mine) - a1 * xc.y;
+#endif
+            }
+        }
+    }
+    uint col = col_base + j;
+    if (rin && j < COLS && col < p.nbatch) {
+        if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += acc;
+        else ys[pi].y[yo + col * nout + row] = acc;
+    }
