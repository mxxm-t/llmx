diff --git a/src/backends/vulkan/shaders/matmul_dtile.comp b/src/backends/vulkan/shaders/matmul_dtile.comp
new file mode 100644
index 0000000..f36f8d8
--- /dev/null
+++ b/src/backends/vulkan/shaders/matmul_dtile.comp
@@ -0,0 +1,159 @@
+#version 450
+// Probe only (never merged): the integer-dot tile's arithmetic (matmul_tile_q.comp) in the shape of a row kernel, for decode calls of few columns.
+// Each output is the tile's: per quant block, the exact integer dot of the row's 32 weights with the column's 8-bit activations, then the tile's float formula for the type, summed over the blocks in order within the call's part, the parts added by matmul_reduce.comp as the tile's are.
+// A group of 8 lanes takes one row, lane j staging word j of each block exactly as a tile of 32 rows stages it (WPR 8, WW 1); the integer sums meet in a clustered add, which is exact in any order, and every lane of the group then keeps the same float sums.
+// A workgroup takes 32 rows and COLS columns, reading a row's weights once for all of them; the push constants and bindings are the tile's, start0..2 counting workgroups of 32 rows.
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+#extension GL_EXT_control_flow_attributes : require
+#include "q.glsl"
+layout(local_size_x = 256) in;
+layout(constant_id = 0) const uint COLS = 8;
+layout(push_constant) uniform P {
+    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
+    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
+    uint per; uint order0; uint xrow;
+} p;
+layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
+layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
+layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
+layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
+layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
+uint pi = 0u;
+
+#define STEP 2u
+
+uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
+void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
+    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
+    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
+    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
+}
+
+void main() {
+    uint tid = gl_LocalInvocationID.x;
+    uint wg = gl_WorkGroupID.x;
+    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
+    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
+    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
+    uint g = tid / 8u, j = tid - g * 8u;
+    uint row = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * 32u + g;
+    uint ncg = (p.nbatch + COLS - 1u) / COLS;
+    uint part = gl_WorkGroupID.y / ncg;
+    uint col_base = (gl_WorkGroupID.y - part * ncg) * COLS;
+    uint nblk = p.nin / 32u;
+    uint xtab = p.xrow * p.nin / 8u;
+    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
+    uint parts = (nblk + p.kper - 1u) / p.kper;
+    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
+    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
+    bool rin = row < nout;
+    uint wr = rin ? row : 0u;
+    float acc[COLS];
+    [[unroll]] for (uint c = 0u; c < COLS; ++c) acc[c] = 0.0;
+    for (uint k0 = kbeg; k0 < kend; k0 += STEP) {
+        // Every load of a step first, then its blocks in order.
+        uint v[STEP];
+        vec4 sc4[STEP];
+        uint xw[STEP][COLS];
+        vec2 xc[STEP][COLS];
+        [[unroll]] for (uint s = 0u; s < STEP; ++s) {
+            uint kb = min(k0 + s, kend - 1u);
+            [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+                uint col = min(col_base + c, p.nbatch - 1u);
+                xw[s][c] = xq[(kb * p.xrow + col) * 8u + j];
+                xc[s][c] = xs[xtab + kb * p.xrow + col];
+            }
+#if defined(LLMX_Q8)
+            uint ob = (wr * nblk + kb) * Q8_0_BYTES;
+            bool str = (ob & 3u) == 0u;
+            uint base = ((ob + 2u) >> 2u) + j;
+            uint w0 = ws[pi].w32[base], w1 = ws[pi].w32[str ? base + 1u : base - 1u];
+            v[s] = str ? (w0 >> 16u) | (w1 << 16u) : w0;
+            uint sw = ws[pi].w32[ob >> 2u];
+            sc4[s] = vec4(unpackHalf2x16(str ? sw : sw >> 16u).x, 0.0, 0.0, 0.0);
+#elif defined(LLMX_Q6)
+            uint nsb = p.nin / 256u;
+            uint gg = kb & 7u, n = gg / 4u, which = gg & 3u;
+            uint o = (wr * nsb + kb / 8u) * Q6_K_BYTES;
+            uint lo = (o + n * 64u + (which & 1u) * 32u + j * 4u) >> 2u, hi = (o + 128u + n * 32u + j * 4u) >> 2u;
+            uint l0 = ws[pi].w32[lo], l1 = ws[pi].w32[lo + 1u], h0 = ws[pi].w32[hi], h1 = ws[pi].w32[hi + 1u];
+            bool odd = (o & 3u) != 0u;
+            uint ql = odd ? (l0 >> 16u) | (l1 << 16u) : l0;
+            uint qh = odd ? (h0 >> 16u) | (h1 << 16u) : h0;
+            uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
+            uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
+            uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
+            v[s] = t | (neg << 1u) | (neg << 2u);
+            uint si = o + 192u + (gg / 4u) * 8u + 2u * (gg & 3u);
+            uint dw = ws[pi].w32[(o + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
+            float d = unpackHalf2x16((o & 3u) == 0u ? dw : (dw >> 16u)).x;
+            uint sb = sw >> (8u * (si & 3u));
+            float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
+            sc4[s] = vec4(d * s0, d * s1, 0.0, 0.0);
+#else
+            if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
+                bool k5 = p.type == TYPE_Q5_K;
+                uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
+                uint gg = kb & 7u;
+                uint o = (wr * nsb + kb / 8u) * bytes;
+                uint q = ws[pi].w32[(o + (k5 ? 48u : 16u) + (gg / 2u) * 32u) / 4u + j];
+                uint vv = (q >> (4u * (gg & 1u))) & 0x0F0F0F0Fu;
+                if (k5) vv |= ((ws[pi].w32[(o + 16u) / 4u + j] >> gg) & 0x01010101u) << 4u;
+                v[s] = vv;
+                uvec4 h = uvec4(ws[pi].w32[o / 4u], ws[pi].w32[o / 4u + 1u], ws[pi].w32[o / 4u + 2u], ws[pi].w32[o / 4u + 3u]);
+                vec2 dd = unpackHalf2x16(h.x);
+                uint sc, mn;
+                scale_min_k4_words(h.yzw, gg, sc, mn);
+                sc4[s] = vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0);
+            } else {
+                bool q41 = p.type == TYPE_Q4_1;
+                uint bytes = q41 ? Q4_1_BYTES : Q4_0_BYTES, qoff = q41 ? 4u : 2u;
+                uint os = (wr * nblk + kb) * bytes;
+                uint q0 = os + qoff;
+                uint i = (q0 >> 2u) + (j & 3u);
+                uint a0 = ws[pi].w32[i], a1 = ws[pi].w32[i + ((q0 & 3u) != 0u ? 1u : 0u)];
+                bool odd = (q0 & 3u) != 0u;
+                uint nw = odd ? (a0 >> 16u) | (a1 << 16u) : a0;
+                uint b = (nw >> (4u * (j >> 2u))) & 0x0F0F0F0Fu;
+                uint t = b ^ 0x08080808u, neg = t & 0x08080808u;
+                v[s] = q41 ? b : t | (neg << 1u) | (neg << 2u) | (neg << 3u) | (neg << 4u);
+                uint sw = ws[pi].w32[os >> 2u];
+                vec2 dm = unpackHalf2x16(!q41 && (os & 3u) != 0u ? sw >> 16u : sw);
+                sc4[s] = q41 ? vec4(dm.x, dm.x, -dm.y, 0.0) : vec4(dm.x, dm.x, 0.0, 0.0);
+            }
+#endif
+        }
+        [[unroll]] for (uint s = 0u; s < STEP; ++s) {
+            if (k0 + s >= kend) break;
+            [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+                int t = dotPacked4x8EXT(int(v[s]), int(xw[s][c]));
+#if defined(LLMX_Q8)
+                t = subgroupClusteredAdd(t, 8u);
+                float d = sc4[s].x, cc = xc[s][c].x;
+                precise float pp = d * cc * float(t);
+                acc[c] += pp;
+#elif defined(LLMX_Q6)
+                int l = subgroupClusteredAdd(j < 4u ? t : 0, 8u), h = subgroupClusteredAdd(j < 4u ? 0 : t, 8u);
+                vec4 w4 = sc4[s];
+                acc[c] += xc[s][c].x * (w4.x * float(l) + w4.y * float(h));
+#else
+                t = subgroupClusteredAdd(t, 8u);
+                vec4 w4 = sc4[s];
+                acc[c] += w4.x * xc[s][c].x * float(t) - w4.z * xc[s][c].y;
+#endif
+            }
+        }
+    }
+    if (j != 0u || !rin) return;
+    [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+        uint col = col_base + c;
+        if (col < p.nbatch) {
+            if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += acc[c];
+            else ys[pi].y[yo + col * nout + row] = acc[c];
+        }
+    }
+}
diff --git a/src/backends/vulkan/shaders/matmul_dtile2.comp b/src/backends/vulkan/shaders/matmul_dtile2.comp
new file mode 100644
index 0000000..3642bb5
--- /dev/null
+++ b/src/backends/vulkan/shaders/matmul_dtile2.comp
@@ -0,0 +1,207 @@
+#version 450
+// Probe only (never merged): the integer-dot tile's arithmetic (matmul_tile_q.comp) in the shape of a row kernel, second form.
+// Each output is the tile's: per quant block, the exact integer dot of the row's 32 weights with the column's 8-bit activations, then the tile's float formula for the type, summed over the blocks in order within the call's part, the parts added by matmul_reduce.comp as the tile's are.
+// A group of 8 lanes takes one row and 8 consecutive blocks a step, lane j block k0 + j whole, so a step's weight reads are contiguous; each lane forms its block's integer dot for every column.
+// The dots and the block's scale values go through shared memory, and lane j then adds columns j, j + 8, ... over the step's blocks in order, evaluating the tile's own expression.
+// The step's activations are staged once in shared memory for the workgroup's 32 rows; the push constants and bindings are the tile's, start0..2 counting workgroups of 32 rows.
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_EXT_control_flow_attributes : require
+#include "q.glsl"
+layout(local_size_x = 256) in;
+layout(constant_id = 0) const uint COLS = 8;
+layout(push_constant) uniform P {
+    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
+    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
+    uint per; uint order0; uint xrow;
+} p;
+layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
+layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
+layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
+layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
+layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
+uint pi = 0u;
+
+#define MAXC 16u
+#define XS_ (MAXC * 8u + 1u)
+shared uint xw[8u * XS_];          // a step's activation words: block s, column c, word m at s * XS_ + c * 8 + m, padded against bank conflicts
+shared vec2 xsc[8u][MAXC];        // and each block's scale and scaled sum per column
+#ifdef LLMX_Q6
+shared ivec2 tt[32u][8u][MAXC + 1u];   // per row, block and column: the dot's two halves
+#else
+shared int tt[32u][8u][MAXC + 1u];   // per row, block and column: the block's integer dot
+#endif
+shared vec4 wsv[32u][8u];         // per row and block: the tile's scale values
+
+uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
+void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
+    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
+    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
+    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
+}
+
+void main() {
+    uint tid = gl_LocalInvocationID.x;
+    uint wg = gl_WorkGroupID.x;
+    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
+    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
+    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
+    uint g = tid / 8u, j = tid - g * 8u;
+    uint row = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * 32u + g;
+    uint ncg = (p.nbatch + COLS - 1u) / COLS;
+    uint part = gl_WorkGroupID.y / ncg;
+    uint col_base = (gl_WorkGroupID.y - part * ncg) * COLS;
+    uint nblk = p.nin / 32u;
+    uint xtab = p.xrow * p.nin / 8u;
+    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
+    uint parts = (nblk + p.kper - 1u) / p.kper;
+    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
+    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
+    bool rin = row < nout;
+    uint wr = rin ? row : 0u;
+    // Lane j adds columns j and j + 8 of its row.
+    float acc0 = 0.0, acc1 = 0.0;
+    for (uint k0 = kbeg; k0 < kend; k0 += 8u) {
+        uint nb = min(8u, kend - k0);
+        // Stage the step's activations: 8 blocks, COLS columns, 8 words each, and their scale pairs.
+        for (uint i = tid; i < 8u * COLS * 8u; i += 256u) {
+            uint s = i / (COLS * 8u), c = (i / 8u) % COLS, w = i % 8u;
+            uint kb = min(k0 + s, kend - 1u), col = min(col_base + c, p.nbatch - 1u);
+            xw[s * XS_ + c * 8u + w] = xq[(kb * p.xrow + col) * 8u + w];
+        }
+        for (uint i = tid; i < 8u * COLS; i += 256u) {
+            uint s = i / COLS, c = i % COLS;
+            uint kb = min(k0 + s, kend - 1u), col = min(col_base + c, p.nbatch - 1u);
+            xsc[s][c] = xs[xtab + kb * p.xrow + col];
+        }
+        // Lane j's block, its 8 staged words as the tile stages them (one thread a row: WPR 1, WW 8), and its scale values.
+        uint kb = min(k0 + j, kend - 1u);
+        uint v[8];
+        vec4 sv;
+#if defined(LLMX_Q8)
+        {
+            uint ob = (wr * nblk + kb) * Q8_0_BYTES;
+            bool str = (ob & 3u) == 0u;
+            uint base = (ob + 2u) >> 2u;
+            uint qv[9];
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) qv[m] = ws[pi].w32[base + m];
+            qv[8] = ws[pi].w32[str ? base + 8u : base - 1u];
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) v[m] = str ? (qv[m] >> 16u) | (qv[m + 1u] << 16u) : qv[m];
+            sv = vec4(unpackHalf2x16(str ? qv[0] : qv[8] >> 16u).x, 0.0, 0.0, 0.0);
+        }
+#elif defined(LLMX_Q6)
+        {
+            uint nsb = p.nin / 256u;
+            uint gg = kb & 7u, n = gg / 4u, which = gg & 3u;
+            uint o = (wr * nsb + kb / 8u) * Q6_K_BYTES;
+            uint lo = (o + n * 64u + (which & 1u) * 32u) >> 2u, hi = (o + 128u + n * 32u) >> 2u;
+            uint lv[9], hv[9];
+            [[unroll]] for (uint m = 0u; m <= 8u; ++m) { lv[m] = ws[pi].w32[lo + m]; hv[m] = ws[pi].w32[hi + m]; }
+            bool odd = (o & 3u) != 0u;
+            uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) {
+                uint ql = odd ? (lv[m] >> 16u) | (lv[m + 1u] << 16u) : lv[m];
+                uint qh = odd ? (hv[m] >> 16u) | (hv[m + 1u] << 16u) : hv[m];
+                uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
+                uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
+                v[m] = t | (neg << 1u) | (neg << 2u);
+            }
+            uint si = o + 192u + (gg / 4u) * 8u + 2u * (gg & 3u);
+            uint dw = ws[pi].w32[(o + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
+            float d = unpackHalf2x16((o & 3u) == 0u ? dw : (dw >> 16u)).x;
+            uint sb = sw >> (8u * (si & 3u));
+            float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
+            sv = vec4(d * s0, d * s1, 0.0, 0.0);
+        }
+#else
+        if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
+            bool k5 = p.type == TYPE_Q5_K;
+            uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
+            uint gg = kb & 7u;
+            uint o = (wr * nsb + kb / 8u) * bytes;
+            uint base = (o + (k5 ? 48u : 16u) + (gg / 2u) * 32u) / 4u;
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) {
+                uint vv = (ws[pi].w32[base + m] >> (4u * (gg & 1u))) & 0x0F0F0F0Fu;
+                if (k5) vv |= ((ws[pi].w32[(o + 16u) / 4u + m] >> gg) & 0x01010101u) << 4u;
+                v[m] = vv;
+            }
+            uvec4 h = uvec4(ws[pi].w32[o / 4u], ws[pi].w32[o / 4u + 1u], ws[pi].w32[o / 4u + 2u], ws[pi].w32[o / 4u + 3u]);
+            vec2 dd = unpackHalf2x16(h.x);
+            uint sc, mn;
+            scale_min_k4_words(h.yzw, gg, sc, mn);
+            sv = vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0);
+        } else {
+            bool q41 = p.type == TYPE_Q4_1;
+            uint bytes = q41 ? Q4_1_BYTES : Q4_0_BYTES, qoff = q41 ? 4u : 2u;
+            uint os = (wr * nblk + kb) * bytes;
+            uint q0 = os + qoff;
+            bool odd = (q0 & 3u) != 0u;
+            [[unroll]] for (uint m = 0u; m < 4u; ++m) {
+                uint i = (q0 >> 2u) + m;
+                uint a0 = ws[pi].w32[i], a1 = ws[pi].w32[i + (odd ? 1u : 0u)];
+                uint nw = odd ? (a0 >> 16u) | (a1 << 16u) : a0;
+                [[unroll]] for (uint hh = 0u; hh < 2u; ++hh) {
+                    uint b = (nw >> (4u * hh)) & 0x0F0F0F0Fu;
+                    uint t = b ^ 0x08080808u, neg = t & 0x08080808u;
+                    v[m + 4u * hh] = q41 ? b : t | (neg << 1u) | (neg << 2u) | (neg << 3u) | (neg << 4u);
+                }
+            }
+            uint sw = ws[pi].w32[os >> 2u];
+            vec2 dm = unpackHalf2x16(!q41 && (os & 3u) != 0u ? sw >> 16u : sw);
+            sv = q41 ? vec4(dm.x, dm.x, -dm.y, 0.0) : vec4(dm.x, dm.x, 0.0, 0.0);
+        }
+#endif
+        wsv[g][j] = sv;
+        barrier();
+        // Lane j's block against every column: the words in order, as the tile sums them, exact in any order.
+        [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+#ifdef LLMX_Q6
+            int l = 0, h = 0;
+            [[unroll]] for (uint m = 0u; m < 4u; ++m) {
+                l += dotPacked4x8EXT(int(v[m]), int(xw[j * XS_ + c * 8u + m]));
+                h += dotPacked4x8EXT(int(v[m + 4u]), int(xw[j * XS_ + c * 8u + m + 4u]));
+            }
+            tt[g][j][c] = ivec2(l, h);
+#else
+            int t = 0;
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) t += dotPacked4x8EXT(int(v[m]), int(xw[j * XS_ + c * 8u + m]));
+            tt[g][j][c] = t;
+#endif
+        }
+        barrier();
+        // Lane j adds its columns over the step's blocks in order, with the tile's expression.
+        for (uint s = 0u; s < nb; ++s) {
+            vec4 w4 = wsv[g][s];
+            [[unroll]] for (uint q = 0u; q < 2u; ++q) {
+                uint c = j + 8u * q;
+                if (c >= COLS) break;
+                vec2 xc = xsc[s][c];
+                float a = q == 0u ? acc0 : acc1;
+#if defined(LLMX_Q8)
+                float d = w4.x, cc = xc.x;
+                precise float pp = d * cc * float(tt[g][s][c]);
+                a += pp;
+#elif defined(LLMX_Q6)
+                ivec2 lh = tt[g][s][c];
+                a += xc.x * (w4.x * float(lh.x) + w4.y * float(lh.y));
+#else
+                a += w4.x * xc.x * float(tt[g][s][c]) - w4.z * xc.y;
+#endif
+                if (q == 0u) acc0 = a; else acc1 = a;
+            }
+        }
+        barrier();
+    }
+    if (!rin) return;
+    [[unroll]] for (uint q = 0u; q < 2u; ++q) {
+        uint c = j + 8u * q;
+        uint col = col_base + c;
+        if (c < COLS && col < p.nbatch) {
+            float a = q == 0u ? acc0 : acc1;
+            if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += a;
+            else ys[pi].y[yo + col * nout + row] = a;
+        }
+    }
+}
diff --git a/src/backends/vulkan/shaders/matmul_dtile3.comp b/src/backends/vulkan/shaders/matmul_dtile3.comp
new file mode 100644
index 0000000..975d0c1
--- /dev/null
+++ b/src/backends/vulkan/shaders/matmul_dtile3.comp
@@ -0,0 +1,185 @@
+#version 450
+// Probe only (never merged): the integer-dot tile's arithmetic (matmul_tile_q.comp) in the shape of a row kernel, third form: one lane a row.
+// Each output is the tile's: per quant block, the exact integer dot of the row's 32 weights with the column's 8-bit activations, then the tile's float formula for the type, summed over the blocks in order within the call's part, the parts added by matmul_reduce.comp as the tile's are.
+// Lane l of a workgroup of 64 takes row 64 w + l and walks its part's blocks in order, staging each block's 8 words as a tile thread staging a whole row does (WPR 1, WW 8), so no sum crosses lanes.
+// A step's activations for the workgroup's COLS columns are staged in shared memory, which every lane reads at the same address; the push constants and bindings are the tile's, start0..2 counting workgroups of 64 rows.
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_EXT_control_flow_attributes : require
+#include "q.glsl"
+layout(local_size_x = 64) in;
+layout(constant_id = 0) const uint COLS = 8;
+layout(push_constant) uniform P {
+    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
+    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
+    uint per; uint order0; uint xrow;
+} p;
+layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
+layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
+layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
+layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
+layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
+uint pi = 0u;
+
+#define SB 8u
+shared uint xw[SB][COLS][8u];
+shared vec2 xsc[SB][COLS];
+
+uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
+void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
+    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
+    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
+    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
+}
+
+// Block kb of row wr: its 8 staged words and the tile's scale values.
+void block(uint wr, uint kb, uint nblk, out uint v[8], out vec4 sv) {
+#if defined(LLMX_Q8)
+    uint ob = (wr * nblk + kb) * Q8_0_BYTES;
+    bool str = (ob & 3u) == 0u;
+    uint base = (ob + 2u) >> 2u;
+    uint qv[9];
+    [[unroll]] for (uint m = 0u; m < 8u; ++m) qv[m] = ws[pi].w32[base + m];
+    qv[8] = ws[pi].w32[str ? base + 8u : base - 1u];
+    [[unroll]] for (uint m = 0u; m < 8u; ++m) v[m] = str ? (qv[m] >> 16u) | (qv[m + 1u] << 16u) : qv[m];
+    sv = vec4(unpackHalf2x16(str ? qv[0] : qv[8] >> 16u).x, 0.0, 0.0, 0.0);
+#elif defined(LLMX_Q6)
+    uint nsb = p.nin / 256u;
+    uint gg = kb & 7u, n = gg / 4u, which = gg & 3u;
+    uint o = (wr * nsb + kb / 8u) * Q6_K_BYTES;
+    uint lo = (o + n * 64u + (which & 1u) * 32u) >> 2u, hi = (o + 128u + n * 32u) >> 2u;
+    uint lv[9], hv[9];
+    [[unroll]] for (uint m = 0u; m <= 8u; ++m) { lv[m] = ws[pi].w32[lo + m]; hv[m] = ws[pi].w32[hi + m]; }
+    bool odd = (o & 3u) != 0u;
+    uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
+    [[unroll]] for (uint m = 0u; m < 8u; ++m) {
+        uint ql = odd ? (lv[m] >> 16u) | (lv[m + 1u] << 16u) : lv[m];
+        uint qh = odd ? (hv[m] >> 16u) | (hv[m + 1u] << 16u) : hv[m];
+        uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
+        uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
+        v[m] = t | (neg << 1u) | (neg << 2u);
+    }
+    uint si = o + 192u + (gg / 4u) * 8u + 2u * (gg & 3u);
+    uint dw = ws[pi].w32[(o + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
+    float d = unpackHalf2x16((o & 3u) == 0u ? dw : (dw >> 16u)).x;
+    uint sb = sw >> (8u * (si & 3u));
+    float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
+    sv = vec4(d * s0, d * s1, 0.0, 0.0);
+#else
+    if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
+        bool k5 = p.type == TYPE_Q5_K;
+        uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
+        uint gg = kb & 7u;
+        uint o = (wr * nsb + kb / 8u) * bytes;
+        uint base = (o + (k5 ? 48u : 16u) + (gg / 2u) * 32u) / 4u;
+        [[unroll]] for (uint m = 0u; m < 8u; ++m) {
+            uint vv = (ws[pi].w32[base + m] >> (4u * (gg & 1u))) & 0x0F0F0F0Fu;
+            if (k5) vv |= ((ws[pi].w32[(o + 16u) / 4u + m] >> gg) & 0x01010101u) << 4u;
+            v[m] = vv;
+        }
+        uvec4 h = uvec4(ws[pi].w32[o / 4u], ws[pi].w32[o / 4u + 1u], ws[pi].w32[o / 4u + 2u], ws[pi].w32[o / 4u + 3u]);
+        vec2 dd = unpackHalf2x16(h.x);
+        uint sc, mn;
+        scale_min_k4_words(h.yzw, gg, sc, mn);
+        sv = vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0);
+    } else {
+        bool q41 = p.type == TYPE_Q4_1;
+        uint bytes = q41 ? Q4_1_BYTES : Q4_0_BYTES, qoff = q41 ? 4u : 2u;
+        uint os = (wr * nblk + kb) * bytes;
+        uint q0 = os + qoff;
+        bool odd = (q0 & 3u) != 0u;
+        [[unroll]] for (uint m = 0u; m < 4u; ++m) {
+            uint i = (q0 >> 2u) + m;
+            uint a0 = ws[pi].w32[i], a1 = ws[pi].w32[i + (odd ? 1u : 0u)];
+            uint nw = odd ? (a0 >> 16u) | (a1 << 16u) : a0;
+            [[unroll]] for (uint hh = 0u; hh < 2u; ++hh) {
+                uint b = (nw >> (4u * hh)) & 0x0F0F0F0Fu;
+                uint t = b ^ 0x08080808u, neg = t & 0x08080808u;
+                v[m + 4u * hh] = q41 ? b : t | (neg << 1u) | (neg << 2u) | (neg << 3u) | (neg << 4u);
+            }
+        }
+        uint sw = ws[pi].w32[os >> 2u];
+        vec2 dm = unpackHalf2x16(!q41 && (os & 3u) != 0u ? sw >> 16u : sw);
+        sv = q41 ? vec4(dm.x, dm.x, -dm.y, 0.0) : vec4(dm.x, dm.x, 0.0, 0.0);
+    }
+#endif
+}
+
+void main() {
+    uint tid = gl_LocalInvocationID.x;
+    uint wg = gl_WorkGroupID.x;
+    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
+    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
+    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
+    uint row = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * 64u + tid;
+    uint ncg = (p.nbatch + COLS - 1u) / COLS;
+    uint part = gl_WorkGroupID.y / ncg;
+    uint col_base = (gl_WorkGroupID.y - part * ncg) * COLS;
+    uint nblk = p.nin / 32u;
+    uint xtab = p.xrow * p.nin / 8u;
+    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
+    uint parts = (nblk + p.kper - 1u) / p.kper;
+    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
+    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
+    bool rin = row < nout;
+    uint wr = rin ? row : 0u;
+    float acc[COLS];
+    [[unroll]] for (uint c = 0u; c < COLS; ++c) acc[c] = 0.0;
+    for (uint k0 = kbeg; k0 < kend; k0 += SB) {
+        uint nb = min(SB, kend - k0);
+        barrier();
+        for (uint i = tid; i < SB * COLS * 8u; i += 64u) {
+            uint s = i / (COLS * 8u), c = (i / 8u) % COLS, w = i % 8u;
+            uint kb = min(k0 + s, kend - 1u), col = min(col_base + c, p.nbatch - 1u);
+            xw[s][c][w] = xq[(kb * p.xrow + col) * 8u + w];
+        }
+        for (uint i = tid; i < SB * COLS; i += 64u) {
+            uint s = i / COLS, c = i % COLS;
+            uint kb = min(k0 + s, kend - 1u), col = min(col_base + c, p.nbatch - 1u);
+            xsc[s][c] = xs[xtab + kb * p.xrow + col];
+        }
+        barrier();
+        for (uint s = 0u; s < nb; s += 2u) {
+            // Two blocks' loads in flight, then each block in order.
+            uint va[8], vb[8];
+            vec4 sa, sb2;
+            block(wr, k0 + s, nblk, va, sa);
+            block(wr, min(k0 + s + 1u, kend - 1u), nblk, vb, sb2);
+            [[unroll]] for (uint h = 0u; h < 2u; ++h) {
+                uint ss = s + h;
+                if (ss >= nb) break;
+                vec4 w4 = h == 0u ? sa : sb2;
+                [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+                    vec2 xc = xsc[ss][c];
+#ifdef LLMX_Q6
+                    int l = 0, hsum = 0;
+                    [[unroll]] for (uint m = 0u; m < 4u; ++m) {
+                        l += dotPacked4x8EXT(int(h == 0u ? va[m] : vb[m]), int(xw[ss][c][m]));
+                        hsum += dotPacked4x8EXT(int(h == 0u ? va[m + 4u] : vb[m + 4u]), int(xw[ss][c][m + 4u]));
+                    }
+                    acc[c] += xc.x * (w4.x * float(l) + w4.y * float(hsum));
+#else
+                    int t = 0;
+                    [[unroll]] for (uint m = 0u; m < 8u; ++m) t += dotPacked4x8EXT(int(h == 0u ? va[m] : vb[m]), int(xw[ss][c][m]));
+#if defined(LLMX_Q8)
+                    float d = w4.x, cc = xc.x;
+                    precise float pp = d * cc * float(t);
+                    acc[c] += pp;
+#else
+                    acc[c] += w4.x * xc.x * float(t) - w4.z * xc.y;
+#endif
+#endif
+                }
+            }
+        }
+    }
+    if (!rin) return;
+    [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+        uint col = col_base + c;
+        if (col < p.nbatch) {
+            if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += acc[c];
+            else ys[pi].y[yo + col * nout + row] = acc[c];
+        }
+    }
+}
diff --git a/src/backends/vulkan/shaders/matmul_dtile4.comp b/src/backends/vulkan/shaders/matmul_dtile4.comp
