+            uint lv[9], hv[9];
+            [[unroll]] for (uint m = 0u; m <= 8u; ++m) { lv[m] = ws[pi].w32[lo + m]; hv[m] = ws[pi].w32[hi + m]; }
+            bool odd = (o & 3u) != 0u;
