+            [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+                int x = subgroupShuffle(t[c], src);
+                if (j == c) mine = x;
+            }
+#endif
+            if (s < nb && j < COLS) {
+                vec2 xc = xs[xtab + (k0 + s) * p.xrow + mycol];
