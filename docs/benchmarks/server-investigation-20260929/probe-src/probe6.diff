+                uint qh = odd ? (hv[m] >> 16u) | (hv[m + 1u] << 16u) : hv[m];
+                uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
+                uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
+                v[m] = t | (neg << 1u) | (neg << 2u);
+            }
+            uint si = o + 192u + (gg / 4u) * 8u + 2u * (gg & 3u);
+            uint dw = ws[pi].w32[(o + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
+            float d = unpackHalf2x16((o & 3u) == 0u ? dw : (dw >> 16u)).x;
+            uint sb = sw >> (8u * (si & 3u));
+            float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
+            sv = vec4(d * s0, d * s1, 0.0, 0.0);
+        }
+#else
+        if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
+            bool k5 = p.type == TYPE_Q5_K;
+            uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
+            uint gg = kb & 7u;
+            uint o = (wr * nsb + kb / 8u) * bytes;
+            uint base = (o + (k5 ? 48u : 16u) + (gg / 2u) * 32u) / 4u;
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) {
+                uint vv = (ws[pi].w32[base + m] >> (4u * (gg & 1u))) & 0x0F0F0F0Fu;
