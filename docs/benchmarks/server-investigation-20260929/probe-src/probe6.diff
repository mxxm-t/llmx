+#else
+            int s = 0;
+            [[unroll]] for (uint m = 0u; m < 8u; ++m) s += dotPacked4x8EXT(int(v[m]), int(xq[xb + m]));
+            t[c] = s;
+#endif
+        }
+        // Block s in round s: every lane of the group takes its scale values and, for column j, its dot, so lane j adds its column over the blocks in order with the tile's own expression.
+        [[unroll]] for (uint s = 0u; s < 8u; ++s) {
+            uint src = lane0 | s;
+            float a0 = subgroupShuffle(sv.x, src);
+#if defined(LLMX_Q6)
+            float a1 = subgroupShuffle(sv.y, src);
+            ivec2 mine = ivec2(0);
+            [[unroll]] for (uint c = 0u; c < COLS; ++c) {
+                ivec2 x = ivec2(subgroupShuffle(t[c].x, src), subgroupShuffle(t[c].y, src));
+                if (j == c) mine = x;
+            }
+#else
+            float a1 = subgroupShuffle(sv.z, src);
