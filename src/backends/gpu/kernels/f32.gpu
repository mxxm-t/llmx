// NVFP4's values with the tensor's F32 factor, each rounded after the decode and again after the factor, as the CPU's float_rows rounds them; the factor is 1 without weight scales.
struct ExactNVFP4 : ExactDecoded<rq::NVFP4> {
    float factor = 1.0f;
    __device__ float value(const unsigned char* row, unsigned long long u) const { return rq::NVFP4::value(row + u / rq::NVFP4::values * rq::NVFP4::bytes, (int)(u % rq::NVFP4::values)) * factor; }
    __device__ float step(const unsigned char* row, const float* x, unsigned long long u, float s) const { return fmaf(value(row, u), x[u], s); }
    template <int O, int R> __device__ void parts(const unsigned char* const* rows, const float* const* x, unsigned long long nin, float (&s)[O][R]) const {
        for (unsigned long long i = threadIdx.x; i < nin; i += kThreads) {
            float w[O], v[R];
#pragma unroll
            for (int o = 0; o < O; ++o) w[o] = value(rows[o], i);
#pragma unroll
            for (int r = 0; r < R; ++r) v[r] = x[r][i];
#pragma unroll
            for (int o = 0; o < O; ++o)
#pragma unroll
                for (int r = 0; r < R; ++r) s[o][r] = fmaf(w[o], v[r], s[o][r]);
        }
    }
};
template <> __device__ inline ExactNVFP4 decoder<ExactNVFP4>(const float* scales, unsigned long long i) {
    ExactNVFP4 d;
    if (scales) d.factor = scales[i];
    return d;
}
// NVFP4's exact family takes its weight's scales after the other types' arguments, null without them; a routed call's are one an expert `step` apart, step 0 for one factor.
extern "C" __global__ void __launch_bounds__(kThreads) llmx_matmul_nvfp4(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout, int add,
                                                                         const float* scales) {
    exact_wave<ExactNVFP4>(W, X, Y, nin, nout, add, decoder<ExactNVFP4>(scales, 0));
}
extern "C" __global__ void __launch_bounds__(kThreads) llmx_routed_nvfp4(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout, RoutedExact r,
                                                                         const float* scales, unsigned long long step) {
    routed_exact<ExactNVFP4>(W, X, Y, nin, nout, r, scales, step);
}
extern "C" __global__ void __launch_bounds__(kThreads) llmx_matmul_rows_nvfp4(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout,
                                                                              unsigned long long nrows, int add, const float* scales) {
    exact_rows<ExactNVFP4>(W, X, Y, nin, nout, nrows, add, decoder<ExactNVFP4>(scales, 0));
}
extern "C" __global__ void llmx_gather_nvfp4(float* dst, const unsigned char* table, const unsigned* ids, unsigned long long width, unsigned nrows, const float* scales) {
    gather_decoded<rq::NVFP4>(dst, table, ids, width, nrows, scales ? scales[0] : 1.0f);
}

// F8_E4M3's values under its grid: row r's input k takes grid[(r >> shift) * (nin / 128) + k / 128], the code's value rounded once after it, as the CPU's embedding rounds it.
// The decoder holds its matrix's first row, so a row pointer gives its grid row.
struct ExactF8 : ExactDecoded<rq::F8_E4M3> {
    static constexpr bool vector = true;
    static constexpr int weight_bytes = 1;
    static constexpr unsigned long long align = 4;
    const unsigned char* base;
    const float* grid;
    unsigned long long nin;
    unsigned shift;
    const float* g = nullptr;   // the bound row's grid row (bound), null before
    __device__ const float* row_grid(const unsigned char* row) const { return grid + ((unsigned long long)(row - base) / nin >> shift) * (nin / quant::F8_E4M3_SCALE_INPUTS); }
    __device__ float4 load4(const unsigned char* row, unsigned long long u) const {
        const unsigned w = ((const unsigned*)row)[u / 4];
        const float sc = g[u / quant::F8_E4M3_SCALE_INPUTS];
        const auto v = [](unsigned c) { const unsigned char b = (unsigned char)c; return rq::F8_E4M3::value(&b, 0); };
        return make_float4(v(w) * sc, v(w >> 8) * sc, v(w >> 16) * sc, v(w >> 24) * sc);
    }
    __device__ float step(const unsigned char* row, const float* x, unsigned long long u, float s) const {
        return fmaf(rq::F8_E4M3::value(row + u, 0) * g[u / quant::F8_E4M3_SCALE_INPUTS], x[u], s);
    }
    template <int O, int R> __device__ void parts(const unsigned char* const* rows, const float* const* x, unsigned long long n, float (&s)[O][R]) const {
        const float* gr[O];
#pragma unroll
        for (int o = 0; o < O; ++o) gr[o] = row_grid(rows[o]);
        for (unsigned long long i = threadIdx.x; i < n; i += kThreads) {
            float w[O], v[R];
#pragma unroll
            for (int o = 0; o < O; ++o) w[o] = rq::F8_E4M3::value(rows[o] + i, 0) * gr[o][i / quant::F8_E4M3_SCALE_INPUTS];
#pragma unroll
            for (int r = 0; r < R; ++r) v[r] = x[r][i];
#pragma unroll
            for (int o = 0; o < O; ++o)
#pragma unroll
                for (int r = 0; r < R; ++r) s[o][r] = fmaf(w[o], v[r], s[o][r]);
        }
    }
};
__device__ inline ExactF8 bound(const ExactF8& d, const unsigned char* row) {
    ExactF8 e = d;
    e.g = d.row_grid(row);
    return e;
}
// Four codes of a word under their scale, the bits ExactF8::load4 gives: a code's bits placed as binary16 are its value / 256, so the scale times 256 rounds each product once.
// A scale that would overflow there, or is not finite, takes ExactF8's decode, as does a word holding a NaN code.
__device__ inline float4 f8_values(unsigned w, float sc) {
    const auto v = [](unsigned c) { const unsigned char b = (unsigned char)c; return rq::F8_E4M3::value(&b, 0); };
    const unsigned nan = (w & 0x7f7f7f7fu) ^ 0x7f7f7f7fu;   // a zero byte where a code is NaN
    if (!(fabsf(sc) < 0x1p119f) || ((nan - 0x01010101u) & ~nan & 0x80808080u) != 0) return make_float4(v(w) * sc, v(w >> 8) * sc, v(w >> 16) * sc, v(w >> 24) * sc);
    const unsigned lo = (w & 0xffu) | (w & 0xff00u) << 8, hi = (w >> 16 & 0xffu) | (w >> 8 & 0xff0000u);
    const unsigned hl = (lo & 0x007f007fu) << 7 | (lo & 0x00800080u) << 8, hh = (hi & 0x007f007fu) << 7 | (hi & 0x00800080u) << 8;
    const float k = sc * 256.0f;
    const auto h = [](unsigned b) { return __half2float(__ushort_as_half((unsigned short)b)); };
    return make_float4(h(hl) * k, h(hl >> 16) * k, h(hh) * k, h(hh >> 16) * k);
}
// The one-row F8_E4M3 product takes kF8Outputs outputs a wave, which share each activation load, in batches of kF8Batch steps (docs/src/backends-gpu.md).
constexpr int kF8Outputs = 4, kF8Batch = 4;
template <int U>
__device__ inline void f8_steps(const ExactF8 (&e)[kF8Outputs], const unsigned char* const (&rows)[kF8Outputs], const float* X, unsigned long long u, float (&s)[kF8Outputs][kThreads / kWave]) {
    constexpr int J = kThreads / kWave;
    unsigned a[U][kF8Outputs][J / 4];
    float sc[U][kF8Outputs];
    float4 b[U][J / 4];
#pragma unroll
    for (int q = 0; q < U; ++q) {
        const unsigned long long v = u + (unsigned long long)q * kThreads;
#pragma unroll
        for (int k = 0; k < J / 4; ++k) b[q][k] = ((const float4*)X)[(v + 4 * k) / 4];
#pragma unroll
        for (int r = 0; r < kF8Outputs; ++r) {
            sc[q][r] = e[r].g[v / quant::F8_E4M3_SCALE_INPUTS];
#pragma unroll
            for (int k = 0; k < J / 4; ++k) a[q][r][k] = ((const unsigned*)rows[r])[(v + 4 * k) / 4];
        }
    }
    schedule_barrier();
#pragma unroll
    for (int q = 0; q < U; ++q)
#pragma unroll
        for (int r = 0; r < kF8Outputs; ++r)
#pragma unroll
            for (int k = 0; k < J / 4; ++k) {
                const float4 w = f8_values(a[q][r][k], sc[q][r]);
                s[r][4 * k] = fmaf(w.x, b[q][k].x, s[r][4 * k]);
                s[r][4 * k + 1] = fmaf(w.y, b[q][k].y, s[r][4 * k + 1]);
                s[r][4 * k + 2] = fmaf(w.z, b[q][k].z, s[r][4 * k + 2]);
                s[r][4 * k + 3] = fmaf(w.w, b[q][k].w, s[r][4 * k + 3]);
            }
}
// Each output the bits of exact_wave<ExactF8>: its lanes, chains, step order and tree as exact_sum keeps them; outputs past nout repeat the last and are not written.
__device__ void f8_wave(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout, int add, const ExactF8& d) {
    constexpr int J = kThreads / kWave;
    const int t = threadIdx.x % kWave;
    const unsigned long long o0 = ((unsigned long long)blockIdx.x * (kThreads / kWave) + threadIdx.x / kWave) * kF8Outputs;
    if (o0 >= nout) return;
    if ((nin % 4 | (unsigned long long)W % 4 | (unsigned long long)X % 16) != 0) {
        for (int r = 0; r < kF8Outputs; ++r)
            if (o0 + r < nout) exact_row<ExactF8>(W, X, Y, nin, o0 + r, add, d);
        return;
    }
    const unsigned long long full = nin / kThreads, first = (unsigned long long)J * t;
    const unsigned char* rows[kF8Outputs];
    ExactF8 e[kF8Outputs];
    float s[kF8Outputs][J];
#pragma unroll
    for (int r = 0; r < kF8Outputs; ++r) {
        rows[r] = W + (o0 + r < nout ? o0 + r : nout - 1) * nin;
        e[r] = bound(d, rows[r]);
#pragma unroll
        for (int j = 0; j < J; ++j) s[r][j] = 0.0f;
    }
    unsigned long long m = 0;
    for (; m + kF8Batch <= full; m += kF8Batch) f8_steps<kF8Batch>(e, rows, X, first + m * kThreads, s);
    for (; m < full; ++m) f8_steps<1>(e, rows, X, first + m * kThreads, s);
#pragma unroll
    for (int r = 0; r < kF8Outputs; ++r) {
#pragma unroll
        for (int j = 0; j < J; ++j)
            if (first + j + full * kThreads < nin) s[r][j] = e[r].step(rows[r], X, first + j + full * kThreads, s[r][j]);
#pragma unroll
        for (int h = kThreads / 2; h >= J; h >>= 1)
#pragma unroll
            for (int j = 0; j < J; ++j) s[r][j] += shuffle_down(s[r][j], h / J, kWave);
#pragma unroll
        for (int h = J / 2; h > 0; h >>= 1)
#pragma unroll
            for (int j = 0; j < h; ++j) s[r][j] += s[r][j + h];
        if (t == 0 && o0 + r < nout) Y[o0 + r] = add ? Y[o0 + r] + s[r][0] : s[r][0];
    }
}
// F8_E4M3's exact family takes its grid and row shift after the other types' arguments; a routed call's experts have grids `step` scales apart.
extern "C" __global__ void __launch_bounds__(kThreads) llmx_matmul_f8_e4m3(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout, int add,
                                                                           const float* grid, unsigned long long shift) {
    f8_wave(W, X, Y, nin, nout, add, ExactF8{{}, W, grid, nin, (unsigned)shift});
}
extern "C" __global__ void __launch_bounds__(kThreads) llmx_routed_f8_e4m3(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout, RoutedExact r,
                                                                           const float* grid, unsigned long long step, unsigned long long shift) {
    const unsigned long long e = r.first + blockIdx.y;
    const unsigned id = r.ids[e];
    if (id >= r.n_expert) return;
    const unsigned char* base = W + id * r.expert_bytes;
    f8_wave(base, X + e / r.per * nin, Y + e * nout, nin, nout, 0, ExactF8{{}, base, grid + id * step, nin, (unsigned)shift});
}
extern "C" __global__ void __launch_bounds__(kThreads) llmx_matmul_rows_f8_e4m3(const unsigned char* W, const float* X, float* Y, unsigned long long nin, unsigned long long nout,
                                                                                unsigned long long nrows, int add, const float* grid, unsigned long long shift) {
    exact_rows<ExactF8>(W, X, Y, nin, nout, nrows, add, ExactF8{{}, W, grid, nin, (unsigned)shift});
}
extern "C" __global__ void llmx_gather_f8_e4m3(float* dst, const unsigned char* table, const unsigned* ids, unsigned long long width, unsigned nrows, const float* grid,
                                               unsigned long long shift) {
    const unsigned long long i = blockIdx.y, j = (unsigned long long)blockIdx.x * kThreads + threadIdx.x;
    if (j >= width) return;
    const unsigned id = ids[i];
    if (id >= nrows) {
        dst[i * width + j] = 0.0f;
        return;
    }
    // A NaN code keeps the CPUs quiet NaN, since a CUDA multiply returns its own canonical NaN, not the inputs.
    const float v = rq::F8_E4M3::value(table + (unsigned long long)id * width + j, 0);
    dst[i * width + j] = isnan(v) ? v : v * grid[((unsigned long long)id >> shift) * (width / quant::F8_E4M3_SCALE_INPUTS) + j / quant::F8_E4M3_SCALE_INPUTS];
}

extern "C" __global__ void llmx_gather_q8_0(float* dst, const unsigned char* table, const unsigned* ids, unsigned long long width, unsigned nrows) {
    gather_decoded<rq::Q8_0>(dst, table, ids, width, nrows);
}

// A row's attention chunks: as many as its history needs at 256 positions each, at most 16, each a whole number of 64-position tiles; a function of the history alone, so a row's chunks are the same in any call.
__device__ inline void attention_chunks(int end, int& count, int& length) {
    count = min(16, (end + 255) / 256);
    length = ((end + count - 1) / count + 63) / 64 * 64;
}

// The ids sparse row r reads for KV head kvh (Op::sparse_attention_blocks): the row's groups of slots >> shift ids are group-major by KV head.
__device__ inline const unsigned* slot_ids(const unsigned* ids, int r, int kvh, int heads_kv, int groups, int slots, unsigned shift) {
    return ids + ((unsigned long long)r * groups + kvh / (heads_kv / groups)) * (unsigned)(slots >> shift);
}
// Slot t is position t mod 2^shift of the block its id names, and a padding id or one past the visible blocks names none (~0u); at shift 0 a slot is its id, as every other caller has it.
// The check before the shift keeps a far id from wrapping into the history.
__device__ inline unsigned slot_token(const unsigned* row, unsigned shift, int t, int visible) {
    const unsigned id = row[(unsigned)t >> shift];
    return id > ((unsigned)visible >> shift) ? ~0u : (id << shift) + ((unsigned)t & ((1u << shift) - 1u));
}

// A block a (row, head, chunk) of the split attention, an online softmax over the chunk's 64-position tiles in order, its state written to `part` for llmx_attention_merge.
// SPARSE reads the row's `stride` selection slots for its positions (slot_token), a slot outside its causal prefix skipped, and WINDOW the row's ends[r] positions from starts[r] (KVView::window).
template <bool SPARSE, bool WINDOW = false>
__device__ inline void attention_chunk(const float* Q, float* part, const void* kc, const void* vc, const int* table, const int* firsts, const int* ends,
                                       int n_head, int ratio, int heads_kv, int dim, int bt, int k_half, int v_half, float scale, const unsigned* ids,
                                       int stride, unsigned shift, int groups, const int* starts = nullptr) {
    __shared__ float sc[64];
    __shared__ float red[64];
    __shared__ unsigned tok[64];
    const int r = blockIdx.x, h = blockIdx.y, c = blockIdx.z, t = threadIdx.x;
    int count, length;
    attention_chunks(SPARSE ? stride : ends[r], count, length);
    if (c >= count) return;
    const int first = c * length, last = min(SPARSE ? stride : ends[r], first + length);
    const float* q = Q + ((unsigned long long)r * n_head + h) * dim;
    const int kvh = h / ratio;
    const int* blocks = table + firsts[r];
    const int begin = WINDOW ? starts[r] : 0;
    const unsigned* row_ids = SPARSE ? slot_ids(ids, r, kvh, heads_kv, groups, stride, shift) : nullptr;
    float m = -INFINITY, l = 0.0f, acc = 0.0f;
    for (int base = first; base < last; base += 64) {
        if (SPARSE && t < 64) {
            const unsigned id = base + t < last ? slot_token(row_ids, shift, base + t, ends[r]) : ~0u;
            tok[t] = id < (unsigned)ends[r] ? id : ~0u;
        }
        if (SPARSE) __syncthreads();
        const int p = t / 4, quarter = t % 4;
        const bool valid = SPARSE ? tok[p] != ~0u : base + p < last;
        const int pos = SPARSE ? (valid ? (int)tok[p] : 0) : begin + base + p;
        float s = 0.0f;
        if (valid) {
            const unsigned long long at = (((unsigned long long)blocks[pos / bt] * heads_kv + kvh) * bt + pos % bt) * dim;
            for (int d = quarter; d < dim; d += 4) {
                const float kd = k_half ? __half2float(((const __half*)kc)[at + d]) : ((const float*)kc)[at + d];
                s = fmaf(q[d], kd, s);
            }
        }
        s += shuffle_xor(s, 1, 4);
        s += shuffle_xor(s, 2, 4);
        if (quarter == 0) sc[p] = valid ? s * scale : -INFINITY;
        __syncthreads();
        // The tile's maximum and then its sum, each one tree over the 64 scores, which every thread reads.
        if (t < 64) red[t] = sc[t];
        __syncthreads();
        for (int w = 32; w > 0; w /= 2) {
            if (t < w) red[t] = fmaxf(red[t], red[t + w]);
            __syncthreads();
        }
        const float mt = fmaxf(m, red[0]);
        __syncthreads();
        // A sparse tile of no selected id after none before leaves the chunk as it was; exp(-inf - -inf) must never be formed.
        if (SPARSE && mt == -INFINITY) continue;
        if (t < 64) {
            sc[t] = expf(sc[t] - mt);
            red[t] = sc[t];
        }
        __syncthreads();
        for (int w = 32; w > 0; w /= 2) {
            if (t < w) red[t] += red[t + w];
            __syncthreads();
        }
        const float a = expf(m - mt);
        l = fmaf(l, a, red[0]);
        m = mt;
        __syncthreads();
        if (t < dim) {
            float v = acc * a;
            for (int j = 0; j < 64 && base + j < last; ++j) {
                if (SPARSE && tok[j] == ~0u) continue;
                const int pj = SPARSE ? (int)tok[j] : begin + base + j;
                const unsigned long long at = (((unsigned long long)blocks[pj / bt] * heads_kv + kvh) * bt + pj % bt) * dim + t;
                const float vd = v_half ? __half2float(((const __half*)vc)[at]) : ((const float*)vc)[at];
                v = fmaf(sc[j], vd, v);
            }
            acc = v;
        }
        __syncthreads();
    }
    float* out = part + (((unsigned long long)r * n_head + h) * 16 + c) * (dim + 2);
    if (t < dim) out[2 + t] = acc;
    if (t == 0) {
        out[0] = m;
        out[1] = l;
    }
}
extern "C" __global__ void llmx_attention_chunk(const float* Q, float* part, const void* kc, const void* vc, const int* table, const int* firsts,
                                                const int* ends, int n_head, int ratio, int heads_kv, int dim, int bt, int k_half, int v_half,
                                                float scale) {
    attention_chunk<false>(Q, part, kc, vc, table, firsts, ends, n_head, ratio, heads_kv, dim, bt, k_half, v_half, scale, nullptr, 0, 0u, 1);
}
extern "C" __global__ void llmx_attention_chunk_window(const float* Q, float* part, const void* kc, const void* vc, const int* table, const int* firsts,
                                                       const int* ends, int n_head, int ratio, int heads_kv, int dim, int bt, int k_half, int v_half,
                                                       float scale, const int* starts) {
    attention_chunk<false, true>(Q, part, kc, vc, table, firsts, ends, n_head, ratio, heads_kv, dim, bt, k_half, v_half, scale, nullptr, 0, 0u, 1, starts);
}
extern "C" __global__ void llmx_sparse_attention_chunk(const float* Q, float* part, const void* kc, const void* vc, const int* table, const int* firsts,
                                                       const int* ends, int n_head, int ratio, int heads_kv, int dim, int bt, int k_half, int v_half,
                                                       float scale, const unsigned* ids, int stride, unsigned shift, int groups) {
    attention_chunk<true>(Q, part, kc, vc, table, firsts, ends, n_head, ratio, heads_kv, dim, bt, k_half, v_half, scale, ids, stride, shift, groups);
}

// Eight values of a K or V row from `i`, as floats: one 16-byte load of halves, or two of floats.
__device__ inline void load8(const void* base, unsigned long long i, bool half, float v[8]) {
    if (half) {
        const uint4 w = *(const uint4*)((const __half*)base + i);
        const unsigned words[4] = {w.x, w.y, w.z, w.w};
        for (int k = 0; k < 4; ++k) {
            v[2 * k] = __half2float(__ushort_as_half((unsigned short)(words[k] & 0xffff)));
            v[2 * k + 1] = __half2float(__ushort_as_half((unsigned short)(words[k] >> 16)));
        }
    } else {
        const float4 a = *(const float4*)((const float*)base + i), b = *(const float4*)((const float*)base + i + 4);
        v[0] = a.x, v[1] = a.y, v[2] = a.z, v[3] = a.w, v[4] = b.x, v[5] = b.y, v[6] = b.z, v[7] = b.w;
    }
}

// attention_rel_sink's keys: tab holds seven words a view (first row, rows, length, ring src slot, dst slot, offset of its block ids in tab, its prompt's extent); a past key comes from the ring or the pooled [k|v] rows.
struct RelKeys {
    const float* kn;
    const float* vn;
    const unsigned* tab;
    const float* st;
    const float* aux;
    unsigned long long slot, ring, block_floats;
    unsigned R, rows_floats, width, kd;
};
__device__ inline const float* rel_key(const RelKeys& a, const unsigned* view, unsigned p, bool value) {
    const unsigned row0 = view[0], len = view[2];
    if (p >= len) return (value ? a.vn : a.kn) + (unsigned long long)(row0 + p - len) * a.kd;
    const float* row = a.st ? a.st + view[3] * a.slot + a.ring + (unsigned long long)(p % a.R) * 2 * a.kd
                            : a.aux + (unsigned long long)a.tab[view[5] + p / 64u] * a.block_floats + a.rows_floats + (unsigned long long)(p % 64u) * a.width;
    return row + (value ? a.kd : 0u);
}
// The tile's relative form (llmx_attention_rel_tile): attention_rel_sink's keys, its per-row relative values and sink logits, the [R][extent] table, the window, and the views it takes, those whose prompt's extent reaches tile_rows.
struct RelTile {
    RelKeys a;
    const float* rel;
    const float* table;
    const float* sink;
    unsigned NR, extent, window, tile_rows;
