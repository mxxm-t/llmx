        d = *(const unsigned short*)(b + 108);
    }
    __device__ void decode(unsigned sub, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned g = 2 * sub + (part >> 1), shift = 2 * (sub & 3);
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            const unsigned l = lo[2 * i] | ((unsigned)lo[2 * i + 1] << 16), h = hm[2 * i] | ((unsigned)hm[2 * i + 1] << 16);
