// The quantized products of the F16 and int8 classes (docs/PRECISION.md, rule 4 and section 5): activations as a block-int16 or block-int8 twin, Q8_0 rows decoded exactly, integer block dots and F32 sums.
// A row's result depends on that row alone: the row kernel for generated rows and the tile for prompt rows each fix their order, whatever the call holds.
#include "backends/gpu/kernels/port.h"
#include "backends/gpu/kernels/quant.h"
#include "backends/gpu/kernels/shapes.h"
#include "backends/gpu/kernels/group.h"
#include "backends/gpu/kernels/rows.h"

namespace {

constexpr int kThreads = 256;
constexpr bool kWave64 = GPU_WAVE == 64;
// The wave sums of a lane's NV values by the same xor tree, transposed: each level halves the values a lane holds, keeping the half its bit m selects plus its partner's copy, as wave_sum adds.
// Every sum so has wave_sum's bits; once one value is left the levels below are wave_sum's, and lane l holds sum k = l / (warpSize / NV).
template <int H, int NV>
__device__ inline void halve(float (&v)[NV], int lane, int m) {
    const bool up = lane & m;
#pragma unroll
    for (int j = 0; j < H; ++j) {
        const float give = up ? v[j] : v[j + H], keep = up ? v[j + H] : v[j];
        v[j] = keep + lane_xor(give, m);
    }
    if constexpr (H > 1) halve<H / 2>(v, lane, m / 2);
}
template <int NV>
__device__ inline float wave_sums(float (&v)[NV], int lane, int& k) {
    static_assert(NV >= 1 && NV <= 64 && (NV & (NV - 1)) == 0, "a power of two values, at most the widest wave's 64 lanes");
    // On a narrower wave the caller passes at most its lanes' values (store_sums), so warpSize / NV is never 0.
    if constexpr (NV > 1) halve<NV / 2>(v, lane, warpSize / 2);
    k = lane / (warpSize / NV);
    return wave_sum(v[0], warpSize / (2 * NV));
}

// A row kernel call: up to three projections of one twin, their output rows numbered one after another, projection 0's from 0 and projection p's from start[p - 1] on.
struct RowCall {
    const unsigned char* w[3];
    float* y[3];
    unsigned long long nout[3];
    unsigned long long start[2];   // the first rows of projections 1 and 2, projection 0 starting at row 0
    unsigned long long total;
    unsigned nproj;
    unsigned cluster;   // the lanes a K-type row takes (k_rows); Q8_0's row kernels take a wave a row
    const float* f[3];  // each projection's F32 factor for a type with one (KFactor), null without it
};
// Row o of a call: its weight row, its output for column 0 and its projection's output count.
struct Row {
    const unsigned char* w;
    float* y;
    unsigned long long nout;
    const float* f;
};
// The kernels pass o through readfirstlane: it is one wave's, so the projection is chosen in scalar registers, which measured 3 to 4 percent faster on the 8B's rows.
// The projection's fields are picked by adding differences, not by selecting between fields, which the compiler folds into an indexed load that keeps a routed call's copy in scratch.
__device__ inline Row row_of(const RowCall& c, unsigned long long o, unsigned long long row_bytes) {
    const bool p1 = c.nproj > 1 && o >= c.start[0], p2 = c.nproj > 2 && o >= c.start[1];
    const auto pick = [&](unsigned long long a, unsigned long long b, unsigned long long d) { return a + (p1 ? b - a : 0) + (p2 ? d - b : 0); };
    const unsigned long long local = o - pick(0, c.start[0], c.start[1]);
    // Through the global space, so the compiler keeps global loads rather than flat ones, whose waits also hold the scalar loads.
    const unsigned char* w = (const unsigned char*)(const GPU_GLOBAL_SPACE unsigned char*)pick((unsigned long long)c.w[0], (unsigned long long)c.w[1], (unsigned long long)c.w[2]);
    float* y = (float*)(GPU_GLOBAL_SPACE float*)pick((unsigned long long)c.y[0], (unsigned long long)c.y[1], (unsigned long long)c.y[2]);
    const float* f = (const float*)pick((unsigned long long)c.f[0], (unsigned long long)c.f[1], (unsigned long long)c.f[2]);
    return {w + local * row_bytes, y + local, pick(c.nout[0], c.nout[1], c.nout[2]), f};
}

// A row build's columns: column c reads twin column x(c) and writes output column y(c), c itself for a plain call.
struct Cols {
    __device__ unsigned long long x(int c) const { return (unsigned long long)c; }
    __device__ unsigned long long y(int c) const { return (unsigned long long)c; }
    __device__ void store(float* y, float s, int add, unsigned long long) const { *y = add ? *y + s : s; }
};
// A grouped routed call's columns, one expert's entries e[0..n): column c reads entry e[c]'s twin column e[c] / per and writes entry e[c]'s outputs; a column past n reads entry e[0]'s and stores nothing.
template <int C>
struct EntryCols {
    const unsigned* e;
    unsigned long long xs[C];
    __device__ EntryCols(const unsigned* entries, int n, unsigned long long per) : e(entries) {
#pragma unroll
        for (int c = 0; c < C; ++c) xs[c] = entries[c < n ? c : 0] / per;
    }
    __device__ unsigned long long x(int c) const { return xs[c]; }
    __device__ unsigned long long y(int c) const { return e[c]; }
    __device__ void store(float* y, float s, int add, unsigned long long) const { *y = add ? *y + s : s; }
};
// One column whose output row o is also channel o of a ring convolution with its input as residual, as llmx_conv_ring computes it for one row of a view (kernels/f32.gpu).
// The row's sum is stored, then the channel's history read, the sum written to the ring at len mod R and (sum + acc) / divisor stored or added to the output.
struct ConvCols : Cols {
    const float* w;
    float* ring;
    float* out;
    unsigned C, T, R, len;
    float divisor;
    int accumulate;
    __device__ void store(float* y, float s, int add, unsigned long long c) const {
        *y = add ? *y + s : s;
        float h[3] = {0.0f, 0.0f, 0.0f};
#pragma unroll
        for (unsigned j = 0; j < 3; ++j)
            if (j + 1 < T && len > j) h[j] = ring[(unsigned long long)((len - 1 - j) % R) * C + c];
        float acc = 0.0f;
#pragma unroll
        for (unsigned k = 0; k < 4; ++k)
            if (k < T) {
                const unsigned lag = T - 1 - k;
                const float sample = lag == 0 ? s : lag == 1 ? h[0] : lag == 2 ? h[1] : h[2];
                const float wt = w[c * T + k];
                acc = k ? fmaf(wt, sample, acc) : wt * sample;
            }
        ring[(unsigned long long)(len % R) * C + c] = s;
        const float sum = s + acc, value = divisor == 1.0f ? sum : sum / divisor;
        out[c] = accumulate ? out[c] + value : value;
    }
};

// Sum s of the wave's row j and column c, stored by its writer lane unless the column is past the call or the row past the end.
// The lane picks its row from the wave's rows r, which sit in scalar registers, so no lane reads the call's arguments again.
template <int R, typename M>
__device__ inline void store_sum(const Row (&r)[R], float s, int j, int c, bool writer, unsigned long long o, unsigned long long total, int ncols, int add, const M& m) {
    if (!writer || c >= ncols || o + j >= total) return;
#pragma unroll
    for (int i = 0; i < R; ++i)
        if (j == i) {
            m.store(r[i].y + m.y(c) * r[i].nout, s, add, o + j);
        }
}
// The R * C sums of a wave's rows o to o + R - 1 and its columns by one transposed tree, each written by its own lane; a column past the call or a row past the end is summed and not stored.
template <int R, int C, typename M = Cols>
__device__ inline void store_sums(float (&acc)[R][C], const Row (&r)[R], int lane, unsigned long long o, unsigned long long total, int ncols, int add, const M& m = M{}) {
    float v[R * C];
#pragma unroll
    for (int j = 0; j < R; ++j)
#pragma unroll
        for (int c = 0; c < C; ++c) v[j * C + c] = acc[j][c];
    // A target that may run 32-lane waves sums a 64-value build in parts of 32, each sum keeping the one tree's bits; gfx9 runs only 64-lane waves, so it keeps one tree, decided at compile time so no dead path holds registers.
    constexpr int NV = R * C, NP = NV < 32 ? NV : 32;
    if constexpr (kWave64 || NV <= 32) {
        int k;
        const float s = wave_sums<NV>(v, lane, k);
        store_sum<R>(r, s, k / C, k % C, lane % (warpSize / NV) == 0, o, total, ncols, add, m);
    } else {
#pragma unroll
        for (int p = 0; p < NV; p += NP) {
            float part[NP];
#pragma unroll
            for (int i = 0; i < NP; ++i) part[i] = v[p + i];
            int k;
            const float s = wave_sums<NP>(part, lane, k);
            store_sum<R>(r, s, (p + k) / C, (p + k) % C, lane % (warpSize / NP) == 0, o, total, ncols, add, m);
        }
    }
}

#if GPU_DOT4 && GPU_WAVE == 64
// A part's eight 16-bit twin values as byte planes: their high bytes, their low bytes halved and the low bytes' low bits, so 256 h + 2 m + b is each value exactly.
struct XPlanes {
    int h0, h1, m0, m1, b0, b1;
};
__device__ __forceinline__ XPlanes x_planes(const int4& xv) {
    const unsigned h0 = byte_perm((unsigned)xv.y, (unsigned)xv.x, 0x07050301u), h1 = byte_perm((unsigned)xv.w, (unsigned)xv.z, 0x07050301u);
    const unsigned l0 = byte_perm((unsigned)xv.y, (unsigned)xv.x, 0x06040200u), l1 = byte_perm((unsigned)xv.w, (unsigned)xv.z, 0x06040200u);
    return {(int)h0, (int)h1, (int)((l0 >> 1) & 0x7f7f7f7fu), (int)((l1 >> 1) & 0x7f7f7f7fu), (int)(l0 & 0x01010101u), (int)(l1 & 0x01010101u)};
}
// The integer sum of a part's eight weights, the words w0 and w1, against its planes p: three four-way dots a word.
__device__ __forceinline__ int plane_dot(int w0, int w1, const XPlanes& p) {
    int isum = dot4_i8(w1, p.h1, dot4_i8(w0, p.h0, 0));
    isum = dot4_i8(w1, p.m1, dot4_i8(w0, p.m0, isum << 7));
    return dot4_i8(w1, p.b1, dot4_i8(w0, p.b0, isum << 1));
}
#endif

// A wave computes R output rows for up to C generated rows: four lanes a block, eight values each, each lane's part scaled into F32 in block order and folded by wave_sums, the bits of one shuffle tree whatever C and R.
// With R rows each twin load serves every row and a row keeps its lanes and its order, so it has the bits of the one-row build (docs/STATUS.md, ROCm F16 decode rows).
template <int C, typename QT, int R, int G, typename M = Cols>
__device__ void q8_0_rows(const RowCall& rc, const QT* q, const float* dx, unsigned long long nin, int ncols, int add, const M& m = M{}) {
    const int lanes = warpSize, lane = threadIdx.x % lanes;
    const unsigned long long blocks = nin / 32, waves = (unsigned long long)gridDim.x * (kThreads / lanes);
    // A wave takes rows o, o + R * waves, ...: the host launches a wave for R rows, and this loop form measured four times faster than an early return on rows of 2048 and 4096 (docs/STATUS.md, ROCm step 3).
    for (unsigned long long o = R * ((unsigned long long)blockIdx.x * (kThreads / lanes) + threadIdx.x / lanes); o < rc.total; o += R * waves) {
        Row r[R];
#pragma unroll
        for (int j = 0; j < R; ++j) r[j] = row_of(rc, first_lane((unsigned)(o + j < rc.total ? o + j : o)), blocks * kQ8);
        float acc[R][C];
#pragma unroll
        for (int j = 0; j < R; ++j)
#pragma unroll
            for (int c = 0; c < C; ++c) acc[j][c] = 0.0f;
        for (unsigned long long u = lane; u < blocks * 4; u += lanes) {
            const unsigned long long k = u / 4;
            const int part = (int)(u % 4);
            const unsigned ko = (unsigned)k, xo = ko * 32 + part * 8;
            constexpr int NW = sizeof(QT) == 2 ? 4 : 2;
#if GPU_DOT4 && GPU_WAVE == 64
            // One column of the 16-bit twin on gfx9, in either module: the eight weights as one 8-byte load, and x as its high byte, its low byte halved and its low bit, three four-way dots a weight word.
            // 256 h + 2 m + b is x exactly, so the integer sum, and with it every bit of the result, is that of the other builds (docs/DEVICE-TUNING.md, Measured prefill facts, with sources).
            if constexpr (C == 1 && sizeof(QT) == 2) {
                typedef unsigned words2 __attribute__((ext_vector_type(2), aligned(2)));
                unsigned short sw[R];
                words2 wv[R];
#pragma unroll
                for (int j = 0; j < R; ++j) {
                    const unsigned char* block = r[j].w + k * kQ8;
                    sw[j] = *(const unsigned short*)block;
                    wv[j] = *(const words2*)(block + 2 + part * 8);
                }
                const int4 xv = *(const int4*)(q + (m.x(0) * blocks + k) * 32 + part * 8);
                const float xd = dx[m.x(0) * blocks + k];
                schedule_barrier();
                const XPlanes x = x_planes(xv);
#pragma unroll
                for (int j = 0; j < R; ++j) acc[j][0] = fmaf(__half2float(__ushort_as_half(sw[j])) * xd, (float)plane_dot((int)wv[j].x, (int)wv[j].y, x), acc[j][0]);
                continue;
            }
#endif
            // A lane's eight weights as four 16-bit loads, the block being 2-byte aligned, and its scale, read raw.
            unsigned short sw[R], pw[R][4];
#pragma unroll
            for (int j = 0; j < R; ++j) {
                const unsigned char* block = r[j].w + k * kQ8;
                sw[j] = *(const unsigned short*)block;
                const unsigned short* wp = (const unsigned short*)(block + 2 + part * 8);
#pragma unroll
                for (int i = 0; i < 4; ++i) pw[j][i] = wp[i];
            }
            // Columns in groups of G, a column past the call reading column 0 and storing nothing, so no branch splits the loads.
            int xw[G][NW];
            float xd[G];
            const auto load = [&](int g) {
#pragma unroll
                for (int c = 0; c < G; ++c) {
                    // A build wider than its group takes one 32-bit lane offset for every column, where a pointer a column held it to one wave a SIMD.
                    // The narrower builds measured faster with a pointer a column (docs/STATUS.md, ROCm wide decode rows).
                    const unsigned long long col = m.x(g + c < ncols ? g + c : 0) * blocks;
                    const QT* qc = C > G ? q + col * 32 : q + (col + k) * 32 + part * 8;
                    const unsigned off = C > G ? xo : 0;
                    if constexpr (NW == 4) {
                        const int4 x = *(const int4*)(qc + off);
                        xw[c][0] = x.x, xw[c][1] = x.y, xw[c][2] = x.z, xw[c][3] = x.w;
                    } else {
                        const int2 x = *(const int2*)(qc + off);
                        xw[c][0] = x.x, xw[c][1] = x.y;
                    }
                    xd[c] = C > G ? dx[col + ko] : dx[col + k];
                }
            };
            // The weights as the twin's words, packed once for every column: four words of two 16-bit values, or two of four 8-bit values.
            float dw[R];
            int ww[R][NW];
            const auto unpack = [&] {
#pragma unroll
                for (int j = 0; j < R; ++j) {
                    dw[j] = __half2float(__ushort_as_half(sw[j]));
#pragma unroll
                    for (int i = 0; i < 4; ++i) {
                        const unsigned short pair = pw[j][i];
                        if constexpr (NW == 4)
                            ww[j][i] = ((int)(signed char)(pair & 0xff) & 0xffff) | ((int)(signed char)(pair >> 8) << 16);
                        else if (i % 2)
                            ww[j][i / 2] |= (int)pair << 16;
                        else
                            ww[j][i / 2] = pair;
                    }
                }
            };
            // In a build of one group the weights' and the group's loads issue together before anything waits on them; a wider build unpacks its weights first, which measured faster for it.
            if constexpr (C <= G) {
                load(0);
                schedule_barrier();
                unpack();
            } else {
                unpack();
                load(0);
            }
#pragma unroll
            for (int g = 0; g < C; g += G) {
                if (g) load(g);
#pragma unroll
                for (int c = 0; c < G; ++c)
#pragma unroll
                    for (int j = 0; j < R; ++j) {
                        // The integer sum is exact, so the word dots give the bits of any order.
                        int isum = 0;
#pragma unroll
                        for (int i = 0; i < NW; ++i) isum = word_dot(ww[j][i], xw[c][i], isum, QT(0));
                        acc[j][g + c] = fmaf(dw[j] * xd[c], (float)isum, acc[j][g + c]);
                    }
                // A group's loads wait for the group before it, which holds a wide build's registers to one group's twin.
                if constexpr (C > G) schedule_barrier();
            }
        }
        store_sums<R, C>(acc, r, lane, o, rc.total, ncols, add, m);
    }
}

#if GPU_DOT4 && GPU_WAVE == 64
typedef unsigned WalkWords __attribute__((ext_vector_type(2), aligned(2)));
// A walk lane's parts of the twin as byte planes: pass i covers parts 64 i to 64 i + 63, and a lane past the row loads its first part's words and adds nothing, so no pass branches and every load issues before the first wait.
template <int H>
struct WalkTwin {
    XPlanes x[H];
    float xd[H];
};
template <int H>
__device__ inline void walk_twin(WalkTwin<H>& t, const short* q, const float* dx, int lane, unsigned parts) {
#pragma unroll
    for (int i = 0; i < H; ++i) {
        const unsigned u = lane + 64u * i, k = (u < parts ? u : lane) / 4;
        t.x[i] = x_planes(*(const int4*)(q + (unsigned long long)k * 32 + (lane % 4) * 8));
        t.xd[i] = dx[k];
    }
}
// A walk lane's weights of one row: each pass's block scale and its part's eight weights.
template <int H>
struct WalkRow {
    unsigned short sw[H];
    WalkWords wv[H];
};
template <int H>
__device__ inline void walk_load(WalkRow<H>& r, const unsigned char* w, int lane, unsigned parts) {
#pragma unroll
    for (int i = 0; i < H; ++i) {
        const unsigned u = lane + 64u * i, k = (u < parts ? u : lane) / 4;
        const unsigned char* block = w + (unsigned long long)k * kQ8;
        r.sw[i] = *(const unsigned short*)block;
        r.wv[i] = *(const WalkWords*)(block + 2 + (lane % 4) * 8);
    }
}
// A lane's sum of a row in part order, q8_0_rows' per-lane sum.
template <int H>
__device__ inline float walk_dot(const WalkRow<H>& r, const WalkTwin<H>& t, int lane, unsigned parts) {
    float acc = 0.0f;
#pragma unroll
    for (int i = 0; i < H; ++i)
        if (lane + 64u * i < parts) acc = fmaf(__half2float(__ushort_as_half(r.sw[i])) * t.xd[i], (float)plane_dot((int)r.wv[i].x, (int)r.wv[i].y, t.x[i]), acc);
    return acc;
}
#endif

// A lane's five words of block bd of a Q8_0 row in the half-block order (two lanes a block): its 16 weights and, on the even lane, the block scale.
struct HalfWords {
    unsigned t[5];
};
__device__ inline HalfWords half_words(const unsigned* w, unsigned bd, unsigned hl) {
    const unsigned start = bd * kQ8 + 18 * hl, sh = start & 2, wi = start >> 2;
    return {{w[wi], w[wi + 1], w[wi + 2], w[wi + 3], w[wi + 3 + (hl == 0 || sh ? 1 : 0)]}};
}
// The lane's share of the block from its words and its int4 of the twin, the even lane handing the scale on, added to acc as q8_0_rows_half's steps chain it.
__device__ inline float half_word_dot(const HalfWords& h, int4 xq, float xd, unsigned bd, unsigned hl, float acc = 0.0f) {
    const unsigned start = bd * kQ8 + 18 * hl, sh = start & 2, s0 = sh + 2 * (1 - hl);
    const unsigned t0 = h.t[0], t1 = h.t[1], t2 = h.t[2], t3 = h.t[3], t4 = h.t[4];
    const bool next = s0 == 4;
    const unsigned u0 = next ? t1 : t0, u1 = next ? t2 : t1, u2 = next ? t3 : t2, u3 = next ? t4 : t3, n = s0 & 3;
    int s = word_dot((int)byte_align(u1, u0, n), xq.x, 0, (signed char)0);
    s = word_dot((int)byte_align(u2, u1, n), xq.y, s, (signed char)0);
    s = word_dot((int)byte_align(u3, u2, n), xq.z, s, (signed char)0);
    s = word_dot((int)byte_align(t4, u3, n), xq.w, s, (signed char)0);
    const int own = (int)(t0 >> (8 * sh)) & 0xffff;
    const int partner = pair_lane(own);
    const float dw = __half2float(__ushort_as_half((unsigned short)(hl ? partner : own)));
    return fmaf(dw * xd, (float)s, acc);
}

// One column of the 16-bit twin, a row a wave, for rows of (H - 1) * 512 to H * 512 values (gpu_shape::walk_passes): on gfx9 each lane keeps its parts of the twin as byte planes, so a row step reads weights alone.
// A lane's parts, its sums in part order and the wave's tree are q8_0_rows', so every row has the bits of the other builds; elsewhere it is q8_0_rows' one-row build.
template <int H>
__device__ void q8_0_walk(const RowCall& rc, const short* q, const float* dx, unsigned long long nin, int ncols, int add) {
#if GPU_DOT4 && GPU_WAVE == 64
    const int lane = threadIdx.x % 64;
    const unsigned long long blocks = nin / 32, waves = (unsigned long long)gridDim.x * (kThreads / 64);
    const unsigned parts = (unsigned)(blocks * 4);
    WalkTwin<H> t;
    walk_twin<H>(t, q, dx, lane, parts);
    for (unsigned long long o = (unsigned long long)blockIdx.x * (kThreads / 64) + threadIdx.x / 64; o < rc.total; o += waves) {
        const Row r[1] = {row_of(rc, first_lane((unsigned)o), blocks * kQ8)};
        WalkRow<H> w;
        walk_load<H>(w, r[0].w, lane, parts);
        schedule_barrier();
        float acc[1][1] = {{walk_dot<H>(w, t, lane, parts)}};
        store_sums<1, 1>(acc, r, lane, o, rc.total, ncols, add);
    }
#else
    q8_0_rows<1, short, 1, 1>(rc, q, dx, nin, ncols, add);
#endif
}

// The int8 class's Q8_0 decode kernel in the Vulkan decode kernel's half-block order, for rows of an even block count: two lanes a block, the even lane handing the scale to the odd one.
// Each lane scales its integer dots in block order and the lanes fold by wave_sums' transposed tree, so every column has the same bits whatever C and R the call takes.
template <int C, int R, int G, typename M = Cols>
__device__ void q8_0_rows_half(const RowCall& rc, const signed char* q, const float* dx, unsigned long long nin, int ncols, int add, const M& m = M{}) {
    // A plain build computes every column it holds, one past the call reading the call's last column, so no column branch splits its loads, where a grouped build of up to 8 columns skips it (docs/STATUS.md).
    constexpr bool whole = C > 8 || (C > 1 && __is_same(M, Cols));
    const int lanes = warpSize, lane = threadIdx.x % lanes;
    const unsigned long long blocks = nin / 32, waves = (unsigned long long)gridDim.x * (kThreads / lanes);
    const unsigned hl = lane & 1;
    // A wave takes R rows, so each twin load serves every row; a row keeps its lanes and its order, so it has the bits of the one-row build.
    for (unsigned long long o = R * ((unsigned long long)blockIdx.x * (kThreads / lanes) + threadIdx.x / lanes); o < rc.total; o += R * waves) {
        Row r[R];
        const unsigned* w[R];
#pragma unroll
        for (int j = 0; j < R; ++j) {
            r[j] = row_of(rc, first_lane((unsigned)(o + j < rc.total ? o + j : o)), blocks * kQ8);
            // An even block count puts every row on a word boundary.
            w[j] = (const unsigned*)r[j].w;
        }
        float acc[R][C];
#pragma unroll
        for (int j = 0; j < R; ++j)
#pragma unroll
            for (int c = 0; c < C; ++c) acc[j][c] = 0.0f;
#pragma unroll 2
        for (unsigned b = lane >> 1; b < blocks; b += lanes / 2) {
            // The lane's bytes start sh bytes into word wi and its weights s0 bytes in, 4 meaning the next word.
            // The even lane's fifth word lies inside its block and the odd lane's, read only where its bytes do not start on a word, inside the block after it.
            const unsigned at = b * kQ8, start = at + 18 * hl, sh = start & 2, wi = start >> 2, s0 = sh + 2 * (1 - hl);
            // Columns in groups of G: the first group's twin loads issue before the weights' and each group's before its products (docs/STATUS.md, ROCm wide decode rows).
            // Up to 8 columns, two buffers of a group's twin: group g + G's loads issue before group g's products, so it arrives under them; a wider build loads each group as it starts, which holds its registers to one group's twin.
            constexpr bool ahead = C <= 8;
            int4 xq[ahead ? 2 : 1][G];
            float xd[ahead ? 2 : 1][G];
            const auto load = [&](int g) {
#pragma unroll
                for (int c = 0; c < G; ++c) {
                    if (whole ? g + c >= C : g + c >= ncols) continue;
                    // Up to 8 columns a column's twin lies within the call's 32-bit span (the host checks it), so its base and the lane's offset are one 32-bit register; a wider build keeps 64-bit offsets, which hold it to fewer registers.
                    const unsigned long long cx = m.x(whole && g + c >= ncols ? ncols - 1 : g + c) * blocks;
                    const int k = ahead ? (g / G) & 1 : 0;
                    if constexpr (ahead) {
                        const unsigned col = (unsigned)cx;
                        xq[k][c] = *(const int4*)(q + (col * 32u + (b * 32 + 16 * hl)));
                        xd[k][c] = dx[col + b];
                    } else {
                        xq[k][c] = *(const int4*)(q + cx * 32 + (b * 32 + 16 * hl));
                        xd[k][c] = dx[cx + b];
                    }
                }
            };
            load(0);
            // Up to 8 columns the weights' words and the first two groups' twin issue before anything waits on them; a wider build reads the words where it aligns them.
            unsigned tw[R][5];
            if constexpr (ahead) {
#pragma unroll
                for (int j = 0; j < R; ++j) {
                    tw[j][0] = w[j][wi], tw[j][1] = w[j][wi + 1], tw[j][2] = w[j][wi + 2], tw[j][3] = w[j][wi + 3], tw[j][4] = w[j][wi + 3 + (hl == 0 || sh ? 1 : 0)];
                }
                if constexpr (C > G) load(G);
                schedule_barrier();
            }
            unsigned wq[R][4];
            float dw[R];
#pragma unroll
            for (int j = 0; j < R; ++j) {
                const unsigned t0 = ahead ? tw[j][0] : w[j][wi], t1 = ahead ? tw[j][1] : w[j][wi + 1], t2 = ahead ? tw[j][2] : w[j][wi + 2], t3 = ahead ? tw[j][3] : w[j][wi + 3],
                               t4 = ahead ? tw[j][4] : w[j][wi + 3 + (hl == 0 || sh ? 1 : 0)];
                const bool next = s0 == 4;
                const unsigned u0 = next ? t1 : t0, u1 = next ? t2 : t1, u2 = next ? t3 : t2, u3 = next ? t4 : t3, n = s0 & 3;
                wq[j][0] = byte_align(u1, u0, n);
                wq[j][1] = byte_align(u2, u1, n);
                wq[j][2] = byte_align(u3, u2, n);
                wq[j][3] = byte_align(t4, u3, n);
                const int own = (int)(t0 >> (8 * sh)) & 0xffff;
                const int partner = pair_lane(own);
                dw[j] = __half2float(__ushort_as_half((unsigned short)(hl ? partner : own)));
            }
#pragma unroll
            for (int g = 0; g < C; g += G) {
                if constexpr (ahead) {
                    if (g && g + G < C) load(g + G);
                    if (g) schedule_barrier();
                } else if (g) {
                    load(g);
                }
                const int k = ahead ? (g / G) & 1 : 0;
#pragma unroll
                for (int c = 0; c < G; ++c) {
                    if (whole ? g + c >= C : g + c >= ncols) continue;
#pragma unroll
                    for (int j = 0; j < R; ++j) {
                        int t = word_dot((int)wq[j][0], xq[k][c].x, 0, (signed char)0);
                        t = word_dot((int)wq[j][1], xq[k][c].y, t, (signed char)0);
                        t = word_dot((int)wq[j][2], xq[k][c].z, t, (signed char)0);
                        t = word_dot((int)wq[j][3], xq[k][c].w, t, (signed char)0);
                        acc[j][g + c] = fmaf(dw[j] * xd[k][c], (float)t, acc[j][g + c]);
                    }
                }
            }
        }
        // A build of 9 to 15 columns sums its columns as 16, the padded ones summed and not stored.
        constexpr int CP = C > 8 ? 16 : C;
        if constexpr (CP == C) {
            store_sums<R, C>(acc, r, lane, o, rc.total, ncols, add, m);
        } else {
            float sums[R][CP];
#pragma unroll
            for (int j = 0; j < R; ++j)
#pragma unroll
                for (int c = 0; c < CP; ++c) sums[j][c] = c < C ? acc[j][c] : 0.0f;
            store_sums<R, CP>(sums, r, lane, o, rc.total, ncols, add, m);
        }
    }
}

// R rows a wave, each twin load serving every row, NS steps a round: a row keeps its lanes, its block order and its tree, so every build gives the one-row build's bits.
template <int R, int NS>
__device__ void q8_0_half_one(const RowCall& rc, const signed char* q, const float* dx, unsigned long long nin, int add) {
    const int lanes = warpSize, lane = threadIdx.x % lanes;
    const unsigned blocks = (unsigned)(nin / 32);
    const unsigned long long waves = (unsigned long long)gridDim.x * (kThreads / lanes), step = R * waves;
    for (unsigned long long base = R * ((unsigned long long)blockIdx.x * (kThreads / lanes) + threadIdx.x / lanes); base < rc.total; base += step) {
        Row r[R];
        const unsigned* w[R];
#pragma unroll
        for (int j = 0; j < R; ++j) {
            r[j] = row_of(rc, first_lane((unsigned)(base + j < rc.total ? base + j : base)), blocks * kQ8);
            w[j] = (const unsigned*)r[j].w;
        }
        float acc[R];
        half_rows<R, NS>(w, q, dx, blocks, acc);
#pragma unroll
        for (int j = 0; j < R; ++j) {
            const float v = wave_sum(acc[j]);
            if (lane == 0 && base + j < rc.total) *r[j].y = add ? *r[j].y + v : v;
        }
    }
}

// A held row's weight words, a step each, loaded before any product.
template <int NS>
struct HeldLoads {
    gpu_words<4> t4[NS];
    unsigned t5[NS];
};
// Steps past the row's blocks load its last block and add nothing, so no step branches and every load issues before the first wait.
template <int NS>
__device__ inline void held_loads(HeldLoads<NS>& l, const unsigned* w, unsigned blocks, int lane) {
    const unsigned hl = lane & 1, span = warpSize / 2, b0 = lane >> 1;
#pragma unroll
    for (int d = 0; d < NS; ++d) {
        const unsigned bd = b0 + d * span, bc = bd < blocks ? bd : blocks - 1, start = bc * kQ8 + 18 * hl, sh = start & 2, wi = start >> 2;
        l.t4[d] = *(const gpu_words<4>*)(w + wi);
        l.t5[d] = w[wi + 3 + (hl == 0 || sh ? 1 : 0)];
    }
}
// The lane's part of the row's product against the twin in LDS; every step's twin and scale leave LDS before the first product, so the reads issue together.
template <int NS>
__device__ inline float held_dot(const HeldLoads<NS>& l, const int4* sq, const float* sd, unsigned blocks, int lane) {
    const unsigned hl = lane & 1, span = warpSize / 2, b0 = lane >> 1;
    int4 xs[NS];
    float xd[NS];
#pragma unroll
    for (int d = 0; d < NS; ++d) {
        const unsigned bd = b0 + d * span, bc = bd < blocks ? bd : blocks - 1;
        xs[d] = sq[2 * bc + hl];
        xd[d] = sd[bc];
    }
    float acc = 0.0f;
#pragma unroll
    for (int d = 0; d < NS; ++d) {
        const unsigned bd = b0 + d * span, bc = bd < blocks ? bd : blocks - 1, start = bc * kQ8 + 18 * hl, sh = start & 2, s0 = sh + 2 * (1 - hl);
        const int4 xq = xs[d];
        const bool next = s0 == 4;
        const unsigned t0 = l.t4[d].x, t1 = l.t4[d].y, t2 = l.t4[d].z, t3 = l.t4[d].w, t5d = l.t5[d];
        const unsigned u0 = next ? t1 : t0, u1 = next ? t2 : t1, u2 = next ? t3 : t2, u3 = next ? t5d : t3, n = s0 & 3;
        int s = word_dot((int)byte_align(u1, u0, n), xq.x, 0, (signed char)0);
        s = word_dot((int)byte_align(u2, u1, n), xq.y, s, (signed char)0);
        s = word_dot((int)byte_align(u3, u2, n), xq.z, s, (signed char)0);
        s = word_dot((int)byte_align(t5d, u3, n), xq.w, s, (signed char)0);
        const int own = (int)(t0 >> (8 * sh)) & 0xffff;
        const int partner = pair_lane(own);
        const float dw = __half2float(__ushort_as_half((unsigned short)(hl ? partner : own)));
        const float next_acc = fmaf(dw * xd[d], (float)s, acc);
        acc = bd < blocks ? next_acc : acc;
    }
    return acc;
}

// One row a wave, a row of at most NS spans of blocks: all of its steps' loads issue before any product, in one pass, so it gives the one-row build's bits.
// A wave whose lanes all take the row's steps together measured 3 to 15 percent faster than the builds it replaces on an MI50 (docs/STATUS.md, Held one-column Q8_0 rows).
template <int NS>
__device__ void q8_0_half_held(const RowCall& rc, const signed char* q, const float* dx, unsigned long long nin, int add, unsigned bx) {
    const int lanes = warpSize, lane = threadIdx.x % lanes;
    const unsigned blocks = (unsigned)(nin / 32);
    const unsigned long long o = (unsigned long long)bx * (kThreads / lanes) + threadIdx.x / lanes;
    // The twin goes into LDS once a block, so a wave loads only its row's weights; every wave meets the barrier, a wave past the call's rows loading the last row.
    constexpr int XQ = NS * 64, XF = (XQ + kThreads - 1) / kThreads;
    static_assert(NS * 32 <= kThreads, "a thread stages at most one block scale");
    __shared__ int4 sq[XQ];
    __shared__ float sd[NS * 32];
    int4 fq[XF];
    float fd = 0.0f;
#pragma unroll
    for (int i = 0; i < XF; ++i) {
        const unsigned t = threadIdx.x + i * kThreads;
        fq[i] = t < 2 * blocks ? *(const int4*)(q + 16ull * t) : int4{0, 0, 0, 0};
    }
    if (threadIdx.x < blocks) fd = dx[threadIdx.x];
    const unsigned long long oc = o < rc.total ? o : rc.total - 1;
    // The weight base is the wave's, in scalar registers; the output pointer stays per lane, since both in scalar form took 48 us against 8 at 2048 rows of 2048 on an MI50.
    const unsigned* w = (const unsigned*)row_of(rc, first_lane((unsigned)oc), blocks * kQ8).w;
    HeldLoads<NS> l;
    held_loads(l, w, blocks, lane);
    schedule_barrier();
#pragma unroll
    for (int i = 0; i < XF; ++i) {
        const unsigned t = threadIdx.x + i * kThreads;
        if (t < 2 * blocks) sq[t] = fq[i];
    }
    if (threadIdx.x < blocks) sd[threadIdx.x] = fd;
    __syncthreads();
    if (o >= rc.total) return;
    const float v = wave_sum(held_dot(l, sq, sd, blocks, lane));
    if (lane == 0) {
        float* y = row_of(rc, o, blocks * kQ8).y;
        *y = add ? *y + v : v;
    }
}

// The pushing held build's tail (GpuCollective::push_rows): the call's rows, y[0] of one projection, go into every peer's staging slot of the parity half, as llmx_group_push would send them.
struct GroupTail {
    const GroupPeers* p;
    unsigned* tiles;   // a counter per tile of the call, zero between launches
    unsigned long long half_at, cap;
    int members, rank;
    unsigned tile;   // blocks a tile
    unsigned epoch;   // this push's count, which a pushed tile's flag takes; 0 when the build does not take
    unsigned* pushed;   // a flag per tile, its epoch once the tile's rows are out
    float* out;
    unsigned long long timeout, tick;
    unsigned takers;   // the walk's first blocks, which only take the sum
    int replace;
};
// Block b's rows are done: the block that finishes a tile's last row sends the tile's rows to each peer as one store a wave, quiet NaNs escaped, and flags the tile out when the build takes.
// Every wave of the block calls it, so every wave meets its barriers.
__device__ inline void held_push_tile(const RowCall& rc, const GroupTail& t, unsigned b, unsigned nb) {
    __shared__ unsigned last;
    const unsigned per = kThreads / warpSize, lane = threadIdx.x % warpSize;
    const unsigned k = b / t.tile, left = nb - k * t.tile, want = left < t.tile ? left : t.tile;
    __syncthreads();
    if (threadIdx.x == 0) {
        __threadfence();
        last = atomicAdd(&t.tiles[k], 1u) == want - 1;
    }
    __syncthreads();
    if (!last) return;
    if (threadIdx.x == 0) t.tiles[k] = 0;
    __threadfence();
    const unsigned long long base = (unsigned long long)k * t.tile * per, span = (unsigned long long)t.tile * per, rows = rc.total - base < span ? rc.total - base : span;
    // The fence above invalidates this CU's L1, so plain loads read the other blocks' rows from L2 and a 16-byte word is one load.
    const float* own = rc.y[0] + base;
    for (int j = (int)(threadIdx.x / warpSize); j < t.members; j += (int)per) {
        if (j == t.rank) continue;
        float* dst = t.p->stage[j] + t.half_at + (unsigned long long)t.rank * t.cap + base;
        for (unsigned long long r = 4ull * lane; r < rows; r += 4ull * warpSize) {
            if (r + 4 <= rows) {
                const float4 v = *(const float4*)(own + r);
                *(GroupWord4*)(dst + r) = GroupWord4{group_sane(v.x), group_sane(v.y), group_sane(v.z), group_sane(v.w)};
            } else {
                for (unsigned long long u = r; u < rows; ++u) ((unsigned*)dst)[u] = group_sane(own[u]);
            }
        }
    }
    if (!t.epoch) return;
    __syncthreads();
    if (threadIdx.x == 0) atomic_store_release_system(&t.pushed[k], t.epoch);
}

// The pushing build of one block's rows, which needs nothing but its own block (GpuCollective::push_rows without an epoch).
__device__ inline void held_push(const RowCall& rc, const GroupTail& t) {
    const unsigned per = kThreads / warpSize, nb = (unsigned)((rc.total + per - 1) / per);
    if (blockIdx.x < nb) held_push_tile(rc, t, blockIdx.x, nb);
}

// The walking held build, which also takes the sum (GpuCollective::push_rows with an epoch): blocks past the first t.takers are the held build's blocks and push each tile as it completes.
// The first t.takers blocks only take the sum, striding over its chunks of kThreads units in order, so a take waits only on pushed tiles and never holds a slot a row block needs (docs/DEVICE-TUNING.md).
template <int NS>
__device__ void q8_0_half_walk(const RowCall& rc, const signed char* q, const float* dx, unsigned long long nin, int add, const GroupTail& t) {
    const unsigned per = kThreads / warpSize, T = t.takers;
    const unsigned long long n = rc.total, units = (n + 3) / 4;
    const unsigned nb = (unsigned)((n + per - 1) / per);
    if (blockIdx.x >= T) {
        q8_0_half_held<NS>(rc, q, dx, nin, add, blockIdx.x - T);
        held_push_tile(rc, t, blockIdx.x - T, nb);
        return;
    }
    __shared__ int failed;
    if (!threadIdx.x) failed = 0;
    __syncthreads();
    unsigned long long u = (unsigned long long)blockIdx.x * kThreads + threadIdx.x;
    for (; u - threadIdx.x < units; u += (unsigned long long)T * kThreads) {
        if (u < units) {
            const unsigned k = (unsigned)(u * 4 / per / t.tile);
            while (atomic_load_acquire_device(&t.pushed[k]) != t.epoch) {}
            unsigned long long next = (unsigned long long)wall_clock() + t.tick;
            const unsigned long long deadline = t.timeout ? (unsigned long long)wall_clock() + t.timeout : ~0ull;
            if (!group_take_unit(t.p, (GroupSignal*)t.p->signal[t.rank], rc.y[0], t.p->stage[t.rank] + t.half_at, t.out, u * 4, n, t.cap, t.members, t.rank, t.replace,
                                 ((unsigned long long)t.out & 15) == 0, deadline, t.tick, &next, &failed))
                atomic_store_relaxed_block(&failed, 1);
        }
        __syncthreads();
        if (failed) break;
    }
    if (failed) {
        if (u < units)
#pragma unroll 1
            for (unsigned long long r = u * 4; r < n && r < u * 4 + 4; ++r) t.out[r] = __builtin_nanf("");
        group_failed(t.p, t.members, t.rank);
    }
}

// The one-row build of a row of at most 16 blocks on a 64-lane wave, each half of the wave a row: a lane holds one block, as the 32-lane tree's lanes do, whose first level adds the idle half's +0, so it gives the one-row build's bits.
// A lane's loads issue together and its products follow without a step loop, which measured 30 percent faster than the stepped build at Flash-Next's HC up rows (docs/STATUS.md, ROCm decode loop).
__device__ void q8_0_half_pair(const RowCall& rc, const signed char* q, const float* dx, unsigned long long nin, int add) {
    const int lane = threadIdx.x % 64, half = lane / 32, sl = lane % 32;
    const unsigned blocks = (unsigned)(nin / 32), hl = sl & 1, bd = sl >> 1;
    const unsigned long long waves = (unsigned long long)gridDim.x * (kThreads / 64), step = 2 * waves;
    for (unsigned long long base = 2 * ((unsigned long long)blockIdx.x * (kThreads / 64) + threadIdx.x / 64); base < rc.total; base += step) {
        const unsigned long long o = base + half;
        const Row r = row_of(rc, o < rc.total ? o : base, blocks * kQ8);
        const unsigned* w = (const unsigned*)r.w;
        const unsigned start = bd * kQ8 + 18 * hl, sh = start & 2, wi = start >> 2, s0 = sh + 2 * (1 - hl);
        float v = 0.0f;
        // Both lanes of a block take or skip it together, so the scale's exchange reads an active partner.
        if (bd < blocks) {
            const int4 xq = *(const int4*)(q + (unsigned long long)bd * 32 + 16 * hl);
            const float xd = dx[bd];
            const unsigned t0 = w[wi], t1 = w[wi + 1], t2 = w[wi + 2], t3 = w[wi + 3], t4 = w[wi + 3 + (hl == 0 || sh ? 1 : 0)];
            const bool next = s0 == 4;
            const unsigned u0 = next ? t1 : t0, u1 = next ? t2 : t1, u2 = next ? t3 : t2, u3 = next ? t4 : t3, n = s0 & 3;
            int s = word_dot((int)byte_align(u1, u0, n), xq.x, 0, (signed char)0);
            s = word_dot((int)byte_align(u2, u1, n), xq.y, s, (signed char)0);
            s = word_dot((int)byte_align(u3, u2, n), xq.z, s, (signed char)0);
            s = word_dot((int)byte_align(t4, u3, n), xq.w, s, (signed char)0);
            const int own = (int)(t0 >> (8 * sh)) & 0xffff;
            const int partner = pair_lane(own);
            const float dw = __half2float(__ushort_as_half((unsigned short)(hl ? partner : own)));
            v = fmaf(dw * xd, (float)s, 0.0f);
        }
        const float sum = wave_sum(v + 0.0f, 16);
        if (sl == 0 && o < rc.total) *r.y = add ? *r.y + sum : sum;
    }
}

constexpr int kTileOut = 64, kTileRows = 64, kNarrowRows = 16, kMidRows = 32;   // a narrow routed tile's rows, a group of up to 16 entries, and a K-type's mid tile's, up to 32
constexpr unsigned kStreamRows = 8;   // the most entries of a group the 8-bit twin's routed stream takes but Q8_0's, which takes kNarrowRows (routed_stream)
constexpr unsigned kThinRows = 8;   // the most entries of a group MXFP4's 16-bit thin build takes (k_thin)

// A tile call: up to kTileProj projections of one X and one twin, projection p's output tiles from workgroup start[p] on, the inner dimension in parts of kper blocks (blockIdx.z the part).
// A split call writes part z of projection p at partials + parts * nrows * (outputs of the projections before p) + z * nrows * nout[p], which llmx_tile_reduce adds in part order.
constexpr unsigned kTileProj = 6;   // every projection of one input in a layer (q, gate, sink, rel, k and v of an Inkling sliding layer) takes one call
struct TileCall {
    const unsigned char* w[kTileProj];
    float* y[kTileProj];
    unsigned long long nout[kTileProj];
    unsigned start[kTileProj];
    unsigned nproj;
    unsigned long long nin, nrows;
    int add;
    unsigned kper, parts;
    float* partials;
    unsigned xrow, xblock;   // the twin's blocks from one row to the next and from one block to the next (TwinMap, kernels/f32.gpu)
    const void* xs;          // the twin's half sums from the call's first row (kernels/quant.h, twin_sums)
    const float* f[kTileProj];   // as RowCall's
};
// The projection of a call's workgroup bx: the starts rise, so it is the count of later projections starting at or below bx.
// CUDA takes the last projection starting at or below bx in one chain of selects, which keeps the tall K tiles within their 128 registers on sm_120.
__device__ inline unsigned tile_proj(const TileCall& c, unsigned bx) {
#if GPU_WAVE == 32
    static_assert(kTileProj == 6, "the chain names every projection");
    return c.nproj > 5 && bx >= c.start[5] ? 5 : c.nproj > 4 && bx >= c.start[4] ? 4 : c.nproj > 3 && bx >= c.start[3] ? 3 : c.nproj > 2 && bx >= c.start[2] ? 2 : c.nproj > 1 && bx >= c.start[1] ? 1 : 0;
#else
    unsigned pi = 0;
#pragma unroll
    for (unsigned p = 1; p < kTileProj; ++p) pi += p < c.nproj && bx >= c.start[p];
    return pi;
#endif
}
// A routed tile call's groups (kernels/f32.gpu, llmx_moe_group): group first + blockIdx.y a tile of its expert's rows, its columns its entries.
// The call never splits, so an entry's sums do not depend on the entries beside it.
struct TileGroups {
    const unsigned* tab;
    unsigned long long order0, per, first;
    unsigned long long stride[3];
};
// Blocks of 32 staged a barrier as the Vulkan tile stages them, four for the 8-bit twin and two for the 16-bit one, a step loading while the previous one computes but in the tall 16-bit build.
// Each value sits at a 32-bit byte offset from a uniform base, which the host bounds (`backend_core.hpp`, the tile launch).
template <typename T> __device__ inline T at(const void* base, unsigned off) { return *(const T*)((const unsigned char*)base + off); }
// WQ quant words as one load: their words are 4-byte aligned, which a global vector load takes.
template <int WQ> using QWords = gpu_words<WQ>;
template <typename QT, int RO> struct TileStep { static constexpr int n = sizeof(QT) == 1 && RO == 4 ? 4 : 2; static constexpr bool ahead = RO == 4 || sizeof(QT) == 1; };
// Under the tensor-core tiles, warps MW along the outputs and RW rows each: lane t's fragment f is d[f % 4] of its 8-row product f / 4, at this output and row of the tile.
template <int MW> __device__ inline int mma_out(int t, int f) { return 16 * (t / 32 % MW) + t % 32 / 4 + 8 * (f % 4 / 2); }
template <int MW, int RW> __device__ inline int mma_row(int t, int f) { return t / 32 / MW * RW + 8 * (f / 4) + 2 * (t % 4) + f % 2; }
// An integer sum as a float: plain, or under BIASED one the tensor cores accumulated from kSumBias, the bits of 1.5 * 2^23, whose float less that is the sum exactly for |sum| < 2^22.
// The tiles' 8-bit sums stay below 2^20, so an add replaces the conversion, which sm_80 to sm_90 run at a quarter of the FP32 rate.
constexpr int kSumBias = 0x4B400000;
template <bool BIASED> __device__ inline float sum_float(int v) { return BIASED ? __int_as_float(v) - 12582912.0f : (float)v; }
// A scale times an integer sum, under BIASED one fma against the scale times 1.5 * 2^23, which rounds the product once wherever the scale times 3 is exact, as for a half scale times a byte (docs/PRECISION.md).
template <bool BIASED> __device__ inline float scaled_sum(float ds, int v) { return BIASED ? fmaf(ds, __int_as_float(v), -12582912.0f * ds) : ds * (float)v; }

// The prompt tile in the Vulkan tile's design: a block of 256 threads 64 outputs by 64 rows, each thread 4 by 4, the steps staged k-major in shared memory.
// Each output sums its blocks in order, acc = fma(dw * dx, isum, acc), so a row gives the same bits wherever the tile falls; routed, a block row is a group.
template <typename QT, int RO, bool ROUTED = false, int ROWS = kTileRows, int GG = 1>
__device__ void q8_0_tile(const TileCall& c, const QT* q, const float* dx, const TileGroups& tg = TileGroups{}) {
    constexpr bool AHEAD = TileStep<QT, RO>::ahead;
    constexpr int STEP = TileStep<QT, RO>::n, WORDS = 32 * (int)sizeof(QT) / 4, OUTS = RO * 16;
    constexpr int WT = kThreads / OUTS, WQ = 32 / WT / 4;   // threads a weight row and the quant words each stages
    constexpr int J = ROWS / 16;   // a thread's rows
    // Under GG > 1 consecutive workgroups take GG row tiles of one output tile, so the workgroups in flight share its weights in L2.
    unsigned bx = blockIdx.x, by = blockIdx.y;
    if constexpr (GG > 1 && !ROUTED) {
        const unsigned gx = gridDim.x, lin = by * gx + bx, per = GG * gx, fy = lin / per * GG, gs = min(gridDim.y - fy, (unsigned)GG), r = lin - lin / per * per;
        bx = r / gs, by = fy + r % gs;
    }
    const unsigned pi = tile_proj(c, bx);
    const unsigned long long gi = ROUTED ? tg.first + blockIdx.y : 0;
    const unsigned long long nout = c.nout[pi], nrows = ROUTED ? tg.tab[4 * gi + 2] : c.nrows, nin = c.nin;
    // A routed group runs in the build of the fewest rows that holds it: the 8-bit twin's stream or the 16-bit twin's thin build up to kNarrowRows, the 16-bit twin's mid tile up to kMidRows, then the 64-row tile.
    // A column's sums are the same in all of them.
    constexpr unsigned long long LO = ROWS == kMidRows || sizeof(QT) == 1 ? kNarrowRows : kMidRows;
    if (ROUTED && (nrows <= LO || nrows > (unsigned long long)ROWS)) return;
    const unsigned* ent = ROUTED ? tg.tab + tg.order0 + tg.tab[4 * gi + 1] : nullptr;
    const unsigned char* W = c.w[pi] + (ROUTED ? tg.tab[4 * gi] * tg.stride[pi] : 0);
#if GPU_IMMA8
    // The 8-bit twin's block sums on the integer tensor cores, each warp 16 outputs by RW rows; the sums are exact, so the tile keeps the dot build's bits.
    constexpr bool MMA = sizeof(QT) == 1 && !ROUTED;
#else
    constexpr bool MMA = false;
#endif
    constexpr int PAD = MMA ? 8 : 0;   // a fragment's eight rows and four words fall in 32 distinct banks
    constexpr int MW = OUTS / 16, RW = ROWS / (kThreads / 32 / MW), NT = RW / 8;   // the warps along the outputs, a warp's rows and its 8-row products
    static_assert(!MMA || NT * 4 == RO * J, "a lane's fragments are its outputs by rows");
    __shared__ __attribute__((aligned(16))) int wq[STEP * WORDS][OUTS + PAD];
    __shared__ __attribute__((aligned(16))) int xw[STEP * WORDS][ROWS + PAD];
    __shared__ float wd[STEP][OUTS], xd[STEP][ROWS];
    // The routed builds give each wave a quarter of the rows rather than of the outputs, so a wave whose rows a short group leaves empty skips its dots.
    constexpr bool WAVES = ROUTED && !MMA;
    // A wave's quarter of the rows is rotated by workgroup, so the quarters a short group leaves empty fall on every SIMD rather than always on the last ones.
    const int t = threadIdx.x, quad = (int)((t / 64 + blockIdx.x + blockIdx.y) % 4);
    const int tr = WAVES ? t % 16 : t / 16, tc = WAVES ? 4 * quad + t / 16 % 4 : t % 16;   // outputs tr * RO.., rows tc * J..
    constexpr int TO = RO, TJ = J;   // a thread's outputs and rows
    const auto out_at = [&](int i) { return tr * RO + i; };
    const auto row_at = [&](int j) { return tc * J + j; };
    const bool idle = WAVES && 4ull * J * quad >= nrows;
    // Under WAVES with four rows a thread, tile place 16a + 4q + j holds row 16a + 4j + q, so a wave whose rows end within its first eight runs rows j = 0, 1 only.
    constexpr bool SPLIT = WAVES && J == 4;
    const bool half = SPLIT && nrows - 4ull * J * quad <= 8;
    const auto row_of = [&](int p) { return SPLIT ? 16 * (p / 16) + 4 * (p % 4) + p % 16 / 4 : p; };
    // Sum i, j's output and row: the thread's own outputs and rows, or under MMA fragment i * TJ + j's, d[f / 4][f % 4] of mma_s8.
    // The fragment place of a lane is computed only under MMA, so the other builds keep the code they had and the HIP code objects stay byte identical.
    const auto oat = [&](int i, int j) {
        if constexpr (MMA) return mma_out<MW>(t, i * TJ + j);
        else return out_at(i);
    };
    const auto rat = [&](int i, int j) {
        if constexpr (MMA) return mma_row<MW, RW>(t, i * TJ + j);
        else return row_at(j);
    };
    const unsigned long long o0 = (unsigned long long)(bx - c.start[pi]) * OUTS, b0 = ROUTED ? 0 : (unsigned long long)by * ROWS;
    const unsigned long long blocks = nin / 32, kbeg = (unsigned long long)blockIdx.z * c.kper;
    const unsigned long long kend = kbeg + c.kper < blocks ? kbeg + c.kper : blocks;
    float acc[TO][TJ];
    for (int i = 0; i < TO; ++i)
        for (int j = 0; j < TJ; ++j) acc[i][j] = 0.0f;
    // Each weight row takes WT threads, each WQ words of a block's quants (two threads a row on the tall tile, four on the other), and the twin's rows four threads, each a quarter of a block (the Vulkan tile's staging).
    // A stage's blocks are loaded into registers while the previous stage computes, and stored to shared memory after it.
    const int r = t / 4, seg = t % 4, wr = t / WT, ws = t % WT;
    const unsigned long long o = o0 + wr, b = b0 + r;
    const unsigned xr = ROUTED ? (b < nrows ? (unsigned)(ent[b] / tg.per) : 0u) : (unsigned)r;   // the twin row this thread stages
    unsigned wv[STEP][WQ + 1];   // the thread's quant words and one more: the word after where they straddle, the word before where not
    bool wok[STEP], al[STEP], xok[STEP];
    int xv[STEP][WORDS / 4];       // a quarter of the twin block
    float xs_[STEP];
    // The tile's first output and first row as uniform bases, so each thread's offsets from them are 32-bit bytes (`at`) and its loads take the base from scalar registers.
    const unsigned char* Wt = W + o0 * blocks * kQ8;
    const unsigned mis = (unsigned)((unsigned long long)Wt & 3);
    const unsigned* W4 = (const unsigned*)(Wt - mis);   // the words around the tile's weights, as a pointer into the same buffer so its loads stay global ones
    const QT* qt = q + b0 * c.xrow * 32;
    const float* dxt = dx + b0 * c.xrow;
    // A thread's quants sit at an offset of 0 or 2 in their 4-byte words, since a block is 34 bytes, so one vector load and one more word cover them.
    // Every load of a stage goes out before any is waited for, a load out of range reading block 0 and its zero chosen at the store.
    const auto load = [&](unsigned long long k0) {
#pragma unroll
        for (int s = 0; s < STEP; ++s) {
            const unsigned long long k = k0 + s;
            xok[s] = k < kend && b < nrows;
            wok[s] = k < kend && o < nout;
            const unsigned a = mis + (wok[s] ? ((unsigned)wr * (unsigned)blocks + (unsigned)k) * 34u : 0u) + 2u + ws * (4u * WQ), w = a & ~3u;
            al[s] = (a & 3) == 0;
            const QWords<WQ> v = at<QWords<WQ>>(W4, w);
#pragma unroll
            for (int i = 0; i < WQ; ++i) wv[s][i] = v[i];
            wv[s][WQ] = at<unsigned>(W4, al[s] ? w - 4u : w + 4u * WQ);
            const unsigned xb = xok[s] ? xr * c.xrow + (unsigned)k * c.xblock : 0u;
            if constexpr (sizeof(QT) == 2) {
                const int4 v = at<int4>(qt, xb * 64u + seg * 16u);
                xv[s][0] = v.x, xv[s][1] = v.y, xv[s][2] = v.z, xv[s][3] = v.w;
            } else {
                const int2 v = at<int2>(qt, xb * 32u + seg * 8u);
                xv[s][0] = v.x, xv[s][1] = v.y;
            }
            xs_[s] = at<float>(dxt, xb * 4u);
        }
    };
    // Widened to the twin's integer type as they are stored: each quant word to two words of two 16-bit values, or the words of bytes as they are.
    const auto store = [&]() {
#pragma unroll
        for (int s = 0; s < STEP; ++s) {
            const unsigned last = wv[s][WQ];
#pragma unroll
            for (int i = 0; i < WQ; ++i) {
                const unsigned next = i + 1 < WQ ? wv[s][i + 1] : last;
                const unsigned qw = wok[s] ? (al[s] ? wv[s][i] : bit_align(next, wv[s][i], 16)) : 0;
                if constexpr (sizeof(QT) == 2) {
#pragma unroll
                    for (int h = 0; h < 2; ++h) {
                        const unsigned pair = (qw >> (16 * h)) & 0xffff;
                        wq[s * WORDS + ws * 2 * WQ + 2 * i + h][wr] = (int)((unsigned)(unsigned short)(short)(signed char)(pair & 0xff) |
                                                                    ((unsigned)(unsigned short)(short)(signed char)(pair >> 8) << 16));
                    }
                } else {
                    wq[s * WORDS + ws * WQ + i][wr] = (int)qw;
                }
            }
            const unsigned short sc = wok[s] ? (unsigned short)(al[s] ? last >> 16 : wv[s][0] & 0xffff) : 0;
            if (ws == 0) wd[s][wr] = __half2float(__ushort_as_half(sc));
#pragma unroll
            for (int w = 0; w < WORDS / 4; ++w)
                if (r < ROWS) xw[s * WORDS + seg * (WORDS / 4) + w][row_of(r)] = xok[s] ? xv[s][w] : 0;
            if (seg == 0 && r < ROWS) xd[s][row_of(r)] = xok[s] ? xs_[s] : 0.0f;
        }
    };
    // The 8-bit twin on 64 outputs stages a whole block a thread instead, weight row and twin row t / 4 and block t % 4, into the same shared layout.
    // Two four-word loads and a word cover the 34-byte block from its 4-aligned base and two four-word loads the twin block, 6 loads a stage for 16 (docs/DEVICE-TUNING.md).
    constexpr bool WHOLE = sizeof(QT) == 1 && OUTS == 64 && STEP == 4;
    unsigned bw[9];
    int bv8[8];
    float bxs = 0.0f;
    bool bwok = false, bxok = false, bal = false;
    const int bs = t % 4;
    const auto load_whole = [&](unsigned long long k0) {
        const unsigned long long k = k0 + bs;
        bxok = k < kend && b < nrows;
        bwok = k < kend && o < nout;
        const unsigned a = mis + (bwok ? ((unsigned)wr * (unsigned)blocks + (unsigned)k) * 34u : 0u), w = a & ~3u;
        bal = (a & 2) != 0;   // the quants start on a word
        const QWords<4> v0 = at<QWords<4>>(W4, w), v1 = at<QWords<4>>(W4, w + 16u);
#pragma unroll
        for (int i = 0; i < 4; ++i) bw[i] = v0[i], bw[4 + i] = v1[i];
        bw[8] = at<unsigned>(W4, w + 32u);
        const unsigned xb = bxok ? xr * c.xrow + (unsigned)k * c.xblock : 0u;
        const int4 x0 = at<int4>(qt, xb * 32u), x1 = at<int4>(qt, xb * 32u + 16u);
        bv8[0] = x0.x, bv8[1] = x0.y, bv8[2] = x0.z, bv8[3] = x0.w, bv8[4] = x1.x, bv8[5] = x1.y, bv8[6] = x1.z, bv8[7] = x1.w;
        bxs = at<float>(dxt, xb * 4u);
    };
    // A lane out of range stages block 0 as it is, with no zero chosen: its output or row is never stored and a block it reads past kend is never summed.
    const auto store_whole = [&]() {
#pragma unroll
        for (int i = 0; i < 8; ++i) wq[bs * WORDS + i][wr] = (int)(bal ? bw[i + 1] : bit_align(bw[i + 1], bw[i], 16));
        const unsigned short sc = (unsigned short)(bal ? bw[0] >> 16 : bw[0] & 0xffff);
        wd[bs][wr] = __half2float(__ushort_as_half(sc));
        if (r < ROWS) {
#pragma unroll
            for (int i = 0; i < 8; ++i) xw[bs * WORDS + i][row_of(r)] = bv8[i];
            xd[bs][row_of(r)] = bxs;
        }
    };
    // On a 64-lane wave the 16-bit twin on 64 outputs stages half a weight block a thread (row t / 4, block t / 2 % 2, half t % 2) as four words and one, and its twin as before.
    constexpr bool HALF = GPU_WAVE == 64 && sizeof(QT) == 2 && OUTS == 64 && STEP == 2;
    unsigned hw[5];
    bool hok = false, hal = false;
    const int hb = t / 2 % 2, hh = t % 2;
    const auto load_half = [&](unsigned long long k0) {
        const unsigned long long k = k0 + hb;
        hok = k < kend && o < nout;
        const unsigned a = mis + (hok ? ((unsigned)wr * (unsigned)blocks + (unsigned)k) * 34u : 0u) + 2u + 16u * hh, w = a & ~3u;
        hal = (a & 3) == 0;
        const QWords<4> v = at<QWords<4>>(W4, w);
#pragma unroll
        for (int i = 0; i < 4; ++i) hw[i] = v[i];
        hw[4] = at<unsigned>(W4, hal ? w - 4u : w + 16u);
#pragma unroll
        for (int s = 0; s < STEP; ++s) {
            const unsigned long long kx = k0 + s;
            xok[s] = kx < kend && b < nrows;
            const unsigned xb = xok[s] ? xr * c.xrow + (unsigned)kx * c.xblock : 0u;
            const int4 x = at<int4>(qt, xb * 64u + seg * 16u);
            if constexpr (HALF) xv[s][0] = x.x, xv[s][1] = x.y, xv[s][2] = x.z, xv[s][3] = x.w;
            xs_[s] = at<float>(dxt, xb * 4u);
        }
    };
    const auto store_half = [&]() {
#pragma unroll
        for (int i = 0; i < 4; ++i) {
            const unsigned next = i + 1 < 4 ? hw[i + 1] : hw[4];
            const unsigned qw = hok ? (hal ? hw[i] : bit_align(next, hw[i], 16)) : 0;
#pragma unroll
            for (int h = 0; h < 2; ++h) {
                const unsigned pair = (qw >> (16 * h)) & 0xffff;
                wq[hb * WORDS + 8 * hh + 2 * i + h][wr] = (int)((unsigned)(unsigned short)(short)(signed char)(pair & 0xff) |
                                                       ((unsigned)(unsigned short)(short)(signed char)(pair >> 8) << 16));
            }
        }
        const unsigned short sc = hok ? (unsigned short)(hal ? hw[4] >> 16 : hw[0] & 0xffff) : 0;
        if (hh == 0) wd[hb][wr] = __half2float(__ushort_as_half(sc));
#pragma unroll
        for (int s = 0; s < STEP; ++s) {
#pragma unroll
            for (int w = 0; w < WORDS / 4; ++w)
                if (r < ROWS) xw[s * WORDS + seg * (WORDS / 4) + w][row_of(r)] = xok[s] ? xv[s][w] : 0;
            if (seg == 0 && r < ROWS) xd[s][row_of(r)] = xok[s] ? xs_[s] : 0.0f;
        }
    };
    const auto stage_load = [&](unsigned long long k0) {
        if constexpr (WHOLE) load_whole(k0);
        else if constexpr (HALF) load_half(k0);
        else load(k0);
    };
    const auto stage_store = [&]() {
        if constexpr (WHOLE) store_whole();
        else if constexpr (HALF) store_half();
        else store();
    };
    if (AHEAD) stage_load(kbeg);
    for (unsigned long long k0 = kbeg; k0 < kend; k0 += STEP) {
        if (!AHEAD) stage_load(k0);
        stage_store();
        __syncthreads();
        if (AHEAD && k0 + STEP < kend) stage_load(k0 + STEP);
#pragma unroll
        for (int s = 0; s < STEP; ++s) {
            if (k0 + s >= kend || idle) break;
            // JN of the thread's TJ rows, one build of the loop each.
            const auto rows = [&](auto jn) {
            constexpr int JN = decltype(jn)::value;
            int is[TO][TJ];
#pragma unroll
            for (int i = 0; i < TO; ++i)
#pragma unroll
                for (int j = 0; j < JN; ++j) is[i][j] = 0;
            if constexpr (MMA) {
#if GPU_IMMA8
                const int g = t % 32 / 4, gk = t % 4, wm = t / 32 % MW, wn = t / 32 / MW;
                const int* q0 = wq[s * WORDS + gk];
                const int* q1 = wq[s * WORDS + gk + 4];
                const int a[4] = {q0[16 * wm + g], q0[16 * wm + g + 8], q1[16 * wm + g], q1[16 * wm + g + 8]};
#pragma unroll
                for (int n = 0; n < NT; ++n) {
                    const int b[2] = {xw[s * WORDS + gk][wn * RW + 8 * n + g], xw[s * WORDS + gk + 4][wn * RW + 8 * n + g]};
                    int d[4] = {0, 0, 0, 0};
                    mma_s8(d, a, b);
#pragma unroll
                    for (int e = 0; e < 4; ++e) is[(4 * n + e) / TJ][(4 * n + e) % TJ] = d[e];
                }
#endif
            } else {   // braced: nvcc takes a #pragma right after a bare else as the whole else branch
#pragma unroll
                for (int w = 0; w < WORDS; ++w) {
                    int av[TO];
#pragma unroll
                    for (int h = 0; h < RO / 4; ++h) {
                        const int4 a = *(const int4*)&wq[s * WORDS + w][tr * RO + 4 * h];
                        av[4 * h] = a.x, av[4 * h + 1] = a.y, av[4 * h + 2] = a.z, av[4 * h + 3] = a.w;
                    }
                    int bv[TJ];
                    if constexpr (TJ == 4) {
                        const int4 b4 = *(const int4*)&xw[s * WORDS + w][row_at(0)];
                        bv[0] = b4.x, bv[1] = b4.y, bv[2] = b4.z, bv[3] = b4.w;
                    } else {
                        for (int j = 0; j < JN; ++j) bv[j] = xw[s * WORDS + w][row_at(j)];
                    }
#pragma unroll
                    for (int i = 0; i < TO; ++i)
#pragma unroll
                        for (int j = 0; j < JN; ++j) is[i][j] = word_dot(av[i], bv[j], is[i][j], QT());
                }
            }
#pragma unroll
            for (int i = 0; i < TO; ++i)
#pragma unroll
                for (int j = 0; j < JN; ++j) acc[i][j] = fmaf(wd[s][oat(i, j)] * xd[s][rat(i, j)], (float)is[i][j], acc[i][j]);
            };
            if (half) rows(std::integral_constant<int, 2>{});
            else rows(std::integral_constant<int, TJ>{});
        }
        __syncthreads();
    }
    unsigned long long before = 0;
    for (unsigned p = 0; p < pi; ++p) before += c.nout[p];
    for (int j = 0; j < TJ; ++j)
        for (int i = 0; i < TO; ++i) {
            const unsigned long long o = o0 + oat(i, j), b = b0 + row_of(rat(i, j));
            if (o >= nout || b >= nrows) continue;
            if (c.parts > 1) {
                c.partials[c.parts * nrows * before + blockIdx.z * nrows * nout + b * nout + o] = acc[i][j];
            } else {
                float* y = c.y[pi] + (ROUTED ? ent[b] : b) * nout + o;
                *y = c.add ? *y + acc[i][j] : acc[i][j];
            }
        }
}

// A Q8_0 routed group of up to kNarrowRows entries on the 16-bit twin, a thread an output row and four output tiles a workgroup, with q8_0_tile's sums: acc = fma(dw * dx, isum, acc) in block order.
// A thread reads its own row's blocks into registers a block ahead; the entries' twin blocks are staged in shared memory kThinChunk blocks at a time and read by every lane at one address.
constexpr int kThinChunk = 8;
__device__ void q8_0_thin(const TileCall& c, const short* q, const float* dx, const TileGroups& tg) {
    constexpr int N = kNarrowRows, KC = kThinChunk, NQ = N / 4;
    const int t = threadIdx.x, lane = t % kTileOut;
    const unsigned tile = blockIdx.x * (kThreads / kTileOut) + t / kTileOut;
    const unsigned long long gi = tg.first + blockIdx.y;
    const unsigned long long nrows = tg.tab[4 * gi + 2];
    if (!nrows || nrows > (unsigned long long)N) return;
    const unsigned pi = tile_proj(c, tile);
    const unsigned long long nout = c.nout[pi], blocks = c.nin / 32;
    const unsigned long long o = (unsigned long long)(tile - c.start[pi]) * kTileOut + lane;
    const bool ok = o < nout;
    const unsigned* ent = tg.tab + tg.order0 + tg.tab[4 * gi + 1];
    // A row (or its window) may start 2 bytes past a word: where word loads need alignment it is read from that word and rs shifts its blocks.
    const unsigned char* wb = c.w[pi] + tg.tab[4 * gi] * tg.stride[pi] + (ok ? o : 0) * blocks * kQ8;
    const unsigned rs = GPU_WORD_ALIGN ? (unsigned)((unsigned long long)wb >> 1) & 1u : 0u;
    const unsigned* wrow = (const unsigned*)(wb - 2 * rs);
    const int nq = (int)((nrows + 3) / 4);
    __shared__ __attribute__((aligned(16))) int xw[KC][16][N];
    __shared__ __attribute__((aligned(16))) float xd[KC][N];
    // Thread t stages entry t / 16, block (t % 16) / 2 of the chunk, its words 8 * (t % 2) on.
    const int sr = t / 16, sk = (t % 16) / 2, sh = t % 2;
    const unsigned xr = sr < (int)nrows ? ent[sr] / (unsigned)tg.per : 0u;
    int4 xa, xb;
    float xs;
    const auto xload = [&](unsigned long long k0) {
        const unsigned long long k = k0 + sk;
        const bool in = sr < (int)nrows && k < blocks;
        const int4* p = (const int4*)(q + ((unsigned long long)xr * c.xrow + (in ? k : 0) * c.xblock) * 32 + 16 * sh);
        xa = in ? p[0] : make_int4(0, 0, 0, 0), xb = in ? p[1] : make_int4(0, 0, 0, 0);
        xs = in ? dx[(unsigned long long)xr * c.xrow + k * c.xblock] : 0.0f;
    };
    const auto xstore = [&]() {
        const int v[8] = {xa.x, xa.y, xa.z, xa.w, xb.x, xb.y, xb.z, xb.w};
#pragma unroll
        for (int i = 0; i < 8; ++i) xw[sk][8 * sh + i][sr] = v[i];
        if (sh == 0) xd[sk][sr] = xs;
    };
    // Block k's 34 bytes in the nine words from byte 34k + 2rs rounded down: its scale and quants sit at an offset of 0 or 2 in them.
    const auto wload = [&](unsigned long long k, unsigned (&v)[9]) {
        const unsigned w = (unsigned)((k < blocks ? k : 0) * kQ8 + 2 * rs) / 4;
        const QWords<4> a = *(const QWords<4>*)(wrow + w), b = *(const QWords<4>*)(wrow + w + 4);
        v[0] = a[0], v[1] = a[1], v[2] = a[2], v[3] = a[3], v[4] = b[0], v[5] = b[1], v[6] = b[2], v[7] = b[3];
        v[8] = wrow[w + 8];
    };
    float acc[N];
#pragma unroll
    for (int j = 0; j < N; ++j) acc[j] = 0.0f;
    unsigned d[9], n[9];
    xload(0);
    wload(0, d);
    for (unsigned long long k0 = 0; k0 < blocks; k0 += KC) {
        __syncthreads();
        xstore();
        __syncthreads();
        if (k0 + KC < blocks) xload(k0 + KC);
#pragma unroll 1
        for (int kk = 0; kk < KC; ++kk) {
            const unsigned long long k = k0 + kk;
            if (k >= blocks) break;
            wload(k + 1, n);
            const bool al = ((k + rs) & 1) == 0;
            const float wd = ok ? __half2float(__ushort_as_half((unsigned short)(al ? d[0] & 0xffff : d[0] >> 16))) : 0.0f;
            // The block's 16 widened words first, then each quad of entries over them, so a quad's sums live only while it runs.
            int aw[16];
#pragma unroll
            for (int i = 0; i < 8; ++i) {
                const unsigned qw = al ? bit_align(d[i + 1], d[i], 16) : d[i + 1];
#pragma unroll
                for (int h = 0; h < 2; ++h) {
                    const unsigned pair = (qw >> (16 * h)) & 0xffff;
                    aw[2 * i + h] = (int)((unsigned)(unsigned short)(short)(signed char)(pair & 0xff) | ((unsigned)(unsigned short)(short)(signed char)(pair >> 8) << 16));
                }
            }
#pragma unroll
            for (int qd = 0; qd < NQ; ++qd) {
                if (qd >= nq) break;
                int s0 = 0, s1 = 0, s2 = 0, s3 = 0;
#pragma unroll
                for (int w = 0; w < 16; ++w) {
                    const int4 b4 = *(const int4*)&xw[kk][w][4 * qd];
                    s0 = word_dot(aw[w], b4.x, s0, short());
                    s1 = word_dot(aw[w], b4.y, s1, short());
                    s2 = word_dot(aw[w], b4.z, s2, short());
                    s3 = word_dot(aw[w], b4.w, s3, short());
                }
                const float4 s4 = *(const float4*)&xd[kk][4 * qd];
                acc[4 * qd] = fmaf(wd * s4.x, (float)s0, acc[4 * qd]);
                acc[4 * qd + 1] = fmaf(wd * s4.y, (float)s1, acc[4 * qd + 1]);
                acc[4 * qd + 2] = fmaf(wd * s4.z, (float)s2, acc[4 * qd + 2]);
                acc[4 * qd + 3] = fmaf(wd * s4.w, (float)s3, acc[4 * qd + 3]);
            }
#pragma unroll
            for (int i = 0; i < 9; ++i) d[i] = n[i];
        }
    }
    if (!ok) return;
#pragma unroll
    for (int j = 0; j < N; ++j) {
        if (j >= (int)nrows) break;
        float* y = c.y[pi] + (unsigned long long)ent[j] * nout + o;
        *y = c.add ? *y + acc[j] : acc[j];
    }
}

// The F16 class's prompt tile for F16 weights, q8_0_tile's 64 outputs by 64 rows: activations rounded to binary16 as they are staged, each output summed in F32 by half dots in k order.
// A row's sums depend on nin alone, so a row gives the same bits wherever the tile falls; the host takes it for whole steps of 32 values on 16-byte aligned rows (backend_core.hpp, half_product).
__device__ void f16_tile(const TileCall& c, const float* X) {
    constexpr int OUTS = kTileOut, ROWS = kTileRows, WORDS = 16;   // a step's 32 values as 16 words of two halves
    const unsigned long long nout = c.nout[0], nrows = c.nrows, nin = c.nin, steps = nin / 32;
    __shared__ __attribute__((aligned(16))) unsigned wq[2][WORDS][OUTS];
    __shared__ __attribute__((aligned(16))) unsigned xw[2][WORDS][ROWS];
    const int t = threadIdx.x, tr = t / 16, tc = t % 16, r = t / 4, seg = t % 4;   // outputs tr * 4.., rows tc * 4..; weight row and twin row r staged, values 8 * seg..
    const unsigned long long o = (unsigned long long)blockIdx.x * OUTS + r, b = (unsigned long long)blockIdx.y * ROWS + r;
    const bool wok = o < nout, xok = b < nrows;
    const unsigned char* wrow = c.w[0] + (wok ? o : 0) * nin * 2 + seg * 16;
    const float* xrow = X + (xok ? b : 0) * nin + seg * 8;
    float acc[4][4];
    for (int i = 0; i < 4; ++i)
        for (int j = 0; j < 4; ++j) acc[i][j] = 0.0f;
    uint4 wv;
    float4 x0, x1;
    const auto load = [&](unsigned long long k) {
        wv = *(const uint4*)(wrow + k * 64);
        x0 = *(const float4*)(xrow + k * 32), x1 = *(const float4*)(xrow + k * 32 + 4);
    };
    const auto pack = [](float lo, float hi) { return (unsigned)__half_as_ushort(__float2half_rn(lo)) | ((unsigned)__half_as_ushort(__float2half_rn(hi)) << 16); };
    const auto store = [&](int s) {
        wq[s][4 * seg][r] = wok ? wv.x : 0, wq[s][4 * seg + 1][r] = wok ? wv.y : 0, wq[s][4 * seg + 2][r] = wok ? wv.z : 0, wq[s][4 * seg + 3][r] = wok ? wv.w : 0;
        xw[s][4 * seg][r] = xok ? pack(x0.x, x0.y) : 0, xw[s][4 * seg + 1][r] = xok ? pack(x0.z, x0.w) : 0;
        xw[s][4 * seg + 2][r] = xok ? pack(x1.x, x1.y) : 0, xw[s][4 * seg + 3][r] = xok ? pack(x1.z, x1.w) : 0;
    };
    // Step k computes from stage k % 2 while step k + 1's values, loaded before it, are stored to the other stage.
    load(0);
    store(0);
    __syncthreads();
    for (unsigned long long k = 0; k < steps; ++k) {
        const int s = (int)(k & 1);
        if (k + 1 < steps) load(k + 1);
#pragma unroll
        for (int w = 0; w < WORDS; ++w) {
            const uint4 a = *(const uint4*)&wq[s][w][tr * 4], x = *(const uint4*)&xw[s][w][tc * 4];
            const unsigned av[4] = {a.x, a.y, a.z, a.w}, xv[4] = {x.x, x.y, x.z, x.w};
#pragma unroll
            for (int i = 0; i < 4; ++i)
#pragma unroll
                for (int j = 0; j < 4; ++j) acc[i][j] = dot2_f16(av[i], xv[j], acc[i][j]);
        }
        if (k + 1 < steps) store(s ^ 1);
        __syncthreads();
    }
    for (int j = 0; j < 4; ++j)
        for (int i = 0; i < 4; ++i) {
            const unsigned long long oo = (unsigned long long)blockIdx.x * OUTS + tr * 4 + i, bb = (unsigned long long)blockIdx.y * ROWS + tc * 4 + j;
            if (oo >= nout || bb >= nrows) continue;
            float* y = c.y[0] + bb * nout + oo;
            *y = c.add ? *y + acc[i][j] : acc[i][j];
        }
}

// The prompt tile for F32 weights, f16_tile's 64 outputs by 64 rows with F32 inputs, each output an fma chain in k order over its part [kbeg, kend) of the blocks.
// Up to kTileProj projections of one X as q8_0_tile takes them, a split call writing partials for llmx_tile_reduce so a row's sums depend on nin and the split alone, and the MIX build summing projections 0 and 1 in one block.
struct TileMix {
    const float* h;
    const float* m;
    unsigned long long h_stride, m_stride;
};
template <bool MIX = false>
__device__ void f32_tile(const TileCall& c, const float* X, TileMix mx = {}) {
    constexpr int OUTS = kTileOut, ROWS = kTileRows, K = 16;   // a stage's 16 values of every weight row and X row
    const unsigned pi = MIX ? 0 : tile_proj(c, blockIdx.x);
    const unsigned long long nout = c.nout[pi], nrows = c.nrows, nin = c.nin;
    const unsigned long long kbeg = (unsigned long long)blockIdx.z * c.kper * 32, kend = kbeg + c.kper * 32ull < nin ? kbeg + c.kper * 32ull : nin;
    __shared__ __attribute__((aligned(16))) float wq[2][K][OUTS];
    __shared__ __attribute__((aligned(16))) float xw[2][K][ROWS];
    __shared__ __attribute__((aligned(16))) float wg[MIX ? 2 : 1][MIX ? K : 1][MIX ? OUTS : 1];
    const int t = threadIdx.x, tr = t / 16, tc = t % 16, r = t / 4, seg = t % 4;   // outputs tr * 4.., rows tc * 4..; weight row and X row r staged, values 4 * seg..
    const unsigned long long o0 = (unsigned long long)(blockIdx.x - c.start[pi]) * OUTS, b0 = (unsigned long long)blockIdx.y * ROWS;
    const bool wok = o0 + r < nout, xok = b0 + r < nrows;
    const float* wrow = (const float*)c.w[pi] + (wok ? o0 + r : 0) * nin + seg * 4;
    const float* xrow = X + (xok ? b0 + r : 0) * nin + seg * 4;
    const float* grow = MIX ? (const float*)c.w[1] + (wok ? o0 + r : 0) * nin + seg * 4 : nullptr;
    float acc[4][4], acg[MIX ? 4 : 1][MIX ? 4 : 1];
    for (int i = 0; i < 4; ++i)
        for (int j = 0; j < 4; ++j) acc[i][j] = 0.0f;
    if constexpr (MIX)
        for (int i = 0; i < 4; ++i)
            for (int j = 0; j < 4; ++j) acg[i][j] = 0.0f;
    float4 wv, xv, gv;
    const auto load = [&](unsigned long long k) {
        wv = *(const float4*)(wrow + k);
        xv = *(const float4*)(xrow + k);
        if constexpr (MIX) gv = *(const float4*)(grow + k);
    };
    const auto store = [&](int s) {
        wq[s][4 * seg][r] = wok ? wv.x : 0.0f, wq[s][4 * seg + 1][r] = wok ? wv.y : 0.0f, wq[s][4 * seg + 2][r] = wok ? wv.z : 0.0f, wq[s][4 * seg + 3][r] = wok ? wv.w : 0.0f;
        xw[s][4 * seg][r] = xok ? xv.x : 0.0f, xw[s][4 * seg + 1][r] = xok ? xv.y : 0.0f, xw[s][4 * seg + 2][r] = xok ? xv.z : 0.0f, xw[s][4 * seg + 3][r] = xok ? xv.w : 0.0f;
        if constexpr (MIX)
            wg[s][4 * seg][r] = wok ? gv.x : 0.0f, wg[s][4 * seg + 1][r] = wok ? gv.y : 0.0f, wg[s][4 * seg + 2][r] = wok ? gv.z : 0.0f, wg[s][4 * seg + 3][r] = wok ? gv.w : 0.0f;
    };
    // Stage k computes from buffer k % 2 while stage k + 1's values, loaded before it, are stored to the other.
    load(kbeg);
    store(0);
    __syncthreads();
    int s = 0;
    for (unsigned long long k = kbeg; k < kend; k += K, s ^= 1) {
        const bool more = k + K < kend;
        if (more) load(k + K);
        // Four steps at a time, not all 16, so the staged reads stay under 128 registers and two waves a SIMD hide the loads (docs/src/backends-gpu.md).
#pragma unroll 4
        for (int w = 0; w < K; ++w) {
            const float4 a = *(const float4*)&wq[s][w][tr * 4], x = *(const float4*)&xw[s][w][tc * 4];
            const float av[4] = {a.x, a.y, a.z, a.w}, xx[4] = {x.x, x.y, x.z, x.w};
#pragma unroll
            for (int i = 0; i < 4; ++i)
#pragma unroll
                for (int j = 0; j < 4; ++j) acc[i][j] = fmaf(av[i], xx[j], acc[i][j]);
            if constexpr (MIX) {
                const float4 g = *(const float4*)&wg[s][w][tr * 4];
                const float gg[4] = {g.x, g.y, g.z, g.w};
#pragma unroll
                for (int i = 0; i < 4; ++i)
#pragma unroll
                    for (int j = 0; j < 4; ++j) acg[i][j] = fmaf(gg[i], xx[j], acg[i][j]);
            }
        }
        if (more) store(s ^ 1);
        __syncthreads();
    }
    if constexpr (MIX) {
        const unsigned long long o = o0 + tr * 4;
        for (int j = 0; j < 4; ++j) {
            const unsigned long long b = b0 + tc * 4 + j;
            if (b >= nrows) continue;
            const float* h = mx.h + b * mx.h_stride + o;
            const float* m = mx.m + b * mx.m_stride + o;
            float* y = c.y[0] + b * nout + o;
#pragma unroll
            for (int i = 0; i < 4; ++i)
                if (o + i < nout) y[i] = tanh_gate(acc[i][j], acg[i][j], h[i], m[i]);
        }
        return;
    }
    unsigned long long before = 0;
    for (unsigned p = 0; p < pi; ++p) before += c.nout[p];
    // A row's four outputs go as one 16-byte store where they are whole and aligned, the same values as four scalar stores.
    float* const base = c.parts > 1 ? c.partials + c.parts * nrows * before + blockIdx.z * nrows * nout : c.y[pi];
    const bool add = c.parts <= 1 && c.add;
    const unsigned long long o = o0 + tr * 4;
    const bool wide = o + 4 <= nout && nout % 4 == 0 && ((unsigned long long)base & 15) == 0;
    for (int j = 0; j < 4; ++j) {
        const unsigned long long b = b0 + tc * 4 + j;
        if (b >= nrows) continue;
        float* y = base + b * nout + o;
        if (wide) {
            float4 v = make_float4(acc[0][j], acc[1][j], acc[2][j], acc[3][j]);
            if (add) {
                const float4 u = *(const float4*)y;
                v = make_float4(u.x + v.x, u.y + v.y, u.z + v.z, u.w + v.w);
            }
            *(float4*)y = v;
        } else {
            for (int i = 0; i < 4; ++i)
                if (o + i < nout) y[i] = add ? y[i] + acc[i][j] : acc[i][j];
        }
    }
}

#if GPU_FLOAT_MMA
// BF16 weights' prompt tile, f16_tile's 64 by 64 on tensor cores: TF32 over activations rounded to binary16 (the F16 class), or with Bf16 BF16 over activations rounded to BF16 (the BF16 class), weights exact in both.
// Each group's product (8 values on TF32, 16 on BF16) starts from zero and is added to the F32 sum in k order, so a row's bits depend on nin alone (docs/CUDA.md, BF16 prompt tile).
template <bool Bf16> __device__ void bf16_tile(const TileCall& c, const float* X) {
    constexpr int OUTS = kTileOut, ROWS = kTileRows, WORDS = Bf16 ? 16 : 32, PAD = WORDS + 4;   // a stage row holds a step's 32 values as words (BF16 pairs or TF32 values), padded so the fragment loads of a warp take 32 banks
    const unsigned long long nout = c.nout[0], nrows = c.nrows, nin = c.nin, steps = nin / 32;
    __shared__ __attribute__((aligned(16))) unsigned ws[2][OUTS * PAD];
    __shared__ __attribute__((aligned(16))) unsigned xs[2][ROWS * PAD];
    const int t = threadIdx.x, r = t / 4, seg = t % 4, at = WORDS / 4 * seg;   // weight row and activation row r staged, values 8 * seg.. at word at
    const int lane = t % 32, g = lane / 4, q = lane % 4, mt = (t / 32) % 4, nb = (t / 128) * 32;   // a warp's 16 outputs from 16 * mt and 32 rows from nb
    const unsigned long long o = (unsigned long long)blockIdx.x * OUTS + r, b = (unsigned long long)blockIdx.y * ROWS + r;
    const bool wok = o < nout, xok = b < nrows;
    const unsigned char* wrow = c.w[0] + (wok ? o : 0) * nin * 2 + seg * 16;
    const float* xrow = X + (xok ? b : 0) * nin + seg * 8;
    float acc[4][4];
    for (int n = 0; n < 4; ++n)
        for (int i = 0; i < 4; ++i) acc[n][i] = 0.0f;
    uint4 wv;
    float4 x0, x1;
    const auto load = [&](unsigned long long k) {
        wv = *(const uint4*)(wrow + k * 64);
        x0 = *(const float4*)(xrow + k * 32), x1 = *(const float4*)(xrow + k * 32 + 4);
    };
    const auto half = [](float v) { return __float_as_uint(__half2float(__float2half_rn(v))); };
    // f32_to_bf16 of src/core/bf16.hpp: nearest even, a NaN kept quiet.
    const auto brain = [](float v) {
        const unsigned u = __float_as_uint(v);
        return (u & 0x7fffffffu) > 0x7f800000u ? (u >> 16) | 0x40u : (u + 0x7fffu + ((u >> 16) & 1u)) >> 16;
    };
    const auto pair = [&](float lo, float hi) { return brain(lo) | brain(hi) << 16; };
    const uint4 zero = make_uint4(0, 0, 0, 0);
    const auto store = [&](int s) {
        if constexpr (Bf16) {
            *(uint4*)&ws[s][r * PAD + at] = wok ? wv : zero;
            *(uint4*)&xs[s][r * PAD + at] = xok ? make_uint4(pair(x0.x, x0.y), pair(x0.z, x0.w), pair(x1.x, x1.y), pair(x1.z, x1.w)) : zero;
        } else {
            const uint4 w0 = wok ? make_uint4(wv.x << 16, wv.x & 0xffff0000u, wv.y << 16, wv.y & 0xffff0000u) : zero;
            const uint4 w1 = wok ? make_uint4(wv.z << 16, wv.z & 0xffff0000u, wv.w << 16, wv.w & 0xffff0000u) : zero;
            const uint4 h0 = xok ? make_uint4(half(x0.x), half(x0.y), half(x0.z), half(x0.w)) : zero;
            const uint4 h1 = xok ? make_uint4(half(x1.x), half(x1.y), half(x1.z), half(x1.w)) : zero;
            *(uint4*)&ws[s][r * PAD + at] = w0, *(uint4*)&ws[s][r * PAD + at + 4] = w1;
            *(uint4*)&xs[s][r * PAD + at] = h0, *(uint4*)&xs[s][r * PAD + at + 4] = h1;
        }
    };
    // Step k computes from stage k % 2 while step k + 1's values, loaded before it, are stored to the other stage.
    load(0);
    store(0);
    __syncthreads();
    for (unsigned long long k = 0; k < steps; ++k) {
        const int s = (int)(k & 1);
        if (k + 1 < steps) load(k + 1);
        // A group is 8 words in either form, at the same fragment positions (port.h, mma_tf32 and mma_bf16).
#pragma unroll
        for (int kk = 0; kk < WORDS; kk += 8) {
            const unsigned* wa = &ws[s][(16 * mt + g) * PAD + kk + q];
            const unsigned a[4] = {wa[0], wa[8 * PAD], wa[4], wa[8 * PAD + 4]};
#pragma unroll
            for (int n = 0; n < 4; ++n) {
                const unsigned* xb = &xs[s][(nb + 8 * n + g) * PAD + kk + q];
                const unsigned bv[2] = {xb[0], xb[4]};
                float d[4];
                if constexpr (Bf16) mma_bf16(d, a, bv);
                else mma_tf32(d, a, bv);
#pragma unroll
                for (int i = 0; i < 4; ++i) acc[n][i] = acc[n][i] + d[i];
            }
        }
        if (k + 1 < steps) store(s ^ 1);
        __syncthreads();
    }
    for (int n = 0; n < 4; ++n)
        for (int i = 0; i < 4; ++i) {
            const unsigned long long oo = (unsigned long long)blockIdx.x * OUTS + 16 * mt + g + 8 * (i / 2), bb = (unsigned long long)blockIdx.y * ROWS + nb + 8 * n + 2 * q + i % 2;
            if (oo >= nout || bb >= nrows) continue;
            float* y = c.y[0] + bb * nout + oo;
            *y = c.add ? *y + acc[n][i] : acc[n][i];
        }
}
#endif

// F8_E4M3's prompt tile, f16_tile's 64 by 64 over exact binary16 codes, each 128-input partial summed in F32 in k order and added times its grid scale as the CPU's fp8_dot adds it.
// A row's sums depend on nin alone, so a row gives the same bits wherever the tile falls; the host takes it on 16-byte aligned rows, whose inputs the grid holds to whole blocks of 128 (backend_core.hpp, half_product).
__device__ inline unsigned f8_half(unsigned c) {
    const unsigned e = (c >> 3) & 15, m = c & 7;
    unsigned v = e ? ((e + 8) << 10) | (m << 7) : (unsigned)__half_as_ushort(__float2half_rn((float)m * (1.0f / 512.0f)));
    if ((c & 0x7f) == 0x7f) v = 0x7e00;
    return (c & 0x80) << 8 | v;
}
__device__ void f8_tile(const TileCall& c, const float* X, const float* grid, unsigned shift) {
    constexpr int OUTS = kTileOut, ROWS = kTileRows, WORDS = 16;   // a step's 32 values as 16 words of two halves
    const unsigned long long nout = c.nout[0], nrows = c.nrows, nin = c.nin, steps = nin / 32, blocks = nin / 128;
    __shared__ __attribute__((aligned(16))) unsigned wq[2][WORDS][OUTS];
    __shared__ __attribute__((aligned(16))) unsigned xw[2][WORDS][ROWS];
    const int t = threadIdx.x, tr = t / 16, tc = t % 16, r = t / 4, seg = t % 4;   // outputs tr * 4.., rows tc * 4..; weight row and twin row r staged, values 8 * seg..
    const unsigned long long o = (unsigned long long)blockIdx.x * OUTS + r, b = (unsigned long long)blockIdx.y * ROWS + r;
    const bool wok = o < nout, xok = b < nrows;
    const unsigned char* wrow = c.w[0] + (wok ? o : 0) * nin + seg * 8;
    const float* xrow = X + (xok ? b : 0) * nin + seg * 8;
    const float* g[4];
    for (int i = 0; i < 4; ++i) g[i] = grid + (min((unsigned long long)blockIdx.x * OUTS + tr * 4 + i, nout - 1) >> shift) * blocks;
    float acc[4][4], part[4][4];
    for (int i = 0; i < 4; ++i)
        for (int j = 0; j < 4; ++j) acc[i][j] = 0.0f, part[i][j] = 0.0f;
    uint2 wv;
    float4 x0, x1;
    const auto load = [&](unsigned long long k) {
        wv = *(const uint2*)(wrow + k * 32);
        x0 = *(const float4*)(xrow + k * 32), x1 = *(const float4*)(xrow + k * 32 + 4);
    };
    const auto codes = [](unsigned w, int h) { return f8_half((w >> (16 * h)) & 0xff) | f8_half((w >> (16 * h + 8)) & 0xff) << 16; };
    const auto pack = [](float lo, float hi) { return (unsigned)__half_as_ushort(__float2half_rn(lo)) | ((unsigned)__half_as_ushort(__float2half_rn(hi)) << 16); };
    const auto store = [&](int s) {
        wq[s][4 * seg][r] = wok ? codes(wv.x, 0) : 0, wq[s][4 * seg + 1][r] = wok ? codes(wv.x, 1) : 0, wq[s][4 * seg + 2][r] = wok ? codes(wv.y, 0) : 0, wq[s][4 * seg + 3][r] = wok ? codes(wv.y, 1) : 0;
        xw[s][4 * seg][r] = xok ? pack(x0.x, x0.y) : 0, xw[s][4 * seg + 1][r] = xok ? pack(x0.z, x0.w) : 0;
        xw[s][4 * seg + 2][r] = xok ? pack(x1.x, x1.y) : 0, xw[s][4 * seg + 3][r] = xok ? pack(x1.z, x1.w) : 0;
    };
    // Step k computes from stage k % 2 while step k + 1's values, loaded before it, are stored to the other stage; every fourth step closes a block.
    load(0);
    store(0);
    __syncthreads();
    for (unsigned long long k = 0; k < steps; ++k) {
        const int s = (int)(k & 1);
        if (k + 1 < steps) load(k + 1);
#pragma unroll
        for (int w = 0; w < WORDS; ++w) {
            const uint4 a = *(const uint4*)&wq[s][w][tr * 4], x = *(const uint4*)&xw[s][w][tc * 4];
            const unsigned av[4] = {a.x, a.y, a.z, a.w}, xv[4] = {x.x, x.y, x.z, x.w};
#pragma unroll
            for (int i = 0; i < 4; ++i)
#pragma unroll
                for (int j = 0; j < 4; ++j) part[i][j] = dot2_f16(av[i], xv[j], part[i][j]);
        }
        if ((k & 3) == 3) {
#pragma unroll
            for (int i = 0; i < 4; ++i) {
                const float sc = g[i][k / 4];
#pragma unroll
                for (int j = 0; j < 4; ++j) acc[i][j] = fmaf(part[i][j], sc, acc[i][j]), part[i][j] = 0.0f;
            }
        }
        if (k + 1 < steps) store(s ^ 1);
        __syncthreads();
    }
    for (int j = 0; j < 4; ++j)
        for (int i = 0; i < 4; ++i) {
            const unsigned long long oo = (unsigned long long)blockIdx.x * OUTS + tr * 4 + i, bb = (unsigned long long)blockIdx.y * ROWS + tc * 4 + j;
            if (oo >= nout || bb >= nrows) continue;
            float* y = c.y[0] + bb * nout + oo;
            *y = c.add ? *y + acc[i][j] : acc[i][j];
        }
}

// The twin products of the K-quants, Q4_0, Q4_1, Q5_0, Q5_1 and IQ4_NL: a lane takes eight values of one 32-value sub-block, whose term is ds * dot(q, x) - dm * sum(x) over the twin's integers.
// Every fused step is written as fmaf, the kernels compiling without contraction (CMakeLists.txt, LLMX_HIP_FLAGS).

// A row lane's share of a block (k_rows, the Vulkan row layout of matmul_row_one.glsl): `lanes` lanes a block, lane t holding `segments` runs, its run s from value xoff(t, s) of twin block xblock(t, s).
// decode gives a run's values as bytes, four a word; a type's KRaw names its lane as Lane, so KRaw stays the type's one decoder for the tile and the rows.

// Sub-block sub's 6-bit scale and min from a Q4_K or Q5_K block's 12 packed scale bytes, as rq::scale_min_k4 reads them.
// A byte's word is selected rather than indexed: a register array indexed by a lane's value goes to local memory under CUDA, and with it the whole lane state that holds it.
__device__ inline void k45_scale_min(const unsigned (&sc)[3], unsigned sub, unsigned& s, unsigned& m) {
    const auto byte = [&](unsigned i) { return ((i < 4 ? sc[0] : i < 8 ? sc[1] : sc[2]) >> (8 * (i & 3))) & 0xffu; };
    if (sub < 4) {
        s = byte(sub) & 63, m = byte(sub + 4) & 63;
    } else {
        s = (byte(sub + 4) & 0xF) | ((byte(sub - 4) >> 6) << 4);
        m = (byte(sub + 4) >> 4) | ((byte(sub) >> 6) << 4);
    }
}
// Q4_K and Q5_K: eight lanes a block, lane t the 16 nibble bytes from 16 * (t % 2) of 64-value chunk c = t / 2, its low nibbles in sub-block 2c and its high nibbles in 2c + 1.
template <bool Q5> struct K45Lane {
    static constexpr int lanes = 8, segments = 2, values = 16;
    unsigned dm, sc[3], q[4], h[4];
    __device__ void load(const unsigned char* b, unsigned t) {
        const QWords<4> hd = *(const QWords<4>*)b, qw = *(const QWords<4>*)(b + (Q5 ? 48 : 16) + 32 * (t >> 1) + 16 * (t & 1));
        dm = hd.x, sc[0] = hd.y, sc[1] = hd.z, sc[2] = hd.w;
        q[0] = qw.x, q[1] = qw.y, q[2] = qw.z, q[3] = qw.w;
        if constexpr (Q5) {
            const QWords<4> hw = *(const QWords<4>*)(b + 16 + 16 * (t & 1));
            h[0] = hw.x, h[1] = hw.y, h[2] = hw.z, h[3] = hw.w;
        }
    }
    __device__ static unsigned xblock(unsigned t, int s) { return 2 * (t >> 1) + s; }
    __device__ static unsigned xoff(unsigned t, int) { return 16 * (t & 1); }
    __device__ void decode(unsigned t, int s, unsigned (&v)[4], float& ds, float& dmin) const {
        const unsigned sub = 2 * (t >> 1) + s;
        unsigned sv, mv;
        k45_scale_min(sc, sub, sv, mv);
#pragma unroll
        for (int i = 0; i < 4; ++i) {
            v[i] = (q[i] >> (4 * s)) & 0x0F0F0F0Fu;
            if constexpr (Q5) v[i] |= ((h[i] >> sub) & 0x01010101u) << 4;
        }
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff))) * (float)sv;
        dmin = __half2float(__ushort_as_half((unsigned short)(dm >> 16))) * (float)mv;
    }
};
// Q6_K: sixteen lanes a block, lane t the 16 values of half t % 2 of 32-value block t / 2, which share one sub-scale; the block is 2-byte aligned, so its words come as 16-bit loads.
struct Q6KLane {
    static constexpr int lanes = 16, segments = 1, values = 16;
    unsigned lo[4], hi[4];
    unsigned short d;
    signed char sc;
    __device__ void load(const unsigned char* b, unsigned t) {
        const unsigned sub = t >> 1, n = sub >> 2, quarter = sub & 3, half = t & 1;
        const unsigned short* l = (const unsigned short*)(b + 64 * n + 32 * (quarter & 1) + 16 * half);
        const unsigned short* g = (const unsigned short*)(b + 128 + 32 * n + 16 * half);
#pragma unroll
        for (int i = 0; i < 4; ++i) lo[i] = l[2 * i] | ((unsigned)l[2 * i + 1] << 16), hi[i] = g[2 * i] | ((unsigned)g[2 * i + 1] << 16);
        sc = ((const signed char*)b)[192 + 8 * n + half + 2 * quarter];
        d = *(const unsigned short*)(b + 208);
    }
    __device__ static unsigned xblock(unsigned t, int) { return t >> 1; }
    __device__ static unsigned xoff(unsigned t, int) { return 16 * (t & 1); }
    __device__ void decode(unsigned t, int, unsigned (&v)[4], float& ds, float& dmin) const {
        const unsigned quarter = (t >> 1) & 3, ls = 4 * (quarter >> 1), hs = 2 * quarter;
#pragma unroll
        for (int i = 0; i < 4; ++i) v[i] = ((lo[i] >> ls) & 0x0F0F0F0Fu) | (((hi[i] >> hs) & 0x03030303u) << 4);
        ds = __half2float(__ushort_as_half(d)) * (float)sc;
        dmin = 0.0f;
    }
};
// Q3_K: sixteen lanes a block, lane t the 16 values of sub-scale t, half t % 2 of 32-value block t / 2; the block is 2-byte aligned, so its words come as 16-bit loads.
// A value is its two low bits of plane t / 2 and its mask bit, a clear one taking four, so the lane's bytes hold the 3-bit code and the term takes the offset of 4.
struct Q3KLane {
    static constexpr int lanes = 16, segments = 1, values = 16;
    unsigned lo[4], hm[4];
    unsigned short d;
    unsigned char sl, sh;
    __device__ void load(const unsigned char* b, unsigned t) {
        const unsigned sub = t >> 1, half = t & 1;
        const unsigned short* l = (const unsigned short*)(b + 32 + 32 * (sub >> 2) + 16 * half);
        const unsigned short* h = (const unsigned short*)(b + 16 * half);
#pragma unroll
        for (int i = 0; i < 4; ++i) lo[i] = l[2 * i] | ((unsigned)l[2 * i + 1] << 16), hm[i] = h[2 * i] | ((unsigned)h[2 * i + 1] << 16);
        sl = b[96 + t % 8], sh = b[104 + t % 4];
        d = *(const unsigned short*)(b + 108);
    }
    __device__ static unsigned xblock(unsigned t, int) { return t >> 1; }
    __device__ static unsigned xoff(unsigned t, int) { return 16 * (t & 1); }
    __device__ void decode(unsigned t, int, unsigned (&v)[4], float& ds, float& dmin) const {
        const unsigned sub = t >> 1, shift = 2 * (sub & 3);
#pragma unroll
        for (int i = 0; i < 4; ++i) v[i] = ((lo[i] >> shift) & 0x03030303u) | (((hm[i] >> sub) & 0x01010101u) << 2);
        const int sc = (int)(((sl >> (4 * (t / 8))) & 15) | (((sh >> (2 * (t / 4))) & 3) << 4)) - 32;
        ds = __half2float(__ushort_as_half(d)) * (float)sc;
        dmin = 0.0f;
    }
};
// Q2_K: sixteen lanes a block, lane t the 16 two-bit values of sub-scale t, half t % 2 of 32-value block t / 2, under its 4-bit scale and min; the block is 4-byte aligned.
struct Q2KLane {
    static constexpr int lanes = 16, segments = 1, values = 16;
    unsigned dm, q[4];
    unsigned char sc;
    __device__ void load(const unsigned char* b, unsigned t) {
        const unsigned* w = (const unsigned*)b;
        const unsigned qo = (16 + 32 * (t >> 3) + 16 * (t & 1)) / 4;
#pragma unroll
        for (int i = 0; i < 4; ++i) q[i] = w[qo + i];
        dm = w[20], sc = b[t];
    }
    __device__ static unsigned xblock(unsigned t, int) { return t >> 1; }
    __device__ static unsigned xoff(unsigned t, int) { return 16 * (t & 1); }
    __device__ void decode(unsigned t, int, unsigned (&v)[4], float& ds, float& dmin) const {
        const unsigned shift = 2 * ((t >> 1) & 3);
#pragma unroll
        for (int i = 0; i < 4; ++i) v[i] = (q[i] >> shift) & 0x03030303u;
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff))) * (float)(sc & 15);
        dmin = __half2float(__ushort_as_half((unsigned short)(dm >> 16))) * (float)(sc >> 4);
    }
};
// The fifth bits of a block's 32 values, bit j of h value j's, as bit 4 of each byte of eight words: words 0 to 3 hold values 0 to 15, words 4 to 7 values 16 to 31.
__device__ inline void fifth_bits32(unsigned h, unsigned (&v)[8]) {
#pragma unroll
    for (int i = 0; i < 8; ++i) {
        const unsigned x = (h >> (4 * i)) & 0xF;
        v[i] |= ((x & 1) | ((x & 2) << 7) | ((x & 4) << 14) | ((x & 8) << 21)) << 4;
    }
}
// The 32 values of 16 nibble bytes l[0..3], low nibbles first (values 0 to 15), then high nibbles (16 to 31).
__device__ inline void nibbles32(const unsigned (&l)[4], unsigned (&v)[8]) {
#pragma unroll
    for (int i = 0; i < 4; ++i) v[i] = l[i] & 0x0F0F0F0Fu, v[4 + i] = (l[i] >> 4) & 0x0F0F0F0Fu;
}
// Q4_0: one lane an 18-byte block, 2-byte aligned, as 16-bit loads; its values less 8, taken out of the integer sum.
struct Q40Lane {
    static constexpr int lanes = 1, segments = 1, values = 32;
    unsigned short d;
    unsigned l[4];
    __device__ void load(const unsigned char* b, unsigned) {
        const unsigned short* w = (const unsigned short*)b;
        d = w[0];
#pragma unroll
        for (int i = 0; i < 4; ++i) l[i] = w[1 + 2 * i] | ((unsigned)w[2 + 2 * i] << 16);
    }
    __device__ static unsigned xblock(unsigned, int) { return 0; }
    __device__ static unsigned xoff(unsigned, int) { return 0; }
    __device__ void decode(unsigned, int, unsigned (&v)[8], float& ds, float& dmin) const {
        nibbles32(l, v);
        ds = __half2float(__ushort_as_half(d));
        dmin = 0.0f;
    }
};
// Q4_1: one lane a 20-byte block, 4-byte aligned, its scale and min and nibbles as words; the min joins as a negative dm, so the term adds it.
struct Q41Lane {
    static constexpr int lanes = 1, segments = 1, values = 32;
    unsigned dm, l[4];
    __device__ void load(const unsigned char* b, unsigned) {
        const unsigned* w = (const unsigned*)b;
        dm = w[0];
#pragma unroll
        for (int i = 0; i < 4; ++i) l[i] = w[1 + i];
    }
    __device__ static unsigned xblock(unsigned, int) { return 0; }
    __device__ static unsigned xoff(unsigned, int) { return 0; }
    __device__ void decode(unsigned, int, unsigned (&v)[8], float& ds, float& dmin) const {
        nibbles32(l, v);
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff)));
        dmin = -__half2float(__ushort_as_half((unsigned short)(dm >> 16)));
    }
};
// Q5_0: one lane a 22-byte block, 2-byte aligned, as 16-bit loads; its values less 16, taken out of the integer sum.
struct Q50Lane {
    static constexpr int lanes = 1, segments = 1, values = 32;
    unsigned short d;
    unsigned h, l[4];
    __device__ void load(const unsigned char* b, unsigned) {
        const unsigned short* w = (const unsigned short*)b;
        d = w[0], h = w[1] | ((unsigned)w[2] << 16);
#pragma unroll
        for (int i = 0; i < 4; ++i) l[i] = w[3 + 2 * i] | ((unsigned)w[4 + 2 * i] << 16);
    }
    __device__ static unsigned xblock(unsigned, int) { return 0; }
    __device__ static unsigned xoff(unsigned, int) { return 0; }
    __device__ void decode(unsigned, int, unsigned (&v)[8], float& ds, float& dmin) const {
        nibbles32(l, v);
        fifth_bits32(h, v);
        ds = __half2float(__ushort_as_half(d));
        dmin = 0.0f;
    }
};
// Q5_1: one lane a 24-byte block, 4-byte aligned, its scale and min, fifth bits and nibbles as words; the min joins as a negative dm, so the term adds it.
struct Q51Lane {
    static constexpr int lanes = 1, segments = 1, values = 32;
    unsigned dm, h, l[4];
    __device__ void load(const unsigned char* b, unsigned) {
        const QWords<2> a = *(const QWords<2>*)b;
        const QWords<4> n = *(const QWords<4>*)(b + 8);
        dm = a.x, h = a.y, l[0] = n.x, l[1] = n.y, l[2] = n.z, l[3] = n.w;
    }
    __device__ static unsigned xblock(unsigned, int) { return 0; }
    __device__ static unsigned xoff(unsigned, int) { return 0; }
    __device__ void decode(unsigned, int, unsigned (&v)[8], float& ds, float& dmin) const {
        nibbles32(l, v);
        fifth_bits32(h, v);
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff)));
        dmin = -__half2float(__ushort_as_half((unsigned short)(dm >> 16)));
    }
};

template <typename KT> struct KRaw;
template <typename KT> struct QuarterLane;
// A block of the K tile's weights: a uniform base, the block's uniform byte offset and the lane's row offset, so a read adds a uniform and a lane part to them.
struct WBased {
    gpu_based base;
    unsigned blk, lane;
    template <typename T, int N> __device__ void get(unsigned uni, unsigned l, T (&v)[N]) const { gpu_based_load(base, blk + uni, lane + l, v); }
};
// Whether a type's KRaw reads a based block (WBased); the others read by pointer, and so does MXFP4, which aligns its reads by the address.
template <typename KT, typename = void> struct KBased { static constexpr bool value = false; };
template <typename KT> struct KBased<KT, decltype(std::declval<KRaw<KT>&>().load(std::declval<const WBased&>(), 0u, 0u))> { static constexpr bool value = !__is_same(KT, rq::MXFP4); };
// Q4_K and Q5_K: the f16 scale and min word, the 12 packed scale bytes, the lane's eight nibble bytes and Q5_K's eight fifth-bit bytes, all 4-byte aligned since a block is a multiple of 16 bytes.
template <bool Q5> struct K45Raw {
    unsigned dm, sc[3], q[2], h[2];
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned* w = (const unsigned*)b;
        dm = w[0], sc[0] = w[1], sc[1] = w[2], sc[2] = w[3];
        const unsigned qo = (Q5 ? 48 : 16) + 32 * (sub >> 1) + 8 * part;
        q[0] = w[qo / 4], q[1] = w[qo / 4 + 1];
        if constexpr (Q5) h[0] = w[4 + 2 * part], h[1] = w[5 + 2 * part];
    }
    // The K tile's read of the same words through its based block (WBased).
    __device__ void load(const WBased& b, unsigned sub, unsigned part) {
        unsigned w[4];
        b.get(0, 0, w);
        dm = w[0], sc[0] = w[1], sc[1] = w[2], sc[2] = w[3];
        b.get((Q5 ? 48 : 16) + 32 * (sub >> 1), 8 * part, q);
        if constexpr (Q5) b.get(16, 8 * part, h);
    }
    // Sub-block 2j + 1 reads the same words as sub-block 2j, its nibbles the high ones.
    __device__ void pair(const K45Raw& e, const WBased&, unsigned, unsigned) { *this = e; }
    __device__ void decode(unsigned sub, unsigned, unsigned (&v)[2], float& ds, float& dmin) const {
        unsigned s, m;
        k45_scale_min(sc, sub, s, m);
        const unsigned sh = 4 * (sub & 1);
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            v[i] = (q[i] >> sh) & 0x0F0F0F0Fu;
            if constexpr (Q5) v[i] |= ((h[i] >> sub) & 0x01010101u) << 4;
        }
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff))) * (float)s;
        dmin = __half2float(__ushort_as_half((unsigned short)(dm >> 16))) * (float)m;
    }
};
template <> struct KRaw<rq::Q4_K> : K45Raw<false> { static constexpr int offset = 0, halves = 1; using Lane = K45Lane<false>; };
template <> struct KRaw<rq::Q5_K> : K45Raw<true> { static constexpr int offset = 0, halves = 1; using Lane = K45Lane<true>; };
// Q6_K: a 210-byte block is 2-byte aligned only, so its words come as 16-bit loads: the lane's eight low-nibble bytes and eight high-bit bytes, its 16 values' sub-scale and the block's scale.
// Its scale changes every 16 values, so the tile takes a sub-block as two halves of two parts, each with its own scale and term.
template <> struct KRaw<rq::Q6_K> {
    static constexpr int offset = 32, halves = 2;
    using Lane = Q6KLane;
    unsigned short lo[4], hi[4], d;
    signed char sc;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned n = sub >> 2, quarter = sub & 3;
        const unsigned short* l = (const unsigned short*)(b + 64 * n + 32 * (quarter & 1) + 8 * part);
        const unsigned short* h = (const unsigned short*)(b + 128 + 32 * n + 8 * part);
#pragma unroll
        for (int i = 0; i < 4; ++i) lo[i] = l[i], hi[i] = h[i];
        sc = ((const signed char*)b)[192 + 8 * n + (part >> 1) + 2 * quarter];
        d = *(const unsigned short*)(b + 208);
    }
    __device__ void load(const WBased& b, unsigned sub, unsigned part) {
        const unsigned n = sub >> 2, quarter = sub & 3;
        b.get(64 * n + 32 * (quarter & 1), 8 * part, lo), b.get(128 + 32 * n, 8 * part, hi);
        signed char s[1];
        unsigned short e[1];
        b.get(192 + 8 * n + 2 * quarter, part >> 1, s), b.get(208, 0, e);
        sc = s[0], d = e[0];
    }
    // Sub-block 2j + 1 shares sub-block 2j's high bits and block scale, so only its low nibbles and sub-scale are read.
    __device__ void pair(const KRaw& e, const WBased& b, unsigned sub, unsigned part) {
        const unsigned n = sub >> 2, quarter = sub & 3;
#pragma unroll
        for (int i = 0; i < 4; ++i) hi[i] = e.hi[i];
        b.get(64 * n + 32 * (quarter & 1), 8 * part, lo);
        signed char s[1];
        b.get(192 + 8 * n + 2 * quarter, part >> 1, s);
        sc = s[0];
        d = e.d;
    }
    __device__ void decode(unsigned sub, unsigned, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned quarter = sub & 3, ls = 4 * (quarter >> 1), hs = 2 * quarter;
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            const unsigned l = lo[2 * i] | ((unsigned)lo[2 * i + 1] << 16), h = hi[2 * i] | ((unsigned)hi[2 * i + 1] << 16);
            v[i] = ((l >> ls) & 0x0F0F0F0Fu) | (((h >> hs) & 0x03030303u) << 4);
        }
        ds = __half2float(__ushort_as_half(d)) * (float)sc;
        dmin = 0.0f;
    }
};
// Q3_K: a 110-byte block, 2-byte aligned, so its words come as 16-bit loads: the lane's eight low-bit bytes and eight mask bytes, its sub-scale's two packed bytes and the block's scale.
// The bytes hold the 3-bit code, low bits | mask bit << 2, less the offset of 4; its scale changes every 16 values, so the tile takes two halves as Q6_K's does.
template <> struct KRaw<rq::Q3_K> {
    static constexpr int offset = 4, halves = 2;
    using Lane = Q3KLane;
    unsigned short lo[4], hm[4], d;
    unsigned char sl, sh;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned short* l = (const unsigned short*)(b + 32 + 32 * (sub >> 2) + 8 * part);
        const unsigned short* h = (const unsigned short*)(b + 8 * part);
#pragma unroll
        for (int i = 0; i < 4; ++i) lo[i] = l[i], hm[i] = h[i];
        const unsigned g = 2 * sub + (part >> 1);
        sl = b[96 + g % 8], sh = b[104 + g % 4];
        d = *(const unsigned short*)(b + 108);
    }
    __device__ void decode(unsigned sub, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned g = 2 * sub + (part >> 1), shift = 2 * (sub & 3);
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            const unsigned l = lo[2 * i] | ((unsigned)lo[2 * i + 1] << 16), h = hm[2 * i] | ((unsigned)hm[2 * i + 1] << 16);
            v[i] = ((l >> shift) & 0x03030303u) | (((h >> sub) & 0x01010101u) << 2);
        }
        const int sc = (int)(((sl >> (4 * (g / 8))) & 15) | (((sh >> (2 * (g / 4))) & 3) << 4)) - 32;
        ds = __half2float(__ushort_as_half(d)) * (float)sc;
        dmin = 0.0f;
    }
};
// Q2_K: an 84-byte block, 4-byte aligned, its scale and min word, the lane's eight two-bit bytes and its sub-scale byte; the scale and min change every 16 values, so the tile takes two halves.
template <> struct KRaw<rq::Q2_K> {
    static constexpr int offset = 0, halves = 2;
    using Lane = Q2KLane;
    unsigned dm, q[2];
    unsigned char sc;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned* w = (const unsigned*)b;
        const unsigned qo = (16 + 32 * (sub >> 2) + 8 * part) / 4;
        q[0] = w[qo], q[1] = w[qo + 1], dm = w[20], sc = b[2 * sub + (part >> 1)];
    }
    __device__ void decode(unsigned sub, unsigned, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned shift = 2 * (sub & 3);
#pragma unroll
        for (int i = 0; i < 2; ++i) v[i] = (q[i] >> shift) & 0x03030303u;
        ds = __half2float(__ushort_as_half((unsigned short)(dm & 0xffff))) * (float)(sc & 15);
        dmin = __half2float(__ushort_as_half((unsigned short)(dm >> 16))) * (float)(sc >> 4);
    }
};
// The fifth bits of a lane's eight values, bits 0 to 7 of h, as bit 4 of each byte of two words.
__device__ inline void fifth_bits(unsigned h, unsigned (&v)[2]) {
#pragma unroll
    for (int i = 0; i < 2; ++i) {
        const unsigned x = (h >> (4 * i)) & 0xF;
        v[i] |= ((x & 1) | ((x & 2) << 7) | ((x & 4) << 14) | ((x & 8) << 21)) << 4;
    }
}
// Q4_0: an 18-byte block, 2-byte aligned, its scale and the lane's four nibble bytes' words as 16-bit loads; the values less 8, taken out of the integer sum.
template <> struct KRaw<rq::Q4_0> {
    static constexpr int offset = 8, halves = 1;
    using Lane = Q40Lane;
    unsigned short d, lo[4];
    __device__ void load(const unsigned char* b, unsigned, unsigned part) {
        const unsigned short* w = (const unsigned short*)b;
        d = w[0];
