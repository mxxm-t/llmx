};
// IQ4_NL: an 18-byte block, 2-byte aligned, its scale and the lane's eight nibble bytes as 16-bit loads; each nibble's value from the format's grid as a signed byte (rq::iq4_grid4).
template <> struct KRaw<rq::IQ4_NL> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::IQ4_NL>;   // one lane a block decodes 32 grid values and measured slower at every width (docs/STATUS.md)
    unsigned short d, lo[4];
    __device__ void load(const unsigned char* b, unsigned, unsigned part) {
        const unsigned short* w = (const unsigned short*)b;
        d = w[0];
#pragma unroll
        for (int i = 0; i < 4; ++i) lo[i] = w[1 + 4 * (part & 1) + i];
    }
    __device__ void load(const WBased& b, unsigned, unsigned part) {
        unsigned short e[1];
        b.get(0, 0, e), b.get(2, 8 * (part & 1), lo);
        d = e[0];
    }
    __device__ void decode(unsigned, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned sh = 4 * (part >> 1);
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            const unsigned l = lo[2 * i] | ((unsigned)lo[2 * i + 1] << 16);
            v[i] = rq::iq4_grid4((l >> sh) & 0x0F0F0F0Fu);
        }
        ds = __half2float(__ushort_as_half(d));
        dmin = 0.0f;
    }
};
// IQ4_XS: a 136-byte block, 4-byte aligned, its scale and high scale bits, the low scale nibbles and the lane's eight nibble bytes as words; each nibble's value from IQ4_NL's grid under the sub-block's 6-bit signed scale.
template <> struct KRaw<rq::IQ4_XS> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::IQ4_XS>;
    unsigned hd, sl, lo[2];
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned* w = (const unsigned*)b;
        const unsigned qo = (8 + 16 * sub + 8 * (part & 1)) / 4;
        hd = w[0], sl = w[1], lo[0] = w[qo], lo[1] = w[qo + 1];
    }
    __device__ void decode(unsigned sub, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned sh = 4 * (part >> 1);
#pragma unroll
        for (int i = 0; i < 2; ++i) {
            v[i] = rq::iq4_grid4((lo[i] >> sh) & 0x0F0F0F0Fu);
        }
        const int ls = (int)(((sl >> (4 * sub)) & 15) | (((hd >> (16 + 2 * sub)) & 3) << 4)) - 32;
        ds = __half2float(__ushort_as_half((unsigned short)(hd & 0xffff))) * (float)ls;
        dmin = 0.0f;
    }
};
// Four values' signs, bits 0 to 3 of s, as a byte mask a value, and four positive bytes under it negated: no byte of a grid is zero, so no negation carries.
__device__ inline unsigned sign_bytes(unsigned s) { return ((s & 1u) | ((s & 2u) << 7) | ((s & 4u) << 14) | ((s & 8u) << 21)) * 0xffu; }
__device__ inline unsigned signed_bytes(unsigned x, unsigned s) {
    const unsigned m = sign_bytes(s);
    return (x ^ m) + (m & 0x01010101u);
}
// IQ2_XXS: a 66-byte block, 2-byte aligned, its scale and the sub-block's four grid bytes and sign and scale word as 16-bit loads; the lane's eight values are grid entry part's bytes under its parity-completed signs.
template <> struct KRaw<rq::IQ2_XXS> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::IQ2_XXS>;
    unsigned short d;
    unsigned idx, word;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned short* w = (const unsigned short*)(b + 2 + 8 * sub);
        d = *(const unsigned short*)b;
