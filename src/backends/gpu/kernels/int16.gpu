        ds = __half2float(__ushort_as_half(d)) * (float)(1 + 2 * ((sc >> (4 * (sub & 1))) & 15u));
        dmin = 0.0f;
    }
};
// IQ2_S: an 82-byte block, 2-byte aligned, its scale, the lane's grid index byte, its two high bits, its sign byte and the sub-block's scale byte, whose nibble changes every 16 values, so the tile takes two halves.
template <> struct KRaw<rq::IQ2_S> {
    static constexpr int offset = 0, halves = 2;
    using Lane = QuarterLane<rq::IQ2_S>;
    unsigned short d;
    unsigned char qs, qh, sg, sc;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        d = *(const unsigned short*)b;
        qs = b[2 + 4 * sub + part], sg = b[34 + 4 * sub + part], qh = b[66 + sub], sc = b[74 + sub];
    }
    __device__ void decode(unsigned, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned long long g = GPU_TABLE(quant::IQ2_S_GRID)[(unsigned)qs | ((((unsigned)qh >> (2 * part)) & 3u) << 8)];
        v[0] = signed_bytes((unsigned)g, sg & 15u);
        v[1] = signed_bytes((unsigned)(g >> 32), (unsigned)sg >> 4);
