extern "C" __global__ void __launch_bounds__(kThreads) llmx_q8_0_routed_mid16(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const short* q, const float* dx) { q8_0_tile<short, 4, true, kMidRows>(c, q, dx, g); }
// The routed prompt stream of a type's 8-bit twin, the groups of up to kStreamRows entries (routed_stream).
#define LLMX_STREAM(name, KT) \
    extern "C" __global__ void __launch_bounds__(kStreamLanes) name(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const signed char* q, const float* dx) { routed_stream<KT>(c, g, q, dx); }
// Q8_0's 8-bit stream takes every group of up to kNarrowRows entries, in place of a stream to kStreamRows beside a narrow tile (docs/DEVICE-TUNING.md).
extern "C" __global__ void __launch_bounds__(kStreamLanes) llmx_q8_0_routed_stream16(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const signed char* q, const float* dx) { routed_stream<rq::Q8_0, 0, kNarrowRows>(c, g, q, dx); }

// The twin types' row builds and tiles but Q8_0's, a type's set named by its type: the builds the host takes by a call's columns (backend_core.hpp, TwinKernels), two rows a wave.
#define LLMX_KROWS(name, KT, C, QT, G, L)                                                                                                               \
    extern "C" __global__ void __launch_bounds__(kThreads) name(RowCall c, const QT* q, const float* dx, unsigned long long nin, int ncols, int add) { \
        k_rows<KT, C, QT, 2, G, Cols, L>(c, q, dx, nin, ncols, add);                                                                                     \
    }
// Q6_K's int8 tiles keep one block an SM, since 128 registers spill the 64-output build on sm_90 and the tall one on sm_86.
template <typename KT> constexpr int tile8_blocks() { return 2; }
template <> constexpr int tile8_blocks<rq::Q6_K>() { return 1; }
template <> constexpr int tile8_blocks<rq::Q3_K>() { return 1; }
template <> constexpr int tile8_blocks<rq::Q2_K>() { return 1; }
template <> constexpr int tile8_blocks<rq::IQ2_XS>() { return 1; }
template <> constexpr int tile8_blocks<rq::IQ2_S>() { return 1; }
#define LLMX_KTILE(name, KT, QT, BOUNDS) \
    extern "C" __global__ void BOUNDS name(LLMX_GRID_CONST TileCall c, const QT* q, const float* dx) { k_tile<KT, QT>(c, q, dx); }
#define LLMX_KTILE_ROUTED(name, KT, QT, ROWS) \
    extern "C" __global__ void __launch_bounds__(kThreads) name(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const QT* q, const float* dx) { k_tile<KT, QT, true, ROWS>(c, q, dx, g); }
// A routed build runs a type's one-column body over an entry's expert and twin column, so each entry has the bits of its expert's one-column product.
#define LLMX_ROUTED(name, QT, ...)                                                                                                       \
    extern "C" __global__ void __launch_bounds__(kThreads) name(RoutedCall rc, const QT* q, const float* dx, unsigned long long nin) { \
        RowCall c;                                                                                                                       \
        unsigned long long col;                                                                                                          \
        if (!routed_entry(rc, c, col, blockIdx.y)) return;                                                                               \
        __VA_ARGS__(c, q + col * (nin / 32) * 32, dx + col * (nin / 32), nin, 1, 0);                                                     \
    }
LLMX_ROUTED(llmx_q8_0_routed16, short, q8_0_rows<1, short, 2, 1>)
LLMX_ROUTED(llmx_q8_0_routed16_walk2, short, q8_0_walk<2>)
LLMX_ROUTED(llmx_q8_0_routed16_walk3, short, q8_0_walk<3>)
LLMX_ROUTED(llmx_q8_0_routed16_walk5, short, q8_0_walk<5>)
// The routed down product and llmx_moe_combine's weighted sum in one launch (backend_core.hpp, matmul_experts_add): a block owns kWalkOut outputs of token row blockIdx.y, its wave j walking entry j's rows of its expert.
// Each sum keeps the walk's lanes and tree so each entry has its one-column product's bits, and kWalkOut lanes add the entries' sums in moe_combine's order (docs/src/backends-gpu.md, int8 twin).
constexpr unsigned kWalkEntries = 8, kWalkOut = 8;
template <int H, typename T, typename M>
__device__ void q8_0_walk_combine(const RoutedCall& rc, const T* q, const float* dx, unsigned long long nin, float* y, const float* weights, const float* y0, unsigned long long y0s, unsigned k,
                                  const M& m) {
    __shared__ float part[kWalkOut][kWalkEntries];
    const unsigned j = threadIdx.x / 64, o0 = blockIdx.x * kWalkOut;
    const unsigned long long first = rc.first + (unsigned long long)blockIdx.y * k, nout = rc.c.nout[0];
#if GPU_DOT4 && GPU_WAVE == 64
    const int lane = threadIdx.x % 64;
    const unsigned long long blocks = nin / 32, row_bytes = blocks * kQ8;
    const unsigned id = j < k ? rc.ids[first + j] : 0xffffffffu;
    // Row o0 + r of the expert, the last row standing in for rows past the matrix, which nothing stores.
    const unsigned char* w = (const unsigned char*)(const GPU_GLOBAL_SPACE unsigned char*)(rc.c.w[0] + (unsigned long long)(id < rc.n_expert ? id : 0) * rc.stride[0]);
    const auto row = [&](unsigned r) { return w + (o0 + r < nout ? o0 + r : nout - 1) * row_bytes; };
    if constexpr (sizeof(T) == 1) {
        if (id < rc.n_expert) {
            // A lane past the row reads the last block and adds 0, as q8_0_half_one's lanes without a block do; both lanes of a block clamp together, so the scale's exchange reads a live partner.
            const unsigned hl = lane & 1, bd = lane >> 1, bc = bd < blocks ? bd : (unsigned)blocks - 1;
            const unsigned long long col = (first + j) / rc.per;
            const int4 xq = *(const int4*)(q + (col * blocks + bc) * 32 + 16 * hl);
            const float xd = dx[col * blocks + bc];
            // Two rows stay in flight: a row's buffer takes the row two ahead right after its dots, before its sum (docs/DEVICE-TUNING.md).
            HalfWords b[2];
            b[0] = half_words((const unsigned*)row(0), bc, hl);
            b[1] = half_words((const unsigned*)row(1), bc, hl);
#pragma unroll
            for (unsigned r = 0; r < kWalkOut; ++r) {
                const float v = half_word_dot(b[r % 2], xq, xd, bc, hl);
                if (r + 2 < kWalkOut) b[r % 2] = half_words((const unsigned*)row(r + 2), bc, hl);
                const float s = wave_sum(bd < blocks ? v : 0.0f);
                if (lane == 0) part[r][j] = s;
            }
        }
    } else if (id < rc.n_expert) {
        const unsigned parts = (unsigned)(blocks * 4);
        WalkTwin<H> t;
        walk_twin<H>(t, q + (first + j) / rc.per * blocks * 32, dx + (first + j) / rc.per * blocks, lane, parts);
        // The next row's weights load before this row's dots: two rows of registers, which keep the waves a unit holds.
        WalkRow<H> b[2];
        walk_load<H>(b[0], row(0), lane, parts);
#pragma unroll
        for (unsigned r = 0; r < kWalkOut; ++r) {
            if (r + 1 < kWalkOut) walk_load<H>(b[(r + 1) % 2], row(r + 1), lane, parts);
            float acc[1] = {walk_dot<H>(b[r % 2], t, lane, parts)};
            int kk;
            const float s = wave_sums<1>(acc, lane, kk);
            if (lane == 0) part[r][j] = s;
        }
    }
#else
    // The host launches this build only where walk_passes holds, a 64-lane wave, which every such target llmx builds pairs with dot4.
    (void)j;
    (void)first;
#endif
    __syncthreads();
    if (threadIdx.x < kWalkOut && o0 + threadIdx.x < nout) {
        const unsigned t = threadIdx.x;
        float s = 0.0f;
        for (unsigned i = 0; i < k; ++i)
            if (rc.ids[first + i] != 0xffffffffu) {
                const float product = weights[first + i] * part[t][i];
                s = i == 0 ? product : s + product;
            }
        m.store(y + blockIdx.y * nout + o0 + t, y0[blockIdx.y * y0s + o0 + t] + s, 0, o0 + t);
    }
}

// The walk builds of a routed down that also adds its entries' weighted sum into y, kWalkEntries waves a block (q8_0_walk_combine).
#define LLMX_WALK_COMBINE(name, H, T)                                                                                                                                     \
    extern "C" __global__ void __launch_bounds__(64 * kWalkEntries) name(RoutedCall rc, const T* q, const float* dx, unsigned long long nin, float* y, const float* weights, \
                                                                          const float* y0, unsigned long long y0s, unsigned k) {                                          \
        q8_0_walk_combine<H>(rc, q, dx, nin, y, weights, y0, y0s, k, Cols{});                                                                                          \
    }
LLMX_WALK_COMBINE(llmx_q8_0_routed16_walk2_add, 2, short)
LLMX_WALK_COMBINE(llmx_q8_0_routed16_walk3_add, 3, short)
LLMX_WALK_COMBINE(llmx_q8_0_routed16_walk5_add, 5, short)
LLMX_WALK_COMBINE(llmx_q8_0_routed_half8_walk_add, 1, signed char)
// The same at one token row whose output is also a ring convolution's input with its input as residual, run in the store (ConvCols, backend_core.hpp conv_in_store).
#define LLMX_WALK_COMBINE_CONV(name, H, T)                                                                                                                                \
    extern "C" __global__ void __launch_bounds__(64 * kWalkEntries) name(RoutedCall rc, const T* q, const float* dx, unsigned long long nin, float* y, const float* weights, \
                                                                          const float* y0, unsigned long long y0s, unsigned k, ConvCols m) {                              \
        q8_0_walk_combine<H>(rc, q, dx, nin, y, weights, y0, y0s, k, m);                                                                                               \
    }
LLMX_WALK_COMBINE_CONV(llmx_q8_0_routed16_walk2_add_conv, 2, short)
LLMX_WALK_COMBINE_CONV(llmx_q8_0_routed16_walk3_add_conv, 3, short)
LLMX_WALK_COMBINE_CONV(llmx_q8_0_routed16_walk5_add_conv, 5, short)
LLMX_WALK_COMBINE_CONV(llmx_q8_0_routed_half8_walk_add_conv, 1, signed char)
// The routed gate and up products with their GLU and twin in one launch (backend_core.hpp, walk_glu): a block owns kGluOut GLU outputs of one entry, its wave w walking every kGluWaves-th row (docs/DEVICE-TUNING.md).
// Each sum keeps the walk's lanes and tree and the block's last wave out forms the GLU and twin as silu_mul does, so the outputs have the bits of the products and silu_mul; an entry without an expert writes nothing.
constexpr unsigned kGluOut = 32, kGluRows = 4, kGluWaves = kGluOut / kGluRows;
template <int H, typename T>
__device__ void q8_0_walk_glu(const RoutedCall& rc, const T* q, const float* dx, unsigned long long nin, float* act, T* aq, float* ad, void* as, float limit, int form, float up_limit) {
#if GPU_DOT4 && GPU_WAVE == 64
    __shared__ float sv[2][kGluOut];
    __shared__ unsigned done;
    if (threadIdx.x == 0) done = 0;
    __syncthreads();
    const unsigned long long e = rc.first + blockIdx.y;
    // Without ids (a dense call, backend_core.hpp glu_products) the entry is the one row of expert 0.
    const unsigned id = rc.ids ? rc.ids[e] : 0u;
    if (id >= rc.n_expert) return;
    const int lane = threadIdx.x % 64;
    // The wave in a scalar register, so each row address of its walk is too.
    const unsigned w = first_lane(threadIdx.x / 64);
    const unsigned long long ff = rc.c.nout[0], blocks = nin / 32, row_bytes = blocks * kQ8, col = e / rc.per;
    const auto row = [&](unsigned r) {
        const unsigned p = r / kGluRows, o = kGluWaves * (r % kGluRows) + w;
        return (const unsigned char*)(const GPU_GLOBAL_SPACE unsigned char*)(rc.c.w[p] + (unsigned long long)id * rc.stride[p] + (blockIdx.x * kGluOut + o) * row_bytes);
    };
    if constexpr (sizeof(T) == 1) {
        // A lane past the row reads the last block and adds nothing, both lanes of a block together, so the scale's exchange reads a live partner.
        const unsigned hl = lane & 1;
        int4 xq[H];
        float xd[H];
        unsigned bc[H];
#pragma unroll
        for (int s = 0; s < H; ++s) {
            const unsigned bd = (lane >> 1) + 32 * s;
            bc[s] = bd < blocks ? bd : (unsigned)blocks - 1;
            xq[s] = *(const int4*)(q + (col * blocks + bc[s]) * 32 + 16 * hl);
            xd[s] = dx[col * blocks + bc[s]];
        }
        HalfWords b[2][H];
        const auto load = [&](HalfWords(&h)[H], unsigned r) {
#pragma unroll
            for (int s = 0; s < H; ++s) h[s] = half_words((const unsigned*)row(r), bc[s], hl);
        };
        load(b[0], 0);
#pragma unroll
        for (unsigned r = 0; r < 2 * kGluRows; ++r) {
            if (r + 1 < 2 * kGluRows) load(b[(r + 1) % 2], r + 1);
            float acc = 0.0f;
#pragma unroll
            for (int s = 0; s < H; ++s)
                if ((lane >> 1) + 32u * s < blocks) acc = half_word_dot(b[r % 2][s], xq[s], xd[s], bc[s], hl, acc);
            const float sum = wave_sum(acc);
            if (lane == 0) sv[r / kGluRows][kGluWaves * (r % kGluRows) + w] = sum;
        }
    } else {
        const unsigned parts = (unsigned)(blocks * 4);
        WalkTwin<H> t;
        walk_twin<H>(t, q + col * blocks * 32, dx + col * blocks, lane, parts);
#pragma unroll 1
        for (unsigned r = 0; r < 2 * kGluRows; ++r) {
            WalkRow<H> b;
            walk_load<H>(b, row(r), lane, parts);
            schedule_barrier();
            float acc[1] = {walk_dot<H>(b, t, lane, parts)};
            int k;
            const float s = wave_sums<1>(acc, lane, k);
            if (lane == 0) sv[r / kGluRows][kGluWaves * (r % kGluRows) + w] = s;
        }
    }
    unsigned old = 0;
    if (lane == 0) old = atomic_add_acq_rel_block(&done, 1u);
    if (first_lane(old) != kGluWaves - 1) return;
    // Both halves of the wave form the same 32 values, so block_amax's 32-lane tree holds; the first half stores.
    const unsigned i = lane % kGluOut;
    const float v = glu_value(sv[0][i], sv[1][i], limit, form, up_limit);
    const float amax = block_amax(v);
    const unsigned long long at = e * ff + blockIdx.x * kGluOut + i;
    if (lane < (int)kGluOut) {
        act[at] = v;
        twin_sums<T, 32>(twin_value<T, sizeof(T) == 1 ? 127 : 32767>(v, amax, aq + at, ad + at / 32, (int)i), (int)i, as, at / 32);
    }
#else
    // The host launches this build only where walk_passes holds, as for q8_0_walk_combine.
    (void)rc, (void)q, (void)dx, (void)nin, (void)act, (void)aq, (void)ad, (void)as, (void)limit, (void)form, (void)up_limit;
#endif
}
#define LLMX_WALK_GLU(name, H, T, WB)                                                                                                                                \
    extern "C" __global__ void LLMX_WAVES_BOUNDS(64 * kGluWaves, WB) name(RoutedCall rc, const T* q, const float* dx, unsigned long long nin, float* act, T* aq, float* ad, \
                                                                       void* as, float limit, int form, float up_limit) {                                           \
        q8_0_walk_glu<H>(rc, q, dx, nin, act, aq, ad, as, limit, form, up_limit);                                                                                   \
    }
LLMX_WALK_GLU(llmx_q8_0_routed16_walk3_glu, 3, short, 4)
LLMX_WALK_GLU(llmx_q8_0_routed16_walk5_glu, 5, short, 4)
// The int8 build holds three waves a SIMD: with the rows interleaved that streams faster than four (docs/DEVICE-TUNING.md).
LLMX_WALK_GLU(llmx_q8_0_routed_half8_walk3_glu, 3, signed char, 3)
LLMX_ROUTED(llmx_q8_0_routed8, signed char, q8_0_rows<1, signed char, 2, 1>)
extern "C" __global__ void __launch_bounds__(kThreads) llmx_q8_0_routed_half8(RoutedCall rc, const signed char* q, const float* dx, unsigned long long nin) {
    RowCall c;
    unsigned long long col;
    if (!routed_entry(rc, c, col, blockIdx.y)) return;
    q8_0_half_one<1, kSteps>(c, q + col * (nin / 32) * 32, dx + col * (nin / 32), nin, 0);
}
extern "C" __global__ void __launch_bounds__(kThreads) llmx_q8_0_routed_half8s1(RoutedCall rc, const signed char* q, const float* dx, unsigned long long nin) {
    RowCall c;
    unsigned long long col;
    if (!routed_entry(rc, c, col, blockIdx.y)) return;
    q8_0_half_one<1, kNarrowSteps>(c, q + col * (nin / 32) * 32, dx + col * (nin / 32), nin, 0);
}
// A grouped build runs a row build of C columns over one expert's entries (EntryCols), a column an entry, so each entry has the bits of its one-column product and the expert's rows are read once a group.
#define LLMX_GROUPED(name, QT, C, ...)                                                                                                                                                 \
    extern "C" __global__ void __launch_bounds__(kThreads) name(RoutedCall rc, const unsigned* tab, unsigned long long order0, const QT* q, const float* dx, unsigned long long nin) { \
        RowCall c;                                                                                                                                                                     \
        const unsigned* e;                                                                                                                                                             \
        const int n = group_entries(rc, tab, order0, c, e);                                                                                                                            \
        if (!n) return;                                                                                                                                                                \
        const EntryCols<C> m(e, n, rc.per);                                                                                                                                            \
        __VA_ARGS__(c, q, dx, nin, n, 0, m);                                                                                                                                           \
    }
LLMX_GROUPED(llmx_q8_0_routed16_g2, short, 2, q8_0_rows<2, short, 2, 2, EntryCols<2>>)
LLMX_GROUPED(llmx_q8_0_routed16_g4, short, 4, q8_0_rows<4, short, 2, 4, EntryCols<4>>)
LLMX_GROUPED(llmx_q8_0_routed16_g8, short, 8, q8_0_rows<8, short, 2, 4, EntryCols<8>>)
LLMX_GROUPED(llmx_q8_0_routed8_g2, signed char, 2, q8_0_rows<2, signed char, 2, 2, EntryCols<2>>)
LLMX_GROUPED(llmx_q8_0_routed8_g4, signed char, 4, q8_0_rows<4, signed char, 2, 4, EntryCols<4>>)
LLMX_GROUPED(llmx_q8_0_routed8_g8, signed char, 8, q8_0_rows<8, signed char, 2, 4, EntryCols<8>>)
LLMX_GROUPED(llmx_q8_0_routed_half8_g2, signed char, 2, q8_0_rows_half<2, 2, 2, EntryCols<2>>)
LLMX_GROUPED(llmx_q8_0_routed_half8_g4, signed char, 4, q8_0_rows_half<4, 2, 4, EntryCols<4>>)
LLMX_GROUPED(llmx_q8_0_routed_half8_g8, signed char, 8, q8_0_rows_half<8, 2, 4, EntryCols<8>>)
#define LLMX_KTYPE(t, KT, form)                            \
    LLMX_KROWS(llmx_##t##_rows16_1, KT, 1, short, 1, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_2, KT, 2, short, 2, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_4, KT, 4, short, 4, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_8, KT, 8, short, 4, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_16, KT, 16, short, 4, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows8_1, KT, 1, signed char, 1, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows8_2, KT, 2, signed char, 2, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows8_4, KT, 4, signed char, 4, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows8_8, KT, 8, signed char, 4, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows8_16, KT, 16, signed char, 4, KRaw<KT>::Lane) \
    LLMX_KTILE(llmx_##t##_tile16, KT, short, __launch_bounds__(kThreads)) \
    LLMX_KTILE(llmx_##t##_tile8, KT, signed char, LLMX_TILE8_BOUNDS(tile8_blocks<KT>())) \
    LLMX_ROUTED(llmx_##t##_routed16, short, k_rows<KT, 1, short, 2, 1>) \
    LLMX_ROUTED(llmx_##t##_routed8, signed char, k_rows<KT, 1, signed char, 2, 1>)                      \
    LLMX_GROUPED(llmx_##t##_routed16_g2, short, 2, k_rows<KT, 2, short, 2, 2, EntryCols<2>>)            \
    LLMX_GROUPED(llmx_##t##_routed16_g4, short, 4, k_rows<KT, 4, short, 2, 4, EntryCols<4>>)            \
    LLMX_GROUPED(llmx_##t##_routed16_g8, short, 8, k_rows<KT, 8, short, 2, G8Step<KT>::n, EntryCols<8>>)            \
    LLMX_GROUPED(llmx_##t##_routed8_g2, signed char, 2, k_rows<KT, 2, signed char, 2, 2, EntryCols<2>>) \
    LLMX_GROUPED(llmx_##t##_routed8_g4, signed char, 4, k_rows<KT, 4, signed char, 2, 4, EntryCols<4>>) \
    LLMX_GROUPED(llmx_##t##_routed8_g8, signed char, 8, k_rows<KT, 8, signed char, 2, G8Step<KT>::n, EntryCols<8>>) \
    LLMX_KTILE_ROUTED(llmx_##t##_routed_tile16, KT, short, kTileRows)                                  \
    LLMX_KTILE_ROUTED(llmx_##t##_routed_tile8, KT, signed char, kTileRows)                             \
    LLMX_KTILE_ROUTED(llmx_##t##_routed_narrow16, KT, short, kNarrowRows)                              \
    LLMX_NARROW8(t, KT)                                                                                \
    LLMX_STREAM(llmx_##t##_routed_stream8, KT)                                                         \
    LLMX_KTILE_ROUTED(llmx_##t##_routed_mid16, KT, short, kMidRows)                                    \
    LLMX_MID8_##form(t, KT)
// A type's 8-bit groups of 9 to 16 entries in the stream at 16 rows, and of 17 to 32 in the mid tile, or, for MXFP4 (form streams), in the stream at 32 rows.
// The narrow tiles ran a layer's routed products 3 to 13 percent slower at 256 rows on every type, and the mid tile only MXFP4's (docs/STATUS.md, Routed prompt streams by type).
#define LLMX_MID8_tiles(t, KT) LLMX_KTILE_ROUTED(llmx_##t##_routed_mid8, KT, signed char, kMidRows)
#define LLMX_NARROW8(t, KT) \
    extern "C" __global__ void __launch_bounds__(kStreamLanes) llmx_##t##_routed_stream16_8(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const signed char* q, const float* dx) { routed_stream<KT, kStreamRows, kNarrowRows>(c, g, q, dx); }
#define LLMX_MID8_streams(t, KT) \
    extern "C" __global__ void __launch_bounds__(kStreamLanes) llmx_##t##_routed_stream32_8(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const signed char* q, const float* dx) { routed_stream<KT, kNarrowRows, kMidRows>(c, g, q, dx); }
