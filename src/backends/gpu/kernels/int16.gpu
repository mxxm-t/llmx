// IQ3_XXS: a 98-byte block, 2-byte aligned, its scale, the lane's two grid bytes and the sub-block's sign and scale word as 16-bit loads; each four values a grid word under parity-completed signs.
template <> struct KRaw<rq::IQ3_XXS> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::IQ3_XXS>;
    unsigned short d, qs;
    unsigned word;
    __device__ void load(const unsigned char* b, unsigned sub, unsigned part) {
        const unsigned short* w = (const unsigned short*)(b + 66 + 4 * sub);
        d = *(const unsigned short*)b;
