// Q1_0: an 18-byte block of 128 values, 2-byte aligned, its scale and the lane's byte of sign bits, each value plus or minus one under the scale.
template <> struct KRaw<rq::Q1_0> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::Q1_0>;
    unsigned short d;
    unsigned char bits;
