// IQ2_XS: a 74-byte block, 2-byte aligned, its scale, the lane's 16-bit word of a 9-bit grid index and a 7-bit sign code, and the sub-block's scale byte, whose nibble changes every 16 values, so the tile takes two halves.
template <> struct KRaw<rq::IQ2_XS> {
    static constexpr int offset = 0, halves = 2;
    using Lane = QuarterLane<rq::IQ2_XS>;
    unsigned short d, word;
    unsigned char sc;
