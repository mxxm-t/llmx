// Four values' signs, bits 0 to 3 of s, as a byte mask a value, and four positive bytes under it negated: no byte of a grid is zero, so no negation carries.
__device__ inline unsigned sign_bytes(unsigned s) { return ((s & 1u) | ((s & 2u) << 7) | ((s & 4u) << 14) | ((s & 8u) << 21)) * 0xffu; }
__device__ inline unsigned signed_bytes(unsigned x, unsigned s) {
    const unsigned m = sign_bytes(s);
    return (x ^ m) + (m & 0x01010101u);
}
// IQ2_XXS: a 66-byte block, 2-byte aligned, its scale and the sub-block's four grid bytes and sign and scale word as 16-bit loads; the lane's eight values are grid entry part's bytes under its parity-completed signs.
template <> struct KRaw<rq::IQ2_XXS> {
    static constexpr int offset = 0, halves = 1;
    using Lane = QuarterLane<rq::IQ2_XXS>;
