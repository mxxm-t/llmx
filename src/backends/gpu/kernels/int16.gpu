// The routed prompt stream of a type's 8-bit twin, the groups of up to kStreamRows entries (routed_stream).
#define LLMX_STREAM(name, KT) \
    extern "C" __global__ void __launch_bounds__(kStreamLanes) name(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const signed char* q, const float* dx) { routed_stream<KT>(c, g, q, dx); }
