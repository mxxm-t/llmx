        const unsigned long long g = GPU_TABLE(quant::IQ2_XS_GRID)[word & 511u];
        const unsigned s = rq::parity_signs((unsigned)word >> 9);
        v[0] = signed_bytes((unsigned)g, s & 15u);
        v[1] = signed_bytes((unsigned)(g >> 32), s >> 4);
        ds = __half2float(__ushort_as_half(d)) * (0.5f + (float)((sc >> (4 * (part >> 1))) & 15u)) * 0.25f;
        dmin = 0.0f;
    }
