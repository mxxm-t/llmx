// IQ3_S: a 110-byte block, 2-byte aligned, its scale, the lane's two grid index bytes, their high bits, its sign byte and the sub-block's scale nibble; each four values a grid word under the odd multiplier.
template <> struct KRaw<rq::IQ3_S> {
