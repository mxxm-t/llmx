#define LLMX_KTYPE(t, KT)                                   \
    LLMX_KROWS(llmx_##t##_rows16_1, KT, 1, short, 1, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_2, KT, 2, short, 2, KRaw<KT>::Lane) \
    LLMX_KROWS(llmx_##t##_rows16_4, KT, 4, short, 4, KRaw<KT>::Lane) \
