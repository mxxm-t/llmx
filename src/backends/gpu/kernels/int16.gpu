        word = w[2] | ((unsigned)w[3] << 16);
    }
    __device__ void decode(unsigned, unsigned part, unsigned (&v)[2], float& ds, float& dmin) const {
        const unsigned long long g = GPU_TABLE(quant::IQ2_XXS_GRID)[idx];
        const unsigned s = rq::parity_signs((word >> (7 * part)) & 127u);
