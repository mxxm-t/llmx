// The routed prompt tiles: the 64-output tile over a group a block row (TileGroups), 64 rows a group or, narrow, 16; the 16-bit twin's narrow groups take the thin build.
// The 8-bit 64-row build is held to 3 waves a SIMD, which its shared memory allows and its whole-block staging needs to hide the shared reads (docs/DEVICE-TUNING.md).
extern "C" __global__ void __launch_bounds__(kThreads) llmx_q8_0_routed_tile16(LLMX_GRID_CONST TileCall c, LLMX_GRID_CONST TileGroups g, const short* q, const float* dx) { q8_0_tile<short, 4, true>(c, q, dx, g); }
