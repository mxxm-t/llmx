#version 450
// dst row r += bias over rows of `width` floats: dst[i] += bias[i % width], the dispatch's invocations striding over the n elements.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint width; } p;
layout(set = 0, binding = 0) buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer B { float bias[]; };
void main() {
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += gl_NumWorkGroups.x * 256u) dst[i] += bias[i % p.width];
}
