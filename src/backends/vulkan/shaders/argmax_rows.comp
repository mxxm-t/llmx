#version 450
// The id of each row's largest logit, ties to the lowest id, as a 32-bit integer; n where the largest is not finite or a logit is NaN, and n where the row's prior id is n or more (backend.hpp, argmax_rows).
// Mode 0 reduces a row in one workgroup; mode 1 reduces each slice of a row's ids to a partial (value, id, NaN seen), a workgroup a slice, and mode 2 a row's partials, in slice order by the same comparison, to its id.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint has_after; uint mode; uint slices; uint slice; } p;
layout(set = 0, binding = 0) writeonly buffer O { uint ids[]; };
layout(set = 0, binding = 1) readonly buffer L { float logits[]; };
layout(set = 0, binding = 2) readonly buffer A { uint after[]; };
layout(set = 0, binding = 3) buffer S { uint parts[]; };
const uint NONE = 0xffffffffu;
shared float best_v[256];
shared uint best_i[256];
shared uint nans[256];
void main() {
    uint lid = gl_LocalInvocationID.x;
    uint r = p.mode == 1u ? gl_WorkGroupID.y : gl_WorkGroupID.x, s = gl_WorkGroupID.x;
    uint base = r * p.n;
    // What the workgroup reduces: a row's ids, one slice of them, or the row's partials.
    uint first = p.mode == 1u ? s * p.slice : 0u;
    uint end = p.mode == 1u ? min(p.n, first + p.slice) : p.mode == 2u ? p.slices : p.n;
    float bv = 0.0;
    uint bi = NONE, nan = 0u;
    // Ascending ids and a strict comparison keep each lane's first largest.
    for (uint i = first + lid; i < end; i += 256u) {
        float v;
        uint id = i;
        if (p.mode == 2u) {
            uint at = (r * p.slices + i) * 3u;
            nan |= parts[at + 2u];
            id = parts[at + 1u];
            if (id == NONE) continue;
            v = uintBitsToFloat(parts[at]);
        } else {
            v = logits[base + i];
            if (isnan(v)) { nan = 1u; continue; }
        }
        if (bi == NONE || v > bv) { bv = v; bi = id; }
    }
    best_v[lid] = bv;
    best_i[lid] = bi;
    nans[lid] = nan;
    barrier();
    for (uint h = 128u; h > 0u; h >>= 1) {
        if (lid < h) {
            uint oi = best_i[lid + h], mi = best_i[lid];
            float ov = best_v[lid + h];
            if (oi != NONE && (mi == NONE || ov > best_v[lid] || (ov == best_v[lid] && oi < mi))) {
                best_v[lid] = ov;
                best_i[lid] = oi;
            }
            nans[lid] |= nans[lid + h];
        }
        barrier();
    }
    if (lid != 0u) return;
    if (p.mode == 1u) {
        uint at = (r * p.slices + s) * 3u;
        parts[at] = floatBitsToUint(best_v[0]);
        parts[at + 1u] = best_i[0];
        parts[at + 2u] = nans[0];
        return;
    }
    uint id = best_i[0];
    if (nans[0] != 0u || id == NONE || isinf(best_v[0]) || (p.has_after != 0u && after[r] >= p.n)) id = p.n;
    ids[r] = id;
}
