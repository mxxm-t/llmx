#version 450
// Merge the split attention states of one (row, head): the maximum and sum across splits, then the accumulation rescaled to them; a split with no tokens carries -inf and zero.
// The sums run in split order, as one lane reading every split would take them, and the row is found through the view table; with `quant` set the output's 16-bit twin is written beside it.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 256) in;
// `xrows` is the rows of the whole call, whose twin this dispatch's rows are written into.
layout(push_constant) uniform P { uint rows; uint n_head; uint dim; uint nsplit; uint quant; uint xrows; uint major; } p;
layout(set = 0, binding = 0) writeonly buffer O { float o[]; };
layout(set = 0, binding = 1) readonly buffer S { float scratch[]; };
layout(set = 0, binding = 2) readonly buffer T { uint tab[]; };
layout(set = 0, binding = 3) writeonly buffer XQ { uint xq[]; };
#include "views.glsl"
#include "xquant.glsl"
// A chunk of splits' weights and sums, a lane taking splits lid, lid + 256 and so on, and each subgroup's largest maximum.
// Splits past one chunk are weighed chunk after chunk, so any number merges and the sums keep split order.
const uint CHUNK = 1024u;
shared float sw[CHUNK];
shared float sl[CHUNK];
shared float sg[256];
void main() {
    uint rh = gl_WorkGroupID.x;
    uint g = rh / p.n_head;
    uint h = rh - g * p.n_head;
    uint lid = gl_LocalInvocationID.x;
    uint v, b;
    view_of_row(g, v, b);
    uint stride = p.dim + 2u;
    uint base = rh * p.nsplit * stride;
    float m = -1.0 / 0.0;
    for (uint i = lid; i < p.nsplit; i += 256u) m = max(m, scratch[base + i * stride]);
    // The maximum is exact in any order: across each subgroup, then across the subgroups.
    for (uint o = gl_SubgroupSize / 2u; o > 0u; o /= 2u) m = max(m, subgroupShuffleXor(m, o));
    if (gl_SubgroupInvocationID == 0u) sg[gl_SubgroupID] = m;
    barrier();
    float M = sg[0];
    for (uint i = 1u; i < gl_NumSubgroups; ++i) M = max(M, sg[i]);
    float L = 0.0, A = 0.0;
    for (uint c0 = 0u; c0 < p.nsplit; c0 += CHUNK) {
        uint cn = min(CHUNK, p.nsplit - c0);
        // The last chunk's weights are read by every lane before they are replaced.
        barrier();
        // A split with no tokens weighs nothing; exp(-inf - -inf) must never be formed.
        for (uint i = lid; i < cn; i += 256u) {
            float mi = scratch[base + (c0 + i) * stride];
            sw[i] = isinf(mi) ? 0.0 : exp(mi - M);
            sl[i] = scratch[base + (c0 + i) * stride + 1u];
        }
        barrier();
        if (lid < p.dim) {
            // Eight splits' values are loaded before any is summed, so their reads overlap.
            for (uint i0 = 0u; i0 < cn; i0 += 8u) {
                float a[8];
                [[unroll]] for (uint k = 0u; k < 8u; ++k) a[k] = scratch[base + (c0 + min(i0 + k, cn - 1u)) * stride + 2u + lid];
                [[unroll]] for (uint k = 0u; k < 8u; ++k) {
                    uint i = i0 + k;
                    if (i >= cn) break;
                    float c = sw[i];
                    if (c == 0.0) continue;
                    L += sl[i] * c;
                    A += a[k] * c;
                }
            }
        }
    }
    if (lid >= p.dim) return;
    uint i = (view_row0(v) + b) * p.n_head * p.dim + h * p.dim + lid;
    float r = A / L;
    o[i] = r;
    if (p.quant != 0u) xquant_block(i, r, p.xrows * p.n_head * p.dim, p.major);
}
