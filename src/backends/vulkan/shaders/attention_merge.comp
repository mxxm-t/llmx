#version 450
// Merge the split states of attention for one (row, head): the softmax's
// maximum and sum across splits, then the accumulation rescaled to it. A
// split with no tokens carries -inf and zero and contributes nothing.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint nq; uint n_head; uint dim; uint row0; uint nsplit; } p;
layout(set = 0, binding = 0) writeonly buffer O { float o[]; };
layout(set = 0, binding = 1) readonly buffer S { float scratch[]; };
void main() {
    uint rh = gl_WorkGroupID.x;
    uint b = rh / p.n_head;
    uint h = rh - b * p.n_head;
    uint lid = gl_LocalInvocationID.x;
    if (lid >= p.dim) return;
    uint stride = p.dim + 2u;
    uint base = rh * p.nsplit * stride;
    float M = scratch[base];
    for (uint i = 1u; i < p.nsplit; ++i) M = max(M, scratch[base + i * stride]);
    float L = 0.0, A = 0.0;
    for (uint i = 0u; i < p.nsplit; ++i) {
        float c = exp(scratch[base + i * stride] - M);
        L += scratch[base + i * stride + 1u] * c;
        A += scratch[base + i * stride + 2u + lid] * c;
    }
    o[(p.row0 + b) * p.n_head * p.dim + h * p.dim + lid] = A / L;
}
