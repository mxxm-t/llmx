#version 450
// Causal GQA for a wide pass over every view of a batch: one workgroup per (tile of 32 query rows of one view, head), the head's K and V streamed through shared memory in tiles of TK tokens.
// Row b of a view attends through its hist + b; the head width is fixed at 128 (256 in the LLMX_D256 build, whose 8-token tiles fit 16 KiB of shared memory), and TK, where the online softmax rescales, is a constant of it, never of the batch.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint n_head; uint n_head_kv; uint bt; float scale; uint quant; uint rows; uint major;
#ifdef LLMX_FULL
    uint wg0;
#endif
} p;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };
// K and V read eight values per load: 16-bit halves in a uvec4, or two vec4 of floats.
#ifdef LLMX_K16
layout(set = 0, binding = 2) readonly buffer K { uvec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = kb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 2) readonly buffer K { vec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) { a = kb[i / 4u]; b = kb[i / 4u + 1u]; }
#endif
#ifdef LLMX_V16
layout(set = 0, binding = 3) readonly buffer V { uvec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = vb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 3) readonly buffer V { vec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) { a = vb[i / 4u]; b = vb[i / 4u + 1u]; }
#endif
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
// With `quant` set every view of the batch is here and the batch's `rows` rows are read next by the integer-dot tile, and the output's 16-bit twin is written here (xquant_word).
layout(set = 0, binding = 5) writeonly buffer XQ { uint xq[]; };
#include "views.glsl"
#include "xquant.glsl"
#if defined(LLMX_D256)
const uint DIM = 256u, TK = 8u;
#elif defined(LLMX_D64)
const uint DIM = 64u, TK = 16u;
#elif defined(LLMX_D72)
const uint DIM = 72u, TK = 16u;
#else
const uint DIM = 128u, TK = 16u;
#endif
// The head's width in the rows and the cache.
const uint WIDTH = DIM;
// LLMX_FULL is the non-causal build, every row attending its view's whole hist + nq, at a vision encoder's heads 64 or 72 wide (docs/VISION.md, section 10).
// The full builds give each group of eight lanes two rows, rows r and r + 32 of the tile, so every staged key and value read from shared memory serves both; each row's arithmetic is the one-row build's.
#ifdef LLMX_FULL
const uint RPG = 2u;
#else
const uint RPG = 1u;
#endif
const uint TQ = 32u * RPG, LANES = 8u, OWN = TK / LANES, RUNS = DIM / 32u;
// Heads 72 wide take two runs of 32 as vec4s and their last eight dimensions one a lane, lane l holding dimension 64 + l.
#ifdef LLMX_D72
#define TAIL
#endif
shared vec4 ks[TK * DIM / 4u];
shared vec4 vs[TK * DIM / 4u];
shared float ps[TQ * TK];

void main() {
#ifdef LLMX_FULL
    // A long non-causal view is cut into dispatches of bounded work, each starting at workgroup wg0 of the whole call.
    uint wg = gl_WorkGroupID.x + p.wg0;
#else
    uint wg = gl_WorkGroupID.x;
#endif
    uint n = view_count();
    uint v = 0u, first = 0u;
    for (uint i = 0u; i < n; ++i) {
        uint tiles = (view_nq(i) + TQ - 1u) / TQ;
        if (wg < first + tiles * p.n_head) { v = i; break; }
        first += tiles * p.n_head;
    }
    uint local = wg - first;
    uint tile = local / p.n_head;
    uint h = local - tile * p.n_head;
    uint nq = view_nq(v), hist = view_hist(v), row0 = view_row0(v);
    uint kvh = h / (p.n_head / p.n_head_kv);
    uint lid = gl_LocalInvocationID.x;
    uint r = lid >> 3u, lane = lid & 7u;             // the lane group's first row in the tile, lane within it
    uint qstride = p.n_head * WIDTH;
    uint b[RPG], qbase[RPG];
    bool live[RPG];
    vec4 qv[RPG][RUNS], acc[RPG][RUNS];
    float m[RPG], l[RPG];
#ifdef TAIL
    float qt[RPG], at[RPG];
#endif
    for (uint s = 0u; s < RPG; ++s) {
        b[s] = tile * TQ + r + 32u * s;              // row of the view
        live[s] = b[s] < nq;
        qbase[s] = (row0 + min(b[s], nq - 1u)) * qstride + h * WIDTH;
        for (uint k = 0u; k < RUNS; ++k) {
            uint d = 32u * k + 4u * lane;
            qv[s][k] = d < WIDTH ? vec4(q[qbase[s] + d], q[qbase[s] + d + 1u], q[qbase[s] + d + 2u], q[qbase[s] + d + 3u]) * p.scale : vec4(0.0);
            acc[s][k] = vec4(0.0);
        }
        m[s] = -1.0 / 0.0;
        l[s] = 0.0;
#ifdef TAIL
        qt[s] = q[qbase[s] + 64u + lane] * p.scale;
        at[s] = 0.0;
#endif
    }
    // The last token any row of this tile attends, exclusive.
#ifdef LLMX_FULL
    uint tile_end = hist + nq;
#else
    uint tile_end = min(hist + tile * TQ + TQ, hist + nq);
#endif
    uint bf = p.n_head_kv * p.bt * WIDTH;
    for (uint t0 = 0u; t0 < tile_end; t0 += TK) {
        // Stage the tile eight values a load, zero past the tile's last token so a masked score meets a finite value.
        for (uint i = lid; i < TK * DIM / 8u; i += 256u) {
            uint j = i / (DIM / 8u), d = (i - j * (DIM / 8u)) * 8u;
            uint t = t0 + j;
            vec4 k0 = vec4(0.0), k1 = vec4(0.0), v0 = vec4(0.0), v1 = vec4(0.0);
            if (t < tile_end && d < WIDTH) {
                uint base = view_block(v, t / p.bt) * bf + (kvh * p.bt + t - (t / p.bt) * p.bt) * WIDTH + d;
                k_load8(base, k0, k1);
                v_load8(base, v0, v1);
            }
            uint s = (j * DIM + d) / 4u;
            ks[s] = k0; ks[s + 1u] = k1;
            vs[s] = v0; vs[s + 1u] = v1;
        }
        barrier();
        // Phase one: partial dots eight tokens at a time, then the butterfly, which leaves token 8g + l's score in lane l.
        float sc[RPG][OWN];
        float mt[RPG];
        for (uint s = 0u; s < RPG; ++s) mt[s] = -1.0 / 0.0;
        for (uint g = 0u; g < OWN; ++g) {
            float part[RPG][8];
            for (uint j = 0u; j < 8u; ++j) {
                for (uint s = 0u; s < RPG; ++s) part[s][j] = 0.0;
                for (uint k = 0u; k < RUNS; ++k) {
                    vec4 kv = ks[(8u * g + j) * (DIM / 4u) + 8u * k + lane];
                    for (uint s = 0u; s < RPG; ++s) part[s][j] += dot(qv[s][k], kv);
                }
#ifdef TAIL
                float kt = ks[(8u * g + j) * (DIM / 4u) + 16u + lane / 4u][lane & 3u];
                for (uint s = 0u; s < RPG; ++s) part[s][j] += qt[s] * kt;
#endif
            }
            for (uint s = 0u; s < RPG; ++s) {
                for (uint half_ = 4u; half_ >= 1u; half_ /= 2u) {
                    bool upper = (lane & half_) != 0u;
                    for (uint j = 0u; j < half_; ++j) {
                        float lo = part[s][j], hi = part[s][j + half_];
                        part[s][j] = (upper ? hi : lo) + subgroupShuffleXor(upper ? lo : hi, half_);
                    }
                }
#ifdef LLMX_FULL
                uint my_end = hist + nq;
#else
                uint my_end = hist + b[s] + 1u;
#endif
                sc[s][g] = t0 + 8u * g + lane < my_end ? part[s][0] : -1.0 / 0.0;
                mt[s] = max(mt[s], sc[s][g]);
            }
        }
        for (uint s = 0u; s < RPG; ++s) {
            mt[s] = max(mt[s], subgroupShuffleXor(mt[s], 1u));
            mt[s] = max(mt[s], subgroupShuffleXor(mt[s], 2u));
            mt[s] = max(mt[s], subgroupShuffleXor(mt[s], 4u));
            float mn = max(m[s], mt[s]);
            // A row with nothing unmasked yet keeps m at -inf; its weights are zero rather than the NaN of inf - inf.
            float corr = mn == -1.0 / 0.0 ? 1.0 : exp(m[s] - mn);
            float sum = 0.0;
            for (uint g = 0u; g < OWN; ++g) {
                float w = sc[s][g] == -1.0 / 0.0 ? 0.0 : exp(sc[s][g] - mn);
                ps[(r + 32u * s) * TK + 8u * g + lane] = w;
                sum += w;
            }
            sum += subgroupShuffleXor(sum, 1u);
            sum += subgroupShuffleXor(sum, 2u);
            sum += subgroupShuffleXor(sum, 4u);
            l[s] = l[s] * corr + sum;
            m[s] = mn;
            for (uint k = 0u; k < RUNS; ++k) acc[s][k] *= corr;
#ifdef TAIL
            at[s] *= corr;
#endif
        }
        // A row's eight lanes are one subgroup, so their probabilities are visible to each other past this point.
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        // Phase two: the weighted sum of the tile's values.
        for (uint j = 0u; j < TK; ++j) {
            float w[RPG];
            for (uint s = 0u; s < RPG; ++s) w[s] = ps[(r + 32u * s) * TK + j];
            for (uint k = 0u; k < RUNS; ++k) {
                vec4 vv = vs[j * (DIM / 4u) + 8u * k + lane];
                for (uint s = 0u; s < RPG; ++s) acc[s][k] += w[s] * vv;
            }
#ifdef TAIL
            float vt = vs[j * (DIM / 4u) + 16u + lane / 4u][lane & 3u];
            for (uint s = 0u; s < RPG; ++s) at[s] += w[s] * vt;
#endif
        }
        barrier();
    }
#ifdef TAIL
    for (uint s = 0u; s < RPG; ++s)
        if (live[s]) o[qbase[s] + 64u + lane] = at[s] / l[s];
#endif
    for (uint s = 0u; s < RPG; ++s)
        for (uint k = 0u; k < RUNS; ++k) {
            uint d = 32u * k + 4u * lane;
            vec4 a = acc[s][k] / l[s];
            if (live[s] && d < WIDTH) { o[qbase[s] + d] = a.x; o[qbase[s] + d + 1u] = a.y; o[qbase[s] + d + 2u] = a.z; o[qbase[s] + d + 3u] = a.w; }
            // Dimensions 32k .. 32k + 31 of head h are block RUNS h + k of the row, held by its eight lanes in order.
            if (p.quant != 0u) xquant_word(live[s] ? a : vec4(0.0), live[s], lane, (row0 + b[s]) * (qstride / 32u) + RUNS * h + k, p.rows * qstride, p.major);
        }
}
