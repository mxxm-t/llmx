#version 450
// Causal GQA for a wide pass over every view of a batch: one workgroup per (two tiles of 32 query rows of one view, head), one tile in the LLMX_D256 build, the head's K and V streamed through shared memory in tiles of TK tokens.
// Row b of a view attends through its hist + b; the head width is fixed at 128 (256 in the LLMX_D256 build, whose 8-token tiles fit 16 KiB of shared memory), and TK, where the online softmax rescales, is a constant of it, never of the batch.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint n_head; uint n_head_kv; uint bt; float scale; uint quant; uint rows; uint major;
} p;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };
// K and V read eight values per load: 16-bit halves in a uvec4, or two vec4 of floats.
#ifdef LLMX_K16
layout(set = 0, binding = 2) readonly buffer K { uvec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = kb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 2) readonly buffer K { vec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) { a = kb[i / 4u]; b = kb[i / 4u + 1u]; }
#endif
#ifdef LLMX_V16
layout(set = 0, binding = 3) readonly buffer V { uvec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = vb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 3) readonly buffer V { vec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) { a = vb[i / 4u]; b = vb[i / 4u + 1u]; }
#endif
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
// With `quant` set every view of the batch is here and the batch's `rows` rows are read next by the integer-dot tile, and the output's 16-bit twin is written here (xquant_word).
layout(set = 0, binding = 5) writeonly buffer XQ { uint xq[]; };
#include "views.glsl"
#include "xquant.glsl"
// The 128-wide build gives each lane two query rows of one 32-row tile, so a workgroup covers two tiles and every K and V value read from shared memory serves both rows.
// Each row takes the operations of a lane of its own in the same order and stops at its own tile's last token, so its bits do not depend on the pairing.
#ifdef LLMX_D256
const uint DIM = 256u, TK = 8u, WG_ROWS = 32u;
#else
const uint DIM = 128u, TK = 16u, WG_ROWS = 64u;
#endif
const uint TQ = 32u, LANES = 8u, OWN = TK / LANES, RUNS = DIM / 32u;
shared vec4 ks[TK * DIM / 4u];
shared vec4 vs[TK * DIM / 4u];
shared float ps[WG_ROWS * TK];
#define ROWS 1
#define TILE_ROWS tile_rows1
#include "attention_tile_rows.glsl"
#undef ROWS
#undef TILE_ROWS
#ifndef LLMX_D256
#define ROWS 2
#define TILE_ROWS tile_rows2
#include "attention_tile_rows.glsl"
#undef ROWS
#undef TILE_ROWS
#endif

void main() {
    uint wg = gl_WorkGroupID.x;
    uint n = view_count();
    uint v = 0u, first = 0u;
    for (uint i = 0u; i < n; ++i) {
        uint tiles = (view_nq(i) + WG_ROWS - 1u) / WG_ROWS;
        if (wg < first + tiles * p.n_head) { v = i; break; }
        first += tiles * p.n_head;
    }
    uint local = wg - first;
    uint tile = local / p.n_head;
    uint h = local - tile * p.n_head;
    uint nq = view_nq(v), base = tile * WG_ROWS;
#ifdef LLMX_D256
    tile_rows1(v, base, h, nq);
#else
    // A workgroup whose second tile holds no row takes one row a lane, so every subgroup has rows.
    if (base + TQ < nq) tile_rows2(v, base, h, nq);
    else tile_rows1(v, base, h, nq);
#endif
}
