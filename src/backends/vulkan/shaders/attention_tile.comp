#version 450
// Causal GQA for a wide pass over every view of a batch: one workgroup per (tile of 32 query rows of one view, head), the head's K and V streamed through shared memory in tiles of TK tokens.
// Row b of a view attends through its hist + b; tokens past that are masked and later tiles are not read.
// The head width is fixed at 128; other widths take the per-row kernel.
// Workgroups are laid out view by view, so a tile never straddles two views.
//
// Eight lanes share a query row, lane l owning dimensions 32k + 4l .. 32k + 4l + 3, so a row reads a staged token as contiguous 128-byte runs.
// Per K tile: partial dots eight tokens at a time, a butterfly that finishes the sums and deals one to each lane, then one online-softmax step per tile, and the probabilities through shared memory for the weighted sum of V.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint n_head; uint n_head_kv; uint bt; float scale;
} p;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };
// K and V read eight values per load: 16-bit halves in a uvec4, or two vec4 of floats.
#ifdef LLMX_K16
layout(set = 0, binding = 2) readonly buffer K { uvec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = kb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 2) readonly buffer K { vec4 kb[]; };
void k_load8(uint i, out vec4 a, out vec4 b) { a = kb[i / 4u]; b = kb[i / 4u + 1u]; }
#endif
#ifdef LLMX_V16
layout(set = 0, binding = 3) readonly buffer V { uvec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) {
    uvec4 w = vb[i / 8u];
    a = vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));
    b = vec4(unpackHalf2x16(w.z), unpackHalf2x16(w.w));
}
#else
layout(set = 0, binding = 3) readonly buffer V { vec4 vb[]; };
void v_load8(uint i, out vec4 a, out vec4 b) { a = vb[i / 4u]; b = vb[i / 4u + 1u]; }
#endif
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
#include "views.glsl"
#ifndef TK
#define TK 16u
#endif
const uint DIM = 128u, TQ = 32u, LANES = 8u, OWN = TK / LANES;
shared vec4 ks[TK * DIM / 4u];
shared vec4 vs[TK * DIM / 4u];
shared float ps[TQ * TK];

void main() {
    uint wg = gl_WorkGroupID.x;
    uint n = view_count();
    uint v = 0u, first = 0u;
    for (uint i = 0u; i < n; ++i) {
        uint tiles = (view_nq(i) + TQ - 1u) / TQ;
        if (wg < first + tiles * p.n_head) { v = i; break; }
        first += tiles * p.n_head;
    }
    uint local = wg - first;
    uint tile = local / p.n_head;
    uint h = local - tile * p.n_head;
    uint nq = view_nq(v), hist = view_hist(v), row0 = view_row0(v);
    uint kvh = h / (p.n_head / p.n_head_kv);
    uint lid = gl_LocalInvocationID.x;
    uint r = lid / LANES, lane = lid - r * LANES;   // query row of the tile, lane within it
    uint b = tile * TQ + r;                          // row of the view
    bool live = b < nq;
    uint qstride = p.n_head * DIM;
    uint qbase = (row0 + min(b, nq - 1u)) * qstride + h * DIM;
    vec4 qv[4], acc[4];
    for (uint k = 0u; k < 4u; ++k) {
        uint d = 32u * k + 4u * lane;
        qv[k] = vec4(q[qbase + d], q[qbase + d + 1u], q[qbase + d + 2u], q[qbase + d + 3u]) * p.scale;
        acc[k] = vec4(0.0);
    }
    float m = -1.0 / 0.0, l = 0.0;
    // The last token any row of this tile attends, exclusive.
    uint tile_end = min(hist + tile * TQ + TQ, hist + nq);
    uint my_end = hist + b + 1u;
    uint bf = p.n_head_kv * p.bt * DIM;
    for (uint t0 = 0u; t0 < tile_end; t0 += TK) {
        // Stage the tile eight values a load, zero past the tile's last token so a masked score meets a finite value.
        for (uint i = lid; i < TK * DIM / 8u; i += 256u) {
            uint j = i / (DIM / 8u), d = (i - j * (DIM / 8u)) * 8u;
            uint t = t0 + j;
            vec4 k0 = vec4(0.0), k1 = vec4(0.0), v0 = vec4(0.0), v1 = vec4(0.0);
            if (t < tile_end) {
                uint base = view_block(v, t / p.bt) * bf + (kvh * p.bt + t - (t / p.bt) * p.bt) * DIM + d;
                k_load8(base, k0, k1);
                v_load8(base, v0, v1);
            }
            uint s = (j * DIM + d) / 4u;
            ks[s] = k0; ks[s + 1u] = k1;
            vs[s] = v0; vs[s + 1u] = v1;
        }
        barrier();
        // Phase one: partial dots eight tokens at a time, then the butterfly, which leaves token 8g + l's score in lane l.
        float sc[OWN];
        float mt = -1.0 / 0.0;
        for (uint g = 0u; g < OWN; ++g) {
            float part[8];
            for (uint j = 0u; j < 8u; ++j) {
                float s = 0.0;
                for (uint k = 0u; k < 4u; ++k) s += dot(qv[k], ks[((8u * g + j) * DIM + 32u * k + 4u * lane) / 4u]);
                part[j] = s;
            }
            for (uint half_ = 4u; half_ >= 1u; half_ /= 2u) {
                bool upper = (lane & half_) != 0u;
                for (uint j = 0u; j < half_; ++j) {
                    float lo = part[j], hi = part[j + half_];
                    part[j] = (upper ? hi : lo) + subgroupShuffleXor(upper ? lo : hi, half_);
                }
            }
            sc[g] = t0 + 8u * g + lane < my_end ? part[0] : -1.0 / 0.0;
            mt = max(mt, sc[g]);
        }
        mt = max(mt, subgroupShuffleXor(mt, 1u));
        mt = max(mt, subgroupShuffleXor(mt, 2u));
        mt = max(mt, subgroupShuffleXor(mt, 4u));
        float mn = max(m, mt);
        // A row with nothing unmasked yet keeps m at -inf; its weights are zero rather than the NaN of inf - inf.
        float corr = mn == -1.0 / 0.0 ? 1.0 : exp(m - mn);
        float sum = 0.0;
        for (uint g = 0u; g < OWN; ++g) {
            float w = sc[g] == -1.0 / 0.0 ? 0.0 : exp(sc[g] - mn);
            ps[r * TK + 8u * g + lane] = w;
            sum += w;
        }
        sum += subgroupShuffleXor(sum, 1u);
        sum += subgroupShuffleXor(sum, 2u);
        sum += subgroupShuffleXor(sum, 4u);
        l = l * corr + sum;
        m = mn;
        for (uint k = 0u; k < 4u; ++k) acc[k] *= corr;
        // A row's eight lanes are one subgroup, so their probabilities are visible to each other past this point.
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        // Phase two: the weighted sum of the tile's values.
        for (uint j = 0u; j < TK; ++j) {
            float w = ps[r * TK + j];
            for (uint k = 0u; k < 4u; ++k) acc[k] += w * vs[(j * DIM + 32u * k + 4u * lane) / 4u];
        }
        barrier();
    }
    if (live) {
        for (uint k = 0u; k < 4u; ++k) {
            uint d = 32u * k + 4u * lane;
            vec4 a = acc[k] / l;
            o[qbase + d] = a.x; o[qbase + d + 1u] = a.y; o[qbase + d + 2u] = a.z; o[qbase + d + 3u] = a.w;
        }
    }
}
