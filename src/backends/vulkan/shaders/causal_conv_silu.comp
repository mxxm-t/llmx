#version 450
// The linear attention's causal conv of four taps, then SiLU, over every view of a batch (backend.hpp, causal_conv_silu).
// `mode` 0 takes one invocation per (row, channel) and writes out[row][c] = silu(sum over tap j of w[c][j] raw[t - 3 + j][c]), raw rows before the view's first coming from slot src's carried rows and rows before the sequence's start being zero.
// `mode` 1 takes one invocation per (view, channel) and leaves the view's last three raw rows in slot dst, after mode 0 has read slot src, which it may be.
// The sum is one fused multiply-add chain in tap order, the CPU's, so a row computes the same whatever else is in the call.
// The view table (vulkan_backend.cpp, state_table) holds the view count, then per view its first batch row, rows, history length, source slot and destination slot.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint C; uint slot; uint carried; uint mode; uint total; } p;
layout(set = 0, binding = 0) writeonly buffer O { float o[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) readonly buffer W { float w[]; };
layout(set = 0, binding = 3) buffer S { float st[]; };
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
uint view_count() { return tab[0]; }
uint view_row0(uint v) { return tab[1u + 5u * v]; }
uint view_nq(uint v) { return tab[2u + 5u * v]; }
uint view_len(uint v) { return tab[3u + 5u * v]; }
uint view_src(uint v) { return tab[4u + 5u * v]; }
uint view_dst(uint v) { return tab[5u + 5u * v]; }
// Raw value `t` of channel c of view v, counting the three carried rows first: 0 before the sequence's start.
float raw(uint v, uint t, uint c) {
    if (t < 3u) return view_len(v) + t >= 3u ? st[view_src(v) * p.slot + p.carried + t * p.C + c] : 0.0;
    return x[(view_row0(v) + t - 3u) * p.C + c];
}
void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= p.total) return;
    if (p.mode == 0u) {
        uint row = g / p.C, c = g - row * p.C;
        uint n = view_count(), v = 0u;
        for (uint i = 1u; i < n; ++i) if (row >= view_row0(i)) v = i;
        uint b = row - view_row0(v);
        precise float acc = w[c * 4u] * raw(v, b, c);
        acc = fma(w[c * 4u + 1u], raw(v, b + 1u, c), acc);
        acc = fma(w[c * 4u + 2u], raw(v, b + 2u, c), acc);
        acc = fma(w[c * 4u + 3u], x[row * p.C + c], acc);
        o[row * p.C + c] = acc / (1.0 + exp(-acc));
        return;
    }
    uint v = g / p.C, c = g - v * p.C, nq = view_nq(v);
    float keep[3] = float[3](raw(v, nq, c), raw(v, nq + 1u, c), raw(v, nq + 2u, c));
    uint base = view_dst(v) * p.slot + p.carried + c;
    for (uint j = 0u; j < 3u; ++j) st[base + j * p.C] = keep[j];
}
