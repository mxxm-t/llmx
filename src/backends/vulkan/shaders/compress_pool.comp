#version 450
// One workgroup a group: each channel the kv values weighted by the softmax of their scores over the group's rows in the CPU's order, then the RMSNorm of the pooled row with w after a tree sum of its squares.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint groups; uint ratio; uint dim; float eps; } p;
layout(set = 0, binding = 0) buffer O { float outv[]; };
layout(set = 0, binding = 1) readonly buffer K { float kv[]; };
layout(set = 0, binding = 2) readonly buffer S { float score[]; };
layout(set = 0, binding = 3) readonly buffer W { float w[]; };
shared float red[256];
void main() {
    uint g = gl_WorkGroupID.x, lid = gl_LocalInvocationID.x;
    uint base = g * p.ratio * p.dim;
    precise float squares = 0.0;
    for (uint d = lid; d < p.dim; d += 256u) {
        float peak = -1.0 / 0.0;
        for (uint i = 0u; i < p.ratio; ++i) peak = max(peak, score[base + i * p.dim + d]);
        precise float sum = 0.0;
        for (uint i = 0u; i < p.ratio; ++i) sum += exp(score[base + i * p.dim + d] - peak);
        precise float acc = 0.0;
        for (uint i = 0u; i < p.ratio; ++i) acc = fma(kv[base + i * p.dim + d], exp(score[base + i * p.dim + d] - peak) / sum, acc);
        outv[g * p.dim + d] = acc;
        squares = fma(acc, acc, squares);
    }
    red[lid] = squares;
    barrier();
    for (uint k = 128u; k > 0u; k >>= 1u) {
        if (lid < k) red[lid] += red[lid + k];
        barrier();
    }
    float scale = 1.0 / sqrt(red[0] / float(p.dim) + p.eps);
    for (uint d = lid; d < p.dim; d += 256u) outv[g * p.dim + d] = outv[g * p.dim + d] * scale * w[d];
}
