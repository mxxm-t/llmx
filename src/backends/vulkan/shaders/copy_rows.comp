#version 450
// dst row r = src row r, or dst row r + src row r when `add`, rows of `width` floats dst_stride and src_stride floats apart.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint width; uint dst_stride; uint src_stride; uint add; } p;
layout(set = 0, binding = 0) buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer S { float src[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.rows * p.width) return;
    uint r = i / p.width, c = i - r * p.width;
    float v = src[r * p.src_stride + c];
    uint d = r * p.dst_stride + c;
    dst[d] = p.add != 0u ? dst[d] + v : v;
}
