#version 450
// One workgroup per gathered row: dst row i = table row ids[i], decoded.
// With LLMX_DEVICE_IDS the ids are read on the device, as a draft chain feeds its drafts back (embed_ids), and an id of nrows or more writes a zero row and reads no row of the table.
#include "q.glsl"
#if defined(LLMX_WEIGHT_F16) || defined(LLMX_WEIGHT_BF16)
#include "f16.glsl"
#ifdef LLMX_WEIGHT_F16
#define WEIGHT_FLOAT(h) f16_to_f32(h)
#else
#define WEIGHT_FLOAT(h) bf16_to_f32(h)
#endif
#endif
layout(local_size_x = 256) in;
#ifdef LLMX_DEVICE_IDS
layout(push_constant) uniform P { uint nin; uint type; uint nrows; } p;
#else
layout(push_constant) uniform P { uint nin; uint type; } p;
#endif
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer TF { float table_f[]; };
layout(set = 0, binding = 2) readonly buffer TB { uint8_t table_b[]; };
layout(set = 0, binding = 3) readonly buffer I { uint ids[]; };
#define QBYTE(i) uint(table_b[i])
#include "qdecode.glsl"
void main() {
    uint i = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint id = ids[i];
    uint out_base = i * p.nin;
#ifdef LLMX_DEVICE_IDS
    if (id >= p.nrows) {
        for (uint j = lid; j < p.nin; j += 256u) dst[out_base + j] = 0.0;
        return;
    }
#endif
#if defined(LLMX_WEIGHT_F16) || defined(LLMX_WEIGHT_BF16)
    uint base = id * p.nin * 2u;
    for (uint j = lid; j < p.nin; j += 256u) {
        uint at = base + 2u * j;
        dst[out_base + j] = WEIGHT_FLOAT(QBYTE(at) | (QBYTE(at + 1u) << 8u));
    }
#elif defined(LLMX_MXFP4)
    uint base = id * (p.nin / MXFP4_BLOCK) * MXFP4_BYTES;
    for (uint j = lid; j < p.nin; j += 256u)
        dst[out_base + j] = mxfp4_at(base + (j / MXFP4_BLOCK) * MXFP4_BYTES, j % MXFP4_BLOCK);
#else
    if (p.type == TYPE_F32) {
        uint base = id * p.nin;
        for (uint j = lid; j < p.nin; j += 256u) dst[out_base + j] = table_f[base + j];
    } else if (p.type == TYPE_Q8_0) {
        uint blocks = p.nin / Q8_0_BLOCK;
        uint base = id * blocks * Q8_0_BYTES;
        for (uint j = lid; j < p.nin; j += 256u) {
            uint b = j / Q8_0_BLOCK, k = j - b * Q8_0_BLOCK;
            uint o = base + b * Q8_0_BYTES;
            uint q = QBYTE(o + 2u + k);
            dst[out_base + j] = half_at(QBYTE(o), QBYTE(o + 1u)) * float(int(q) - (q >= 128u ? 256 : 0));
        }
    } else {
        // Q4_0, Q4_1 and the K-quants, one value at a time through the decoders.
        uint bv = block_values(p.type), bb = block_bytes(p.type);
        uint base = id * (p.nin / bv) * bb;
        for (uint j = lid; j < p.nin; j += 256u) {
            uint b = j / bv, k = j - b * bv;
            uint o = base + b * bb;
            float v;
            if (p.type == TYPE_Q4_0) v = q4_0_exact(o, k, half_at(QBYTE(o), QBYTE(o + 1u)));
            else if (p.type == TYPE_Q4_1) v = q4_1_at(o, k, half_at(QBYTE(o), QBYTE(o + 1u)),
                                                      half_at(QBYTE(o + 2u), QBYTE(o + 3u)));
            else if (p.type == TYPE_Q4_K) v = q4_k_at(o, k, half_at(QBYTE(o), QBYTE(o + 1u)),
                                                      half_at(QBYTE(o + 2u), QBYTE(o + 3u)));
            else if (p.type == TYPE_Q5_K) v = q5_k_at(o, k, half_at(QBYTE(o), QBYTE(o + 1u)),
                                                      half_at(QBYTE(o + 2u), QBYTE(o + 3u)));
            else v = q6_k_at(o, k, half_at(QBYTE(o + 208u), QBYTE(o + 209u)));
            dst[out_base + j] = v;
        }
    }
#endif
}
