#version 450
// dst row i = src row rows[i], `width` floats each.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint width; uint count; } p;
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer S { float src[]; };
layout(set = 0, binding = 2) readonly buffer I { uint rows[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.width * p.count) {
        uint r = i / p.width, j = i - r * p.width;
        dst[i] = src[rows[r] * p.width + j];
    }
}
