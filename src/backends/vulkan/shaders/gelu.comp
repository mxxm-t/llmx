#version 450
// dst[i] = gelu(src[i]) in F32: with `erf_form` x times the normal CDF through erf, else its tanh approximation; dst may be src.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint erf_form; } p;
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer X { float src[]; };
// erfc(z) by a Chebyshev fit, fractional error below 1.2e-7 everywhere, so the tail of the normal CDF keeps its digits.
float erfc_of(float z) {
    float a = abs(z), t = 1.0 / (1.0 + 0.5 * a);
    float q = -1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277))))))));
    float r = t * exp(q - a * a);
    return z >= 0.0 ? r : 2.0 - r;
}
void main() {
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += gl_NumWorkGroups.x * 256u) {
        float x = src[i];
        float g = p.erf_form != 0u ? 0.5 * x * erfc_of(-x * 0.70710678) : 0.5 * x * (1.0 + tanh(clamp(0.79788456 * (x + 0.044715 * x * x * x), -10.0, 10.0)));
        dst[i] = g;
    }
}
