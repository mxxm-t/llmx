#version 450
// One lane a (row, channel): X'_k = post[k] f + sum over j in order of comb[j][k] X_j with the CPU's multiply-adds, every old stream read before any new one is written, so dst may be the stream.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint hc; uint dim; uint n; } p;
layout(set = 0, binding = 0) buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer F { float f[]; };
layout(set = 0, binding = 2) readonly buffer X { float x[]; };
layout(set = 0, binding = 3) readonly buffer A { float post[]; };
layout(set = 0, binding = 4) readonly buffer C { float comb[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint r = i / p.dim, d = i - r * p.dim, hc = p.hc, width = hc * p.dim;
    float old[16];
    for (uint j = 0u; j < hc; ++j) old[j] = x[r * width + j * p.dim + d];
    float fv = f[r * p.dim + d];
    precise float outs[16];
    for (uint k = 0u; k < hc; ++k) {
        precise float sum = comb[r * hc * hc + k] * old[0];
        for (uint j = 1u; j < hc; ++j) sum = fma(comb[r * hc * hc + j * hc + k], old[j], sum);
        outs[k] = fma(post[r * hc + k], fv, sum);
    }
    for (uint k = 0u; k < hc; ++k) dst[r * width + k * p.dim + d] = outs[k];
}
