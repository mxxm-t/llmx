#version 450
#extension GL_EXT_control_flow_attributes : require
// A workgroup runs of max(1, 256 / heads) positions of one row, a lane a (position, head) dot: out = sum over heads of w[h] w_scale ReLU(dot(q_h, key)).
// The key is the view's pooled row's last dim floats; each dot and the head sum are the CPU's multiply-add chains, and a position the row cannot see is -inf.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint heads; uint dim; uint n; float w_scale; uint tokens; uint bt; uint block_floats; uint rows_floats; uint width; uint block_k; uint block_size; uint key_format; uint key_words; } p;
layout(set = 0, binding = 0) writeonly buffer O { float outv[]; };
layout(set = 0, binding = 1) readonly buffer Q { float q[]; };
layout(set = 0, binding = 2) readonly buffer A { float aux[]; };
layout(set = 0, binding = 3) readonly buffer T { uint tab[]; };
layout(set = 0, binding = 4) readonly buffer W { float w[]; };
layout(set = 0, binding = 5) readonly buffer B { uint blocks[]; };
// The pooled rows as words, for keys held in a packed format (model_formats.glsl).
layout(set = 0, binding = 2) readonly buffer AU { uint aux_words[]; };
#include "views.glsl"
#include "model_formats.glsl"
#define FORMAT_WORD(i) aux_words[i]
float key_value0(uint key, uint d) { precise float v; FORMAT_VALUE(key, d, 0u, v) return v; }
float key_value1(uint key, uint d) { precise float v; FORMAT_VALUE(key, d, 1u, v) return v; }
float key_value2(uint key, uint d) { precise float v; FORMAT_VALUE(key, d, 2u, v) return v; }
float key_value3(uint key, uint d) { return aux[key + d]; }
shared float dots[1024];
shared float lut[272];
FORMAT_DOT(key_dot0, aux_words, key_value0, 0u, 32u, 33u)
FORMAT_DOT(key_dot1, aux_words, key_value1, 1u, 32u, 17u)
FORMAT_DOT(key_dot2, aux_words, key_value2, 2u, 16u, 9u)
FORMAT_DOT(key_dot3, aux_words, key_value3, 3u, 1u, 1u)
shared uint seen[256];
void main() {
    uint r = gl_WorkGroupID.y, lid = gl_LocalInvocationID.x;
    uint per = max(1u, 256u / p.heads);
    uint v, b;
    view_of_row(r, v, b);
    uint len = (view_hist(v) + b + 1u) / p.tokens;
    for (uint c = lid; c < 272u; c += 256u) lut[c] = c < 256u ? e4m3_value(c) : e2m1_value(c - 256u);
    for (uint first = gl_WorkGroupID.x * per; first < p.n; first += gl_NumWorkGroups.x * per) {
        for (uint j = lid; j < per; j += 256u) {
            uint t = first + j;
            bool reached = t < p.n && t < len;
            if (reached && p.block_k != 0u) {
                reached = false;
                for (uint i = 0u; i < p.block_k && !reached; ++i) reached = blocks[r * p.block_k + i] == t / p.block_size;
            }
            seen[j] = reached ? 1u : 0u;
        }
        barrier();
        for (uint i = lid; i < per * p.heads; i += 256u) {
            uint j = i / p.heads, h = i - j * p.heads;
            if (seen[j] == 0u) continue;
            uint key = pooled_row(v, first + j, p.tokens, p.bt, p.block_floats, p.rows_floats, p.width) + p.width - p.key_words;
            uint qh = (r * p.heads + h) * p.dim;
            uint f = p.key_format;
            dots[i] = f == 3u ? key_dot3(qh, key) : f == 0u ? key_dot0(qh, key) : f == 1u ? key_dot1(qh, key) : key_dot2(qh, key);
        }
        barrier();
        for (uint j = lid; j < per; j += 256u) {
            uint t = first + j;
            if (t >= p.n) continue;
            if (seen[j] == 0u) {
                outv[r * p.n + t] = -1.0 / 0.0;
                continue;
            }
            precise float sum = 0.0;
            for (uint h = 0u; h < p.heads; ++h) {
                precise float scaled = w[r * p.heads + h] * p.w_scale;
                sum = fma(max(dots[j * p.heads + h], 0.0), scaled, sum);
            }
            outv[r * p.n + t] = sum;
        }
        barrier();
    }
}
