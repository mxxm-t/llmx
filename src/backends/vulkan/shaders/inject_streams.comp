#version 450
// Add a row's block into each residual stream with 2 * sigmoid(gate / streams).
#include "float_controls.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint streams; uint dim; uint n; } p;
layout(set = 0, binding = 0) buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer B { float block[]; };
layout(set = 0, binding = 2) readonly buffer G { float gate[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) {
        uint row = i / (p.streams * p.dim);
        uint rem = i - row * p.streams * p.dim;
        uint stream = rem / p.dim, d = rem - stream * p.dim;
        float g = gate[row * p.streams + stream] / float(p.streams);
        float weight = 2.0 * (1.0 / (1.0 + exp(-g)));
        dst[i] += block[row * p.dim + d] * weight;
    }
}
