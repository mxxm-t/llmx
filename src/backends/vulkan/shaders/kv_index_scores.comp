#version 450
// One workgroup scores a complete causal group for one query, summing rectified dots across indexer heads.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint view; uint row; uint first; uint groups; uint heads; uint dim; uint compression; float scale; } p;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer K { float pooled[]; };
layout(set = 0, binding = 2) writeonly buffer O { float scores[]; };
layout(set = 0, binding = 3) readonly buffer T { uint tab[]; };
#include "views.glsl"
shared float red[256];
void main() {
    uint at = p.first + gl_WorkGroupID.x, row = at / p.groups, g = at % p.groups;
    uint lid = gl_LocalInvocationID.x;
    uint visible = view_hist(p.view) + p.row + row + 1u;
    if (g >= visible / p.compression) return;
    uint base = (view_row0(p.view) + p.row + row) * p.heads * p.dim;
    float score = 0.0;
    for (uint h = 0u; h < p.heads; ++h) {
        red[lid] = lid < p.dim ? q[base + h * p.dim + lid] * pooled[g * p.dim + lid] : 0.0;
        barrier();
        for (uint k = 128u; k > 0u; k >>= 1u) {
            if (lid < k) red[lid] += red[lid + k];
            barrier();
        }
        score += max(red[0], 0.0);
        barrier();
    }
    if (lid == 0u) scores[at] = score * p.scale;
}
