#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
// The indexer's scores (score_rows in vulkan_backend.cpp): a workgroup scores 64 groups for up to ROWS query rows, four lanes a group, each row's heads in turn.
// Each dot is a tree of steps k = 128 to 1 over 256 slots, +0 past the width, nothing contracted: lane s adds its slots s + 4m for steps 128 to 4, its neighbours' for 2 and 1.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint view; uint row; uint first; uint groups; uint heads; uint dim; uint compression; float scale; uint rows; uint bt; uint block_floats; uint rows_floats; } p;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer K { float aux[]; };
layout(set = 0, binding = 2) writeonly buffer O { float scores[]; };
layout(set = 0, binding = 3) readonly buffer T { uint tab[]; };
#include "views.glsl"
#define ROWS 4u
#define HEADS 8u
// The queries of ROWS rows and HEADS heads at a time, a head's 256 slots laid out lane by lane, slot s + 4m at s * 64 + m, so a lane reads four of its slots at once; more heads take turns.
shared vec4 qs[ROWS][HEADS][64];
void main() {
    uint lid = gl_LocalInvocationID.x, s = lid & 3u, g = (p.first + gl_WorkGroupID.x) * 64u + lid / 4u;
    uint r0 = gl_WorkGroupID.y * ROWS, nr = min(ROWS, p.rows - r0);
    // The groups the last of these rows sees; an earlier row writes only its own.
    bool live = g < (view_hist(p.view) + p.row + r0 + nr) / p.compression;
    uint key = live ? pooled_row(p.view, g, p.compression, p.bt, p.block_floats, p.rows_floats, p.dim) : 0u;
    bool hi = p.dim > 128u;
    float k[64];
    [[unroll]] for (uint m = 0u; m < 64u; ++m) k[m] = live && s + 4u * m < p.dim ? aux[key + s + 4u * m] : 0.0;
    precise float score[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; ++r) score[r] = 0.0;
    for (uint h0 = 0u; h0 < p.heads; h0 += HEADS) {
        uint nh = min(HEADS, p.heads - h0);
        barrier();
        for (uint r = 0u; r < nr; ++r) {
            uint qrow = (view_row0(p.view) + p.row + r0 + r) * p.heads * p.dim;
            for (uint i = lid; i < nh * 256u; i += 256u) {
                uint h = i / 256u, slot = i % 256u, at = (slot & 3u) * 64u + slot / 4u;
                qs[r][h][at / 4u][at % 4u] = slot < p.dim ? q[qrow + (h0 + h) * p.dim + slot] : 0.0;
            }
        }
        barrier();
        if (!live) continue;
        [[unroll]] for (uint r = 0u; r < ROWS; ++r) {
            if (r >= nr) break;
            for (uint h = 0u; h < nh; ++h) {
                precise float x[64];
                // The products of slots s + 4m, +0 past the width as the old kernel selects it, which also keeps each product a separate rounding; then step 128, whose upper slots are +0 for a head no wider than 128.
                [[unroll]] for (uint c = 0u; c < 8u; ++c) {
                    vec4 a = qs[r][h][s * 16u + c];
                    [[unroll]] for (uint e = 0u; e < 4u; ++e) x[4u * c + e] = s + 16u * c + 4u * e < p.dim ? a[e] * k[4u * c + e] : 0.0;
                }
                if (hi) {
                    [[unroll]] for (uint c = 8u; c < 16u; ++c) {
                        vec4 a = qs[r][h][s * 16u + c];
                        [[unroll]] for (uint e = 0u; e < 4u; ++e) x[4u * c + e] = s + 16u * c + 4u * e < p.dim ? a[e] * k[4u * c + e] : 0.0;
                    }
                    [[unroll]] for (uint m = 0u; m < 32u; ++m) x[m] = x[m] + x[m + 32u];
                } else {
                    [[unroll]] for (uint m = 0u; m < 32u; ++m) x[m] = x[m] + 0.0;
                }
                [[unroll]] for (uint m = 0u; m < 16u; ++m) x[m] = x[m] + x[m + 16u];
                [[unroll]] for (uint m = 0u; m < 8u; ++m) x[m] = x[m] + x[m + 8u];
                [[unroll]] for (uint m = 0u; m < 4u; ++m) x[m] = x[m] + x[m + 4u];
                [[unroll]] for (uint m = 0u; m < 2u; ++m) x[m] = x[m] + x[m + 2u];
                precise float a = x[0] + x[1];
                precise float b = a + subgroupShuffleXor(a, 2u);
                precise float c = b + subgroupShuffleXor(b, 1u);
                score[r] += max(c, 0.0);
            }
        }
    }
    if (!live || s != 0u) return;
    [[unroll]] for (uint r = 0u; r < ROWS; ++r) {
        if (r >= nr) break;
        precise float scaled = score[r] * p.scale;
        if (g < (view_hist(p.view) + p.row + r0 + r + 1u) / p.compression) scores[(r0 + r) * p.groups + g] = scaled;
    }
}
