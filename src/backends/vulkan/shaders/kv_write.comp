#version 450
// Scatter the token-major [heads, dim] rows of every view of a batch into their blocks, row b of a view at position hist + b. A block holds [head][token][dim].
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "f16.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint heads; uint dim; uint bt; } p;
// K and V storage of either type, f32 or f16 (round-to-nearest), chosen per side at build by LLMX_K16 and LLMX_V16.
#ifdef LLMX_K16
layout(set = 0, binding = 0) buffer K { uint16_t kb16[]; };
void k_store(uint i, float v) { kb16[i] = uint16_t(f16_bits(v)); }
#else
layout(set = 0, binding = 0) buffer K { float kb[]; };
void k_store(uint i, float v) { kb[i] = v; }
#endif
#ifdef LLMX_V16
layout(set = 0, binding = 1) buffer V { uint16_t vb16[]; };
void v_store(uint i, float v) { vb16[i] = uint16_t(f16_bits(v)); }
#else
layout(set = 0, binding = 1) buffer V { float vb[]; };
void v_store(uint i, float v) { vb[i] = v; }
#endif
layout(set = 0, binding = 2) readonly buffer KI { float kin[]; };
layout(set = 0, binding = 3) readonly buffer VI { float vin[]; };
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
#include "views.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint hd = p.heads * p.dim;
    if (i >= p.rows * hd) return;
    uint g = i / hd, rem = i - g * hd;
    uint h = rem / p.dim, d = rem - h * p.dim;
    uint v, b;
    view_of_row(g, v, b);
    uint t = view_hist(v) + b;
    uint block = view_block(v, t / p.bt);
    uint o = block * (p.heads * p.bt * p.dim) + (h * p.bt + t - (t / p.bt) * p.bt) * p.dim + d;
    uint src = (view_row0(v) + b) * hd + rem;
    k_store(o, kin[src]);
    v_store(o, vin[src]);
}
