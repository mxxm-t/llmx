#version 450
// y[i] = the parts of a split tile call (matmul_tile_q.comp) added in part order, then y[i] added to that total when accumulating.
// Up to three projections: projection q's parts start at parts * (the outputs before q), part z at z * n_q after that; each projection has whole workgroups from start_q on, so a workgroup's output buffer is uniform.
#ifdef LLMX_MXFP4
#extension GL_ARB_gpu_shader_fp64 : require
#endif
#include "float_controls.glsl"
layout(local_size_x = 256) in;
#ifdef LLMX_FLOAT_REPLAY
// A float-weight tile's parts (matmul_tile.comp), one projection: `kper` inputs a part, the weights as the tile reads them.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "f16.glsl"
layout(push_constant) uniform P { uint n0; uint n1; uint n2; uint parts; uint accum; uint start1; uint start2; uint nin; uint nout; uint kper; uint wstride; uint type; } p;
layout(set = 0, binding = 2) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 3) readonly buffer WF { float wf[]; };
layout(set = 0, binding = 4) readonly buffer X { float x[]; };
#define TILE_REPLAY_WEIGHT(r, k) (p.type == 0u ? wf[(r) * p.wstride + (k)] : p.type == 1u ? f16_to_f32(uint(w16[(r) * p.nin + (k)])) : bf16_to_f32(uint(w16[(r) * p.nin + (k)])))
#define TILE_REPLAY_INPUT(c, k) x[(c) * p.nin + (k)]
#include "tile_replay.glsl"
#else
layout(push_constant) uniform P { uint n0; uint n1; uint n2; uint parts; uint accum; uint start1; uint start2; } p;
#endif
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
#ifdef LLMX_MXFP4
// The MXFP4 tile keeps exceptional partials wide until they are summed here.
layout(set = 0, binding = 1) readonly buffer S { double part[]; };
#else
layout(set = 0, binding = 1) readonly buffer S { float part[]; };
#endif
void main() {
    uint wg = gl_WorkGroupID.x;
    uint q = wg >= p.start2 ? 2u : (wg >= p.start1 ? 1u : 0u);
    uint first = q == 0u ? 0u : (q == 1u ? p.start1 : p.start2);
    uint local = (wg - first) * 256u + gl_LocalInvocationID.x, n = q == 0u ? p.n0 : (q == 1u ? p.n1 : p.n2);
    if (local >= n) return;
    uint before = (q > 0u ? p.n0 : 0u) + (q > 1u ? p.n1 : 0u);
    uint base = p.parts * before + local;
#ifdef LLMX_MXFP4
    double s = 0.0;
    for (uint z = 0u; z < p.parts; ++z) s += part[base + z * n];
    float result = float(s);
    if (p.accum != 0u) result += ys[q].y[local];
    ys[q].y[local] = result;
#else
    // The parts' total first and y last, as an unsplit tile adds its sum to y.
    float s = 0.0;
    for (uint z = 0u; z < p.parts; ++z) s += part[base + z * n];
#ifdef LLMX_FLOAT_REPLAY
    // A part or the running total that left f32 is summed again: each part's scaled fold in part order, then scaled back.
    if (tile_nonfinite(s)) {
        uint row = local % p.nout, col = local / p.nout;
#ifdef LLMX_PRESERVE_F32
        precise float t = 0.0, r;
#else
        float t = 0.0, r;
#endif
        for (uint z = 0u; z < p.parts; ++z) t += tile_replay_scaled(row, col, z * p.kper, min(p.nin, (z + 1u) * p.kper));
        r = t * TILE_REPLAY_UP;
        s = r;
    }
#endif
    if (p.accum != 0u) s += ys[q].y[local];
    ys[q].y[local] = s;
#endif
}
