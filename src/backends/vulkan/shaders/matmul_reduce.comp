#version 450
// y[i] = the parts of a split tile call (matmul_tile_q.comp) added in part order, plus y[i] when accumulating.
// Up to three projections: projection q's parts start at parts * (the outputs before q), part z at z * n_q after that; each projection has whole workgroups from start_q on, so a workgroup's output buffer is uniform.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n0; uint n1; uint n2; uint parts; uint accum; uint start1; uint start2; } p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 1) readonly buffer S { float part[]; };
void main() {
    uint wg = gl_WorkGroupID.x;
    uint q = wg >= p.start2 ? 2u : (wg >= p.start1 ? 1u : 0u);
    uint first = q == 0u ? 0u : (q == 1u ? p.start1 : p.start2);
    uint local = (wg - first) * 256u + gl_LocalInvocationID.x, n = q == 0u ? p.n0 : (q == 1u ? p.n1 : p.n2);
    if (local >= n) return;
    uint before = (q > 0u ? p.n0 : 0u) + (q > 1u ? p.n1 : 0u);
    uint base = p.parts * before + local;
    float s = p.accum != 0u ? ys[q].y[local] : 0.0;
    for (uint z = 0u; z < p.parts; ++z) s += part[base + z * n];
    ys[q].y[local] = s;
}
