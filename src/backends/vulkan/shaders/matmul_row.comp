#version 450
// Y[b*nout + o] = dot(row o, X column b) for up to three projections of
// the same X in one dispatch: the q, k and v projections of a layer, or
// gate and up. Workgroups are handed out to projections in order, so a
// workgroup's projection is uniform and its buffers are selected once.
// A subgroup handles `rows_per_sg` rows at once, each on a cluster of
// `cluster` lanes: the cluster's lanes stride over the row's work units
// and reduce with xor shuffles. Each lane keeps up to eight batch columns
// in registers so a weight is read once per chunk of columns. This is the
// decode kernel; the tile kernel takes wide batches (docs/VULKAN.md).
//
// Quantized rows meet the activations as signed 16-bit values in blocks
// of 32 (xquant.glsl), with a scale d and d times the block's sums: a
// weight word's values pair off with activation words through 16-bit
// integer dots, the block's integer sum is scaled once, and a type's
// offset (Q4_0's -8, Q4_1's min, the K-quant mins, Q6_K's -32) is folded
// through the block sum. Float activations cost the 4-bit paths eight
// extractions, conversions and multiply-adds per word and every path
// four times the activation bytes. The activations are read 8 or 16
// bytes at a time, since the load count and not the arithmetic is what
// bounds these paths: the same dots over 8-byte loads throughout ran
// Q4_0 at 150 us against 105 with 16-byte loads at the 8B shape. F32
// rows keep float activations.
//
// Compiled six times, one module per family of paths: as is for F32
// and the narrow Q8_0 path, with LLMX_Q8W for the wide Q8_0 path, with
// LLMX_Q4 for Q4_0 and Q4_1, with LLMX_K4 for Q4_K, with LLMX_K5 for
// Q5_K, with LLMX_KQUANT for Q6_K. The branches of every type in one
// module raised the register demand of every path and cost Q8_0 decode
// 40 percent, Q4_K and Q5_K beside Q6_K cost Q6_K 40 percent the same
// way, and the narrow Q8_0 path beside the wide one cost the wide one a
// third at the 8B shape, so a family is a module.
//
// Q8_0 rows with at least four block pairs take the wide path: a pair is
// 68 bytes, 17 words, and four consecutive lanes share one pair, lane t
// loading words t, t + 4, t + 8, t + 12 and, for lane 0, word 16, so a
// load instruction touches 16 contiguous bytes per pair and every lane
// has five loads in flight. On the Radeon VII that is the optimum of
// one, two, four, eight and sixteen lanes per pair, measured at the 8B
// shapes: 200, 190, 336, 295 and 185 GB/s. The two scales live in words
// 0 and 8 and every lane of the pair reads them, which the hardware
// serves as one broadcast and which measured faster than a shuffle. The
// loop is unrolled by hand and the accumulators are scalars: a generic
// loop over words with accumulator arrays indexed by column spilled to
// scratch and ran ten times slower. The first block's quants start two
// bytes into its words, so each lane shifts its two first-block words by
// a half word with the word after, fetched from the next lane of the
// pair with a shuffle, and every word then meets aligned activations;
// handling the straddle with per-word selects instead cost a quarter of
// the kernel. Rows with fewer or an odd number of blocks take the
// 16-bit path, two loads per word.
//
// Q4_0 rows with an even block count take a word path too: a pair is 36
// bytes, 9 words, and two lanes share it, lane 0 taking words 0..3 (the
// first scale and nibble bytes 0..13 of block 0) and lane 1 words 4..8
// (nibble bytes 14 and 15, the second scale and block 1). Q4_1 blocks are
// 20 bytes, 5 words, always word aligned, one lane per block. Q6_K blocks
// are 210 bytes, so every other block starts two bytes into a word and
// its words are assembled from two loads; sixteen lanes share a block,
// each taking four consecutive positions of one half, which is three
// words of quants, two of sub-scales and the block scale.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint col0; uint ncols; uint cluster; uint rows_per_sg; uint nproj;
    uint nout0; uint type0; uint wide0; uint start0;
    uint nout1; uint type1; uint wide1; uint start1;
    uint nout2; uint type2; uint wide2; uint start2;
    uint accum;   // Y += rather than Y =, the residual add folded in
} p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; } w16s[3];
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; } w32s[3];
layout(set = 0, binding = 3) readonly buffer WF { float wf[]; } wfs[3];
layout(set = 0, binding = 4) readonly buffer X { float x[]; };
layout(set = 0, binding = 5) readonly buffer W8 { uint8_t w8[]; } w8s[3];
// The quantized activations (xquant.glsl): per column nin / 2 words of
// pairs, then per block the scale and the scaled sum, then per block the
// scaled half sums. One buffer bound four ways so a lane loads two pair
// words, four, a table entry or a pair of entries at once.
layout(set = 0, binding = 6) readonly buffer XQ2 { uvec2 xq2[]; };
layout(set = 0, binding = 7) readonly buffer XQ4 { uvec4 xq4[]; };
layout(set = 0, binding = 8) readonly buffer XT2 { vec2 xt2[]; };
layout(set = 0, binding = 9) readonly buffer XT4 { vec4 xt4[]; };

uint pi = 0u;

// Offset in pair words into the quantized activations of column c.
uint xa_col(uint c) { return c * p.nin / 2u; }
// A block's scale d and d times its integer sum; and d times the sums of
// its two halves.
vec2 xq_block(uint c, uint b) { return xt2[p.nbatch * p.nin / 4u + c * (p.nin / 32u) + b]; }
vec2 xq_halves(uint c, uint b) { return xt2[p.nbatch * p.nin / 4u + p.nbatch * p.nin / 32u + c * (p.nin / 32u) + b]; }
// The scale entries of blocks 2j and 2j + 1 in one load.
vec4 xq_pair(uint c, uint j) { return xt4[p.nbatch * p.nin / 8u + c * (p.nin / 64u) + j]; }
// Two pairs of 16-bit values against two activation pair words.
int pair_dot(uint a, uint b, uvec2 xw) {
    return dotEXT(unpack16(int(a)), unpack16(int(xw.x))) + dotEXT(unpack16(int(b)), unpack16(int(xw.y)));
}
// A word of four signed bytes at positions 4k..4k+3 against the pair
// words: bytes 0 and 2 form one pair, 1 and 3 the other.
int byte_dot(uint w, uvec2 xw) {
    i8vec4 v = unpack8(int(w));
    return dotEXT(i16vec2(v.xz), unpack16(int(xw.x))) + dotEXT(i16vec2(v.yw), unpack16(int(xw.y)));
}
// A word at any even byte offset, two 16-bit loads.
uint hword_at(uint byte_off) {
    uint h = byte_off >> 1u;
    return uint(w16s[pi].w16[h]) | (uint(w16s[pi].w16[h + 1u]) << 16u);
}

#ifdef LLMX_Q8W
// Word d of a Q8_0 pair, shifted so that block 0's words 0..7 hold
// values 4d..4d+3 and block 1's words 9..16 hold values 32+4(d-9)..;
// word 8 is zero. `a2` is the pair's first pair-word couple.
void q8_word(uint w, uint d, uint a2, inout int p0, inout int p1) {
    i8vec4 v = unpack8(int(w));
    uvec2 xw = xq2[d < 8u ? a2 + d : a2 + 8u + d - 9u];
    int r = dotEXT(i16vec2(v.xz), unpack16(int(xw.x))) + dotEXT(i16vec2(v.yw), unpack16(int(xw.y)));
    if (d < 8u) p0 += r; else p1 += r;
}
#endif

#if defined(LLMX_Q4) || defined(LLMX_K4) || defined(LLMX_K5)
// The eight nibbles of a word: byte i's low nibble is position 4k + i of
// a group and its high nibble the same position 16 (Q4_0, Q4_1) or 32
// (Q4_K, Q5_K) further on. Low and high nibbles go to separate dots
// since the K-quants scale them apart; `hb` carries a fifth bit per
// nibble in bit 4 of each byte's pair word, zero for the others.
void nibble_dots(uint w, uint hl0, uint hl1, uint hh0, uint hh1, uvec2 xl, uvec2 xh, inout int pl, inout int ph) {
    pl += pair_dot((w & 0x000F000Fu) | hl0, ((w >> 8u) & 0x000F000Fu) | hl1, xl);
    ph += pair_dot(((w >> 4u) & 0x000F000Fu) | hh0, ((w >> 12u) & 0x000F000Fu) | hh1, xh);
}
#endif

#if defined(LLMX_KQUANT) || defined(LLMX_K4) || defined(LLMX_K5)
// A word at any even byte offset: aligned, or the high half of one word
// and the low half of the next.
uint word_at(uint byte_off) {
    uint i = byte_off >> 2u;
    if ((byte_off & 3u) == 0u) return w32s[pi].w32[i];
    return (w32s[pi].w32[i] >> 16u) | (w32s[pi].w32[i + 1u] << 16u);
}
float half_word_at(uint byte_off) {
    uint w = w32s[pi].w32[byte_off >> 2u];
    return (byte_off & 3u) == 0u ? unpackHalf2x16(w).x : unpackHalf2x16(w).y;
}
// Byte k of the twelve packed sub-scale bytes held in three words, and
// the sub-scale and sub-min of group j from them (quant/k_quants.hpp).
uint kbyte(uint s0, uint s1, uint s2, uint k) {
    uint w = k < 4u ? s0 : (k < 8u ? s1 : s2);
    return (w >> (8u * (k & 3u))) & 255u;
}
void scale_min_words(uint s0, uint s1, uint s2, uint j, out float sc, out float mn) {
    uint a, b;
    if (j < 4u) {
        a = kbyte(s0, s1, s2, j) & 63u;
        b = kbyte(s0, s1, s2, j + 4u) & 63u;
    } else {
        a = (kbyte(s0, s1, s2, j + 4u) & 15u) | ((kbyte(s0, s1, s2, j - 4u) >> 6u) << 4u);
        b = (kbyte(s0, s1, s2, j + 4u) >> 4u) | ((kbyte(s0, s1, s2, j) >> 6u) << 4u);
    }
    sc = float(a);
    mn = float(b);
}
#endif

void main() {
    // Which projection this workgroup belongs to, uniform across it.
    uint wg = gl_WorkGroupID.x;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint type = pi == 0u ? p.type0 : (pi == 1u ? p.type1 : p.type2);
    uint wide = pi == 0u ? p.wide0 : (pi == 1u ? p.wide1 : p.wide2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));

    uint lane = gl_SubgroupInvocationID;
    uint rsub = lane / p.cluster;      // which of the subgroup's rows
    uint l = lane - rsub * p.cluster;  // lane within the row's cluster
    uint row = (local_wg * (256u / gl_SubgroupSize) + gl_SubgroupID) * p.rows_per_sg + rsub;
    float acc[8];
    for (uint c = 0u; c < 8u; ++c) acc[c] = 0.0;
    if (row < nout) {
#ifdef LLMX_Q8W
        {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = row * nblocks * 17u / 2u;   // words: a pair is 17
            uint group = l / 4u, t = l - group * 4u;   // four lanes per pair
            uint groups = p.cluster / 4u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 17u;
                uint wa = w32s[pi].w32[o + t];
                uint wb = w32s[pi].w32[o + t + 4u];
                uint wc = w32s[pi].w32[o + t + 8u];
                uint wd = w32s[pi].w32[o + t + 12u];
                uint we = (t == 0u) ? w32s[pi].w32[o + 16u] : 0u;
                float s0 = unpackHalf2x16(w32s[pi].w32[o]).x;
                float s1 = unpackHalf2x16(w32s[pi].w32[o + 8u]).y;
                // Block 0's words shifted by a half word with the next
                // word, which the next lane of the pair holds: lane 3's next
                // words are lane 0's second and third. Word 8's remaining
                // half is the second scale, so the word drops out.
                uint src = (lane & ~3u) | ((t + 1u) & 3u);
                uint sa = subgroupShuffle(wa, src), sb = subgroupShuffle(wb, src), sc = subgroupShuffle(wc, src);
                wa = (wa >> 16u) | ((t == 3u ? sb : sa) << 16u);
                wb = (wb >> 16u) | ((t == 3u ? sc : sb) << 16u);
                if (t == 0u) wc = 0u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a2 = xa_col(col) / 2u + j * 16u;
                    int p0 = 0, p1 = 0;
                    q8_word(wa, t, a2, p0, p1);
                    q8_word(wb, t + 4u, a2, p0, p1);
                    q8_word(wc, t + 8u, a2, p0, p1);
                    q8_word(wd, t + 12u, a2, p0, p1);
                    if (t == 0u) q8_word(we, 16u, a2, p0, p1);
                    vec4 dd = xq_pair(col, j);
                    acc[c] += s0 * (dd.x * float(p0)) + s1 * (dd.z * float(p1));
                }
            }
        }
#endif
#if !defined(LLMX_Q8W) && !defined(LLMX_Q4) && !defined(LLMX_KQUANT) && !(defined(LLMX_K4) || defined(LLMX_K5))
        if (type == TYPE_Q8_0) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint bbase = row * nblocks * Q8_0_BYTES;   // bytes
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = bbase + b * Q8_0_BYTES;
                float scale = unpackHalf2x16(uint(w16s[pi].w16[o >> 1u])).x;
                uint q0 = hword_at(o + 2u), q1 = hword_at(o + 6u), q2 = hword_at(o + 10u), q3 = hword_at(o + 14u);
                uint q4 = hword_at(o + 18u), q5 = hword_at(o + 22u), q6 = hword_at(o + 26u), q7 = hword_at(o + 30u);
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a2 = xa_col(col) / 2u + b * 8u;
                    int s = byte_dot(q0, xq2[a2]) + byte_dot(q1, xq2[a2 + 1u]) + byte_dot(q2, xq2[a2 + 2u]) + byte_dot(q3, xq2[a2 + 3u]) +
                            byte_dot(q4, xq2[a2 + 4u]) + byte_dot(q5, xq2[a2 + 5u]) + byte_dot(q6, xq2[a2 + 6u]) + byte_dot(q7, xq2[a2 + 7u]);
                    acc[c] += scale * (xq_block(col, b).x * float(s));
                }
            }
        } else {
            uint wbase = row * p.nin;
            for (uint i = l; i < p.nin; i += p.cluster) {
                float w = wfs[pi].wf[wbase + i];
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += w * x[(p.col0 + c) * p.nin + i];
            }
        }
#endif
#ifdef LLMX_Q4
        if (type == TYPE_Q4_0 && wide != 0u) {
            // Two lanes per 9-word pair, a block each, both loading five
            // words: lane 0 words 0..4, whose low half is the scale and
            // whose nibble bytes start two bytes in, so each nibble word is
            // assembled from two; lane 1 words 4..8, the scale in the high
            // half of word 4 and the nibble words aligned after it.
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = row * nblocks * 9u / 2u;   // words: a pair is 9
            uint group = l / 2u, t = l - group * 2u;
            uint groups = p.cluster / 2u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 9u + 4u * t;
                uint wa = w32s[pi].w32[o], wb = w32s[pi].w32[o + 1u], wc = w32s[pi].w32[o + 2u];
                uint wd = w32s[pi].w32[o + 3u], we = w32s[pi].w32[o + 4u];
                float d;
                uint n0, n1, n2, n3;
                if (t == 0u) {
                    d = unpackHalf2x16(wa).x;
                    n0 = (wa >> 16u) | (wb << 16u);
                    n1 = (wb >> 16u) | (wc << 16u);
                    n2 = (wc >> 16u) | (wd << 16u);
                    n3 = (wd >> 16u) | (we << 16u);
                } else {
                    d = unpackHalf2x16(wa).y;
                    n0 = wb; n1 = wc; n2 = wd; n3 = we;
                }
                uint b = 2u * j + t;
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    uvec4 lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    int pl = 0, ph = 0;
                    nibble_dots(n0, 0u, 0u, 0u, 0u, lo0.xy, hi0.xy, pl, ph);
                    nibble_dots(n1, 0u, 0u, 0u, 0u, lo0.zw, hi0.zw, pl, ph);
                    nibble_dots(n2, 0u, 0u, 0u, 0u, lo1.xy, hi1.xy, pl, ph);
                    nibble_dots(n3, 0u, 0u, 0u, 0u, lo1.zw, hi1.zw, pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += d * (xb.x * float(pl + ph) - 8.0 * xb.y);
                }
            }
        } else if (type == TYPE_Q4_0) {
            // 16-bit loads over 18-byte blocks for an odd block count.
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint bbase = row * nblocks * Q4_0_BYTES;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = bbase + b * Q4_0_BYTES;
                float d = unpackHalf2x16(uint(w16s[pi].w16[o >> 1u])).x;
                uint n0 = hword_at(o + 2u), n1 = hword_at(o + 6u), n2 = hword_at(o + 10u), n3 = hword_at(o + 14u);
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    uvec4 lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    int pl = 0, ph = 0;
                    nibble_dots(n0, 0u, 0u, 0u, 0u, lo0.xy, hi0.xy, pl, ph);
                    nibble_dots(n1, 0u, 0u, 0u, 0u, lo0.zw, hi0.zw, pl, ph);
                    nibble_dots(n2, 0u, 0u, 0u, 0u, lo1.xy, hi1.xy, pl, ph);
                    nibble_dots(n3, 0u, 0u, 0u, 0u, lo1.zw, hi1.zw, pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += d * (xb.x * float(pl + ph) - 8.0 * xb.y);
                }
            }
        } else {
            // Q4_1: one lane per 5-word block, d and m in word 0.
            uint nblocks = p.nin / 32u;
            uint wbase = row * nblocks * 5u;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * 5u;
                uint w0 = w32s[pi].w32[o];
                uint w1 = w32s[pi].w32[o + 1u], w2 = w32s[pi].w32[o + 2u];
                uint w3 = w32s[pi].w32[o + 3u], w4 = w32s[pi].w32[o + 4u];
                vec2 dm = unpackHalf2x16(w0);
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    uvec4 lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    int pl = 0, ph = 0;
                    nibble_dots(w1, 0u, 0u, 0u, 0u, lo0.xy, hi0.xy, pl, ph);
                    nibble_dots(w2, 0u, 0u, 0u, 0u, lo0.zw, hi0.zw, pl, ph);
                    nibble_dots(w3, 0u, 0u, 0u, 0u, lo1.xy, hi1.xy, pl, ph);
                    nibble_dots(w4, 0u, 0u, 0u, 0u, lo1.zw, hi1.zw, pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += dm.x * (xb.x * float(pl + ph)) + dm.y * xb.y;
                }
            }
        }
#endif
#if defined(LLMX_K4) || defined(LLMX_K5)
        {
            // Q4_K and Q5_K: eight lanes per block, lane t taking the 16
            // nibble bytes h * 16.. of 64-value chunk c (c = t / 2, h = t
            // mod 2), whose low nibbles are group 2c at positions c * 64 +
            // h * 16 + i and whose high nibbles are group 2c + 1 at c * 64
            // + 32 + h * 16 + i. Every lane reads the three packed
            // sub-scale words; both block sizes are multiples of four.
            // Q5_K's fifth bits are bits 2c and 2c + 1 of each byte of the
            // matching word of the 32 high-bit bytes.
#ifdef LLMX_K5
            const uint q5 = 1u;
#else
            const uint q5 = 0u;
#endif
            uint bw = (q5 != 0u ? Q5_K_BYTES : Q4_K_BYTES) / 4u;
            uint nblocks = p.nin / Q6_K_BLOCK;
            uint wbase = row * nblocks * bw;
            uint group = l / 8u, t = l - group * 8u;
            uint groups = p.cluster / 8u;
            uint c = t / 2u, h = t - c * 2u;
            uint sl = 2u * c, sh = 2u * c + 1u;
            for (uint b = group; b < nblocks; b += groups) {
                uint o = wbase + b * bw;
                vec2 dd = unpackHalf2x16(w32s[pi].w32[o]);   // d, dmin
                uint s0 = w32s[pi].w32[o + 1u], s1 = w32s[pi].w32[o + 2u], s2 = w32s[pi].w32[o + 3u];
                uint qo = o + (q5 != 0u ? 12u : 4u) + c * 8u + h * 4u;
                uint n0 = w32s[pi].w32[qo], n1 = w32s[pi].w32[qo + 1u];
                uint n2 = w32s[pi].w32[qo + 2u], n3 = w32s[pi].w32[qo + 3u];
                // Fifth bits for the two pairs of each word's low and high
                // nibbles, already in bit 4 of each 16-bit lane.
                uint hl0[4], hl1[4], hh0[4], hh1[4];
                for (uint k = 0u; k < 4u; ++k) { hl0[k] = 0u; hl1[k] = 0u; hh0[k] = 0u; hh1[k] = 0u; }
                if (q5 != 0u) {
                    uint ho = o + 4u + h * 4u;
                    for (uint k = 0u; k < 4u; ++k) {
                        uint hb = w32s[pi].w32[ho + k];
                        hl0[k] = ((hb >> sl) & 0x00010001u) << 4u;
                        hl1[k] = ((hb >> (sl + 8u)) & 0x00010001u) << 4u;
                        hh0[k] = ((hb >> sh) & 0x00010001u) << 4u;
                        hh1[k] = ((hb >> (sh + 8u)) & 0x00010001u) << 4u;
                    }
                }
                float scl, mnl, sch, mnh;
                scale_min_words(s0, s1, s2, 2u * c, scl, mnl);
                scale_min_words(s0, s1, s2, 2u * c + 1u, sch, mnh);
                uint bl = b * 8u + 2u * c;   // the low group's 32-block, the high group's is next
                for (uint cc = 0u; cc < p.ncols; ++cc) {
                    uint col = p.col0 + cc;
                    uint a4 = xa_col(col) / 4u + (b * 256u + c * 64u + h * 16u) / 8u;
                    uvec4 lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 4u], hi1 = xq4[a4 + 5u];
                    int pl = 0, ph = 0;
                    nibble_dots(n0, hl0[0], hl1[0], hh0[0], hh1[0], lo0.xy, hi0.xy, pl, ph);
                    nibble_dots(n1, hl0[1], hl1[1], hh0[1], hh1[1], lo0.zw, hi0.zw, pl, ph);
                    nibble_dots(n2, hl0[2], hl1[2], hh0[2], hh1[2], lo1.xy, hi1.xy, pl, ph);
                    nibble_dots(n3, hl0[3], hl1[3], hh0[3], hh1[3], lo1.zw, hi1.zw, pl, ph);
                    vec2 xl = xq_block(col, bl), xh = xq_block(col, bl + 1u);
                    acc[cc] += dd.x * (scl * (xl.x * float(pl)) + sch * (xh.x * float(ph)));
                    // The mins multiply the whole group's sum; the group's
                    // two lanes reduce together, so one of them applies it.
                    if (h == 0u) acc[cc] -= dd.y * (mnl * xl.y + mnh * xh.y);
                }
            }
        }
#endif
#ifdef LLMX_KQUANT
        {
            // Q6_K: sixteen lanes per block, lane t taking positions l0..l0+3
            // of half n. Position l0 + i of a half has four values, one per
            // 32-group: low nibble of ql[l0 + i] with bits 0..1 of qh[l0 + i],
            // low nibble of ql[l0 + 32 + i] with bits 2..3, the high nibbles
            // with bits 4..5 and 6..7; each group has its own sub-scale,
            // and sub-scale index l0 / 16 is the same for the lane's four.
            // A group's four values are packed as unsigned bytes 0..63 and
            // the -32 offset folded through the block sum.
            uint nblocks = p.nin / Q6_K_BLOCK;
            uint bbase = row * nblocks * Q6_K_BYTES;   // bytes
            uint group = l / 16u, t = l - group * 16u;
            uint groups = p.cluster / 16u;
            uint n = t / 8u, l0 = (t - n * 8u) * 4u;
            for (uint b = group; b < nblocks; b += groups) {
                uint o = bbase + b * Q6_K_BYTES;
                uint ql_lo = word_at(o + n * 64u + l0);
                uint ql_hi = word_at(o + n * 64u + 32u + l0);
                uint qh = word_at(o + 128u + n * 32u + l0);
                uint sc_a = word_at(o + 192u + n * 8u), sc_b = word_at(o + 192u + n * 8u + 4u);
                float d = half_word_at(o + 208u);
                // Sub-scales of groups 0..3 are bytes l0/16 + 0, 2, 4, 6.
                uint sh = (l0 / 16u) * 8u;
                float s0 = float((int(sc_a << (24u - sh))) >> 24);
                float s1 = float((int(sc_a << (8u - sh))) >> 24);
                float s2 = float((int(sc_b << (24u - sh))) >> 24);
                float s3 = float((int(sc_b << (8u - sh))) >> 24);
                uint q0 = (ql_lo & 0x0F0F0F0Fu) | ((qh & 0x03030303u) << 4u);
                uint q1 = (ql_hi & 0x0F0F0F0Fu) | (((qh >> 2u) & 0x03030303u) << 4u);
                uint q2 = ((ql_lo >> 4u) & 0x0F0F0F0Fu) | (((qh >> 4u) & 0x03030303u) << 4u);
                uint q3 = ((ql_hi >> 4u) & 0x0F0F0F0Fu) | (((qh >> 6u) & 0x03030303u) << 4u);
                uint bg = b * 8u + n * 4u;   // the 32-block of group 0
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col = p.col0 + c;
                    uint a2 = xa_col(col) / 2u + (b * Q6_K_BLOCK + n * 128u + l0) / 4u;
                    int p0 = pair_dot(q0 & 0x00FF00FFu, (q0 >> 8u) & 0x00FF00FFu, xq2[a2]);
                    int p1 = pair_dot(q1 & 0x00FF00FFu, (q1 >> 8u) & 0x00FF00FFu, xq2[a2 + 8u]);
                    int p2 = pair_dot(q2 & 0x00FF00FFu, (q2 >> 8u) & 0x00FF00FFu, xq2[a2 + 16u]);
                    int p3 = pair_dot(q3 & 0x00FF00FFu, (q3 >> 8u) & 0x00FF00FFu, xq2[a2 + 24u]);
                    float x0 = xq_block(col, bg).x, x1 = xq_block(col, bg + 1u).x;
                    float x2 = xq_block(col, bg + 2u).x, x3 = xq_block(col, bg + 3u).x;
                    acc[c] += d * (s0 * (x0 * float(p0)) + s1 * (x1 * float(p1)) +
                                   s2 * (x2 * float(p2)) + s3 * (x3 * float(p3)));
                    // The -32 offset times each half-group's sum under that
                    // half's sub-scale, applied by the first lane of each
                    // half among the eight that reduce together.
                    if (l0 == 0u || l0 == 16u) {
                        vec2 h0 = xq_halves(col, bg), h1 = xq_halves(col, bg + 1u);
                        vec2 h2 = xq_halves(col, bg + 2u), h3 = xq_halves(col, bg + 3u);
                        acc[c] -= d * 32.0 * (l0 == 0u ? s0 * h0.x + s1 * h1.x + s2 * h2.x + s3 * h3.x
                                                       : s0 * h0.y + s1 * h1.y + s2 * h2.y + s3 * h3.y);
                    }
                }
            }
        }
#endif
    }
    // Reduce within each cluster of lanes; every lane joins every shuffle
    // and lanes past the last row add zero.
    for (uint c = 0u; c < p.ncols; ++c) {
        float s = acc[c];
        for (uint off = p.cluster / 2u; off > 0u; off >>= 1u) s += subgroupShuffleXor(s, off);
        if (l == 0u && row < nout && c < p.ncols) {
            if (p.accum != 0u) ys[pi].y[(p.col0 + c) * nout + row] += s;
            else ys[pi].y[(p.col0 + c) * nout + row] = s;
        }
    }
}
