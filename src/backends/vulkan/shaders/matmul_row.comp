#version 450
// Y[b*nout + o] = dot(row o, X column b), the decode kernel, for up to three projections of one X in one dispatch (a layer's q, k and v, or gate and up).
// Workgroups go to projections in order, so a workgroup's projection and buffers are uniform.
// A subgroup takes `rows_per_sg` rows, each on a cluster of `cluster` lanes that stride over the row's work units and reduce with xor shuffles; a lane keeps up to eight batch columns in registers.
//
// Quantized rows meet the activations as a signed 16-bit twin in blocks of 32 (xquant.glsl) with the block's scale and scaled sums; a type's offset (Q4_0's -8, Q4_1's min, the K-quant mins, Q6_K's -32) is folded through the block sum. F32 rows keep float activations.
//
// One module per family of types, since one module for all of them raised every path's registers: as is for F32 and narrow Q8_0, LLMX_Q8W wide Q8_0, LLMX_Q4 Q4_0 and Q4_1, LLMX_K4 Q4_K, LLMX_K5 Q5_K, LLMX_KQUANT Q6_K.
//
// Wide Q8_0: four lanes share a 68-byte block pair, lane t loading words t, t + 4, t + 8, t + 12 and lane 0 word 16; block 0's quants start two bytes into its words, so each lane shifts them by a half word with the next lane's word.
// Q4_0 with an even block count: two lanes share a 36-byte pair.
// Q4_1: one lane per 20-byte block.
// Q6_K: 210-byte blocks, eight lanes a block, every other block two bytes off word alignment.
// Measurements behind these layouts are in docs/VULKAN.md.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#ifdef LLMX_DOT
#extension GL_EXT_integer_dot_product : require
#endif
#if defined(LLMX_X8) && !defined(LLMX_DOT)
#error "the 8-bit twin is read only through the integer dot"
#endif
#if defined(LLMX_DOT) && !(defined(LLMX_Q4) || defined(LLMX_K4) || defined(LLMX_K5) || defined(LLMX_KQUANT))
#error "Q8_0 and F32 rows take matmul_vec_q8.comp and the plain build on integer-dot devices"
#endif
#include "q.glsl"
layout(local_size_x = 256) in;
// Batch columns a lane keeps in registers, specialization constant 0; the backend takes the one-column build for a one-column chunk, which frees the registers seven unused accumulators would hold.
layout(constant_id = 0) const uint MAX_COLS = 8;
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint col0; uint ncols; uint cluster; uint rows_per_sg; uint nproj;
    uint nout0; uint type0; uint wide0; uint start0;
    uint nout1; uint type1; uint wide1; uint start1;
    uint nout2; uint type2; uint wide2; uint start2;
    uint accum;   // Y += rather than Y =, the residual add folded in
    uint per;
} p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; } w16s[3];
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; } w32s[3];
layout(set = 0, binding = 3) readonly buffer WF { float wf[]; } wfs[3];
layout(set = 0, binding = 4) readonly buffer X { float x[]; };
// The weights as 16-byte vectors, for the K-quant blocks whose sizes are multiples of 16.
layout(set = 0, binding = 5) readonly buffer W128 { uvec4 w128[]; } w128s[3];
// The quantized activations (xquant.glsl), one buffer bound four ways: four values, eight, a table entry or a pair of entries per load.
// The default build reads the 16-bit twin: per column nin / 2 words of pairs, then per block the scale and scaled sum, then per block the scaled half sums.
// LLMX_X8 reads the 8-bit twin: per column nin / 4 words of bytes in position order, then per block the scale and scaled sum (vulkan_backend.cpp, reads_x8).
// Four values are one xq2 element and eight one xq4 element in both, so indices are the same; XA and XB take an xq4 element's first and second four values.
#ifdef LLMX_X8
layout(set = 0, binding = 6) readonly buffer XQ2 { uint xq2[]; };
layout(set = 0, binding = 7) readonly buffer XQ4 { uvec2 xq4[]; };
#define XQ4T uvec2
#define XWT uint
#define XA(v) (v).x
#define XB(v) (v).y
#else
layout(set = 0, binding = 6) readonly buffer XQ2 { uvec2 xq2[]; };
layout(set = 0, binding = 7) readonly buffer XQ4 { uvec4 xq4[]; };
#define XQ4T uvec4
#define XWT uvec2
#define XA(v) (v).xy
#define XB(v) (v).zw
#endif
layout(set = 0, binding = 8) readonly buffer XT2 { vec2 xt2[]; };
layout(set = 0, binding = 9) readonly buffer XT4 { vec4 xt4[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs one entry per workgroup row y: entry e reads X column e / per through the rows of expert ids[e] and writes output row e.
layout(set = 0, binding = 10) readonly buffer IDS { uint ids[]; };

uint pi = 0u;

// Offset in pair words into the quantized activations of column c.
uint xa_col(uint c) { return c * p.nin / 2u; }
// A block's scale d and d times its integer sum.
#ifdef LLMX_X8
#define XTAB2 (p.nbatch * p.nin / 8u)
#else
#define XTAB2 (p.nbatch * p.nin / 4u)
#endif
vec2 xq_block(uint c, uint b) { return xt2[XTAB2 + c * (p.nin / 32u) + b]; }
// The scale entries of blocks 2j and 2j + 1 in one load, and likewise their scaled half sums.
vec4 xq_pair(uint c, uint j) { return xt4[XTAB2 / 2u + c * (p.nin / 64u) + j]; }
#ifndef LLMX_X8
vec4 xq_halves_pair(uint c, uint j) {
    return xt4[(p.nbatch * p.nin / 4u + p.nbatch * p.nin / 32u) / 2u + c * (p.nin / 64u) + j];
}
#endif
// The dots in two forms, picked per device (backends/device_profile.hpp): LLMX_DOT through the integer dot product extension, otherwise plain multiplies.
#ifdef LLMX_X8
#define QDOT int
// Four signed bytes against four 8-bit activations, the four-wide dot.
int dot4(uint a, uint b) { return dotPacked4x8EXT(int(a), int(b)); }
#elif defined(LLMX_DOT)
#define QDOT int
// Two pairs of 16-bit values against two activation pair words.
int pair_dot(uint a, uint b, uvec2 xw) {
    return dotEXT(unpack16(int(a)), unpack16(int(xw.x))) + dotEXT(unpack16(int(b)), unpack16(int(xw.y)));
}
#else
#define QDOT float
// The signed halves of a word, and one signed byte of it.
int lo16(uint w) { return int(int16_t(w)); }
int hi16(uint w) { return int(int16_t(w >> 16u)); }
int byte_at(uint w, uint s) { return int(int8_t(w >> s)); }
// The nibble and K-quant dots multiply as floats, because the chip's 32-bit integer multiply is quarter rate.
// Every caller passes non-negative quants of at most six bits against 16-bit activations, so the sums stay below 2^24 and are exact (the bound per type is in docs/VULKAN.md).
float pair_dot(uint a, uint b, uvec2 xw) {
    return float(a & 0xFFFFu) * float(lo16(xw.x)) + float(a >> 16u) * float(hi16(xw.x))
         + float(b & 0xFFFFu) * float(lo16(xw.y)) + float(b >> 16u) * float(hi16(xw.y));
}
// Q8_0's weights are signed and its sums can exceed 2^24, so it keeps the integer multiply.
int byte_dot(uint w, uvec2 xw) {
    return byte_at(w, 0u) * lo16(xw.x) + byte_at(w, 16u) * hi16(xw.x) + byte_at(w, 8u) * lo16(xw.y) + byte_at(w, 24u) * hi16(xw.y);
}
#endif
// A word at any even byte offset, two 16-bit loads.
uint hword_at(uint byte_off) {
    uint h = byte_off >> 1u;
    return uint(w16s[pi].w16[h]) | (uint(w16s[pi].w16[h + 1u]) << 16u);
}

#ifdef LLMX_Q8W
// Word d of a Q8_0 pair shifted so block 0's words 0..7 hold values 4d..4d+3 and block 1's words 9..16 hold 32+4(d-9)..; word 8 is zero. `a2` is the pair's first pair-word couple.
void q8_word(uint w, uint d, uint a2, inout int p0, inout int p1) {
    int r = byte_dot(w, xq2[d < 8u ? a2 + d : a2 + 8u + d - 9u]);
    if (d < 8u) p0 += r; else p1 += r;
}
#endif

#if defined(LLMX_Q4) || defined(LLMX_K4) || defined(LLMX_K5)
// The eight nibbles of a word: byte i's low nibble is position 4k + i of a group, its high nibble the same position 16 (Q4_0, Q4_1) or 32 (Q4_K, Q5_K) on.
// Low and high go to separate dots since the K-quants scale them apart; `hb` carries Q5_K's fifth bit in bit 4 of each pair word, zero otherwise.
void nibble_dots(uint w, uint hl0, uint hl1, uint hh0, uint hh1, XWT xl, XWT xh, inout QDOT pl, inout QDOT ph) {
#ifdef LLMX_X8
    pl += dot4((w & 0x0F0F0F0Fu) | hl0 | (hl1 << 8u), xl);
    ph += dot4(((w >> 4u) & 0x0F0F0F0Fu) | hh0 | (hh1 << 8u), xh);
#else
    pl += pair_dot((w & 0x000F000Fu) | hl0, ((w >> 8u) & 0x000F000Fu) | hl1, xl);
    ph += pair_dot(((w >> 4u) & 0x000F000Fu) | hh0, ((w >> 12u) & 0x000F000Fu) | hh1, xh);
#endif
}
// Q5_K's fifth bits for one nibble word: bit s of each byte of `hb`, placed in bit 4 of each 16-bit lane.
uint fifth(uint hb, uint s) { return ((hb >> s) & 0x00010001u) << 4u; }
#endif

#if defined(LLMX_KQUANT) && defined(LLMX_X8)
// Four 6-bit values, a byte each, as the signed bytes value - 32: flipping bit 5 gives value - 32 or value + 32, and a set bit 5 then means negative, so it is copied into bits 6 and 7.
uint signed6(uint q) {
    uint t = q ^ 0x20202020u, neg = t & 0x20202020u;
    return t | (neg << 1u) | (neg << 2u);
}
#endif

#if defined(LLMX_KQUANT) || defined(LLMX_K4) || defined(LLMX_K5)
// A word at any even byte offset: aligned, or the high half of one word and the low half of the next.
uint word_at(uint byte_off) {
    uint i = byte_off >> 2u;
    if ((byte_off & 3u) == 0u) return w32s[pi].w32[i];
    return (w32s[pi].w32[i] >> 16u) | (w32s[pi].w32[i + 1u] << 16u);
}
// Two consecutive words at any even byte offset, three loads when unaligned.
void words_at(uint byte_off, out uint a, out uint b) {
    uint i = byte_off >> 2u;
    if ((byte_off & 3u) == 0u) { a = w32s[pi].w32[i]; b = w32s[pi].w32[i + 1u]; return; }
    uint w0 = w32s[pi].w32[i], w1 = w32s[pi].w32[i + 1u], w2 = w32s[pi].w32[i + 2u];
    a = (w0 >> 16u) | (w1 << 16u);
    b = (w1 >> 16u) | (w2 << 16u);
}
float half_word_at(uint byte_off) {
    uint w = w32s[pi].w32[byte_off >> 2u];
    return (byte_off & 3u) == 0u ? unpackHalf2x16(w).x : unpackHalf2x16(w).y;
}
// The sub-scales and sub-mins of groups 2c and 2c + 1 from the twelve packed bytes in three words (quant/k_quants.hpp): groups 0..3 are the low six bits of bytes 0..3 (scales) and 4..7 (mins), groups 4..7 the nibbles of bytes 8..11 with the earlier bytes' top two bits above.
// Branch-free, since the lanes of a block hold different c.
void scale_min_pair(uint s0, uint s1, uint s2, uint c, out float scl, out float mnl, out float sch, out float mnh) {
    uint sh = 16u * (c & 1u);   // the two groups' bytes within their words
    uint a0 = s0 >> sh, a1 = s1 >> sh, a2 = s2 >> sh;
    bool low = c < 2u;
    scl = float(low ? a0 & 63u : (a2 & 15u) | (((a0 >> 6u) & 3u) << 4u));
    mnl = float(low ? a1 & 63u : ((a2 >> 4u) & 15u) | (((a1 >> 6u) & 3u) << 4u));
    sch = float(low ? (a0 >> 8u) & 63u : ((a2 >> 8u) & 15u) | (((a0 >> 14u) & 3u) << 4u));
    mnh = float(low ? (a1 >> 8u) & 63u : ((a2 >> 12u) & 15u) | (((a1 >> 14u) & 3u) << 4u));
}
#endif

void main() {
    // Which projection this workgroup belongs to, uniform across it.
    uint wg = gl_WorkGroupID.x;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint type = pi == 0u ? p.type0 : (pi == 1u ? p.type1 : p.type2);
    uint wide = pi == 0u ? p.wide0 : (pi == 1u ? p.wide1 : p.wide2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));

    uint lane = gl_SubgroupInvocationID;
    uint rsub = lane / p.cluster;      // which of the subgroup's rows
    uint l = lane - rsub * p.cluster;  // lane within the row's cluster
    uint row = (local_wg * (256u / gl_SubgroupSize) + gl_SubgroupID) * p.rows_per_sg + rsub;
    uint col0 = p.col0, out0 = p.col0, wrow = row;
    if (p.per != 0u) {
        uint e = gl_WorkGroupID.y;
        col0 = e / p.per;
        out0 = e;
        wrow = ids[e] * nout + row;
    }
    // One in the one-column build, so the column loops collapse.
    const uint ncols = MAX_COLS == 1u ? 1u : p.ncols;
    float acc[MAX_COLS];
    for (uint c = 0u; c < MAX_COLS; ++c) acc[c] = 0.0;
    if (row < nout) {
#ifdef LLMX_Q8W
        {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = wrow * nblocks * 17u / 2u;   // words: a pair is 17
            uint group = l / 4u, t = l - group * 4u;   // four lanes per pair
            uint groups = p.cluster / 4u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 17u;
                uint wa = w32s[pi].w32[o + t];
                uint wb = w32s[pi].w32[o + t + 4u];
                uint wc = w32s[pi].w32[o + t + 8u];
                uint wd = w32s[pi].w32[o + t + 12u];
                uint we = (t == 0u) ? w32s[pi].w32[o + 16u] : 0u;
                float s0 = unpackHalf2x16(w32s[pi].w32[o]).x;
                float s1 = unpackHalf2x16(w32s[pi].w32[o + 8u]).y;
                // Block 0's words shifted by a half word with the next word, held by the next lane of the pair; word 8's remaining half is the second scale, so it drops out.
                uint src = (lane & ~3u) | ((t + 1u) & 3u);
                uint sa = subgroupShuffle(wa, src), sb = subgroupShuffle(wb, src), sc = subgroupShuffle(wc, src);
                wa = (wa >> 16u) | ((t == 3u ? sb : sa) << 16u);
                wb = (wb >> 16u) | ((t == 3u ? sc : sb) << 16u);
                if (t == 0u) wc = 0u;
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a2 = xa_col(col) / 2u + j * 16u;
                    int p0 = 0, p1 = 0;
                    q8_word(wa, t, a2, p0, p1);
                    q8_word(wb, t + 4u, a2, p0, p1);
                    q8_word(wc, t + 8u, a2, p0, p1);
                    q8_word(wd, t + 12u, a2, p0, p1);
                    if (t == 0u) q8_word(we, 16u, a2, p0, p1);
                    vec4 dd = xq_pair(col, j);
                    acc[c] += s0 * (dd.x * float(p0)) + s1 * (dd.z * float(p1));
                }
            }
        }
#endif
#if !defined(LLMX_Q8W) && !defined(LLMX_Q4) && !defined(LLMX_KQUANT) && !(defined(LLMX_K4) || defined(LLMX_K5))
        if (type == TYPE_Q8_0) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint bbase = wrow * nblocks * Q8_0_BYTES;   // bytes
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = bbase + b * Q8_0_BYTES;
                float scale = unpackHalf2x16(uint(w16s[pi].w16[o >> 1u])).x;
                uint q0 = hword_at(o + 2u), q1 = hword_at(o + 6u), q2 = hword_at(o + 10u), q3 = hword_at(o + 14u);
                uint q4 = hword_at(o + 18u), q5 = hword_at(o + 22u), q6 = hword_at(o + 26u), q7 = hword_at(o + 30u);
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a2 = xa_col(col) / 2u + b * 8u;
                    int s = byte_dot(q0, xq2[a2]) + byte_dot(q1, xq2[a2 + 1u]) + byte_dot(q2, xq2[a2 + 2u]) + byte_dot(q3, xq2[a2 + 3u]) +
                            byte_dot(q4, xq2[a2 + 4u]) + byte_dot(q5, xq2[a2 + 5u]) + byte_dot(q6, xq2[a2 + 6u]) + byte_dot(q7, xq2[a2 + 7u]);
                    acc[c] += scale * (xq_block(col, b).x * float(s));
                }
            }
        } else if (p.nin % 4u == 0u) {
            // F32 rows four values a load: the weights through the 16-byte view, X through the twin's vec4 view, which F32 rows have bound to X itself.
            uint n4 = p.nin / 4u, wbase4 = wrow * n4;
            for (uint i = l; i < n4; i += p.cluster) {
                vec4 w = uintBitsToFloat(w128s[pi].w128[wbase4 + i]);
                for (uint c = 0u; c < ncols; ++c) acc[c] += dot(w, xt4[(col0 + c) * n4 + i]);
            }
        } else {
            uint wbase = wrow * p.nin;
            for (uint i = l; i < p.nin; i += p.cluster) {
                float w = wfs[pi].wf[wbase + i];
                for (uint c = 0u; c < ncols; ++c) acc[c] += w * x[(col0 + c) * p.nin + i];
            }
        }
#endif
#ifdef LLMX_Q4
        if (type == TYPE_Q4_0 && wide != 0u) {
            // Two lanes per 9-word pair, a block each: lane 0 words 0..4 (the scale, then nibble bytes starting two bytes in), lane 1 words 4..8 (the scale in word 4's high half, then aligned nibble words).
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = wrow * nblocks * 9u / 2u;   // words: a pair is 9
            uint group = l / 2u, t = l - group * 2u;
            uint groups = p.cluster / 2u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 9u + 4u * t;
                uint wa = w32s[pi].w32[o], wb = w32s[pi].w32[o + 1u], wc = w32s[pi].w32[o + 2u];
                uint wd = w32s[pi].w32[o + 3u], we = w32s[pi].w32[o + 4u];
                float d;
                uint n0, n1, n2, n3;
                if (t == 0u) {
                    d = unpackHalf2x16(wa).x;
                    n0 = (wa >> 16u) | (wb << 16u);
                    n1 = (wb >> 16u) | (wc << 16u);
                    n2 = (wc >> 16u) | (wd << 16u);
                    n3 = (wd >> 16u) | (we << 16u);
                } else {
                    d = unpackHalf2x16(wa).y;
                    n0 = wb; n1 = wc; n2 = wd; n3 = we;
                }
                uint b = 2u * j + t;
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    XQ4T lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    QDOT pl = QDOT(0);
                    QDOT ph = QDOT(0);
                    nibble_dots(n0, 0u, 0u, 0u, 0u, XA(lo0), XA(hi0), pl, ph);
                    nibble_dots(n1, 0u, 0u, 0u, 0u, XB(lo0), XB(hi0), pl, ph);
                    nibble_dots(n2, 0u, 0u, 0u, 0u, XA(lo1), XA(hi1), pl, ph);
                    nibble_dots(n3, 0u, 0u, 0u, 0u, XB(lo1), XB(hi1), pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += d * (xb.x * float(pl + ph) - 8.0 * xb.y);
                }
            }
        } else if (type == TYPE_Q4_0) {
            // 16-bit loads over 18-byte blocks for an odd block count.
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint bbase = wrow * nblocks * Q4_0_BYTES;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = bbase + b * Q4_0_BYTES;
                float d = unpackHalf2x16(uint(w16s[pi].w16[o >> 1u])).x;
                uint n0 = hword_at(o + 2u), n1 = hword_at(o + 6u), n2 = hword_at(o + 10u), n3 = hword_at(o + 14u);
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    XQ4T lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    QDOT pl = QDOT(0);
                    QDOT ph = QDOT(0);
                    nibble_dots(n0, 0u, 0u, 0u, 0u, XA(lo0), XA(hi0), pl, ph);
                    nibble_dots(n1, 0u, 0u, 0u, 0u, XB(lo0), XB(hi0), pl, ph);
                    nibble_dots(n2, 0u, 0u, 0u, 0u, XA(lo1), XA(hi1), pl, ph);
                    nibble_dots(n3, 0u, 0u, 0u, 0u, XB(lo1), XB(hi1), pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += d * (xb.x * float(pl + ph) - 8.0 * xb.y);
                }
            }
        } else {
            // Q4_1: one lane per 5-word block, d and m in word 0.
            uint nblocks = p.nin / 32u;
            uint wbase = wrow * nblocks * 5u;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * 5u;
                uint w0 = w32s[pi].w32[o];
                uint w1 = w32s[pi].w32[o + 1u], w2 = w32s[pi].w32[o + 2u];
                uint w3 = w32s[pi].w32[o + 3u], w4 = w32s[pi].w32[o + 4u];
                vec2 dm = unpackHalf2x16(w0);
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a4 = xa_col(col) / 4u + b * 4u;
                    XQ4T lo0 = xq4[a4], lo1 = xq4[a4 + 1u], hi0 = xq4[a4 + 2u], hi1 = xq4[a4 + 3u];
                    QDOT pl = QDOT(0);
                    QDOT ph = QDOT(0);
                    nibble_dots(w1, 0u, 0u, 0u, 0u, XA(lo0), XA(hi0), pl, ph);
                    nibble_dots(w2, 0u, 0u, 0u, 0u, XB(lo0), XB(hi0), pl, ph);
                    nibble_dots(w3, 0u, 0u, 0u, 0u, XA(lo1), XA(hi1), pl, ph);
                    nibble_dots(w4, 0u, 0u, 0u, 0u, XB(lo1), XB(hi1), pl, ph);
                    vec2 xb = xq_block(col, b);
                    acc[c] += dm.x * (xb.x * float(pl + ph)) + dm.y * xb.y;
                }
            }
        }
#endif
#if defined(LLMX_K4) || defined(LLMX_K5)
        {
            // Q4_K and Q5_K: eight lanes per block, lane t taking 16 nibble bytes h * 16.. of 64-value chunk c (c = t / 2, h = t mod 2): low nibbles are group 2c at c * 64 + h * 16 + i, high nibbles group 2c + 1 at c * 64 + 32 + h * 16 + i.
            // Q5_K's fifth bits are bits 2c and 2c + 1 of each byte of the matching high-bit word.
#ifdef LLMX_K5
            const uint q5 = 1u;
#else
            const uint q5 = 0u;
#endif
            uint bw = (q5 != 0u ? Q5_K_BYTES : Q4_K_BYTES) / 4u;
            uint nblocks = p.nin / Q6_K_BLOCK;
            uint wbase = wrow * nblocks * bw;
            uint group = l / 8u, t = l - group * 8u;
            uint groups = p.cluster / 8u;
            uint c = t / 2u, h = t - c * 2u;
            uint sl = 2u * c, sh = 2u * c + 1u;
            for (uint b = group; b < nblocks; b += groups) {
                uint o = wbase + b * bw;
                uvec4 hd = w128s[pi].w128[o / 4u];   // d and dmin, then the three sub-scale words
                vec2 dd = unpackHalf2x16(hd.x);
                uint s0 = hd.y, s1 = hd.z, s2 = hd.w;
                uvec4 nq = w128s[pi].w128[(o + (q5 != 0u ? 12u : 4u) + c * 8u + h * 4u) / 4u];
                // Q5_K's fifth bits, unpacked just before each word's dots.
                uvec4 hbv = uvec4(0u);
                if (q5 != 0u) hbv = w128s[pi].w128[(o + 4u + h * 4u) / 4u];
                float scl, mnl, sch, mnh;
                scale_min_pair(s0, s1, s2, c, scl, mnl, sch, mnh);
                // The block's scales folded once; the mins multiply the whole group's sum, so only one of the group's two lanes applies them.
                float dl = dd.x * scl, dh = dd.x * sch;
                float ml = h == 0u ? dd.y * mnl : 0.0, mh = h == 0u ? dd.y * mnh : 0.0;
                uint bl = b * 8u + 2u * c;   // the low group's 32-block, the high group's is next
                for (uint cc = 0u; cc < ncols; ++cc) {
                    uint col = col0 + cc;
                    uint a4 = xa_col(col) / 4u + (b * 256u + c * 64u + h * 16u) / 8u;
                    QDOT pl = QDOT(0);
                    QDOT ph = QDOT(0);
                    {
                        XQ4T lo = xq4[a4], hi = xq4[a4 + 4u];
                        nibble_dots(nq.x, fifth(hbv.x, sl), fifth(hbv.x, sl + 8u), fifth(hbv.x, sh), fifth(hbv.x, sh + 8u), XA(lo), XA(hi), pl, ph);
                        nibble_dots(nq.y, fifth(hbv.y, sl), fifth(hbv.y, sl + 8u), fifth(hbv.y, sh), fifth(hbv.y, sh + 8u), XB(lo), XB(hi), pl, ph);
                    }
                    {
                        XQ4T lo = xq4[a4 + 1u], hi = xq4[a4 + 5u];
                        nibble_dots(nq.z, fifth(hbv.z, sl), fifth(hbv.z, sl + 8u), fifth(hbv.z, sh), fifth(hbv.z, sh + 8u), XA(lo), XA(hi), pl, ph);
                        nibble_dots(nq.w, fifth(hbv.w, sl), fifth(hbv.w, sl + 8u), fifth(hbv.w, sh), fifth(hbv.w, sh + 8u), XB(lo), XB(hi), pl, ph);
                    }
                    vec4 xt = xq_pair(col, bl / 2u);   // d, ds of the low group, then the high
                    acc[cc] += dl * (xt.x * float(pl)) + dh * (xt.z * float(ph)) - (ml * xt.y + mh * xt.w);
                }
            }
        }
#endif
#ifdef LLMX_KQUANT
        {
            // Q6_K: eight lanes per block, lane t taking positions l0..l0+7 of half n.
            // Position l0 + i has one value per 32-group: low nibble of ql[l0 + i] with qh bits 0..1, low nibble of ql[l0 + 32 + i] with bits 2..3, the high nibbles with bits 4..5 and 6..7.
            // Each group has its own sub-scale, index l0 / 16 for all eight; values are packed as unsigned bytes 0..63 and the -32 offset folded through the block sum.
            uint nblocks = p.nin / Q6_K_BLOCK;
            uint bbase = wrow * nblocks * Q6_K_BYTES;   // bytes
            uint group = l / 8u, t = l - group * 8u;
            uint groups = p.cluster / 8u;
            uint n = t / 4u, l0 = (t - n * 4u) * 8u;
            for (uint b = group; b < nblocks; b += groups) {
                uint o = bbase + b * Q6_K_BYTES;
                uint lo0, lo1, hi0, hi1, qh0, qh1, sc_a, sc_b;
                words_at(o + n * 64u + l0, lo0, lo1);
                words_at(o + n * 64u + 32u + l0, hi0, hi1);
                words_at(o + 128u + n * 32u + l0, qh0, qh1);
                words_at(o + 192u + n * 8u, sc_a, sc_b);
                float d = half_word_at(o + 208u);
                // Sub-scales of groups 0..3 are bytes l0/16 + 0, 2, 4, 6.
                uint sh = (l0 / 16u) * 8u;
                float s0 = float((int(sc_a << (24u - sh))) >> 24);
                float s1 = float((int(sc_a << (8u - sh))) >> 24);
                float s2 = float((int(sc_b << (24u - sh))) >> 24);
                float s3 = float((int(sc_b << (8u - sh))) >> 24);
                uint q0a = (lo0 & 0x0F0F0F0Fu) | ((qh0 & 0x03030303u) << 4u), q0b = (lo1 & 0x0F0F0F0Fu) | ((qh1 & 0x03030303u) << 4u);
                uint q1a = (hi0 & 0x0F0F0F0Fu) | (((qh0 >> 2u) & 0x03030303u) << 4u), q1b = (hi1 & 0x0F0F0F0Fu) | (((qh1 >> 2u) & 0x03030303u) << 4u);
                uint q2a = ((lo0 >> 4u) & 0x0F0F0F0Fu) | (((qh0 >> 4u) & 0x03030303u) << 4u), q2b = ((lo1 >> 4u) & 0x0F0F0F0Fu) | (((qh1 >> 4u) & 0x03030303u) << 4u);
                uint q3a = ((hi0 >> 4u) & 0x0F0F0F0Fu) | (((qh0 >> 6u) & 0x03030303u) << 4u), q3b = ((hi1 >> 4u) & 0x0F0F0F0Fu) | (((qh1 >> 6u) & 0x03030303u) << 4u);
                uint bg = b * 8u + n * 4u;   // the 32-block of group 0
#ifdef LLMX_X8
                // On the 8-bit twin the -32 goes into each byte, so a group is two four-wide dots of signed bytes and needs no half sums.
                q0a = signed6(q0a); q0b = signed6(q0b); q1a = signed6(q1a); q1b = signed6(q1b);
                q2a = signed6(q2a); q2b = signed6(q2b); q3a = signed6(q3a); q3b = signed6(q3b);
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a4 = xa_col(col) / 4u + (b * Q6_K_BLOCK + n * 128u + l0) / 8u;
                    XQ4T x0v = xq4[a4], x1v = xq4[a4 + 4u], x2v = xq4[a4 + 8u], x3v = xq4[a4 + 12u];
                    int p0 = dot4(q0a, x0v.x) + dot4(q0b, x0v.y), p1 = dot4(q1a, x1v.x) + dot4(q1b, x1v.y);
                    int p2 = dot4(q2a, x2v.x) + dot4(q2b, x2v.y), p3 = dot4(q3a, x3v.x) + dot4(q3b, x3v.y);
                    vec4 xa = xq_pair(col, bg / 2u), xb = xq_pair(col, bg / 2u + 1u);   // d, ds of groups 0..3
                    acc[c] += d * (s0 * (xa.x * float(p0)) + s1 * (xa.z * float(p1)) +
                                   s2 * (xb.x * float(p2)) + s3 * (xb.z * float(p3)));
                }
#else
                for (uint c = 0u; c < ncols; ++c) {
                    uint col = col0 + c;
                    uint a4 = xa_col(col) / 4u + (b * Q6_K_BLOCK + n * 128u + l0) / 8u;
                    XQ4T x0v = xq4[a4], x1v = xq4[a4 + 4u], x2v = xq4[a4 + 8u], x3v = xq4[a4 + 12u];
                    QDOT p0 = pair_dot(q0a & 0x00FF00FFu, (q0a >> 8u) & 0x00FF00FFu, x0v.xy) + pair_dot(q0b & 0x00FF00FFu, (q0b >> 8u) & 0x00FF00FFu, x0v.zw);
                    QDOT p1 = pair_dot(q1a & 0x00FF00FFu, (q1a >> 8u) & 0x00FF00FFu, x1v.xy) + pair_dot(q1b & 0x00FF00FFu, (q1b >> 8u) & 0x00FF00FFu, x1v.zw);
                    QDOT p2 = pair_dot(q2a & 0x00FF00FFu, (q2a >> 8u) & 0x00FF00FFu, x2v.xy) + pair_dot(q2b & 0x00FF00FFu, (q2b >> 8u) & 0x00FF00FFu, x2v.zw);
                    QDOT p3 = pair_dot(q3a & 0x00FF00FFu, (q3a >> 8u) & 0x00FF00FFu, x3v.xy) + pair_dot(q3b & 0x00FF00FFu, (q3b >> 8u) & 0x00FF00FFu, x3v.zw);
                    vec4 xa = xq_pair(col, bg / 2u), xb = xq_pair(col, bg / 2u + 1u);   // d, ds of groups 0..3
                    acc[c] += d * (s0 * (xa.x * float(p0)) + s1 * (xa.z * float(p1)) +
                                   s2 * (xb.x * float(p2)) + s3 * (xb.z * float(p3)));
                    // The -32 offset times each half-group's sum under its sub-scale, applied by the first lane of each half.
                    if (l0 == 0u || l0 == 16u) {
                        vec4 ha = xq_halves_pair(col, bg / 2u), hb = xq_halves_pair(col, bg / 2u + 1u);
                        acc[c] -= d * 32.0 * (l0 == 0u ? s0 * ha.x + s1 * ha.z + s2 * hb.x + s3 * hb.z
                                                       : s0 * ha.y + s1 * ha.w + s2 * hb.y + s3 * hb.w);
                    }
                }
#endif
            }
        }
#endif
    }
    // Reduce within each cluster; every lane joins every shuffle and lanes past the last row add zero.
    for (uint c = 0u; c < ncols; ++c) {
        float s = acc[c];
        for (uint off = p.cluster / 2u; off > 0u; off >>= 1u) s += subgroupShuffleXor(s, off);
        if (l == 0u && row < nout && c < ncols) {
            if (p.accum != 0u) ys[pi].y[(out0 + c) * nout + row] += s;
            else ys[pi].y[(out0 + c) * nout + row] = s;
        }
    }
}
