#version 450
#include "matmul_row.glsl"
void main() {
#if defined(LLMX_IQ1) || defined(LLMX_IQ3_S) || ((defined(LLMX_IQ2_S) || defined(LLMX_IQ3_XXS) || defined(LLMX_IQ2_SMALL)) && !defined(LLMX_DOT))
    // Every invocation reaches the cache barrier, including inactive rows and empty routed groups.
    lookup_init();
#endif
#if defined(LLMX_MXFP4) && defined(LLMX_DOT)
    {
        uint i = gl_LocalInvocationIndex;
        mxfp4_pairs[i] = (uint(fp4_value(i & 15u)) & 0xFFFFu) | (uint(fp4_value(i >> 4u)) << 16u);
        barrier();
    }
#endif
    // Which projection this workgroup belongs to, uniform across it.
    uint wg = gl_WorkGroupID.x;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
#if !defined(LLMX_IQ3_S) && !defined(LLMX_IQ2_S) && !defined(LLMX_IQ3_XXS) && !defined(LLMX_IQ2_SMALL) && !defined(LLMX_IQ1)
#ifdef LLMX_ROW_F32
    // The F32 family alone, a diagnostic build that backend-vulkan --isa holds the fused route step's rows to.
    const uint type = TYPE_F32;
#else
    uint type = WEIGHT_TYPE == 0xffffffffu ? (pi == 0u ? p.type0 : (pi == 1u ? p.type1 : p.type2)) : WEIGHT_TYPE;
#endif
#endif
    uint wide = pi == 0u ? p.wide0 : (pi == 1u ? p.wide1 : p.wide2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));

    uint lane = gl_SubgroupInvocationID;
#if defined(LLMX_FLOAT_X) && (defined(LLMX_Q2) || defined(LLMX_Q3))
    // Float rows contain whole 256-value blocks, so row_plan always assigns a whole subgroup to each row.
    uint l = lane;
    uint row = local_wg * (256u / gl_SubgroupSize) + gl_SubgroupID;
#else
    uint rsub = lane / p.cluster;      // which of the subgroup's rows
    uint l = lane - rsub * p.cluster;  // lane within the row's cluster
    uint row = (local_wg * (256u / gl_SubgroupSize) + gl_SubgroupID) * p.rows_per_sg + rsub;
#endif
    // A plain call's workgroups in y take its whole chunks side by side, each its own columns (for_each_column_chunk).
    uint col0 = p.col0 + gl_WorkGroupID.y * p.ncols, out0 = col0, wrow = row, g_first = 0u, g_cnt = 0u;
    if (GROUPED) {
        uint y = gl_WorkGroupID.y;
        g_first = tab[4u * y + 1u];
        g_cnt = tab[4u * y + 2u];
        if (g_cnt == 0u) return;
        wrow = tab[4u * y] * nout + row;
    } else if (p.per != 0u) {
        uint e = gl_WorkGroupID.y;
        // An entry without an expert has no product, and its rows are left as they were.
        if (ids[e] == 0xffffffffu) return;
        col0 = e / p.per;
        out0 = e;
        wrow = ids[e] * nout + row;
    }
    // One in the one-column build, so the column loops collapse.
    const uint ncols = MAX_COLS == 1u ? 1u : GROUPED ? g_cnt : p.ncols;
// Column c's X column and output row: consecutive from col0, or a grouped chunk's entries.
#define XCOL(c) (GROUPED ? tab[p.order0 + g_first + (c)] / p.per : col0 + (c))
#define OCOL(c) (GROUPED ? tab[p.order0 + g_first + (c)] : out0 + (c))
#if defined(LLMX_Q4) || defined(LLMX_K4) || defined(LLMX_K5) || defined(LLMX_KQUANT)
// Row r0 + r's sum for a column, by the cluster's first lane.
#define ROW_STORE2(c, r, s) \
                if (l == 0u && r <= rlast) { \
                    if (p.accum != 0u) ys[pi].y[OCOL(c) * nout + r0 + r] += s; \
                    else ys[pi].y[OCOL(c) * nout + r0 + r] = s; \
                }
#include "matmul_row_two.glsl"
#endif
// A column's sum into its output row, by the cluster's first lane.
#define ROW_STORE(c, s) \
        if (l == 0u && row < nout && c < ncols) { \
            if (p.accum != 0u) ys[pi].y[OCOL(c) * nout + row] += s; \
            else ys[pi].y[OCOL(c) * nout + row] = s; \
        }
#include "matmul_row_one.glsl"
}
