#version 450
// Y[b*nout + o] = dot(row o, X column b). A subgroup handles `rows_per_sg`
// rows at once, each on a cluster of `cluster` lanes: the cluster's lanes
// stride over the row's work units and reduce with xor shuffles. Each lane
// keeps up to eight batch columns in registers so a weight is read once
// per chunk of columns. This is the decode kernel; the tile kernel takes
// wide batches (docs/VULKAN.md).
//
// Q8_0 rows with at least eight block pairs take the wide path: a pair is
// 68 bytes, 17 words, and eight consecutive lanes share one pair, lane t
// loading words t, t + 8 and, for lane 0, word 16, so a load instruction
// touches 32 contiguous bytes per pair instead of four. The two scales
// live in words 0 and 8 and every lane of the pair reads them, which the
// hardware serves as one broadcast. The loop is unrolled by hand and the
// accumulators are scalars: a generic loop over words with accumulator
// arrays indexed by column spilled to scratch and ran ten times slower.
// Rows with fewer or an odd number of blocks take the 16-bit path, two
// values per load. Bytes are sign-extended by a shift up and an
// arithmetic shift down.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint nin; uint nout; uint nbatch; uint type; uint col0; uint ncols; uint wide;
    uint cluster; uint rows_per_sg; uint lpp;
} p;
layout(set = 0, binding = 0) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; };
layout(set = 0, binding = 3) readonly buffer WF { float wf[]; };
layout(set = 0, binding = 4) readonly buffer X { float x[]; };
layout(set = 0, binding = 5) readonly buffer X4 { vec4 x4[]; };

int b0(uint w) { return (int(w << 24u)) >> 24; }
int b1(uint w) { return (int(w << 16u)) >> 24; }
int b2(uint w) { return (int(w << 8u)) >> 24; }
int b3(uint w) { return int(w) >> 24; }

// The four values of word `d` of a pair against the activations of the
// pair's 64 positions starting at xb. Word 0 holds a scale and values 0
// and 1 of block 0; words 1..7 hold values 4d-2..4d+1 of block 0; word 8
// holds values 30 and 31 of block 0 and the second scale; words 9..16 hold
// values 4d-36..4d-33 of block 1, which is position 32 + that.
void word_dot(uint w, uint d, uint xb, uint col_base, inout float p0, inout float p1) {
    if (d == 0u) {
        p0 += float(b2(w)) * x[col_base + xb] + float(b3(w)) * x[col_base + xb + 1u];
    } else if (d < 8u) {
        uint v = xb + 4u * d - 2u;
        p0 += float(b0(w)) * x[col_base + v] + float(b1(w)) * x[col_base + v + 1u] +
              float(b2(w)) * x[col_base + v + 2u] + float(b3(w)) * x[col_base + v + 3u];
    } else if (d == 8u) {
        p0 += float(b0(w)) * x[col_base + xb + 30u] + float(b1(w)) * x[col_base + xb + 31u];
    } else {
        uint v = xb + 4u * d - 4u;
        p1 += float(b0(w)) * x[col_base + v] + float(b1(w)) * x[col_base + v + 1u] +
              float(b2(w)) * x[col_base + v + 2u] + float(b3(w)) * x[col_base + v + 3u];
    }
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint rsub = lane / p.cluster;      // which of the subgroup's rows
    uint l = lane - rsub * p.cluster;  // lane within the row's cluster
    uint row = (gl_WorkGroupID.x * (256u / gl_SubgroupSize) + gl_SubgroupID) * p.rows_per_sg + rsub;
    float acc[8];
    for (uint c = 0u; c < 8u; ++c) acc[c] = 0.0;
    if (row < p.nout) {
        if (p.type == TYPE_Q8_0 && p.wide != 0u) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = row * nblocks * 17u / 2u;   // words: a pair is 17
            uint group = l / 8u, t = l - group * 8u;   // eight lanes per pair
            uint groups = p.cluster / 8u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 17u;
                uint wa = w32[o + t];
                uint wb = w32[o + t + 8u];
                uint wc = (t == 0u) ? w32[o + 16u] : 0u;
                float s0 = unpackHalf2x16(w32[o]).x;
                float s1 = unpackHalf2x16(w32[o + 8u]).y;
                uint xb = j * 64u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col_base = (p.col0 + c) * p.nin;
                    float p0 = 0.0, p1 = 0.0;
                    word_dot(wa, t, xb, col_base, p0, p1);
                    word_dot(wb, t + 8u, xb, col_base, p0, p1);
                    if (t == 0u) word_dot(wc, 16u, xb, col_base, p0, p1);
                    acc[c] += s0 * p0 + s1 * p1;
                }
            }
        } else if (p.type == TYPE_Q8_0) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint wbase = row * nblocks * 17u;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * 17u;
                float scale = unpackHalf2x16(uint(w16[o])).x;
                uint xb = b * Q8_0_BLOCK;
                float part[8];
                for (uint c = 0u; c < 8u; ++c) part[c] = 0.0;
                for (uint k = 0u; k < 16u; ++k) {
                    uint word = uint(w16[o + 1u + k]);
                    int q0 = b0(word);
                    int q1 = b1(word);
                    for (uint c = 0u; c < p.ncols; ++c) {
                        uint xo = (p.col0 + c) * p.nin + xb + 2u * k;
                        part[c] += float(q0) * x[xo] + float(q1) * x[xo + 1u];
                    }
                }
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += scale * part[c];
            }
        } else {
            uint wbase = row * p.nin;
            for (uint i = l; i < p.nin; i += p.cluster) {
                float w = wf[wbase + i];
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += w * x[(p.col0 + c) * p.nin + i];
            }
        }
    }
    // Reduce within each cluster of lanes; every lane joins every shuffle
    // and lanes past the last row add zero.
    for (uint c = 0u; c < 8u; ++c) {
        float s = acc[c];
        for (uint off = p.cluster / 2u; off > 0u; off >>= 1u) s += subgroupShuffleXor(s, off);
        if (l == 0u && row < p.nout && c < p.ncols) y[(p.col0 + c) * p.nout + row] = s;
    }
}
