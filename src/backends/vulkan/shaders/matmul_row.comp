#version 450
// Y[b*nout + o] = dot(row o, X column b) for up to three projections of
// the same X in one dispatch: the q, k and v projections of a layer, or
// gate and up. Workgroups are handed out to projections in order, so a
// workgroup's projection is uniform and its buffers are selected once.
// A subgroup handles `rows_per_sg` rows at once, each on a cluster of
// `cluster` lanes: the cluster's lanes stride over the row's work units
// and reduce with xor shuffles. Each lane keeps up to eight batch columns
// in registers so a weight is read once per chunk of columns. This is the
// decode kernel; the tile kernel takes wide batches (docs/VULKAN.md).
//
// Compiled three times, one module per family of types: as is for F32
// and Q8_0, with LLMX_Q4 for Q4_0 and Q4_1, with LLMX_KQUANT for Q6_K.
// The branches of every type in one module raised the register demand of
// every path and cost Q8_0 decode 40 percent, so a family is a module.
//
// Q8_0 rows with at least four block pairs take the wide path: a pair is
// 68 bytes, 17 words, and four consecutive lanes share one pair, lane t
// loading words t, t + 4, t + 8, t + 12 and, for lane 0, word 16, so a
// load instruction touches 16 contiguous bytes per pair and every lane
// has five loads in flight. On the Radeon VII that is the optimum of
// one, two, four, eight and sixteen lanes per pair, measured at the 8B
// shapes: 200, 190, 336, 295 and 185 GB/s. The two scales live in words
// 0 and 8 and every lane of the pair reads them, which the hardware
// serves as one broadcast and which measured faster than a shuffle. The
// loop is unrolled by hand and the accumulators are scalars: a generic
// loop over words with accumulator arrays indexed by column spilled to
// scratch and ran ten times slower. Rows with fewer or an odd number of
// blocks take the 16-bit path, two values per load. Bytes are
// sign-extended by a shift up and an arithmetic shift down.
//
// Q4_0 rows with an even block count take a word path too: a pair is 36
// bytes, 9 words, and two lanes share it, lane 0 taking words 0..3 (the
// first scale and nibble bytes 0..13 of block 0) and lane 1 words 4..8
// (nibble bytes 14 and 15, the second scale and block 1). Q4_1 blocks are
// 20 bytes, 5 words, always word aligned, one lane per block. Q6_K blocks
// are 210 bytes, so every other block starts two bytes into a word and
// its words are assembled from two loads; sixteen lanes share a block,
// each taking four consecutive positions of one half, which is three
// words of quants, two of sub-scales and the block scale.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint col0; uint ncols; uint cluster; uint rows_per_sg; uint nproj;
    uint nout0; uint type0; uint wide0; uint start0;
    uint nout1; uint type1; uint wide1; uint start1;
    uint nout2; uint type2; uint wide2; uint start2;
} p;
layout(set = 0, binding = 0) writeonly buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; } w16s[3];
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; } w32s[3];
layout(set = 0, binding = 3) readonly buffer WF { float wf[]; } wfs[3];
#if defined(LLMX_Q4) || defined(LLMX_KQUANT)
// The activations as 16-byte vectors: every quant path here reads them
// in aligned groups of four, one load instead of four. Bound offsets are
// 16-byte aligned and the row width is a multiple of 32.
layout(set = 0, binding = 4) readonly buffer X { vec4 x4[]; };
float x_at(uint i) { return x4[i >> 2u][i & 3u]; }
#else
layout(set = 0, binding = 4) readonly buffer X { float x[]; };
#endif
layout(set = 0, binding = 5) readonly buffer W8 { uint8_t w8[]; } w8s[3];

int b0(uint w) { return (int(w << 24u)) >> 24; }
int b1(uint w) { return (int(w << 16u)) >> 24; }
int b2(uint w) { return (int(w << 8u)) >> 24; }
int b3(uint w) { return int(w) >> 24; }

#if !defined(LLMX_Q4) && !defined(LLMX_KQUANT)
// The four values of word `d` of a pair against the activations of the
// pair's 64 positions starting at xb. Word 0 holds a scale and values 0
// and 1 of block 0; words 1..7 hold values 4d-2..4d+1 of block 0; word 8
// holds values 30 and 31 of block 0 and the second scale; words 9..16 hold
// values 4d-36..4d-33 of block 1, which is position 32 + that.
void word_dot(uint w, uint d, uint xb, uint col_base, inout float p0, inout float p1) {
    if (d == 0u) {
        p0 += float(b2(w)) * x[col_base + xb] + float(b3(w)) * x[col_base + xb + 1u];
    } else if (d < 8u) {
        uint v = xb + 4u * d - 2u;
        p0 += float(b0(w)) * x[col_base + v] + float(b1(w)) * x[col_base + v + 1u] +
              float(b2(w)) * x[col_base + v + 2u] + float(b3(w)) * x[col_base + v + 3u];
    } else if (d == 8u) {
        p0 += float(b0(w)) * x[col_base + xb + 30u] + float(b1(w)) * x[col_base + xb + 31u];
    } else {
        uint v = xb + 4u * d - 4u;
        p1 += float(b0(w)) * x[col_base + v] + float(b1(w)) * x[col_base + v + 1u] +
              float(b2(w)) * x[col_base + v + 2u] + float(b3(w)) * x[col_base + v + 3u];
    }
}
#endif

#ifdef LLMX_Q4
// The eight nibbles of a word of Q4_0 or Q4_1 quants against the
// activations at the word's four positions and the four sixteen further
// on: byte i of the word is the low nibble at xl[i] and the high one at
// xh[i]. The offsets are folded out: Q4_0's -8 and Q4_1's min apply to
// the sum of the activations, which the caller adds once per block.
float nibble_dot(uint w, vec4 xl, vec4 xh) {
    vec4 lo = vec4(bitfieldExtract(w, 0, 4), bitfieldExtract(w, 8, 4), bitfieldExtract(w, 16, 4), bitfieldExtract(w, 24, 4));
    vec4 hi = vec4(bitfieldExtract(w, 4, 4), bitfieldExtract(w, 12, 4), bitfieldExtract(w, 20, 4), bitfieldExtract(w, 28, 4));
    return dot(lo, xl) + dot(hi, xh);
}
// One 32-value block of nibbles in four words against the activations
// starting at vector xv, and the block's activation sum.
float block_nibble_dot(uint w0, uint w1, uint w2, uint w3, uint xv, out float px) {
    vec4 x0 = x4[xv], x1 = x4[xv + 1u], x2 = x4[xv + 2u], x3 = x4[xv + 3u];
    vec4 y0 = x4[xv + 4u], y1 = x4[xv + 5u], y2 = x4[xv + 6u], y3 = x4[xv + 7u];
    px = dot(x0 + x1 + x2 + x3 + y0 + y1 + y2 + y3, vec4(1.0));
    return nibble_dot(w0, x0, y0) + nibble_dot(w1, x1, y1) + nibble_dot(w2, x2, y2) + nibble_dot(w3, x3, y3);
}
#endif

#ifdef LLMX_KQUANT
uint kproj = 0u;
// A word at any even byte offset: aligned, or the high half of one word
// and the low half of the next.
uint word_at(uint byte_off) {
    uint i = byte_off >> 2u;
    if ((byte_off & 3u) == 0u) return w32s[kproj].w32[i];
    return (w32s[kproj].w32[i] >> 16u) | (w32s[kproj].w32[i + 1u] << 16u);
}
float half_word_at(uint byte_off) {
    uint w = w32s[kproj].w32[byte_off >> 2u];
    return (byte_off & 3u) == 0u ? unpackHalf2x16(w).x : unpackHalf2x16(w).y;
}
#endif

void main() {
    // Which projection this workgroup belongs to, uniform across it.
    uint wg = gl_WorkGroupID.x;
    uint pi = 0u;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint type = pi == 0u ? p.type0 : (pi == 1u ? p.type1 : p.type2);
    uint wide = pi == 0u ? p.wide0 : (pi == 1u ? p.wide1 : p.wide2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));
#ifdef LLMX_KQUANT
    kproj = pi;
#endif

    uint lane = gl_SubgroupInvocationID;
    uint rsub = lane / p.cluster;      // which of the subgroup's rows
    uint l = lane - rsub * p.cluster;  // lane within the row's cluster
    uint row = (local_wg * (256u / gl_SubgroupSize) + gl_SubgroupID) * p.rows_per_sg + rsub;
    float acc[8];
    for (uint c = 0u; c < 8u; ++c) acc[c] = 0.0;
    if (row < nout) {
#if !defined(LLMX_Q4) && !defined(LLMX_KQUANT)
        if (type == TYPE_Q8_0 && wide != 0u) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = row * nblocks * 17u / 2u;   // words: a pair is 17
            uint group = l / 4u, t = l - group * 4u;   // four lanes per pair
            uint groups = p.cluster / 4u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 17u;
                uint wa = w32s[pi].w32[o + t];
                uint wb = w32s[pi].w32[o + t + 4u];
                uint wc = w32s[pi].w32[o + t + 8u];
                uint wd = w32s[pi].w32[o + t + 12u];
                uint we = (t == 0u) ? w32s[pi].w32[o + 16u] : 0u;
                float s0 = unpackHalf2x16(w32s[pi].w32[o]).x;
                float s1 = unpackHalf2x16(w32s[pi].w32[o + 8u]).y;
                uint xb = j * 64u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint col_base = (p.col0 + c) * p.nin;
                    float p0 = 0.0, p1 = 0.0;
                    word_dot(wa, t, xb, col_base, p0, p1);
                    word_dot(wb, t + 4u, xb, col_base, p0, p1);
                    word_dot(wc, t + 8u, xb, col_base, p0, p1);
                    word_dot(wd, t + 12u, xb, col_base, p0, p1);
                    if (t == 0u) word_dot(we, 16u, xb, col_base, p0, p1);
                    acc[c] += s0 * p0 + s1 * p1;
                }
            }
        } else if (type == TYPE_Q8_0) {
            uint nblocks = p.nin / Q8_0_BLOCK;
            uint wbase = row * nblocks * 17u;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * 17u;
                float scale = unpackHalf2x16(uint(w16s[pi].w16[o])).x;
                uint xb = b * Q8_0_BLOCK;
                float part[8];
                for (uint c = 0u; c < 8u; ++c) part[c] = 0.0;
                for (uint k = 0u; k < 16u; ++k) {
                    uint word = uint(w16s[pi].w16[o + 1u + k]);
                    int q0 = b0(word);
                    int q1 = b1(word);
                    for (uint c = 0u; c < p.ncols; ++c) {
                        uint xo = (p.col0 + c) * p.nin + xb + 2u * k;
                        part[c] += float(q0) * x[xo] + float(q1) * x[xo + 1u];
                    }
                }
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += scale * part[c];
            }
        } else {
            uint wbase = row * p.nin;
            for (uint i = l; i < p.nin; i += p.cluster) {
                float w = wfs[pi].wf[wbase + i];
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += w * x[(p.col0 + c) * p.nin + i];
            }
        }
#endif
#ifdef LLMX_Q4
        if (type == TYPE_Q4_0 && wide != 0u) {
            // Two lanes per 9-word pair, a block each, both loading five
            // words: lane 0 words 0..4, whose low half is the scale and
            // whose nibble bytes start two bytes in, so each nibble word is
            // assembled from two; lane 1 words 4..8, the scale in the high
            // half of word 4 and the nibble words aligned after it.
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint npairs = nblocks / 2u;
            uint wbase = row * nblocks * 9u / 2u;   // words: a pair is 9
            uint group = l / 2u, t = l - group * 2u;
            uint groups = p.cluster / 2u;
            for (uint j = group; j < npairs; j += groups) {
                uint o = wbase + j * 9u + 4u * t;
                uint wa = w32s[pi].w32[o], wb = w32s[pi].w32[o + 1u], wc = w32s[pi].w32[o + 2u];
                uint wd = w32s[pi].w32[o + 3u], we = w32s[pi].w32[o + 4u];
                float d;
                uint n0, n1, n2, n3;
                if (t == 0u) {
                    d = unpackHalf2x16(wa).x;
                    n0 = (wa >> 16u) | (wb << 16u);
                    n1 = (wb >> 16u) | (wc << 16u);
                    n2 = (wc >> 16u) | (wd << 16u);
                    n3 = (wd >> 16u) | (we << 16u);
                } else {
                    d = unpackHalf2x16(wa).y;
                    n0 = wb; n1 = wc; n2 = wd; n3 = we;
                }
                uint xv = (j * 64u + t * 32u) / 4u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    float px;
                    float pq = block_nibble_dot(n0, n1, n2, n3, (p.col0 + c) * p.nin / 4u + xv, px);
                    acc[c] += d * (pq - 8.0 * px);
                }
            }
        } else if (type == TYPE_Q4_0) {
            // Byte loads over 18-byte blocks for an odd block count.
            uint nblocks = p.nin / Q4_0_BLOCK;
            uint wbase = row * nblocks * Q4_0_BYTES;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * Q4_0_BYTES;
                float d = half_at(w8s[pi].w8[o], w8s[pi].w8[o + 1u]);
                uint xb = b * Q4_0_BLOCK;
                float part[8];
                for (uint c = 0u; c < 8u; ++c) part[c] = 0.0;
                for (uint k = 0u; k < 16u; ++k) {
                    uint byte = uint(w8s[pi].w8[o + 2u + k]);
                    float lo = float(byte & 15u) - 8.0, hi = float(byte >> 4u) - 8.0;
                    for (uint c = 0u; c < p.ncols; ++c) {
                        uint xo = (p.col0 + c) * p.nin + xb + k;
                        part[c] += lo * x_at(xo) + hi * x_at(xo + 16u);
                    }
                }
                for (uint c = 0u; c < p.ncols; ++c) acc[c] += d * part[c];
            }
        } else {
            // Q4_1: one lane per 5-word block, d and m in word 0.
            uint nblocks = p.nin / 32u;
            uint wbase = row * nblocks * 5u;
            for (uint b = l; b < nblocks; b += p.cluster) {
                uint o = wbase + b * 5u;
                uint w0 = w32s[pi].w32[o];
                uint w1 = w32s[pi].w32[o + 1u], w2 = w32s[pi].w32[o + 2u];
                uint w3 = w32s[pi].w32[o + 3u], w4 = w32s[pi].w32[o + 4u];
                vec2 dm = unpackHalf2x16(w0);
                uint xv = b * 8u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    float px;
                    float pq = block_nibble_dot(w1, w2, w3, w4, (p.col0 + c) * p.nin / 4u + xv, px);
                    acc[c] += dm.x * pq + dm.y * px;
                }
            }
        }
#endif
#ifdef LLMX_KQUANT
        {
            // Q6_K: sixteen lanes per block, lane t taking positions l0..l0+3
            // of half n. Position l0 + i of a half has four values, one per
            // 32-group: low nibble of ql[l0 + i] with bits 0..1 of qh[l0 + i],
            // low nibble of ql[l0 + 32 + i] with bits 2..3, the high nibbles
            // with bits 4..5 and 6..7; each group has its own sub-scale,
            // and sub-scale index l0 / 16 is the same for the lane's four.
            uint nblocks = p.nin / Q6_K_BLOCK;
            uint bbase = row * nblocks * Q6_K_BYTES;   // bytes
            uint group = l / 16u, t = l - group * 16u;
            uint groups = p.cluster / 16u;
            uint n = t / 8u, l0 = (t - n * 8u) * 4u;
            for (uint b = group; b < nblocks; b += groups) {
                uint o = bbase + b * Q6_K_BYTES;
                uint ql_lo = word_at(o + n * 64u + l0);
                uint ql_hi = word_at(o + n * 64u + 32u + l0);
                uint qh = word_at(o + 128u + n * 32u + l0);
                uint sc_a = word_at(o + 192u + n * 8u), sc_b = word_at(o + 192u + n * 8u + 4u);
                float d = half_word_at(o + 208u);
                // Sub-scales of groups 0..3 are bytes l0/16 + 0, 2, 4, 6.
                uint sh = (l0 / 16u) * 8u;
                float s0 = float((int(sc_a << (24u - sh))) >> 24);
                float s1 = float((int(sc_a << (8u - sh))) >> 24);
                float s2 = float((int(sc_b << (24u - sh))) >> 24);
                float s3 = float((int(sc_b << (8u - sh))) >> 24);
                // The lane's sixteen quants as four vectors, one per group.
                vec4 q0, q1, q2, q3;
                for (uint i = 0u; i < 4u; ++i) {
                    uint lo = bitfieldExtract(ql_lo, int(8u * i), 4), hi = bitfieldExtract(ql_lo, int(8u * i + 4u), 4);
                    uint lo2 = bitfieldExtract(ql_hi, int(8u * i), 4), hi2 = bitfieldExtract(ql_hi, int(8u * i + 4u), 4);
                    uint h = qh >> (8u * i);
                    q0[i] = float(int(lo | ((h & 3u) << 4u)) - 32);
                    q1[i] = float(int(lo2 | (((h >> 2u) & 3u) << 4u)) - 32);
                    q2[i] = float(int(hi | (((h >> 4u) & 3u) << 4u)) - 32);
                    q3[i] = float(int(hi2 | (((h >> 6u) & 3u) << 4u)) - 32);
                }
                uint xv = (b * Q6_K_BLOCK + n * 128u + l0) / 4u;
                for (uint c = 0u; c < p.ncols; ++c) {
                    uint cv = (p.col0 + c) * p.nin / 4u + xv;
                    acc[c] += d * (s0 * dot(q0, x4[cv]) + s1 * dot(q1, x4[cv + 8u]) +
                                   s2 * dot(q2, x4[cv + 16u]) + s3 * dot(q3, x4[cv + 24u]));
                }
            }
        }
#endif
    }
    // Reduce within each cluster of lanes; every lane joins every shuffle
    // and lanes past the last row add zero.
    for (uint c = 0u; c < 8u; ++c) {
        float s = acc[c];
        for (uint off = p.cluster / 2u; off > 0u; off >>= 1u) s += subgroupShuffleXor(s, off);
        if (l == 0u && row < nout && c < p.ncols) ys[pi].y[(p.col0 + c) * nout + row] = s;
    }
}
