#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches: a workgroup computes a TILE_ROWS x TILE_COLS output tile, walking the inner dimension one stage at a time through shared memory.
// TILE_ROWS is a specialization constant picked per call (a taller tile reads less shared memory per product but yields fewer workgroups), and a call of few workgroups splits the inner dimension into parts matmul_reduce.comp adds in order.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "q.glsl"
#include "iq2_layout.glsl"
#include "tq_layout.glsl"
#ifdef LLMX_IQ1
#include "iq1_layout.glsl"
#endif
#ifdef LLMX_MXFP4
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4466], 4461, 64);
#endif
#include "float_controls.glsl"
#if defined(LLMX_WEIGHT_F16) || defined(LLMX_WEIGHT_BF16)
#include "f16.glsl"
#ifdef LLMX_WEIGHT_F16
#define WEIGHT_FLOAT(h) f16_to_f32(h)
#else
#define WEIGHT_FLOAT(h) bf16_to_f32(h)
#endif
#endif
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
#define TILE_COLS 64u
// `wstride` is an F32 row's stride in floats: nin, or more for the padded copy the backend keeps of a matrix whose rows are a power of two wide.
layout(push_constant) uniform P { uint nin; uint nout; uint nbatch; uint type; uint accum; uint per; uint order0; uint kper; uint ctiles; uint wstride; } p;
#ifdef LLMX_MXFP4
// Split calls store double partials as two words; unsplit calls store f32 bits.
layout(set = 0, binding = 0) buffer Y { uint ybits[]; };
#else
layout(set = 0, binding = 0) buffer Y { float y[]; };
#endif
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 2) readonly buffer WF { float wf[]; };
layout(set = 0, binding = 3) readonly buffer X { float x[]; };
// The weights as words, since this driver issues one load per byte: a K-quant run is 2 or 4 aligned words, and scattered bytes are extracted from the word holding them.
layout(set = 0, binding = 4) readonly buffer W32 { uint w32[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs workgroup row y as tile y of the grouping (moe_group.comp): up to TILE_COLS entries of one expert, column c being entry tab[order0 + first + c].
// A routed call is never split.
layout(set = 0, binding = 5) readonly buffer T { uint tab[]; };
#define QBYTE(i) ((w32[(i) >> 2u] >> (8u * ((i) & 3u))) & 255u)
#ifdef LLMX_IQ3_S
// IQ3_S uses no F32 weight view, so binding 2 holds its dictionary words.
#define LOOKUP_GRID_SOURCE(i) floatBitsToUint(wf[i])
#define LOOKUP_GRID_SIZE 512u
#include "lookup_cache.glsl"
#define IQ3_GRID_WORD(i) lookup_words[i]
#include "iq3_s.glsl"
#elif defined(LLMX_IQ3_XXS)
#define LOOKUP_GRID_SOURCE(i) floatBitsToUint(wf[i])
#define LOOKUP_GRID_SIZE 256u
#include "lookup_cache.glsl"
#define IQ3_XXS_GRID_WORD(i) lookup_words[i]
#include "iq3_xxs.glsl"
#elif defined(LLMX_IQ2_SMALL)
#define IQ2_SMALL_HALF(i) (QBYTE(i) | (QBYTE((i) + 1u) << 8u))
#define LOOKUP_GRID_SOURCE(i) floatBitsToUint(wf[i])
#define LOOKUP_GRID_SIZE IQ2_SMALL_GRID_WORDS
#include "lookup_cache.glsl"
#define IQ2_GRID_WORD(i) lookup_words[i]
#include "iq2_small.glsl"
#elif defined(LLMX_IQ1)
#define LOOKUP_GRID_SOURCE(i) floatBitsToUint(wf[i])
#define LOOKUP_GRID_SIZE 1024u
#include "lookup_cache.glsl"
#define IQ1_GRID_WORD(i) lookup_words[i]
#include "iq1.glsl"
#elif defined(LLMX_IQ2_S)
#define LOOKUP_GRID_SOURCE(i) floatBitsToUint(wf[i])
#define LOOKUP_GRID_SIZE 2048u
#include "lookup_cache.glsl"
#define IQ2_GRID_WORD(i) lookup_words[i]
#include "iq2_s.glsl"
#endif
#include "qdecode.glsl"

float matrix_input(float value) {
#ifdef LLMX_BF16
    uint bits = floatBitsToUint(value);
    bits = (bits & 0x7fffffffu) > 0x7f800000u ? bits | 0x00400000u
                                            : bits + 0x7fffu + ((bits >> 16u) & 1u);
    value = uintBitsToFloat(bits & 0xffff0000u);
#endif
    return value;
}

// Rows a thread accumulates, threads sharing one W-tile row, and the values each loads; 256 threads cover one stage of TILE_ROWS rows.
#define THREAD_COLS (TILE_COLS / 4u)
#define MROWS (TILE_ROWS / (256u / THREAD_COLS))
#define XPR (256u / TILE_COLS)
#define WPR (256u / TILE_ROWS)
#ifdef LLMX_MXFP4
#define STAGE_K 16u
#else
#define STAGE_K 32u
#endif
#define WVALS (STAGE_K / WPR)

// k-major tiles, [k][row] and [k][column], so a thread's rows and four columns for one k are adjacent and load as wide reads.
shared float ws[STAGE_K][TILE_ROWS];
shared float xs[STAGE_K][TILE_COLS];
#ifdef LLMX_MXFP4
shared uint wrange[TILE_ROWS];
shared uint xrange[XPR][TILE_COLS];
// A weight of scale byte e and an input of exponent field f multiply to at least 2^(e + f - 255) and less than 2^(e + f - 250) in magnitude.
// Where e + f < 129 the product can fall below the smallest normal float before the sum and where e + f > 378 it can overflow, so a row whose scale lies outside [65, 188] is summed wide whatever its inputs.
bool wide_row(uint e) {
    return e < 65u || e > 188u;
}
// So an input needs the wide sum when its exponent field is below `lo` or above `hi`, which pair it with the tile's other scales.
bool needs_wide_product(float v, uint lo, uint hi) {
    uint a = floatBitsToUint(v) & 0x7fffffffu;
    uint e = a >> 23u;
    return a != 0u && (e < lo || e > hi);
}
double mxfp4_wide(uint row, uint col, uint begin, uint end) {
    double sum = 0.0;
    for (uint k = begin; k < end; ++k) {
        uint o = (row * (p.nin / MXFP4_BLOCK) + k / MXFP4_BLOCK) * MXFP4_BYTES;
        sum += double(mxfp4_at(o, k % MXFP4_BLOCK)) * double(matrix_input(x[col * p.nin + k]));
    }
    return sum;
}
#endif

int lo8(uint w) { return (int(w << 24u)) >> 24; }
int hi8(uint w) { return (int(w << 16u)) >> 24; }

void main() {
#ifdef LLMX_IQ3_S
    // Cache before the empty-group return; all invocations participate once, before any stage.
    lookup_init();
    const uint type = TYPE_IQ3_S;
#elif defined(LLMX_IQ3_XXS)
    lookup_init();
    const uint type = TYPE_IQ3_XXS;
#elif defined(LLMX_IQ2_SMALL)
    lookup_init();
    const uint type = IQ2_SMALL_TYPE;
#elif defined(LLMX_IQ1)
    lookup_init();
    const uint type = IQ1_TYPE;
#elif defined(LLMX_IQ2_S)
    lookup_init();
    const uint type = TYPE_IQ2_S;
#elif defined(LLMX_TQ)
    const uint type = TQ_TYPE;
#else
    uint type = p.type;
#endif
    uint tid = gl_LocalInvocationID.x;
    uint row_base = gl_WorkGroupID.x * TILE_ROWS;
    uint part = gl_WorkGroupID.y / p.ctiles;
    uint col_base = (gl_WorkGroupID.y - part * p.ctiles) * TILE_COLS;
    uint kbeg = part * p.kper, kend = min(p.nin, kbeg + p.kper);
    uint yoff = part * p.nbatch * p.nout;   // an unsplit call's one part writes Y itself
    uint expert = 0u, first = 0u, ncols = TILE_COLS;
    if (p.per != 0u) {
        uint y = gl_WorkGroupID.y;
        expert = tab[4u * y];
        first = tab[4u * y + 1u];
        ncols = tab[4u * y + 2u];
        if (ncols == 0u) return;
        col_base = 0u;
    }
    uint tr = tid / THREAD_COLS, tc = tid - tr * THREAD_COLS;   // micro-tile at rows tr*MROWS.., cols tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W loader: row wrow, k segment wseg*WVALS
    uint xcol = tid / XPR, xseg = tid - xcol * XPR;     // X loader: XPR segments per column
    // The X column this thread loads.
    uint xc = col_base + xcol;
    bool xin = xc < p.nbatch;
    if (p.per != 0u) {
        xin = xcol < ncols;
        xc = xin ? tab[p.order0 + first + xcol] / p.per : 0u;
    }
#ifdef LLMX_PRESERVE_F32
    precise float acc[MROWS][4];
#else
    float acc[MROWS][4];
#endif
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
#ifdef LLMX_MXFP4
    uint wide_rows[MROWS], wide_cols[4];
    for (uint i = 0u; i < MROWS; ++i) wide_rows[i] = 0u;
    for (uint j = 0u; j < 4u; ++j) wide_cols[j] = 0u;
#endif
    uint nblocks = p.nin / 32u;   // the small-block types have 32-value blocks
#ifdef LLMX_MXFP4
    // The inputs' bounds come from the least and greatest scale of the rows not summed wide, read once for the tile's part into wrange[0] and wrange[1] before the stages use it.
    // Shared scalars of their own would shift the tiles off the alignment their wide reads need.
    if (tid == 0u) { wrange[0] = 256u; wrange[1] = 0u; }
    barrier();
    {
        uint lo = 256u, hi = 0u;
        // Adjacent threads read adjacent blocks of one row, so the reads share cache lines.
        uint blocks = (kend - kbeg) / MXFP4_BLOCK;
        for (uint at = tid; at < TILE_ROWS * blocks; at += 256u) {
            uint row = row_base + at / blocks;
            if (row >= p.nout) continue;
            uint e = QBYTE(((expert * p.nout + row) * nblocks + kbeg / MXFP4_BLOCK + at % blocks) * MXFP4_BYTES);
            if (!wide_row(e)) { lo = min(lo, e); hi = max(hi, e); }
        }
        if (lo <= hi) { atomicMin(wrange[0], lo); atomicMax(wrange[1], hi); }
    }
    barrier();
    uint xlo = wrange[0] >= 129u ? 0u : 129u - wrange[0];
    uint xhi = wrange[1] == 0u ? 255u : 378u - wrange[1];
    barrier();
#endif
    for (uint k0 = kbeg; k0 < kend; k0 += STAGE_K) {
        // MXFP4 reads both tiles before storing them, so independent loads can be issued together.
        uint row = row_base + wrow, wr = expert * p.nout + row;
#ifdef LLMX_MXFP4
        float xv[STAGE_K / XPR];
        for (uint i = 0u; i < STAGE_K / XPR; ++i) {
            uint k = k0 + xseg * (STAGE_K / XPR) + i;
            xv[i] = matrix_input(x[xin && k < p.nin ? xc * p.nin + k : 0u]);
        }
        uint o = ((row < p.nout ? wr : 0u) * nblocks + k0 / MXFP4_BLOCK) * MXFP4_BYTES;
        uint e = QBYTE(o);
        float wv[WVALS];
        for (uint i = 0u; i < WVALS; ++i)
            wv[i] = mxfp4_at(o, (k0 % MXFP4_BLOCK) + wseg * WVALS + i);
        if (wseg == 0u) wrange[wrow] = row < p.nout && wide_row(e) ? 1u : 0u;
        for (uint i = 0u; i < WVALS; ++i)
            ws[wseg * WVALS + i][wrow] = row < p.nout ? wv[i] : 0.0;
#elif defined(LLMX_WEIGHT_F16) || defined(LLMX_WEIGHT_BF16)
        for (uint i = 0u; i < WVALS; ++i) {
            uint k = k0 + wseg * WVALS + i;
            ws[wseg * WVALS + i][wrow] = row < p.nout && k < p.nin ? WEIGHT_FLOAT(uint(w16[wr * p.nin + k])) : 0.0;
        }
#else
        if (row < p.nout) {
            if (type == TYPE_Q8_0) {
                uint o = (wr * nblocks + k0 / Q8_0_BLOCK) * 17u;
                float scale = unpackHalf2x16(uint(w16[o])).x;
                for (uint i = 0u; i < WVALS / 2u; ++i) {
                    uint word = uint(w16[o + 1u + wseg * (WVALS / 2u) + i]);
                    ws[wseg * WVALS + 2u * i][wrow] = scale * float(lo8(word));
                    ws[wseg * WVALS + 2u * i + 1u][wrow] = scale * float(hi8(word));
                }
            } else if (type == TYPE_Q4_0) {
                uint o = (wr * nblocks + k0 / Q4_0_BLOCK) * Q4_0_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = q4_0_at(o, k, d);
                }
            } else if (type == TYPE_Q5_0) {
                uint o = (wr * nblocks + k0 / 32u) * Q5_0_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                for (uint i = 0u; i < WVALS; ++i) ws[wseg * WVALS + i][wrow] = q5_0_at(o, wseg * WVALS + i, d);
#ifdef LLMX_IQ3_XXS
            } else if (type == TYPE_IQ3_XXS) {
                uint o = (wr * (p.nin / IQ3_XXS_BLOCK) + k0 / IQ3_XXS_BLOCK) * IQ3_XXS_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                uint first = k0 % IQ3_XXS_BLOCK + wseg * WVALS;
                uint control = iq3_xxs_control(o, first / 32u);
                float scaled = iq3_xxs_scale(control, d);
                for (uint i = 0u; i < WVALS; i += 4u) {
                    uint j = first + i;
                    uint word = IQ3_XXS_GRID_WORD(QBYTE(o + 2u + j / 4u));
                    uint signs = iq3_xxs_signs(control, (j & 31u) / 8u);
                    for (uint lane = 0u; lane < min(4u, WVALS - i); ++lane) {
                        uint position = j + lane;
                        ws[wseg * WVALS + i + lane][wrow] = iq3_xxs_component(word, position & 3u,
                            (signs >> (position & 7u)) & 1u, scaled);
                    }
                }
#endif
#ifdef LLMX_IQ2_SMALL
            } else if (type == IQ2_SMALL_TYPE) {
                uint o = (wr * (p.nin / 256u) + k0 / 256u) * IQ2_SMALL_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                uint first = k0 % 256u + wseg * WVALS;
                for (uint i = 0u; i < WVALS; i += 4u) {
                    uint j = first + i, signs, scale;
                    uint index = iq2_small_index(type, o, j / 32u, (j / 8u) & 3u, signs, scale);
                    uint word = IQ2_GRID_WORD(2u * index + ((j & 7u) / 4u));
                    precise float scaled = d * float(1u + 2u * scale) * 0.125;
                    for (uint lane = 0u; lane < 4u && i + lane < WVALS; ++lane) {
                        uint position = j + lane;
                        ws[wseg * WVALS + i + lane][wrow] = iq2_small_component(word, position & 3u,
                            (signs >> (position & 7u)) & 1u, scaled);
                    }
                }
#elif defined(LLMX_IQ1)
            } else if (type == IQ1_TYPE) {
                uint o = (wr * (p.nin / 256u) + k0 / 256u) * IQ1_BYTES;
                float d = iq1_scale(IQ1_TYPE, o);
                uint first = k0 % 256u + wseg * WVALS;
                for (uint i = 0u; i < WVALS; ++i)
                    ws[wseg * WVALS + i][wrow] = iq1_at(IQ1_TYPE, o, first + i, d);
#endif
#ifdef LLMX_IQ2_S
            } else if (type == TYPE_IQ2_S) {
                uint o = (wr * (p.nin / IQ2_S_BLOCK) + k0 / IQ2_S_BLOCK) * IQ2_S_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                uint first = k0 % IQ2_S_BLOCK + wseg * WVALS;
                for (uint i = 0u; i < WVALS; i += 4u) {
                    uint j = first + i;
                    uint word = iq2_s_vector_word(o, j), signs = QBYTE(o + 34u + j / 8u);
                    float scaled = iq2_s_scale(o, j / 16u, d);
                    for (uint lane = 0u; lane < min(4u, WVALS - i); ++lane) {
                        uint position = j + lane;
                        ws[wseg * WVALS + i + lane][wrow] = iq2_s_component(word, position & 3u,
                            (signs >> (position & 7u)) & 1u, scaled);
                    }
                }
#endif
#ifdef LLMX_IQ3_S
            } else if (type == TYPE_IQ3_S) {
                uint o = (wr * (p.nin / IQ3_S_BLOCK) + k0 / IQ3_S_BLOCK) * IQ3_S_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                // Each loader's run stays in this stage's group of 32; two-value runs take only their own half of a dictionary vector.
                uint j0 = k0 % IQ3_S_BLOCK + wseg * WVALS;
                float scaled = iq3_s_scale(o, j0 / 32u, d);
                uint high = QBYTE(o + 66u + j0 / 32u), sign = floatBitsToUint(d) & 0x80000000u;
                for (uint i = 0u; i < WVALS; i += 4u) {
                    uint j = j0 + i;
                    uint vector = iq3_s_vector(o, j / 4u, high);
                    uint signs = QBYTE(o + 74u + j / 8u);
                    for (uint lane = 0u; lane < min(4u, WVALS - i); ++lane) {
                        uint position = j + lane;
                        ws[wseg * WVALS + i + lane][wrow] = iq3_s_component(vector, position & 3u,
                            (signs >> (position & 7u)) & 1u, scaled, sign);
                    }
                }
#endif
            } else if (type == TYPE_TQ1_0 || type == TYPE_TQ2_0) {
                uint o = (wr * (p.nin / 256u) + k0 / 256u) * block_bytes(type);
                float d = tq_scale(type, o);
                uint first = k0 % 256u + wseg * WVALS;
                for (uint i = 0u; i < WVALS; ++i)
                    ws[wseg * WVALS + i][wrow] = tq_at(type, o, first + i, d);
            } else if (type == TYPE_IQ4_NL || type == TYPE_IQ4_XS) {
                float d;
                uint codes = iq4_group(type, wr, p.nin, k0 / 32u, d);
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = iq4_at(codes, k, d);
                }
            } else if (type == TYPE_Q4_1 || type == TYPE_Q5_1) {
                uint o = (wr * nblocks + k0 / 32u) * block_bytes(type);
                float d = half_at(QBYTE(o), QBYTE(o + 1u)), m = half_at(QBYTE(o + 2u), QBYTE(o + 3u));
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = type == TYPE_Q5_1 ? q5_1_at(o, k, d, m) : q4_1_at(o, k, d, m);
                }
            } else if (type == TYPE_Q2_K || type == TYPE_Q3_K) {
                uint o = (wr * (p.nin / 256u) + k0 / 256u) * block_bytes(type);
                uint first = k0 % 256u + wseg * WVALS;
                // Each aligned run of 4, 8 or 16 values stays within one scale group.
                if (type == TYPE_Q2_K) {
                    Q2KScale scale = q2_k_scale(o, first);
                    for (uint i = 0u; i < WVALS; ++i)
                        ws[wseg * WVALS + i][wrow] = q2_k_at(o, first + i, scale);
                } else {
                    Q3KScale scale = q3_k_scale(o, first);
                    for (uint i = 0u; i < WVALS; ++i)
                        ws[wseg * WVALS + i][wrow] = q3_k_at(o, first + i, scale);
                }
            } else if (is_kquant(type)) {
                // 256-value blocks: this 32-wide step is a slice of one and a thread's run lies inside one group of 32, so the sub-scale, sub-min, nibble half and start byte are read once per run rather than per value.
                uint o = (wr * (p.nin / Q6_K_BLOCK) + k0 / Q6_K_BLOCK) * block_bytes(type);
                uint k_in = k0 - (k0 / Q6_K_BLOCK) * Q6_K_BLOCK;
                uint j0 = k_in + wseg * WVALS;   // the run's first value in the block
                uint l0 = j0 & 31u;              // and its position within the group
                if (type == TYPE_Q6_K) {
                    float d = half_at(QBYTE(o + 208u), QBYTE(o + 209u));
                    uint n = j0 / 128u, which = (j0 - n * 128u) / 32u;
                    uint lbase = o + n * 64u + l0 + ((which & 1u) != 0u ? 32u : 0u);
                    uint hbase = o + 128u + n * 32u + l0;
                    uint shift = 2u * which;
                    float ds = d * float((int(uint(QBYTE(o + 192u + n * 8u + l0 / 16u + 2u * which))) << 24) >> 24);
                    for (uint i = 0u; i < WVALS; ++i) {
                        uint lowb = uint(QBYTE(lbase + i));
                        uint q = (which < 2u ? (lowb & 15u) : (lowb >> 4u))
                               | (((uint(QBYTE(hbase + i)) >> shift) & 3u) << 4u);
                        ws[wseg * WVALS + i][wrow] = ds * float(int(q) - 32);
                    }
                } else {
                    float d = half_at(QBYTE(o), QBYTE(o + 1u)), dmin = half_at(QBYTE(o + 2u), QBYTE(o + 3u));
                    uint sc, mn;
                    scale_min_k4(o + 4u, j0 / 32u, sc, mn);
                    float ds = d * float(sc), dm = dmin * float(mn);
                    uint c = j0 / 64u;
                    bool low = ((j0 >> 5u) & 1u) == 0u;   // the group's nibble half
                    if (type == TYPE_Q4_K) {
                        uint base = (o + 16u + c * 32u + l0) / 4u;
                        for (uint g = 0u; g < WVALS / 4u; ++g) {
                            uint word = w32[base + g];
                            for (uint i = 0u; i < 4u; ++i) {
                                uint byte = (word >> (8u * i)) & 255u;
                                ws[wseg * WVALS + 4u * g + i][wrow] =
                                    ds * float(low ? (byte & 15u) : (byte >> 4u)) - dm;
                            }
                        }
                    } else {
                        uint base = (o + 48u + c * 32u + l0) / 4u, hbase = (o + 16u + l0) / 4u;
                        uint shift = 2u * c + (low ? 0u : 1u);
                        for (uint g = 0u; g < WVALS / 4u; ++g) {
                            uint word = w32[base + g], hword = w32[hbase + g];
                            for (uint i = 0u; i < 4u; ++i) {
                                uint byte = (word >> (8u * i)) & 255u;
                                uint q = (low ? (byte & 15u) : (byte >> 4u))
                                       | ((((hword >> (8u * i)) >> shift) & 1u) << 4u);
                                ws[wseg * WVALS + 4u * g + i][wrow] = ds * float(q) - dm;
                            }
                        }
                    }
                }
            } else {
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = k0 + wseg * WVALS + i;
                    ws[wseg * WVALS + i][wrow] = k < p.nin ? wf[wr * p.wstride + k] : 0.0;
                }
            }
        } else {
            for (uint i = 0u; i < WVALS; ++i) ws[wseg * WVALS + i][wrow] = 0.0;
        }
#endif
        // X tile: one stage of TILE_COLS columns, XPR threads to a column.
#ifdef LLMX_MXFP4
        uint xr = 0u;
#endif
        for (uint i = 0u; i < STAGE_K / XPR; ++i) {
            uint k = k0 + xseg * (STAGE_K / XPR) + i;
#ifdef LLMX_MXFP4
            float v = (xin && k < p.nin) ? xv[i] : 0.0;
            xs[xseg * (STAGE_K / XPR) + i][xcol] = v;
            if (needs_wide_product(v, xlo, xhi)) xr = 1u;
#else
            xs[xseg * (STAGE_K / XPR) + i][xcol] = (xin && k < p.nin) ? matrix_input(x[xc * p.nin + k]) : 0.0;
#endif
        }
#ifdef LLMX_MXFP4
        xrange[xseg][xcol] = xr;
#endif
        barrier();
#ifdef LLMX_MXFP4
        // Each output needs a wide sum if any block flagged its weight row or activation column.
        for (uint i = 0u; i < MROWS; ++i) wide_rows[i] |= wrange[tr * MROWS + i];
        for (uint j = 0u; j < 4u; ++j) {
            uint c = tc * 4u + j;
            for (uint segment = 0u; segment < XPR; ++segment) wide_cols[j] |= xrange[segment][c];
        }
#endif
        // Unrolled by eight so the steps' shared-memory reads carry immediate offsets rather than recomputed addresses.
        for (uint kb = 0u; kb < STAGE_K; kb += 8u) {
            for (uint u = 0u; u < 8u; ++u) {
                uint k = kb + u;
                float b0 = xs[k][tc * 4u], b1 = xs[k][tc * 4u + 1u];
                float b2 = xs[k][tc * 4u + 2u], b3 = xs[k][tc * 4u + 3u];
                for (uint i = 0u; i < MROWS; ++i) {
                    float a = ws[k][tr * MROWS + i];
#ifdef LLMX_PRESERVE_F32
                    acc[i][0] = fma(a, b0, acc[i][0]);
                    acc[i][1] = fma(a, b1, acc[i][1]);
                    acc[i][2] = fma(a, b2, acc[i][2]);
                    acc[i][3] = fma(a, b3, acc[i][3]);
#else
                    acc[i][0] += a * b0;
                    acc[i][1] += a * b1;
                    acc[i][2] += a * b2;
                    acc[i][3] += a * b3;
#endif
                }
            }
        }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= p.nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            bool cv = col < p.nbatch;
            if (p.per != 0u) {
                cv = tc * 4u + j < ncols;
                col = cv ? tab[p.order0 + first + tc * 4u + j] : 0u;
            }
            if (cv) {
#ifdef LLMX_MXFP4
                bool recompute = (wide_rows[i] | wide_cols[j]) != 0u || isnan(acc[i][j]) || isinf(acc[i][j]);
                uint index = yoff + col * p.nout + row;
                if (p.per == 0u && p.kper < p.nin) {
                    // A partial may exceed f32, or lie below its smallest value, while the sum of the parts is finite and representable.
                    double s = recompute ? mxfp4_wide(row, col, kbeg, kend) : double(acc[i][j]);
                    uvec2 words = unpackDouble2x32(s);
                    ybits[2u * index] = words.x;
                    ybits[2u * index + 1u] = words.y;
                } else {
                    float s = recompute ? float(mxfp4_wide(expert * p.nout + row, p.per != 0u ? col / p.per : col, kbeg, kend)) : acc[i][j];
                    if (p.accum != 0u) s += uintBitsToFloat(ybits[index]);
                    ybits[index] = floatBitsToUint(s);
                }
#else
                if (p.accum != 0u) y[yoff + col * p.nout + row] += acc[i][j];
                else y[yoff + col * p.nout + row] = acc[i][j];
#endif
            }
        }
    }
}
