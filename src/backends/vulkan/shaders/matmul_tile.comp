#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches: a workgroup computes a TILE_ROWS x 64 tile of outputs, walking the inner dimension 32 at a time.
// Each step stages the W tile, dequantized, and the X tile in shared memory, then every thread accumulates a (TILE_ROWS/16) x 4 micro-tile in registers, so a weight is read from memory once per pass rather than once per chunk of columns.
// TILE_ROWS is a specialization constant because the two things it trades off are properties of the device and of the call, not of the algorithm.
// A taller tile reads less shared memory per multiply-add, which is what bounds this kernel: eight rows and four columns is twelve reads per thirty-two products where four and four is eight per sixteen.
// A taller tile also produces fewer workgroups for the same output, so a small call stops filling the device. The backend picks the height per dispatch (docs/VULKAN.md).
// Rows past nout and columns past nbatch read as zero and are not stored.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
layout(push_constant) uniform P { uint nin; uint nout; uint nbatch; uint type; uint accum; } p;
layout(set = 0, binding = 0) buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 2) readonly buffer WF { float wf[]; };
layout(set = 0, binding = 3) readonly buffer X { float x[]; };
layout(set = 0, binding = 4) readonly buffer W8 { uint8_t w8[]; };
#define QBYTES w8
#include "qdecode.glsl"

// Rows a thread accumulates, threads that share one row of the W tile, and
// the k values each of those loads. The 256 threads cover TILE_ROWS rows of
// 32 values either way; only the split between them changes.
#define MROWS (TILE_ROWS / 16u)
#define WPR (256u / TILE_ROWS)
#define WVALS (32u / WPR)

// The tiles are k-major: [k][row] and [k][column], so the four rows and four
// columns a thread multiplies for one k are four adjacent floats and load as
// one wide read each. Held the other way round, with a row per shared-memory
// row, those were eight separate reads at a stride of 33 and the driver spent
// six instructions of every thirty-two recomputing their addresses, issuing
// only half the inner loop as arithmetic (docs/VULKAN.md).
shared float ws[32][TILE_ROWS];
shared float xs[32][64];

int lo8(uint w) { return (int(w << 24u)) >> 24; }
int hi8(uint w) { return (int(w << 16u)) >> 24; }

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_base = gl_WorkGroupID.x * TILE_ROWS;
    uint col_base = gl_WorkGroupID.y * 64u;
    uint tr = tid / 16u, tc = tid - tr * 16u;   // micro-tile at rows tr*MROWS.., cols tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W loader: row wrow, k segment wseg*WVALS
    uint xcol = tid / 4u, xseg = tid - xcol * 4u;     // X loader: column xcol, k segment xseg*8..+8
    float acc[MROWS][4];
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
    uint nblocks = p.nin / 32u;   // Q8_0 and Q4_0 both have 32-value blocks
    for (uint k0 = 0u; k0 < p.nin; k0 += 32u) {
        // W tile: TILE_ROWS rows x 32 values.
        uint row = row_base + wrow;
        if (row < p.nout) {
            if (p.type == TYPE_Q8_0) {
                uint o = (row * nblocks + k0 / Q8_0_BLOCK) * 17u;
                float scale = unpackHalf2x16(uint(w16[o])).x;
                for (uint i = 0u; i < WVALS / 2u; ++i) {
                    uint word = uint(w16[o + 1u + wseg * (WVALS / 2u) + i]);
                    ws[wseg * WVALS + 2u * i][wrow] = scale * float(lo8(word));
                    ws[wseg * WVALS + 2u * i + 1u][wrow] = scale * float(hi8(word));
                }
            } else if (p.type == TYPE_Q4_0) {
                uint o = (row * nblocks + k0 / Q4_0_BLOCK) * Q4_0_BYTES;
                float d = half_at(w8[o], w8[o + 1u]);
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = q4_0_at(o, k, d);
                }
            } else if (p.type == TYPE_Q4_1) {
                uint o = (row * nblocks + k0 / 32u) * Q4_1_BYTES;
                float d = half_at(w8[o], w8[o + 1u]), m = half_at(w8[o + 2u], w8[o + 3u]);
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = q4_1_at(o, k, d, m);
                }
            } else if (is_kquant(p.type)) {
                // 256-value blocks: this 32-wide step is a slice of one.
                uint o = (row * (p.nin / Q6_K_BLOCK) + k0 / Q6_K_BLOCK) * block_bytes(p.type);
                uint k_in = k0 - (k0 / Q6_K_BLOCK) * Q6_K_BLOCK;
                if (p.type == TYPE_Q6_K) {
                    float d = half_at(w8[o + 208u], w8[o + 209u]);
                    for (uint i = 0u; i < WVALS; ++i) {
                        uint k = wseg * WVALS + i;
                        ws[k][wrow] = q6_k_at(o, k_in + k, d);
                    }
                } else {
                    float d = half_at(w8[o], w8[o + 1u]), dmin = half_at(w8[o + 2u], w8[o + 3u]);
                    for (uint i = 0u; i < WVALS; ++i) {
                        uint k = wseg * WVALS + i;
                        ws[k][wrow] = p.type == TYPE_Q4_K ? q4_k_at(o, k_in + k, d, dmin)
                                                         : q5_k_at(o, k_in + k, d, dmin);
                    }
                }
            } else {
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = k0 + wseg * WVALS + i;
                    ws[wseg * WVALS + i][wrow] = k < p.nin ? wf[row * p.nin + k] : 0.0;
                }
            }
        } else {
            for (uint i = 0u; i < WVALS; ++i) ws[wseg * WVALS + i][wrow] = 0.0;
        }
        // X tile: 64 columns x 32 values, four threads to a column.
        uint col = col_base + xcol;
        for (uint i = 0u; i < 8u; ++i) {
            uint k = k0 + xseg * 8u + i;
            xs[xseg * 8u + i][xcol] = (col < p.nbatch && k < p.nin) ? x[col * p.nin + k] : 0.0;
        }
        barrier();
        // Unrolled by four so the four inner steps differ by a constant, which
        // lets the shared-memory reads carry an immediate offset instead of an
        // address computed per step. Rolled, the driver spent six of every
        // thirty-two instructions on those addresses and issued only half the
        // loop as arithmetic (docs/VULKAN.md).
        // Unrolled by eight on top of the k-major layout: the eight steps then
        // differ by a constant, so their reads carry an immediate offset
        // rather than an address recomputed per step. Four was worth 5 percent
        // of pp512 here and eight another 3; sixteen and thirty-two measured
        // the same as eight, so eight is where it stops (docs/VULKAN.md).
        for (uint kb = 0u; kb < 32u; kb += 8u) {
            for (uint u = 0u; u < 8u; ++u) {
                uint k = kb + u;
                float b0 = xs[k][tc * 4u], b1 = xs[k][tc * 4u + 1u];
                float b2 = xs[k][tc * 4u + 2u], b3 = xs[k][tc * 4u + 3u];
                for (uint i = 0u; i < MROWS; ++i) {
                    float a = ws[k][tr * MROWS + i];
                    acc[i][0] += a * b0;
                    acc[i][1] += a * b1;
                    acc[i][2] += a * b2;
                    acc[i][3] += a * b3;
                }
            }
        }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= p.nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            if (col < p.nbatch) {
                if (p.accum != 0u) y[col * p.nout + row] += acc[i][j];
                else y[col * p.nout + row] = acc[i][j];
            }
        }
    }
}
