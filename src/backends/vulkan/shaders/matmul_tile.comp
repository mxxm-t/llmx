#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches: a workgroup computes a TILE_ROWS x 64 output tile, walking the inner dimension 32 at a time.
// Each step stages the dequantized W tile and the X tile in shared memory, and every thread accumulates a (TILE_ROWS/16) x 4 micro-tile in registers.
// TILE_ROWS is a specialization constant: a taller tile reads less shared memory per product but yields fewer workgroups, so the backend picks it per call.
// Rows past nout and columns past nbatch read as zero and are not stored.
// A call of few workgroups splits the inner dimension: workgroup row y is part y / ctiles of column tile y % ctiles, summing `kper` values from the part's start into its own slice of Y, which matmul_reduce.comp then adds in part order.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
layout(push_constant) uniform P { uint nin; uint nout; uint nbatch; uint type; uint accum; uint per; uint order0; uint kper; uint ctiles; } p;
layout(set = 0, binding = 0) buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 2) readonly buffer WF { float wf[]; };
layout(set = 0, binding = 3) readonly buffer X { float x[]; };
// The weights as words, since this driver issues one load per byte: a K-quant run is 2 or 4 aligned words, and scattered bytes are extracted from the word holding them.
layout(set = 0, binding = 4) readonly buffer W32 { uint w32[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs workgroup row y as tile y of the grouping (moe_group.comp): up to 64 entries of one expert, column c being entry
// tab[order0 + first + c], which reads X column entry / per through the expert's rows and writes output row entry. A routed call is never split.
layout(set = 0, binding = 5) readonly buffer T { uint tab[]; };
#define QBYTE(i) ((w32[(i) >> 2u] >> (8u * ((i) & 3u))) & 255u)
#include "qdecode.glsl"

// Rows a thread accumulates, threads sharing one W-tile row, and the values each loads; 256 threads cover TILE_ROWS rows of 32 values either way.
#define MROWS (TILE_ROWS / 16u)
#define WPR (256u / TILE_ROWS)
#define WVALS (32u / WPR)

// k-major tiles, [k][row] and [k][column], so a thread's four rows and four columns for one k are adjacent and load as one wide read each.
shared float ws[32][TILE_ROWS];
shared float xs[32][64];

int lo8(uint w) { return (int(w << 24u)) >> 24; }
int hi8(uint w) { return (int(w << 16u)) >> 24; }

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_base = gl_WorkGroupID.x * TILE_ROWS;
    uint part = gl_WorkGroupID.y / p.ctiles;
    uint col_base = (gl_WorkGroupID.y - part * p.ctiles) * 64u;
    uint kbeg = part * p.kper, kend = min(p.nin, kbeg + p.kper);
    uint yoff = part * p.nbatch * p.nout;   // an unsplit call's one part writes Y itself
    uint expert = 0u, first = 0u, ncols = 64u;
    if (p.per != 0u) {
        uint y = gl_WorkGroupID.y;
        expert = tab[4u * y];
        first = tab[4u * y + 1u];
        ncols = tab[4u * y + 2u];
        if (ncols == 0u) return;
        col_base = 0u;
    }
    uint tr = tid / 16u, tc = tid - tr * 16u;   // micro-tile at rows tr*MROWS.., cols tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W loader: row wrow, k segment wseg*WVALS
    uint xcol = tid / 4u, xseg = tid - xcol * 4u;     // X loader: column xcol, k segment xseg*8..+8
    // The X column this thread loads.
    uint xc = col_base + xcol;
    bool xin = xc < p.nbatch;
    if (p.per != 0u) {
        xin = xcol < ncols;
        xc = xin ? tab[p.order0 + first + xcol] / p.per : 0u;
    }
    float acc[MROWS][4];
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
    uint nblocks = p.nin / 32u;   // Q8_0 and Q4_0 both have 32-value blocks
    // F32 rows a power of two wide sit a multiple of the memory's channel interleave apart, so every row of a step reads the same channel; each block of rows starts its part at its own step and wraps, which spreads the tiles in flight across channels.
    // The rotation follows the 128-row block holding the tile, which every tile height the batch may pick lies within, so a row sums in the same order in any batch.
    uint nsteps = (kend - kbeg + 31u) / 32u;
    uint rot = p.type == TYPE_F32 && nsteps > 0u ? (row_base / 128u) % nsteps : 0u;
    uint kwrap = kbeg + nsteps * 32u, k0 = kbeg + rot * 32u;
    for (uint s = 0u; s < nsteps; ++s, k0 = k0 + 32u == kwrap ? kbeg : k0 + 32u) {
        // W tile: TILE_ROWS rows x 32 values.
        uint row = row_base + wrow, wr = expert * p.nout + row;
        if (row < p.nout) {
            if (p.type == TYPE_Q8_0) {
                uint o = (wr * nblocks + k0 / Q8_0_BLOCK) * 17u;
                float scale = unpackHalf2x16(uint(w16[o])).x;
                for (uint i = 0u; i < WVALS / 2u; ++i) {
                    uint word = uint(w16[o + 1u + wseg * (WVALS / 2u) + i]);
                    ws[wseg * WVALS + 2u * i][wrow] = scale * float(lo8(word));
                    ws[wseg * WVALS + 2u * i + 1u][wrow] = scale * float(hi8(word));
                }
            } else if (p.type == TYPE_Q4_0) {
                uint o = (wr * nblocks + k0 / Q4_0_BLOCK) * Q4_0_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u));
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = q4_0_at(o, k, d);
                }
            } else if (p.type == TYPE_Q4_1) {
                uint o = (wr * nblocks + k0 / 32u) * Q4_1_BYTES;
                float d = half_at(QBYTE(o), QBYTE(o + 1u)), m = half_at(QBYTE(o + 2u), QBYTE(o + 3u));
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = wseg * WVALS + i;
                    ws[k][wrow] = q4_1_at(o, k, d, m);
                }
            } else if (is_kquant(p.type)) {
                // 256-value blocks: this 32-wide step is a slice of one and a thread's run lies inside one group of 32, so the sub-scale, sub-min, nibble half and start byte are read once per run rather than per value.
                uint o = (wr * (p.nin / Q6_K_BLOCK) + k0 / Q6_K_BLOCK) * block_bytes(p.type);
                uint k_in = k0 - (k0 / Q6_K_BLOCK) * Q6_K_BLOCK;
                uint j0 = k_in + wseg * WVALS;   // the run's first value in the block
                uint l0 = j0 & 31u;              // and its position within the group
                if (p.type == TYPE_Q6_K) {
                    float d = half_at(QBYTE(o + 208u), QBYTE(o + 209u));
                    uint n = j0 / 128u, which = (j0 - n * 128u) / 32u;
                    uint lbase = o + n * 64u + l0 + ((which & 1u) != 0u ? 32u : 0u);
                    uint hbase = o + 128u + n * 32u + l0;
                    uint shift = 2u * which;
                    float ds = d * float((int(uint(QBYTE(o + 192u + n * 8u + l0 / 16u + 2u * which))) << 24) >> 24);
                    for (uint i = 0u; i < WVALS; ++i) {
                        uint lowb = uint(QBYTE(lbase + i));
                        uint q = (which < 2u ? (lowb & 15u) : (lowb >> 4u))
                               | (((uint(QBYTE(hbase + i)) >> shift) & 3u) << 4u);
                        ws[wseg * WVALS + i][wrow] = ds * float(int(q) - 32);
                    }
                } else {
                    float d = half_at(QBYTE(o), QBYTE(o + 1u)), dmin = half_at(QBYTE(o + 2u), QBYTE(o + 3u));
                    uint sc, mn;
                    scale_min_k4(o + 4u, j0 / 32u, sc, mn);
                    float ds = d * float(sc), dm = dmin * float(mn);
                    uint c = j0 / 64u;
                    bool low = ((j0 >> 5u) & 1u) == 0u;   // the group's nibble half
                    if (p.type == TYPE_Q4_K) {
                        uint base = (o + 16u + c * 32u + l0) / 4u;
                        for (uint g = 0u; g < WVALS / 4u; ++g) {
                            uint word = w32[base + g];
                            for (uint i = 0u; i < 4u; ++i) {
                                uint byte = (word >> (8u * i)) & 255u;
                                ws[wseg * WVALS + 4u * g + i][wrow] =
                                    ds * float(low ? (byte & 15u) : (byte >> 4u)) - dm;
                            }
                        }
                    } else {
                        uint base = (o + 48u + c * 32u + l0) / 4u, hbase = (o + 16u + l0) / 4u;
                        uint shift = 2u * c + (low ? 0u : 1u);
                        for (uint g = 0u; g < WVALS / 4u; ++g) {
                            uint word = w32[base + g], hword = w32[hbase + g];
                            for (uint i = 0u; i < 4u; ++i) {
                                uint byte = (word >> (8u * i)) & 255u;
                                uint q = (low ? (byte & 15u) : (byte >> 4u))
                                       | ((((hword >> (8u * i)) >> shift) & 1u) << 4u);
                                ws[wseg * WVALS + 4u * g + i][wrow] = ds * float(q) - dm;
                            }
                        }
                    }
                }
            } else {
                for (uint i = 0u; i < WVALS; ++i) {
                    uint k = k0 + wseg * WVALS + i;
                    ws[wseg * WVALS + i][wrow] = k < p.nin ? wf[wr * p.nin + k] : 0.0;
                }
            }
        } else {
            for (uint i = 0u; i < WVALS; ++i) ws[wseg * WVALS + i][wrow] = 0.0;
        }
        // X tile: 64 columns x 32 values, four threads to a column.
        for (uint i = 0u; i < 8u; ++i) {
            uint k = k0 + xseg * 8u + i;
            xs[xseg * 8u + i][xcol] = (xin && k < p.nin) ? x[xc * p.nin + k] : 0.0;
        }
        barrier();
        // Unrolled by eight so the steps' shared-memory reads carry immediate offsets rather than recomputed addresses.
        for (uint kb = 0u; kb < 32u; kb += 8u) {
            for (uint u = 0u; u < 8u; ++u) {
                uint k = kb + u;
                float b0 = xs[k][tc * 4u], b1 = xs[k][tc * 4u + 1u];
                float b2 = xs[k][tc * 4u + 2u], b3 = xs[k][tc * 4u + 3u];
                for (uint i = 0u; i < MROWS; ++i) {
                    float a = ws[k][tr * MROWS + i];
                    acc[i][0] += a * b0;
                    acc[i][1] += a * b1;
                    acc[i][2] += a * b2;
                    acc[i][3] += a * b3;
                }
            }
        }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= p.nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            bool cv = col < p.nbatch;
            if (p.per != 0u) {
                cv = tc * 4u + j < ncols;
                col = cv ? tab[p.order0 + first + tc * 4u + j] : 0u;
            }
            if (cv) {
                if (p.accum != 0u) y[yoff + col * p.nout + row] += acc[i][j];
                else y[yoff + col * p.nout + row] = acc[i][j];
            }
        }
    }
}
