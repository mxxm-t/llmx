#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches through the two-wide 16-bit integer dot, on devices where the integer dot is native, against the activations' 16-bit twin (xquant.glsl), which the row kernels read too.
// A workgroup computes a TILE_ROWS x 64 tile, walking the inner dimension one quant block of 32 at a time, over all of it or over one part when the call is split; matmul_reduce.comp adds the parts in order.
// Each step stages, per row, the block's quants widened to the twin's signed 16-bit pairs with its scale and minimum, and per column the twin's 16 words of the block with its scale and scaled sum.
// A thread forms (TILE_ROWS / 16) x 4 dots of 32 products, as two of 16 since Q6_K scales the halves apart.
// Types: Q4_0, Q4_1, Q4_K and Q5_K, Q6_K in its own build (LLMX_Q6) and Q8_0 in its own build (LLMX_Q8).
// The Q8_0 build stages one float scale per row and per column, since Q8_0 has one scale per block and no minimum, and takes no type branch.
// Rows past nout and columns past nbatch read as zero and are not stored.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#ifdef LLMX_Q8
#extension GL_EXT_control_flow_attributes : require
#endif
#include "dot16.glsl"
#include "q.glsl"
#ifdef LLMX_Q8MX
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4466], 4461, 64);
#endif
#include "float_controls.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
// Up to three projections of one X and one type per dispatch; workgroups start0, start1 and start2 on begin each projection's row tiles. kper is the quant blocks a workgroup sums, a multiple of two when the call is split; blocks of a step past its part read as zero.
// When the call is split, projection q's part z goes to y at parts * nbatch * (rows of the projections before q) + z * nbatch * nout_q, all projections sharing one scratch buffer.
// xcols is the columns of X the twin holds, which a routed call's entries read by entry / per; the scale table follows their pairs.
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
    uint per; uint order0; uint xcols;
} p;
#ifdef LLMX_Q8MX
layout(set = 0, binding = 0) buffer Y { uint ybits[]; } ys[3];
#else
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
#endif
layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
// The twin bound twice: as words for the pairs and as pairs of floats for the per-block scale table after them.
layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs workgroup row y as tile y of the grouping (moe_group.comp): up to 64 entries of one expert, column c being entry tab[order0 + first + c], which reads X column entry / per through the expert's rows and writes output row entry.
// A routed call is never split.
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
uint pi = 0u;   // this workgroup's projection, uniform across it
#ifdef LLMX_Q8MX
// MXFP4 uses exact float-scale copies and retains packed weights for range repair.
layout(set = 0, binding = 5) readonly buffer WM { uint w[]; } wm[3];
#define QBYTE(i) ((wm[pi].w[(i) >> 2u] >> (8u * ((i) & 3u))) & 255u)
#endif
#ifdef LLMX_Q8MX
#include "qdecode.glsl"
// Range repair uses exact decoded weights and the same reconstructed 16-bit inputs as the integer dot.
double mxfp4_wide_q(uint row, uint col, uint begin, uint end) {
    double sum = 0.0;
    for (uint k = begin; k < end; ++k) {
        uint o = (row * (p.nin / MXFP4_BLOCK) + k / MXFP4_BLOCK) * MXFP4_BYTES;
        uint word = xq[col * (p.nin / 2u) + (k / 4u) * 2u + (k & 1u)];
        int q = int(int16_t(word >> ((k & 2u) * 8u)));
        double dx = double(xs[p.xcols * p.nin / 4u + col * (p.nin / 32u) + k / 32u].x);
        sum += double(mxfp4_at(o, k % MXFP4_BLOCK)) * (double(q) * dx);
    }
    return sum;
}
// With a weight scale d in [2^-24, 2^15] and |sum| < 2^24, an activation scale c in [2^-102, 2^89) keeps d * c and its product with the sum inside the normal floats; zero is exact.
// A row's block with d outside that range, and a column's with c outside it, take the wide sum.
bool wide_weight(float d) {
    uint a = floatBitsToUint(d) & 0x7fffffffu, e = a >> 23u;
    return a != 0u && (e < 103u || e > 142u);   // exponent fields of 2^-24 and 2^15; a zero scale is a block past the part
}
bool wide_scale(float c) {
    uint a = floatBitsToUint(c) & 0x7fffffffu, e = a >> 23u;
    return a != 0u && (e < 25u || e >= 216u);   // exponent fields of 2^-102 and 2^89
}
#endif


#define MROWS (TILE_ROWS / 16u)
#define WPR (256u / TILE_ROWS)   // threads that stage one row's 8 words
#define WW (8u / WPR)            // and how many words each

// Quant blocks staged per barrier, so their loads are in flight together; two keep the tallest tile's widened quants and activations below 32 KB.
#ifndef STEP
#define STEP 2u
#endif
// k-major: pair w of every row, then of every column, each four values; block s of a step at pairs 8s to 8s + 7.
shared uvec2 wq[8u * STEP][TILE_ROWS];
shared uvec2 xw[8u * STEP][64];
#ifdef LLMX_Q8
shared float wsc[STEP * TILE_ROWS];   // per row and block: the scale
// Per column and block: the activation scale, one stored by each of a column's four threads, so a step of two leaves two unused.
shared float xsc[4u * 64u];
#else
// Per row and block: the scale of each half and the minimum it subtracts; only Q6_K scales its halves apart.
shared vec4 wsc[STEP * TILE_ROWS];
shared vec2 xsc[STEP * 64u];     // per column and block: the activation scale and scale times integer sum
#endif

#if !defined(LLMX_Q8) && !defined(LLMX_Q6)
float tile_term(float scale, float minimum, vec2 activation, int dot) {
    return scale * activation.x * float(dot) - minimum * activation.y;
}
#endif

// scale_min_k4 (qdecode.glsl) over the twelve packed sub-scale bytes held in three words, without a branch.
uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
}

#ifndef LLMX_Q8
// Stores this thread's share of the four scale values of its scale block (ks in main()), zero when the block is out of range.
// A row's WPR threads each take block wseg % STEP of the step, which needs STEP to divide WPR: a step of two does at every tile height.
void store_scales(uint wrow, uint wseg, bool ok, vec4 v) {
    for (uint k = 0u; k < 4u * STEP / WPR; ++k) {
        uint c = wseg / STEP + k * (WPR / STEP);
        wsc[(wseg % STEP) * TILE_ROWS + wrow][c] = ok ? v[c] : 0.0;
    }
}
#endif

// A step's activations: a column's four threads each load four of a block's sixteen words and one of the step's scale values, 2 * STEP of them, or STEP in the Q8_0 build, where a block has one and thread xseg loads block xseg's.
#ifdef LLMX_Q8
#define XSC 1u
#else
#define XSC (STEP / 2u)
#endif
// Stores them from the registers they were loaded into, zero past the batch or the thread's part of the inner dimension.
void store_x(uint k0, uint kend, bool xin, uint xcol, uint xseg, uvec4 xv[STEP], float xf[XSC]) {
    for (uint s = 0u; s < STEP; ++s) {
        bool colv = xin && k0 + s < kend;
        xw[s * 8u + xseg * 2u][xcol] = colv ? xv[s].xy : uvec2(0u);
        xw[s * 8u + xseg * 2u + 1u][xcol] = colv ? xv[s].zw : uvec2(0u);
    }
#ifdef LLMX_Q8
    xsc[xseg * 64u + xcol] = xin && xseg < STEP && k0 + xseg < kend ? xf[0] : 0.0;
#else
    for (uint k = 0u; k < XSC; ++k) {
        uint s = xseg % STEP;
        xsc[s * 64u + xcol][xseg / STEP + k * (4u / STEP)] = xin && k0 + s < kend ? xf[k] : 0.0;
    }
#endif
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint row_base = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * TILE_ROWS;
    uint ncg = (p.nbatch + 63u) / 64u;                 // column tiles; the workgroup's y is column tile plus ncg times its part
    uint part = gl_WorkGroupID.y / ncg;
    uint col_base = (gl_WorkGroupID.y - part * ncg) * 64u;
    uint expert = 0u, first = 0u, ncols = 64u;
    if (p.per != 0u) {
        uint y = gl_WorkGroupID.y;
        expert = tab[4u * y];
        first = tab[4u * y + 1u];
        ncols = tab[4u * y + 2u];
        if (ncols == 0u) return;
        part = 0u;
        col_base = 0u;
    }
    uint tr = tid / 16u, tc = tid - tr * 16u;         // micro-tile at rows tr*MROWS.., columns tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W stager: row wrow, words wseg*WW..
    uint xcol = tid / 4u, xseg = tid - xcol * 4u;     // X stager: column xcol, words xseg*4..
    uint nblk = p.nin / 32u;
    uint xtab = p.xcols * p.nin / 4u;                  // the scale table's start, in pairs
    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
    uint parts = (nblk + p.kper - 1u) / p.kper;
    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
    // The X column this thread stages.
    uint xc = col_base + xcol;
    bool xin = xc < p.nbatch;
    if (p.per != 0u) {
        xin = xcol < ncols;
        xc = xin ? tab[p.order0 + first + xcol] / p.per : 0u;
    }
    float acc[MROWS][4];
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
#ifdef LLMX_Q8MX
    uint wide = 0u;
#endif
    for (uint k0 = kbeg; k0 < kend; k0 += STEP) {
        // Every global load of a step goes out before the first is waited for.
        // The compiler waits for a load under a branch it cannot prove uniform inside that branch, and moves a load down into the block that first uses it.
        // So a load out of range reads a valid address and its zero is selected when it is stored, and each type's staging ends by storing the activations loaded before it.
        uvec4 xv[STEP];
        float xf[XSC];
        for (uint s = 0u; s < STEP; ++s) {
            uint kb = k0 + s;
            uint xb = xin && kb < kend ? (xc * nblk + kb) * 16u + xseg * 4u : 0u;
            xv[s] = uvec4(xq[xb], xq[xb + 1u], xq[xb + 2u], xq[xb + 3u]);
        }
        for (uint k = 0u; k < XSC; ++k) {
#ifdef LLMX_Q8
            uint kb = k0 + xseg;
            xf[k] = xs[xin && xseg < STEP && kb < kend ? xtab + xc * nblk + kb : 0u].x;
#else
            uint kb = k0 + xseg % STEP;
            xf[k] = xs[xin && kb < kend ? xtab + xc * nblk + kb : 0u][xseg / STEP + k * (4u / STEP)];
#endif
        }
        uint row = row_base + wrow, wr = expert * nout + row;
#ifndef LLMX_Q8
        // The block whose scales this thread stages (store_scales).
        uint ks = k0 + wseg % STEP;
        bool oks = row < nout && ks < kend;
#endif
#ifdef LLMX_Q6
        {
            // Q6_K, 210-byte blocks: group g takes its low four bits from 32 bytes of ql and its top two from 32 of qh, with a sub-scale per 16 values; the -32 offset goes into each byte, and both runs are funnelled when they straddle.
            // Each run is a thread's words plus one, which lies inside the block whether or not the run straddles.
            uint nsb = p.nin / 256u;
            uint lv[STEP][WW + 1u], hv[STEP][WW + 1u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u, n = g / 4u, which = g & 3u;
                uint o = row < nout && kb < kend ? (wr * nsb + kb / 8u) * Q6_K_BYTES : 0u;
                uint lo = (o + n * 64u + (which & 1u) * 32u + wseg * WW * 4u) >> 2u, hi = (o + 128u + n * 32u + wseg * WW * 4u) >> 2u;
                for (uint m = 0u; m <= WW; ++m) {
                    lv[s][m] = ws[pi].w32[lo + m];
                    hv[s][m] = ws[pi].w32[hi + m];
                }
            }
            // The scale block's half scale and its group's two sub-scales, each pair of bytes within one word since o is even.
            uint os = oks ? (wr * nsb + ks / 8u) * Q6_K_BYTES : 0u, gs = ks & 7u;
            uint si = os + 192u + (gs / 4u) * 8u + 2u * (gs & 3u);
            uint dw = ws[pi].w32[(os + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u, which = g & 3u;
                bool ok = row < nout && kb < kend;
                uint o = ok ? (wr * nsb + kb / 8u) * Q6_K_BYTES : 0u;
                uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
                bool odd = (o & 3u) != 0u;   // o is even, so both runs share this
                for (uint m = 0u; m < WW; ++m) {
                    uint ql = odd ? (lv[s][m] >> 16u) | (lv[s][m + 1u] << 16u) : lv[s][m];
                    uint qh = odd ? (hv[s][m] >> 16u) | (hv[s][m + 1u] << 16u) : hv[s][m];
                    uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
                    // b - 32 per byte: flipping bit 5 gives b - 32 or b + 32, and a set bit 5 then means negative, so it is copied into bits 6 and 7.
                    uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
                    wq[s * 8u + wseg * WW + m][wrow] = weight16(ok ? t | (neg << 1u) | (neg << 2u) : 0u);
                }
            }
            float d = unpackHalf2x16((os & 3u) == 0u ? dw : (dw >> 16u)).x;
            uint sb = sw >> (8u * (si & 3u));
            float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
            store_scales(wrow, wseg, oks, vec4(d * s0, d * s1, 0.0, 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#elif defined(LLMX_Q8MX)
        {
            // An MXFP4 copy's blocks (copy_mxfp4.comp), nine aligned words: the float scale, then the 32 codes a byte each, so a thread loads its words and the scale word.
            uint qv[STEP][WW + 1u];
            bool okw[STEP];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                okw[s] = row < nout && kb < kend;
                uint ob = okw[s] ? (wr * nblk + kb) * 9u : 0u;
                for (uint m = 0u; m < WW; ++m) qv[s][m] = ws[pi].w32[ob + 1u + wseg * WW + m];
                qv[s][WW] = ws[pi].w32[ob];
            }
            for (uint s = 0u; s < STEP; ++s)
                for (uint m = 0u; m < WW; ++m) wq[s * 8u + wseg * WW + m][wrow] = weight16(okw[s] ? qv[s][m] : 0u);
            if (wseg == 0u)
                for (uint s = 0u; s < STEP; ++s) wsc[s * TILE_ROWS + wrow] = okw[s] ? uintBitsToFloat(qv[s][WW]) : 0.0;
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#elif defined(LLMX_Q8)
        {
            // Q8_0, 34-byte blocks: the half scale, then 32 quants starting on a word boundary or two bytes past one, so a thread loads its words plus one and funnels them when they straddle.
            // Where they straddle the extra word is the one after the thread's share, and where they do not the one before, so a load reads past the block only where it straddles, and then only the rest of the word holding its last two quants.
            // A row's first thread then holds the half scale, in the low half of its first word or the high half of the word before, and stores the step's scales.
            uint qv[STEP][WW + 1u];
            bool okw[STEP], str[STEP];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                okw[s] = row < nout && kb < kend;
                uint ob = okw[s] ? (wr * nblk + kb) * Q8_0_BYTES : 0u;
                str[s] = (ob & 3u) == 0u;
                uint base = ((ob + 2u) >> 2u) + wseg * WW;
                for (uint m = 0u; m < WW; ++m) qv[s][m] = ws[pi].w32[base + m];
                qv[s][WW] = ws[pi].w32[str[s] ? base + WW : base - 1u];
            }
            for (uint s = 0u; s < STEP; ++s) {
                for (uint m = 0u; m < WW; ++m) {
                    uint v = str[s] ? (qv[s][m] >> 16u) | (qv[s][m + 1u] << 16u) : qv[s][m];
                    wq[s * 8u + wseg * WW + m][wrow] = weight16(okw[s] ? v : 0u);
                }
            }
            if (wseg == 0u)
                for (uint s = 0u; s < STEP; ++s)
                    wsc[s * TILE_ROWS + wrow] = okw[s] ? unpackHalf2x16(str[s] ? qv[s][0] : qv[s][WW] >> 16u).x : 0.0;
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#else
        if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
            // Q4_K, 144-byte blocks: block 32 is group g of a 256-value block; its nibbles are the low or high halves of 32 word-aligned bytes, so a quant word is one load, a shift and a mask.
            // Q5_K, 176-byte blocks: the same with a fifth bit per value, bit g of 32 word-aligned high-bit bytes before the nibbles.
            // The scale block's scales come from the 16-byte head of its 256-value block: the two half scales and the twelve packed sub-scale bytes.
            bool k5 = p.type == TYPE_Q5_K;
            uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
            uint qv[STEP][WW], hv[STEP][WW];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                uint o = row < nout && kb < kend ? (wr * nsb + kb / 8u) * bytes : 0u;
                uint base = (o + (k5 ? 48u : 16u) + ((kb & 7u) / 2u) * 32u) / 4u + wseg * WW;
                for (uint m = 0u; m < WW; ++m) qv[s][m] = ws[pi].w32[base + m];
                if (k5) for (uint m = 0u; m < WW; ++m) hv[s][m] = ws[pi].w32[(o + 16u) / 4u + wseg * WW + m];
            }
            uint os = oks ? (wr * nsb + ks / 8u) * bytes : 0u;
            uvec4 h = uvec4(ws[pi].w32[os / 4u], ws[pi].w32[os / 4u + 1u], ws[pi].w32[os / 4u + 2u], ws[pi].w32[os / 4u + 3u]);
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u;
                bool ok = row < nout && kb < kend;
                for (uint m = 0u; m < WW; ++m) {
                    uint v = (qv[s][m] >> (4u * (g & 1u))) & 0x0F0F0F0Fu;
                    v = k5 ? v | (((hv[s][m] >> g) & 0x01010101u) << 4u) : v;
                    wq[s * 8u + wseg * WW + m][wrow] = weight16(ok ? v : 0u);
                }
            }
            vec2 dd = unpackHalf2x16(h.x);
            uint sc, mn;
            scale_min_k4_words(h.yzw, ks & 7u, sc, mn);
            store_scales(wrow, wseg, oks, vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        } else {
            // Q4_0, 18-byte blocks: a half scale, then 16 bytes whose low nibbles are values 0 to 15 and high nibbles 16 to 31; the offset of 8 goes into each byte, and the words are funnelled when they straddle.
            // Q4_1, 20-byte blocks, always word aligned: a half scale and a half minimum, then Q4_0's nibbles without the offset; the minimum is stored negated since it is added.
            // Staged words w and w + 4 are the low and high nibbles of one source word, so a thread staging two or more takes source words whole and stages both halves.
            // A Q4_0 word that does not straddle loads itself twice, so no load leaves the matrix.
            const uint SPT = WW >= 2u ? WW / 2u : 1u;   // source words a thread takes
            bool q41 = p.type == TYPE_Q4_1;
            uint bytes = q41 ? Q4_1_BYTES : Q4_0_BYTES, qoff = q41 ? 4u : 2u;   // the quants' offset in a block
            uint qv[STEP][SPT][2];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                uint q0 = (row < nout && kb < kend ? (wr * nblk + kb) * bytes : 0u) + qoff;
                for (uint m = 0u; m < SPT; ++m) {
                    uint i = (q0 >> 2u) + (WW >= 2u ? wseg * SPT + m : (wseg & 3u));
                    qv[s][m][0] = ws[pi].w32[i];
                    qv[s][m][1] = ws[pi].w32[i + ((q0 & 3u) != 0u ? 1u : 0u)];
                }
            }
            uint os = oks ? (wr * nblk + ks) * bytes : 0u;
            uint sw = ws[pi].w32[os >> 2u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                bool ok = row < nout && kb < kend;
                bool odd = (((ok ? (wr * nblk + kb) * bytes : 0u) + qoff) & 3u) != 0u;
                for (uint m = 0u; m < SPT; ++m) {
                    uint w = WW >= 2u ? wseg * SPT + m : (wseg & 3u);
                    uint nw = odd ? (qv[s][m][0] >> 16u) | (qv[s][m][1] << 16u) : qv[s][m][0];
                    for (uint h = 0u; h < 2u; ++h) {
                        if (WW < 2u && h != (wseg >> 2u)) continue;
                        uint b = (nw >> (4u * h)) & 0x0F0F0F0Fu;
                        // Q4_0's b - 8 per byte: flipping bit 3 gives b - 8 or b + 8, and a set bit 3 then means negative, so it is copied into bits 4 to 7.
                        uint t = b ^ 0x08080808u, neg = t & 0x08080808u;
                        uint v = q41 ? b : t | (neg << 1u) | (neg << 2u) | (neg << 3u) | (neg << 4u);
                        wq[s * 8u + w + 4u * h][wrow] = weight16(ok ? v : 0u);
                    }
                }
            }
            vec2 dm = unpackHalf2x16(!q41 && (os & 3u) != 0u ? sw >> 16u : sw);
            store_scales(wrow, wseg, oks, q41 ? vec4(dm.x, dm.x, -dm.y, 0.0) : vec4(dm.x, dm.x, 0.0, 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#endif
        barrier();
#ifdef LLMX_Q8
      // Keep the block loop unrolled.
      [[unroll]]
#endif
      for (uint s = 0u; s < STEP; ++s) {
#ifndef LLMX_Q6
        // Word w of every row of the thread against word w of its four columns, so all 4 * MROWS dot sums of the block stay live and a column word is read once.
        // Each sum still takes the block's eight words in order, so it is the integer a row at a time gave.
#ifdef LLMX_Q8
        float c0 = xsc[s * 64u + tc * 4u], c1 = xsc[s * 64u + tc * 4u + 1u];
        float c2 = xsc[s * 64u + tc * 4u + 2u], c3 = xsc[s * 64u + tc * 4u + 3u];
#else
        vec2 c0 = xsc[s * 64u + tc * 4u], c1 = xsc[s * 64u + tc * 4u + 1u];
        vec2 c2 = xsc[s * 64u + tc * 4u + 2u], c3 = xsc[s * 64u + tc * 4u + 3u];
#endif
#ifdef LLMX_Q8MX
        if (wide_scale(c0)) wide |= 1u;
        if (wide_scale(c1)) wide |= 2u;
        if (wide_scale(c2)) wide |= 4u;
        if (wide_scale(c3)) wide |= 8u;
#endif
        int t[MROWS][4];
        for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) t[i][j] = 0;
#ifdef LLMX_Q8
        [[unroll]]
#endif
        for (uint w = 0u; w < 8u; ++w) {
            uvec2 b0 = xw[s * 8u + w][tc * 4u], b1 = xw[s * 8u + w][tc * 4u + 1u];
            uvec2 b2 = xw[s * 8u + w][tc * 4u + 2u], b3 = xw[s * 8u + w][tc * 4u + 3u];
            for (uint i = 0u; i < MROWS; ++i) {
                uvec2 a = wq[s * 8u + w][tr * MROWS + i];
                t[i][0] = dot_pairs(a, b0, t[i][0]);
                t[i][1] = dot_pairs(a, b1, t[i][1]);
                t[i][2] = dot_pairs(a, b2, t[i][2]);
                t[i][3] = dot_pairs(a, b3, t[i][3]);
            }
        }
        for (uint i = 0u; i < MROWS; ++i) {
#ifdef LLMX_Q8
            // The scales' product, then its product with the sum, each rounded before the add.
            // The general build rounds them so too, since its minimum term, zero for Q8_0, stands between the last product and the add.
            float d = wsc[s * TILE_ROWS + tr * MROWS + i];
#ifdef LLMX_Q8MX
            if (wide_weight(d)) wide |= 1u << (4u + i);
#endif
            precise float p0 = d * c0 * float(t[i][0]), p1 = d * c1 * float(t[i][1]);
            precise float p2 = d * c2 * float(t[i][2]), p3 = d * c3 * float(t[i][3]);
            acc[i][0] += p0;
            acc[i][1] += p1;
            acc[i][2] += p2;
            acc[i][3] += p3;
#else
            vec4 ws = wsc[s * TILE_ROWS + tr * MROWS + i];
            acc[i][0] += tile_term(ws.x, ws.z, c0, t[i][0]);
            acc[i][1] += tile_term(ws.x, ws.z, c1, t[i][1]);
            acc[i][2] += tile_term(ws.x, ws.z, c2, t[i][2]);
            acc[i][3] += tile_term(ws.x, ws.z, c3, t[i][3]);
#endif
        }
#else
        // The same word-outer form, the block's two halves of 16 summed apart since Q6_K scales them apart; Q6_K takes only the short and small heights (qtile), so a thread's rows are all live at once.
        vec2 c0 = xsc[s * 64u + tc * 4u], c1 = xsc[s * 64u + tc * 4u + 1u];
        vec2 c2 = xsc[s * 64u + tc * 4u + 2u], c3 = xsc[s * 64u + tc * 4u + 3u];
        {
            int l[MROWS][4], h[MROWS][4];
            for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) { l[i][j] = 0; h[i][j] = 0; }
            for (uint w = 0u; w < 4u; ++w) {
                uvec2 l0 = xw[s * 8u + w][tc * 4u], l1 = xw[s * 8u + w][tc * 4u + 1u], l2 = xw[s * 8u + w][tc * 4u + 2u], l3 = xw[s * 8u + w][tc * 4u + 3u];
                uvec2 h0 = xw[s * 8u + w + 4u][tc * 4u], h1 = xw[s * 8u + w + 4u][tc * 4u + 1u];
                uvec2 h2 = xw[s * 8u + w + 4u][tc * 4u + 2u], h3 = xw[s * 8u + w + 4u][tc * 4u + 3u];
                for (uint i = 0u; i < MROWS; ++i) {
                    uint r = tr * MROWS + i;
                    uvec2 a = wq[s * 8u + w][r], e = wq[s * 8u + w + 4u][r];
                    l[i][0] = dot_pairs(a, l0, l[i][0]); h[i][0] = dot_pairs(e, h0, h[i][0]);
                    l[i][1] = dot_pairs(a, l1, l[i][1]); h[i][1] = dot_pairs(e, h1, h[i][1]);
                    l[i][2] = dot_pairs(a, l2, l[i][2]); h[i][2] = dot_pairs(e, h2, h[i][2]);
                    l[i][3] = dot_pairs(a, l3, l[i][3]); h[i][3] = dot_pairs(e, h3, h[i][3]);
                }
            }
            for (uint i = 0u; i < MROWS; ++i) {
                vec4 ws = wsc[s * TILE_ROWS + tr * MROWS + i];
                acc[i][0] += c0.x * (ws.x * float(l[i][0]) + ws.y * float(h[i][0]));
                acc[i][1] += c1.x * (ws.x * float(l[i][1]) + ws.y * float(h[i][1]));
                acc[i][2] += c2.x * (ws.x * float(l[i][2]) + ws.y * float(h[i][2]));
                acc[i][3] += c3.x * (ws.x * float(l[i][3]) + ws.y * float(h[i][3]));
            }
        }
#endif
      }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            bool cv = col < p.nbatch;
            if (p.per != 0u) {
                cv = tc * 4u + j < ncols;
                col = cv ? tab[p.order0 + first + tc * 4u + j] : 0u;
            }
            if (cv) {
#ifdef LLMX_Q8MX
                bool repair = ((wide >> j) & 1u) != 0u || ((wide >> (4u + i)) & 1u) != 0u || isnan(acc[i][j]) || isinf(acc[i][j]);
                double value = repair ? mxfp4_wide_q(row, col, kbeg * 32u, kend * 32u) : double(acc[i][j]);
                uint index = yo + col * nout + row;
                if (parts > 1u) {
                    uvec2 words = unpackDouble2x32(value);
                    ys[pi].ybits[2u * index] = words.x;
                    ys[pi].ybits[2u * index + 1u] = words.y;
                } else {
                    float result = float(value);
                    if (p.accum != 0u) result += uintBitsToFloat(ys[pi].ybits[index]);
                    ys[pi].ybits[index] = floatBitsToUint(result);
                }
#else
                if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += acc[i][j];
                else ys[pi].y[yo + col * nout + row] = acc[i][j];
#endif
            }
        }
    }
}
