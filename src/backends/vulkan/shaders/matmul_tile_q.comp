#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches through the four-wide 8-bit integer dot, for devices where that instruction is native.
// The float tile (matmul_tile.comp) multiplies one product per instruction on dequantized floats; this one multiplies four per instruction on the quants themselves, against activations quantized to 8 bits per block of 32 (quantize_x8.comp), and holds a quarter of the shared memory per value.
// A workgroup computes a TILE_ROWS x 64 tile, walking the inner dimension one quant block of 32 at a time.
// Each step stages, for every row, the block's quants as 8 words of signed bytes with the block's scale and minimum, and for every column the activation block's 8 words with its scale and scaled sum.
// A thread then forms (TILE_ROWS / 16) x 4 integer dots of 32 products each, as two of 16 because Q6_K scales the halves apart, and folds them into its float accumulator with a multiply-add per half and one more for the types with a minimum.
// Types: Q8_0, Q4_0, Q4_1, Q4_K and Q5_K as is, Q6_K when compiled with LLMX_Q6. The Q6_K build sums each half of a block apart, which the others do not need and which cost them 4 percent when one module served all four, so it is its own module as the row kernel families are. Rows past nout and columns past nbatch read as zero and are not stored.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
layout(push_constant) uniform P { uint nin; uint nout; uint nbatch; uint type; uint accum; } p;
layout(set = 0, binding = 0) buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer W16 { uint16_t w16[]; };
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; };
// The 8-bit activations bound twice, as words for the quants and as pairs for the per-block scale table after them.
layout(set = 0, binding = 3) readonly buffer XQ { uint xq[]; };
layout(set = 0, binding = 4) readonly buffer XS { vec2 xs[]; };
#define QBYTE(i) ((w32[(i) >> 2u] >> (8u * ((i) & 3u))) & 255u)
#include "qdecode.glsl"

#define MROWS (TILE_ROWS / 16u)
#define WPR (256u / TILE_ROWS)   // threads that stage one row's 8 words
#define WW (8u / WPR)            // and how many words each

// k-major: word w of every row, then of every column, so a thread's rows and columns for one word are adjacent.
shared uint wq[8][TILE_ROWS];
// Per row: the scale of each half of this block, and the minimum it subtracts. Only Q6_K scales its halves apart; the others give both halves one scale.
shared vec4 wsc[TILE_ROWS];
shared uint xw[8][64];
shared vec2 xsc[64];             // per column: the activation scale and scale times integer sum

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_base = gl_WorkGroupID.x * TILE_ROWS;
    uint col_base = gl_WorkGroupID.y * 64u;
    uint tr = tid / 16u, tc = tid - tr * 16u;         // micro-tile at rows tr*MROWS.., columns tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W stager: row wrow, words wseg*WW..
    uint xcol = tid / 4u, xseg = tid - xcol * 4u;     // X stager: column xcol, words xseg*2..
    uint nblk = p.nin / 32u;
    uint xtab = p.nbatch * p.nin / 8u;                // the scale table's start, in pairs
    float acc[MROWS][4];
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
    for (uint kb = 0u; kb < nblk; ++kb) {
        uint row = row_base + wrow;
        if (row < p.nout) {
            if (p.type == TYPE_Q8_0) {
                // A 34-byte block: the half scale, then the 32 quants. A block's quants start either on a word boundary or two bytes past one, so a thread loads its words plus one and funnels them when they straddle: one load per quant word rather than the two halves each took, which is what held Q8_0 below Q4_K here.
                uint ob = (row * nblk + kb) * 34u, q0 = ob + 2u;
                uint base = (q0 >> 2u) + wseg * WW;
                if ((q0 & 3u) == 0u) {
                    for (uint m = 0u; m < WW; ++m) wq[wseg * WW + m][wrow] = w32[base + m];
                } else {
                    uint prev = w32[base];
                    for (uint m = 0u; m < WW; ++m) {
                        uint next = w32[base + m + 1u];
                        wq[wseg * WW + m][wrow] = (prev >> 16u) | (next << 16u);
                        prev = next;
                    }
                }
                if (wseg == 0u) {
                    uint sw = w32[ob >> 2u];
                    float d = unpackHalf2x16((ob & 3u) == 0u ? sw : (sw >> 16u)).x;
                    wsc[wrow] = vec4(d, d, 0.0, 0.0);
                }
#ifdef LLMX_Q6
            } else if (p.type == TYPE_Q6_K) {
                // Q6_K, 210-byte blocks: group g of 32 takes its low four bits from 32 consecutive bytes of ql and its top two from 32 of qh, and has a sub-scale per 16 values. The -32 offset goes into each byte, so the stored quants are signed and need no minimum. Blocks alternate word alignment, so both runs are funnelled when they straddle, as Q8_0's are.
                uint o = (row * (p.nin / 256u) + kb / 8u) * Q6_K_BYTES;
                uint g = kb & 7u, n = g / 4u, which = g & 3u;
                uint lo = o + n * 64u + (which & 1u) * 32u + wseg * WW * 4u;
                uint hi = o + 128u + n * 32u + wseg * WW * 4u;
                uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
                bool odd = (lo & 3u) != 0u;   // o is even, so both runs share this
                uint lp = w32[lo >> 2u], hp = w32[hi >> 2u];
                for (uint m = 0u; m < WW; ++m) {
                    uint ln = w32[(lo >> 2u) + m + 1u], hn = w32[(hi >> 2u) + m + 1u];
                    uint ql = odd ? (lp >> 16u) | (ln << 16u) : lp;
                    uint qh = odd ? (hp >> 16u) | (hn << 16u) : hp;
                    lp = ln; hp = hn;
                    uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
                    // b - 32 per byte: flipping bit 5 gives b - 32 for b >= 32 and b + 32 otherwise, and a set bit 5 then means negative, so it is copied into bits 6 and 7.
                    uint t = b ^ 0x20202020u, s = t & 0x20202020u;
                    wq[wseg * WW + m][wrow] = t | (s << 1u) | (s << 2u);
                }
                if (wseg == 0u) {
                    float d = half_at(QBYTE(o + 208u), QBYTE(o + 209u));
                    uint si = o + 192u + n * 8u + 2u * which;
                    float s0 = float(int(QBYTE(si) << 24u) >> 24), s1 = float(int(QBYTE(si + 1u) << 24u) >> 24);
                    wsc[wrow] = vec4(d * s0, d * s1, 0.0, 0.0);
                }
#endif
            } else if (p.type == TYPE_Q4_0) {
                // Q4_0, 18-byte blocks: a half scale, then 16 bytes whose low nibbles are values 0 to 15 and high nibbles 16 to 31. The offset of 8 goes into each staged byte as Q6_K's 32 does, so the quants are signed and need no minimum. Blocks alternate word alignment, so the nibble words are funnelled when they straddle.
                uint ob = (row * nblk + kb) * Q4_0_BYTES, q0 = ob + 2u;
                bool odd = (q0 & 3u) != 0u;
                for (uint m = 0u; m < WW; ++m) {
                    uint w = wseg * WW + m, i = (q0 >> 2u) + (w & 3u);
                    uint nw = odd ? (w32[i] >> 16u) | (w32[i + 1u] << 16u) : w32[i];
                    uint b = (nw >> (w >= 4u ? 4u : 0u)) & 0x0F0F0F0Fu;
                    // b - 8 per byte: flipping bit 3 gives b - 8 for b >= 8 and b + 8 otherwise, and a set bit 3 then means negative, so it is copied into bits 4 to 7.
                    uint t = b ^ 0x08080808u, s = t & 0x08080808u;
                    wq[w][wrow] = t | (s << 1u) | (s << 2u) | (s << 3u) | (s << 4u);
                }
                if (wseg == 0u) {
                    uint sw = w32[ob >> 2u];
                    float d = unpackHalf2x16((ob & 3u) == 0u ? sw : (sw >> 16u)).x;
                    wsc[wrow] = vec4(d, d, 0.0, 0.0);
                }
            } else if (p.type == TYPE_Q4_1) {
                // Q4_1, 20-byte blocks, always word aligned: a half scale and a half minimum, then Q4_0's nibble layout without the offset. The minimum is added rather than subtracted, so it is stored negated.
                uint ob = (row * nblk + kb) * Q4_1_BYTES;
                for (uint m = 0u; m < WW; ++m) {
                    uint w = wseg * WW + m;
                    wq[w][wrow] = (w32[(ob >> 2u) + 1u + (w & 3u)] >> (w >= 4u ? 4u : 0u)) & 0x0F0F0F0Fu;
                }
                if (wseg == 0u) {
                    vec2 dm = unpackHalf2x16(w32[ob >> 2u]);
                    wsc[wrow] = vec4(dm.x, dm.x, -dm.y, 0.0);
                }
            } else if (p.type == TYPE_Q5_K) {
                // Q5_K, 176-byte blocks: Q4_K's nibbles with a fifth bit per value, bit g of 32 word-aligned high-bit bytes.
                uint o = (row * (p.nin / 256u) + kb / 8u) * Q5_K_BYTES;
                uint g = kb & 7u;
                uint base = (o + 48u + (g / 2u) * 32u) / 4u, hb = (o + 16u) / 4u;
                uint shift = 4u * (g & 1u);
                for (uint m = 0u; m < WW; ++m) {
                    uint w = wseg * WW + m;
                    wq[w][wrow] = ((w32[base + w] >> shift) & 0x0F0F0F0Fu) | (((w32[hb + w] >> g) & 0x01010101u) << 4u);
                }
                if (wseg == 0u) {
                    vec2 dd = unpackHalf2x16(w32[o / 4u]);
                    uint sc, mn;
                    scale_min_k4(o + 4u, g, sc, mn);
                    wsc[wrow] = vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0);
                }
            } else {
                // Q4_K: block 32 is group g of a 256-value block; its nibbles are the low or high halves of 32 word-aligned bytes, so a quant word is one load, a shift and a mask.
                uint o = (row * (p.nin / 256u) + kb / 8u) * Q4_K_BYTES;
                uint g = kb & 7u;
                uint base = (o + 16u + (g / 2u) * 32u) / 4u;
                uint shift = 4u * (g & 1u);
                for (uint m = 0u; m < WW; ++m) {
                    uint w = wseg * WW + m;
                    wq[w][wrow] = (w32[base + w] >> shift) & 0x0F0F0F0Fu;
                }
                if (wseg == 0u) {
                    vec2 dd = unpackHalf2x16(w32[o / 4u]);
                    uint sc, mn;
                    scale_min_k4(o + 4u, g, sc, mn);
                    wsc[wrow] = vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0);
                }
            }
        } else {
            for (uint m = 0u; m < WW; ++m) wq[wseg * WW + m][wrow] = 0u;
            if (wseg == 0u) wsc[wrow] = vec4(0.0);
        }
        uint col = col_base + xcol;
        uint xb = (col * nblk + kb) * 8u + xseg * 2u;
        bool colv = col < p.nbatch;
        xw[xseg * 2u][xcol] = colv ? xq[xb] : 0u;
        xw[xseg * 2u + 1u][xcol] = colv ? xq[xb + 1u] : 0u;
        if (xseg == 0u) xsc[xcol] = colv ? xs[xtab + col * nblk + kb] : vec2(0.0);
        barrier();
        // A thread's four columns for the whole block, then each of its rows against them.
        uint b0[8], b1[8], b2[8], b3[8];
        for (uint w = 0u; w < 8u; ++w) {
            b0[w] = xw[w][tc * 4u]; b1[w] = xw[w][tc * 4u + 1u];
            b2[w] = xw[w][tc * 4u + 2u]; b3[w] = xw[w][tc * 4u + 3u];
        }
        vec2 c0 = xsc[tc * 4u], c1 = xsc[tc * 4u + 1u], c2 = xsc[tc * 4u + 2u], c3 = xsc[tc * 4u + 3u];
        for (uint i = 0u; i < MROWS; ++i) {
            uint r = tr * MROWS + i;
            vec4 ws = wsc[r];
#ifdef LLMX_Q6
            // The block's two halves of 16 summed apart, since Q6_K scales them apart.
            int l0 = 0, l1 = 0, l2 = 0, l3 = 0, h0 = 0, h1 = 0, h2 = 0, h3 = 0;
            for (uint w = 0u; w < 4u; ++w) {
                uint a = wq[w][r], e = wq[w + 4u][r];
                l0 += dotPacked4x8EXT(int(a), int(b0[w])); h0 += dotPacked4x8EXT(int(e), int(b0[w + 4u]));
                l1 += dotPacked4x8EXT(int(a), int(b1[w])); h1 += dotPacked4x8EXT(int(e), int(b1[w + 4u]));
                l2 += dotPacked4x8EXT(int(a), int(b2[w])); h2 += dotPacked4x8EXT(int(e), int(b2[w + 4u]));
                l3 += dotPacked4x8EXT(int(a), int(b3[w])); h3 += dotPacked4x8EXT(int(e), int(b3[w + 4u]));
            }
            acc[i][0] += c0.x * (ws.x * float(l0) + ws.y * float(h0));
            acc[i][1] += c1.x * (ws.x * float(l1) + ws.y * float(h1));
            acc[i][2] += c2.x * (ws.x * float(l2) + ws.y * float(h2));
            acc[i][3] += c3.x * (ws.x * float(l3) + ws.y * float(h3));
#else
            int s0 = 0, s1 = 0, s2 = 0, s3 = 0;
            for (uint w = 0u; w < 8u; ++w) {
                uint a = wq[w][r];
                s0 += dotPacked4x8EXT(int(a), int(b0[w]));
                s1 += dotPacked4x8EXT(int(a), int(b1[w]));
                s2 += dotPacked4x8EXT(int(a), int(b2[w]));
                s3 += dotPacked4x8EXT(int(a), int(b3[w]));
            }
            acc[i][0] += ws.x * c0.x * float(s0) - ws.z * c0.y;
            acc[i][1] += ws.x * c1.x * float(s1) - ws.z * c1.y;
            acc[i][2] += ws.x * c2.x * float(s2) - ws.z * c2.y;
            acc[i][3] += ws.x * c3.x * float(s3) - ws.z * c3.y;
#endif
        }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= p.nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            if (col < p.nbatch) {
                if (p.accum != 0u) y[col * p.nout + row] += acc[i][j];
                else y[col * p.nout + row] = acc[i][j];
            }
        }
    }
}
