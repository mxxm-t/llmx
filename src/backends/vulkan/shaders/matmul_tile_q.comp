#version 450
// Y[b*nout + o] = dot(row o, X column b) for wide batches through the four-wide 8-bit integer dot, on devices where it is native, against activations quantized to 8 bits per block of 32 (quantize_x8.comp).
// A workgroup computes a TILE_ROWS x 64 tile, walking the inner dimension one quant block of 32 at a time, over all of it or over one part when the call is split; matmul_reduce.comp adds the parts in order.
// Each step stages, per row, the block's quants as 8 words of signed bytes with its scale and minimum, and per column the activation block's 8 words with its scale and scaled sum.
// A thread forms (TILE_ROWS / 16) x 4 dots of 32 products, as two of 16 since Q6_K scales the halves apart.
// Types: Q8_0, Q4_0, Q4_1, Q4_K and Q5_K, and Q6_K in its own build (LLMX_Q6).
// Rows past nout and columns past nbatch read as zero and are not stored.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#include "q.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TILE_ROWS = 64;
// Up to three projections of one X and one type per dispatch; workgroups start0, start1 and start2 on begin each projection's row tiles. kper is the quant blocks a workgroup sums, a multiple of STEP.
// When the call is split, projection q's part z goes to y at parts * nbatch * (rows of the projections before q) + z * nbatch * nout_q, all projections sharing one scratch buffer.
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint type; uint accum; uint kper; uint nproj;
    uint nout0; uint start0; uint nout1; uint start1; uint nout2; uint start2;
    uint per; uint order0;
} p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 1) readonly buffer W32 { uint w32[]; } ws[3];
// The 8-bit activations bound twice: as words for the quants and as pairs for the per-block scale table after them.
layout(set = 0, binding = 2) readonly buffer XQ { uint xq[]; };
layout(set = 0, binding = 3) readonly buffer XS { vec2 xs[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs workgroup row y as tile y of the grouping (moe_group.comp): up to 64 entries of one expert, column c being entry tab[order0 + first + c], which reads X column entry / per through the expert's rows and writes output row entry.
// A routed call is never split.
layout(set = 0, binding = 4) readonly buffer T { uint tab[]; };
uint pi = 0u;   // this workgroup's projection, uniform across it

#define MROWS (TILE_ROWS / 16u)
#define RG6 (MROWS < 4u ? MROWS : 4u)   // Q6_K rows the math takes together
#define WPR (256u / TILE_ROWS)   // threads that stage one row's 8 words
#define WW (8u / WPR)            // and how many words each

// Quant blocks staged per barrier, so their loads are in flight together.
#ifndef STEP
#define STEP 2u
#endif
// k-major: word w of every row, then of every column; block s of a step at words 8s to 8s + 7.
shared uint wq[8u * STEP][TILE_ROWS];
// Per row and block: the scale of each half and the minimum it subtracts; only Q6_K scales its halves apart.
shared vec4 wsc[STEP * TILE_ROWS];
shared uint xw[8u * STEP][64];
shared vec2 xsc[STEP * 64u];     // per column and block: the activation scale and scale times integer sum

// scale_min_k4 (qdecode.glsl) over the twelve packed sub-scale bytes held in three words, without a branch.
uint k4_byte(uvec3 v, uint i) { return (v[i >> 2u] >> (8u * (i & 3u))) & 255u; }
void scale_min_k4_words(uvec3 v, uint j, out uint sc, out uint mn) {
    uint bj = k4_byte(v, j), bj4 = k4_byte(v, j + 4u), bjm4 = k4_byte(v, (j + 4u) & 7u);
    sc = j < 4u ? bj & 63u : (bj4 & 15u) | ((bjm4 >> 6u) << 4u);
    mn = j < 4u ? bj4 & 63u : (bj4 >> 4u) | ((bj >> 6u) << 4u);
}

// Stores this thread's share of the four scale values of its scale block (ks in main()), zero when the block is out of range.
// A row's WPR threads each take block wseg % STEP of the step, which needs STEP to divide WPR: a step of two does at every tile height.
void store_scales(uint wrow, uint wseg, bool ok, vec4 v) {
    for (uint k = 0u; k < 4u * STEP / WPR; ++k) {
        uint c = wseg / STEP + k * (WPR / STEP);
        wsc[(wseg % STEP) * TILE_ROWS + wrow][c] = ok ? v[c] : 0.0;
    }
}

// A step's activations: a column's four threads each load two of a block's eight words and one of the step's 2 * STEP scale values (STEP of 2 or 4).
#define XSC (STEP / 2u)
// Stores them from the registers they were loaded into, zero past the batch or the thread's part of the inner dimension.
void store_x(uint k0, uint kend, bool xin, uint xcol, uint xseg, uvec2 xv[STEP], float xf[XSC]) {
    for (uint s = 0u; s < STEP; ++s) {
        bool colv = xin && k0 + s < kend;
        xw[s * 8u + xseg * 2u][xcol] = colv ? xv[s].x : 0u;
        xw[s * 8u + xseg * 2u + 1u][xcol] = colv ? xv[s].y : 0u;
    }
    for (uint k = 0u; k < XSC; ++k) {
        uint s = xseg % STEP;
        xsc[s * 64u + xcol][xseg / STEP + k * (4u / STEP)] = xin && k0 + s < kend ? xf[k] : 0.0;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint row_base = (wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2))) * TILE_ROWS;
    uint ncg = (p.nbatch + 63u) / 64u;                 // column tiles; the workgroup's y is column tile plus ncg times its part
    uint part = gl_WorkGroupID.y / ncg;
    uint col_base = (gl_WorkGroupID.y - part * ncg) * 64u;
    uint expert = 0u, first = 0u, ncols = 64u;
    if (p.per != 0u) {
        uint y = gl_WorkGroupID.y;
        expert = tab[4u * y];
        first = tab[4u * y + 1u];
        ncols = tab[4u * y + 2u];
        if (ncols == 0u) return;
        part = 0u;
        col_base = 0u;
    }
    uint tr = tid / 16u, tc = tid - tr * 16u;         // micro-tile at rows tr*MROWS.., columns tc*4..
    uint wrow = tid / WPR, wseg = tid - wrow * WPR;   // W stager: row wrow, words wseg*WW..
    uint xcol = tid / 4u, xseg = tid - xcol * 4u;     // X stager: column xcol, words xseg*2..
    uint nblk = p.nin / 32u;
    uint xtab = p.nbatch * p.nin / 8u;                // the scale table's start, in pairs
    uint kbeg = part * p.kper, kend = min(nblk, kbeg + p.kper);
    uint parts = (nblk + p.kper - 1u) / p.kper;
    uint before = (pi > 0u ? p.nout0 : 0u) + (pi > 1u ? p.nout1 : 0u);
    uint yo = parts > 1u ? p.nbatch * (parts * before + part * nout) : 0u;
    // The X column this thread stages.
    uint xc = col_base + xcol;
    bool xin = xc < p.nbatch;
    if (p.per != 0u) {
        xin = xcol < ncols;
        xc = xin ? tab[p.order0 + first + xcol] / p.per : 0u;
    }
    float acc[MROWS][4];
    for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) acc[i][j] = 0.0;
    for (uint k0 = kbeg; k0 < kend; k0 += STEP) {
        // Every global load of a step goes out before the first is waited for.
        // The compiler waits for a load under a branch it cannot prove uniform inside that branch, and moves a load down into the block that first uses it.
        // So a load out of range reads a valid address and its zero is selected when it is stored, and each type's staging ends by storing the activations loaded before it.
        uvec2 xv[STEP];
        float xf[XSC];
        for (uint s = 0u; s < STEP; ++s) {
            uint kb = k0 + s;
            uint xb = xin && kb < kend ? (kb * p.nbatch + xc) * 8u + xseg * 2u : 0u;
            xv[s] = uvec2(xq[xb], xq[xb + 1u]);
        }
        for (uint k = 0u; k < XSC; ++k) {
            uint kb = k0 + xseg % STEP;
            xf[k] = xs[xin && kb < kend ? xtab + kb * p.nbatch + xc : 0u][xseg / STEP + k * (4u / STEP)];
        }
        uint row = row_base + wrow, wr = expert * nout + row;
        // The block whose scales this thread stages (store_scales).
        uint ks = k0 + wseg % STEP;
        bool oks = row < nout && ks < kend;
#ifdef LLMX_Q6
        {
            // Q6_K, 210-byte blocks: group g takes its low four bits from 32 bytes of ql and its top two from 32 of qh, with a sub-scale per 16 values; the -32 offset goes into each byte, and both runs are funnelled when they straddle.
            // Each run is a thread's words plus one, which lies inside the block whether or not the run straddles.
            uint nsb = p.nin / 256u;
            uint lv[STEP][WW + 1u], hv[STEP][WW + 1u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u, n = g / 4u, which = g & 3u;
                uint o = row < nout && kb < kend ? (wr * nsb + kb / 8u) * Q6_K_BYTES : 0u;
                uint lo = (o + n * 64u + (which & 1u) * 32u + wseg * WW * 4u) >> 2u, hi = (o + 128u + n * 32u + wseg * WW * 4u) >> 2u;
                for (uint m = 0u; m <= WW; ++m) {
                    lv[s][m] = ws[pi].w32[lo + m];
                    hv[s][m] = ws[pi].w32[hi + m];
                }
            }
            // The scale block's half scale and its group's two sub-scales, each pair of bytes within one word since o is even.
            uint os = oks ? (wr * nsb + ks / 8u) * Q6_K_BYTES : 0u, gs = ks & 7u;
            uint si = os + 192u + (gs / 4u) * 8u + 2u * (gs & 3u);
            uint dw = ws[pi].w32[(os + 208u) >> 2u], sw = ws[pi].w32[si >> 2u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u, which = g & 3u;
                bool ok = row < nout && kb < kend;
                uint o = ok ? (wr * nsb + kb / 8u) * Q6_K_BYTES : 0u;
                uint nsh = which >= 2u ? 4u : 0u, hsh = 2u * which;
                bool odd = (o & 3u) != 0u;   // o is even, so both runs share this
                for (uint m = 0u; m < WW; ++m) {
                    uint ql = odd ? (lv[s][m] >> 16u) | (lv[s][m + 1u] << 16u) : lv[s][m];
                    uint qh = odd ? (hv[s][m] >> 16u) | (hv[s][m + 1u] << 16u) : hv[s][m];
                    uint b = ((ql >> nsh) & 0x0F0F0F0Fu) | (((qh >> hsh) & 0x03030303u) << 4u);
                    // b - 32 per byte: flipping bit 5 gives b - 32 or b + 32, and a set bit 5 then means negative, so it is copied into bits 6 and 7.
                    uint t = b ^ 0x20202020u, neg = t & 0x20202020u;
                    wq[s * 8u + wseg * WW + m][wrow] = ok ? t | (neg << 1u) | (neg << 2u) : 0u;
                }
            }
            float d = unpackHalf2x16((os & 3u) == 0u ? dw : (dw >> 16u)).x;
            uint sb = sw >> (8u * (si & 3u));
            float s0 = float(int(sb << 24u) >> 24), s1 = float(int((sb >> 8u) << 24u) >> 24);
            store_scales(wrow, wseg, oks, vec4(d * s0, d * s1, 0.0, 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#else
        if (p.type == TYPE_Q8_0) {
            // A 34-byte block: the half scale, then 32 quants starting on a word boundary or two bytes past one, so a thread loads its words plus one and funnels them when they straddle.
            // A block that does not straddle loads its last word twice, so no load leaves the matrix.
            uint qv[STEP][WW + 1u], obs[STEP];
            bool okw[STEP];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                okw[s] = row < nout && kb < kend;
                obs[s] = okw[s] ? (wr * nblk + kb) * Q8_0_BYTES : 0u;
                uint base = ((obs[s] + 2u) >> 2u) + wseg * WW;
                for (uint m = 0u; m < WW; ++m) qv[s][m] = ws[pi].w32[base + m];
                qv[s][WW] = ws[pi].w32[base + WW - ((obs[s] & 3u) >> 1u)];
            }
            uint os = oks ? (wr * nblk + ks) * Q8_0_BYTES : 0u;
            uint sw = ws[pi].w32[os >> 2u];
            for (uint s = 0u; s < STEP; ++s) {
                bool straddles = (obs[s] & 3u) == 0u;
                for (uint m = 0u; m < WW; ++m) {
                    uint v = straddles ? (qv[s][m] >> 16u) | (qv[s][m + 1u] << 16u) : qv[s][m];
                    wq[s * 8u + wseg * WW + m][wrow] = okw[s] ? v : 0u;
                }
            }
            float d = unpackHalf2x16((os & 3u) == 0u ? sw : (sw >> 16u)).x;
            store_scales(wrow, wseg, oks, vec4(d, d, 0.0, 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        } else if (p.type == TYPE_Q4_K || p.type == TYPE_Q5_K) {
            // Q4_K, 144-byte blocks: block 32 is group g of a 256-value block; its nibbles are the low or high halves of 32 word-aligned bytes, so a quant word is one load, a shift and a mask.
            // Q5_K, 176-byte blocks: the same with a fifth bit per value, bit g of 32 word-aligned high-bit bytes before the nibbles.
            // The scale block's scales come from the 16-byte head of its 256-value block: the two half scales and the twelve packed sub-scale bytes.
            bool k5 = p.type == TYPE_Q5_K;
            uint bytes = k5 ? Q5_K_BYTES : Q4_K_BYTES, nsb = p.nin / 256u;
            uint qv[STEP][WW], hv[STEP][WW];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                uint o = row < nout && kb < kend ? (wr * nsb + kb / 8u) * bytes : 0u;
                uint base = (o + (k5 ? 48u : 16u) + ((kb & 7u) / 2u) * 32u) / 4u + wseg * WW;
                for (uint m = 0u; m < WW; ++m) qv[s][m] = ws[pi].w32[base + m];
                if (k5) for (uint m = 0u; m < WW; ++m) hv[s][m] = ws[pi].w32[(o + 16u) / 4u + wseg * WW + m];
            }
            uint os = oks ? (wr * nsb + ks / 8u) * bytes : 0u;
            uvec4 h = uvec4(ws[pi].w32[os / 4u], ws[pi].w32[os / 4u + 1u], ws[pi].w32[os / 4u + 2u], ws[pi].w32[os / 4u + 3u]);
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s, g = kb & 7u;
                bool ok = row < nout && kb < kend;
                for (uint m = 0u; m < WW; ++m) {
                    uint v = (qv[s][m] >> (4u * (g & 1u))) & 0x0F0F0F0Fu;
                    v = k5 ? v | (((hv[s][m] >> g) & 0x01010101u) << 4u) : v;
                    wq[s * 8u + wseg * WW + m][wrow] = ok ? v : 0u;
                }
            }
            vec2 dd = unpackHalf2x16(h.x);
            uint sc, mn;
            scale_min_k4_words(h.yzw, ks & 7u, sc, mn);
            store_scales(wrow, wseg, oks, vec4(dd.x * float(sc), dd.x * float(sc), dd.y * float(mn), 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        } else {
            // Q4_0, 18-byte blocks: a half scale, then 16 bytes whose low nibbles are values 0 to 15 and high nibbles 16 to 31; the offset of 8 goes into each byte, and the words are funnelled when they straddle.
            // Q4_1, 20-byte blocks, always word aligned: a half scale and a half minimum, then Q4_0's nibbles without the offset; the minimum is stored negated since it is added.
            // Staged words w and w + 4 are the low and high nibbles of one source word, so a thread staging two or more takes source words whole and stages both halves.
            // A Q4_0 word that does not straddle loads itself twice, so no load leaves the matrix.
            const uint SPT = WW >= 2u ? WW / 2u : 1u;   // source words a thread takes
            bool q41 = p.type == TYPE_Q4_1;
            uint bytes = q41 ? Q4_1_BYTES : Q4_0_BYTES, qoff = q41 ? 4u : 2u;   // the quants' offset in a block
            uint qv[STEP][SPT][2];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                uint q0 = (row < nout && kb < kend ? (wr * nblk + kb) * bytes : 0u) + qoff;
                for (uint m = 0u; m < SPT; ++m) {
                    uint i = (q0 >> 2u) + (WW >= 2u ? wseg * SPT + m : (wseg & 3u));
                    qv[s][m][0] = ws[pi].w32[i];
                    qv[s][m][1] = ws[pi].w32[i + ((q0 & 3u) != 0u ? 1u : 0u)];
                }
            }
            uint os = oks ? (wr * nblk + ks) * bytes : 0u;
            uint sw = ws[pi].w32[os >> 2u];
            for (uint s = 0u; s < STEP; ++s) {
                uint kb = k0 + s;
                bool ok = row < nout && kb < kend;
                bool odd = (((ok ? (wr * nblk + kb) * bytes : 0u) + qoff) & 3u) != 0u;
                for (uint m = 0u; m < SPT; ++m) {
                    uint w = WW >= 2u ? wseg * SPT + m : (wseg & 3u);
                    uint nw = odd ? (qv[s][m][0] >> 16u) | (qv[s][m][1] << 16u) : qv[s][m][0];
                    for (uint h = 0u; h < 2u; ++h) {
                        if (WW < 2u && h != (wseg >> 2u)) continue;
                        uint b = (nw >> (4u * h)) & 0x0F0F0F0Fu;
                        // Q4_0's b - 8 per byte: flipping bit 3 gives b - 8 or b + 8, and a set bit 3 then means negative, so it is copied into bits 4 to 7.
                        uint t = b ^ 0x08080808u, neg = t & 0x08080808u;
                        uint v = q41 ? b : t | (neg << 1u) | (neg << 2u) | (neg << 3u) | (neg << 4u);
                        wq[s * 8u + w + 4u * h][wrow] = ok ? v : 0u;
                    }
                }
            }
            vec2 dm = unpackHalf2x16(!q41 && (os & 3u) != 0u ? sw >> 16u : sw);
            store_scales(wrow, wseg, oks, q41 ? vec4(dm.x, dm.x, -dm.y, 0.0) : vec4(dm.x, dm.x, 0.0, 0.0));
            store_x(k0, kend, xin, xcol, xseg, xv, xf);
        }
#endif
        barrier();
      for (uint s = 0u; s < STEP; ++s) {
#ifndef LLMX_Q6
        // Word w of every row of the thread against word w of its four columns, so all 4 * MROWS dot sums of the block stay live and a column word is read once.
        // Each sum still takes the block's eight words in order, so it is the integer a row at a time gave.
        vec2 c0 = xsc[s * 64u + tc * 4u], c1 = xsc[s * 64u + tc * 4u + 1u];
        vec2 c2 = xsc[s * 64u + tc * 4u + 2u], c3 = xsc[s * 64u + tc * 4u + 3u];
        int t[MROWS][4];
        for (uint i = 0u; i < MROWS; ++i) for (uint j = 0u; j < 4u; ++j) t[i][j] = 0;
        for (uint w = 0u; w < 8u; ++w) {
            uvec4 b = uvec4(xw[s * 8u + w][tc * 4u], xw[s * 8u + w][tc * 4u + 1u], xw[s * 8u + w][tc * 4u + 2u], xw[s * 8u + w][tc * 4u + 3u]);
            for (uint i = 0u; i < MROWS; ++i) {
                uint a = wq[s * 8u + w][tr * MROWS + i];
                t[i][0] += dotPacked4x8EXT(int(a), int(b.x));
                t[i][1] += dotPacked4x8EXT(int(a), int(b.y));
                t[i][2] += dotPacked4x8EXT(int(a), int(b.z));
                t[i][3] += dotPacked4x8EXT(int(a), int(b.w));
            }
        }
        for (uint i = 0u; i < MROWS; ++i) {
            vec4 ws = wsc[s * TILE_ROWS + tr * MROWS + i];
            acc[i][0] += ws.x * c0.x * float(t[i][0]) - ws.z * c0.y;
            acc[i][1] += ws.x * c1.x * float(t[i][1]) - ws.z * c1.y;
            acc[i][2] += ws.x * c2.x * float(t[i][2]) - ws.z * c2.y;
            acc[i][3] += ws.x * c3.x * float(t[i][3]) - ws.z * c3.y;
        }
#else
        // The same word-outer form over groups of RG6 rows, the block's two halves of 16 summed apart since Q6_K scales them apart.
        vec2 c0 = xsc[s * 64u + tc * 4u], c1 = xsc[s * 64u + tc * 4u + 1u];
        vec2 c2 = xsc[s * 64u + tc * 4u + 2u], c3 = xsc[s * 64u + tc * 4u + 3u];
        for (uint i0 = 0u; i0 < MROWS; i0 += RG6) {
            int l[RG6][4], h[RG6][4];
            for (uint i = 0u; i < RG6; ++i) for (uint j = 0u; j < 4u; ++j) { l[i][j] = 0; h[i][j] = 0; }
            for (uint w = 0u; w < 4u; ++w) {
                uvec4 bl = uvec4(xw[s * 8u + w][tc * 4u], xw[s * 8u + w][tc * 4u + 1u], xw[s * 8u + w][tc * 4u + 2u], xw[s * 8u + w][tc * 4u + 3u]);
                uvec4 bh = uvec4(xw[s * 8u + w + 4u][tc * 4u], xw[s * 8u + w + 4u][tc * 4u + 1u], xw[s * 8u + w + 4u][tc * 4u + 2u], xw[s * 8u + w + 4u][tc * 4u + 3u]);
                for (uint i = 0u; i < RG6; ++i) {
                    uint r = tr * MROWS + i0 + i;
                    uint a = wq[s * 8u + w][r], e = wq[s * 8u + w + 4u][r];
                    l[i][0] += dotPacked4x8EXT(int(a), int(bl.x)); h[i][0] += dotPacked4x8EXT(int(e), int(bh.x));
                    l[i][1] += dotPacked4x8EXT(int(a), int(bl.y)); h[i][1] += dotPacked4x8EXT(int(e), int(bh.y));
                    l[i][2] += dotPacked4x8EXT(int(a), int(bl.z)); h[i][2] += dotPacked4x8EXT(int(e), int(bh.z));
                    l[i][3] += dotPacked4x8EXT(int(a), int(bl.w)); h[i][3] += dotPacked4x8EXT(int(e), int(bh.w));
                }
            }
            for (uint i = 0u; i < RG6; ++i) {
                vec4 ws = wsc[s * TILE_ROWS + tr * MROWS + i0 + i];
                acc[i0 + i][0] += c0.x * (ws.x * float(l[i][0]) + ws.y * float(h[i][0]));
                acc[i0 + i][1] += c1.x * (ws.x * float(l[i][1]) + ws.y * float(h[i][1]));
                acc[i0 + i][2] += c2.x * (ws.x * float(l[i][2]) + ws.y * float(h[i][2]));
                acc[i0 + i][3] += c3.x * (ws.x * float(l[i][3]) + ws.y * float(h[i][3]));
            }
        }
#endif
      }
        barrier();
    }
    for (uint i = 0u; i < MROWS; ++i) {
        uint row = row_base + tr * MROWS + i;
        if (row >= nout) continue;
        for (uint j = 0u; j < 4u; ++j) {
            uint col = col_base + tc * 4u + j;
            bool cv = col < p.nbatch;
            if (p.per != 0u) {
                cv = tc * 4u + j < ncols;
                col = cv ? tab[p.order0 + first + tc * 4u + j] : 0u;
            }
            if (cv) {
                if (p.accum != 0u) ys[pi].y[yo + col * nout + row] += acc[i][j];
                else ys[pi].y[yo + col * nout + row] = acc[i][j];
            }
        }
    }
}
