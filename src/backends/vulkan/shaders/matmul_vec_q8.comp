#version 450
// Y[b*nout + o] = dot(row o, X column b) for Q8_0 rows through two-wide 16-bit integer dots, a weight word widened once for every column: the Q8_0 decode kernel on integer-dot devices, with matmul_row.comp's bindings and push constants.
// A column's lanes, block order, products, sums and reduction pairs are the same in every build, the 8-bit builds (LLMX_I8, docs/PRECISION.md) reading the 8-bit twin in the same order, so it computes the same bits in all of them.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_control_flow_attributes : require
#include "dot16.glsl"
#include "q.glsl"
#include "float_controls.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint MAX_COLS = 8;
// Rows a subgroup takes (specialization constant 9), and steps whose weights a lane loads before using any (10), so STEPS steps of every row are in flight at once; the backend dispatches by the same rows (kVecBuilds).
layout(constant_id = 9) const uint ROWS = 2;
layout(constant_id = 10) const uint STEPS = 1;
// TREE (11) reduces every row and column through the subgroup reduction's own pairs, lanes l and l ^ 1, 2, 7, 15, 16 and 32 in that order, transposed so each level halves the values a lane holds, and stores them in one write.
// It gives the subgroup reduction's bits only where that reduction takes those pairs, as RADV's on a 64-lane GCN subgroup does, so the backend sets it only from the device profile.
layout(constant_id = 11) const bool TREE = false;
// HALF (12), on 64-lane subgroups where the block count is even, has lane l cover half l % 2 of blocks l / 2, l / 2 + 32 and on, so a lane's 16 bytes of a block meet in one integer sum and one scaled product.
// It sums a column's products in another order than the quarter layout, so the backend gives it to every build of the kernel on a device or to none (docs/VULKAN.md).
layout(constant_id = 12) const bool HALF = false;
// SPAN column groups of MAX_COLS each take the same rows on SPAN adjacent workgroups (13), whose reads of a row meet in the L2 cache; a group past the pass's columns returns whole.
layout(constant_id = 13) const uint SPAN = 1;
// The row kernel's push layout, which row_dispatch fills for every row kernel; cluster, rows_per_sg, the types and the wide flags go unread here.
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint col0; uint ncols; uint cluster; uint rows_per_sg; uint nproj;
    uint nout0; uint type0; uint wide0; uint start0;
    uint nout1; uint type1; uint wide1; uint start1;
    uint nout2; uint type2; uint wide2; uint start2;
    uint accum;
    uint per;
    uint order0;
} p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; } w32s[3];
// The 16-bit twin (xquant.glsl): interleaved pairs, then per block the scale and scaled sum; the 8-bit twin: four bytes a word in position order, then the same per block, eight values one xq8 element and sixteen one xq element.
#ifdef LLMX_I8
layout(set = 0, binding = 6) readonly buffer XQ8 { uvec2 xq8[]; };
#endif
layout(set = 0, binding = 7) readonly buffer XQ { uvec4 xq[]; };
layout(set = 0, binding = 8) readonly buffer XT2 { vec2 xt2[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs one entry per workgroup row y: entry e reads X column e / per through the rows of expert ids[e] and writes output row e.
layout(set = 0, binding = 10) readonly buffer IDS { uint ids[]; };
// A grouped routed call, the wide build's third pipeline (GROUPED, specialization constant 8), runs one chunk of the grouping (moe_group.comp) per workgroup row y: up to MAX_COLS entries of one expert.
// As a specialization it costs the plain and routed pipelines nothing.
layout(constant_id = 8) const bool GROUPED = false;
layout(set = 0, binding = 11) readonly buffer TAB { uint tab[]; };

#include "matmul_vec_q8.glsl"


void main() {
    uint wg = gl_WorkGroupID.x;
    uint pi = 0u;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));
    uint lane = gl_SubgroupInvocationID, S = gl_SubgroupSize;
    // The column group this workgroup takes, and the workgroup its rows follow.
    uint part = 0u;
    if (SPAN > 1u) {
        part = local_wg % SPAN;
        local_wg /= SPAN;
    }
    uint row0 = (local_wg * (256u / S) + gl_SubgroupID) * ROWS;
    uint col0 = p.col0 + part * MAX_COLS, out0 = col0, wrow0 = 0u, g_first = 0u, g_cnt = 0u;
    if (GROUPED) {
        uint y = gl_WorkGroupID.y;
        g_first = tab[4u * y + 1u];
        g_cnt = tab[4u * y + 2u];
        if (g_cnt == 0u) return;
        wrow0 = tab[4u * y] * nout;
    } else if (p.per != 0u) {
        uint e = gl_WorkGroupID.y;
        // An entry without an expert has no product, and its rows are left as they were.
        if (ids[e] == 0xffffffffu) return;
        col0 = e / p.per;
        out0 = e;
        wrow0 = ids[e] * nout;
    }
    // A subgroup past the last row returns whole; one that holds a row reads the rows past the end as the last row and writes none of them.
    if (row0 >= nout) return;
    if (SPAN > 1u && p.ncols <= part * MAX_COLS) return;
    const uint ncols = MAX_COLS == 1u ? 1u : GROUPED ? g_cnt : SPAN > 1u ? min(p.ncols - part * MAX_COLS, MAX_COLS) : p.ncols;
// Column c's X column and output row, as in matmul_row.comp.
#define XCOL(c) (GROUPED ? tab[p.order0 + g_first + (c)] / p.per : col0 + (c))
#define OCOL(c) (GROUPED ? tab[p.order0 + g_first + (c)] : out0 + (c))
// A row and column's sum into its output, by the lane that holds it alone after the TREE reduction or by the first lane.
#define VEC_TREE_STORE(c, row, v) \
            if (writer && c < ncols && row < nout) { \
                uint o = OCOL(c) * nout + row; \
                if (p.accum != 0u) ys[pi].y[o] += v; \
                else ys[pi].y[o] = v; \
            }
#define VEC_STORE(c, row, s) \
            if (lane == 0u && row < nout) { \
                if (p.accum != 0u) ys[pi].y[OCOL(c) * nout + row] += s; \
                else ys[pi].y[OCOL(c) * nout + row] = s; \
            }
#include "matmul_vec_q8_one.glsl"
}
