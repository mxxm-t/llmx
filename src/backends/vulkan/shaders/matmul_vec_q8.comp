#version 450
// Y[b*nout + o] = dot(row o, X column b) for Q8_0 rows through the four-wide 8-bit integer dot: the Q8_0 decode kernel on integer-dot devices, with the row kernel's bindings and push constants (matmul_row.comp).
// A subgroup takes ROWS rows; lane l covers quarter l % 4 of blocks l / 4, l / 4 + S / 4 and on, so a step reads S / 4 consecutive blocks of a row.
// A lane loads its eight 8-bit activation values per column once for all the subgroup's rows.
// Every other block's quants start two bytes into a word, so a lane loads the words its eight bytes touch and shifts.
// The lanes' sums meet in one subgroup reduction per row and column.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint MAX_COLS = 8;
layout(push_constant) uniform P {
    uint nin; uint nbatch; uint col0; uint ncols; uint cluster; uint rows_per_sg; uint nproj;
    uint nout0; uint type0; uint wide0; uint start0;
    uint nout1; uint type1; uint wide1; uint start1;
    uint nout2; uint type2; uint wide2; uint start2;
    uint accum;
    uint per;
    uint group; uint order0;
} p;
layout(set = 0, binding = 0) buffer Y { float y[]; } ys[3];
layout(set = 0, binding = 2) readonly buffer W32 { uint w32[]; } w32s[3];
// The 8-bit twin (xquant.glsl): per column nin / 4 words of bytes, read two at a time, then per block the scale and scaled sum.
layout(set = 0, binding = 7) readonly buffer XQ4 { uvec2 xq4[]; };
layout(set = 0, binding = 8) readonly buffer XT2 { vec2 xt2[]; };
// A routed call (per != 0, backend.hpp matmul_experts) runs one entry per workgroup row y: entry e reads X column e / per through the rows of expert ids[e] and writes output row e.
layout(set = 0, binding = 10) readonly buffer IDS { uint ids[]; };
// A grouped routed call (group != 0) runs one chunk of the grouping (moe_group.comp) per workgroup row y: up to MAX_COLS entries of one expert, whose rows are then read once for all of them.
layout(set = 0, binding = 11) readonly buffer TAB { uint tab[]; };

// Column c's X column and output row: consecutive from col0 in a plain call, the workgroup row's entry in a routed one, and in a grouped one the chunk's entries, columns past the last repeating it.
// Computed where used, so a plain call pays for nothing it does not use.
uint g_first = 0u, g_cnt = 1u, g_entry = 0u;
uint entry_of(uint c) { return p.group != 0u ? tab[p.order0 + g_first + min(c, g_cnt - 1u)] : g_entry; }
uint xcol(uint c) { return p.per != 0u ? entry_of(c) / p.per : p.col0 + c; }
uint ocol(uint c) { return p.per != 0u ? entry_of(c) : p.col0 + c; }

#ifndef ROWS
#define ROWS 2u
#endif

void main() {
    uint wg = gl_WorkGroupID.x;
    uint pi = 0u;
    if (p.nproj > 1u && wg >= p.start1) pi = 1u;
    if (p.nproj > 2u && wg >= p.start2) pi = 2u;
    uint nout = pi == 0u ? p.nout0 : (pi == 1u ? p.nout1 : p.nout2);
    uint local_wg = wg - (pi == 0u ? p.start0 : (pi == 1u ? p.start1 : p.start2));
    uint lane = gl_SubgroupInvocationID, S = gl_SubgroupSize;
    uint row0 = (local_wg * (256u / S) + gl_SubgroupID) * ROWS;
    uint wrow0 = 0u;
    uint ncols = MAX_COLS == 1u ? 1u : p.ncols;
    if (p.per != 0u && p.group != 0u) {
        uint y = gl_WorkGroupID.y;
        g_first = tab[4u * y + 1u];
        g_cnt = tab[4u * y + 2u];
        // group 1 takes runs of two or more entries, group 2 lone entries, group 3 every run.
        if (g_cnt == 0u || (p.group == 1u && g_cnt < 2u) || (p.group == 2u && g_cnt != 1u)) return;
        wrow0 = tab[4u * y] * nout;
        ncols = MAX_COLS == 1u ? 1u : g_cnt;
    } else if (p.per != 0u) {
        g_entry = gl_WorkGroupID.y;
        wrow0 = ids[g_entry] * nout;
    }
    uint nblk = p.nin / 32u;
    uint q = lane & 3u;
    uint xtab = p.nbatch * p.nin / 8u;
    float acc[ROWS][MAX_COLS];
    for (uint r = 0u; r < ROWS; ++r) for (uint c = 0u; c < MAX_COLS; ++c) acc[r][c] = 0.0;
    for (uint b = lane >> 2u; b < nblk; b += S >> 2u) {
        uvec2 xa[MAX_COLS];
        float dx[MAX_COLS];
        // Column loops run to MAX_COLS with the pushed count as a guard, so the arrays are indexed by constants and stay in registers.
        for (uint c = 0u; c < MAX_COLS; ++c) {
            uint col = xcol(min(c, ncols - 1u));
            xa[c] = xq4[(col * p.nin + b * 32u + q * 8u) / 8u];
            dx[c] = xt2[xtab + col * nblk + b].x;
        }
        for (uint r = 0u; r < ROWS; ++r) {
            uint row = row0 + r;
            if (row >= nout) continue;
            uint ob = ((wrow0 + row) * nblk + b) * 34u;
            uint qb = ob + 2u + q * 8u;
            uint i = qb >> 2u;
            bool odd = (qb & 2u) != 0u;
            // The third word only where the bytes straddle, since an aligned last quarter of the matrix ends at the buffer's end.
            uint t0 = w32s[pi].w32[i], t1 = w32s[pi].w32[i + 1u], t2 = odd ? w32s[pi].w32[i + 2u] : 0u;
            uint w0 = odd ? (t0 >> 16u) | (t1 << 16u) : t0;
            uint w1 = odd ? (t1 >> 16u) | (t2 << 16u) : t1;
            uint sw = w32s[pi].w32[ob >> 2u];
            float dw = unpackHalf2x16((ob & 2u) != 0u ? sw >> 16u : sw).x;
            for (uint c = 0u; c < MAX_COLS; ++c) {
                if (c >= ncols) break;
                int s = dotPacked4x8EXT(int(w0), int(xa[c].x)) + dotPacked4x8EXT(int(w1), int(xa[c].y));
                acc[r][c] += dw * dx[c] * float(s);
            }
        }
    }
    for (uint r = 0u; r < ROWS; ++r) {
        uint row = row0 + r;
        for (uint c = 0u; c < MAX_COLS; ++c) {
            if (c >= ncols) break;
            float s = subgroupAdd(acc[r][c]);
            if (lane == 0u && row < nout) {
                if (p.accum != 0u) ys[pi].y[ocol(c) * nout + row] += s;
                else ys[pi].y[ocol(c) * nout + row] = s;
            }
        }
    }
}
