#version 450
// A lane a value: DeepSeek-V4.1's storage formats quantized and dequantized in place as quant/model_formats.hpp does, or packed into rows, so the CPU and the device store the same bytes.
// The block's quotients by its scale are correctly rounded by an integer division, codes come from exact comparisons, and a value is one multiply of code and scale, which needs subnormals kept.
#define LLMX_PRESERVE_F32
#include "float_controls.glsl"
layout(local_size_x = 256) in;
// Format 0 is fp8_power, 1 fp4_power and 2 fp4_e4m3; the inverse maxima and the FP8 floor come from the host as the CPU rounds them.
// With `packed` set, `blocks` counts rows of `dim` values, each packed into `row_words` words of O from word row * stride, and X is left as it is.
layout(push_constant) uniform P { uint blocks; uint format; float inv_fp8; float inv_fp4; float fp8_floor; uint packed; uint dim; uint stride; uint row_words; } p;
layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) buffer O { uint o[]; };
#include "model_formats.glsl"
shared float mags[256];
shared uint words[66];   // a packed row's runs of four blocks, whole words, gathered here: at most two runs of 33 words (FP8) a workgroup
// The block's scale byte and value from its amax.
void block_scale(float amax, out uint scale, out float s) {
    if (p.format == 2u) {
        scale = e4m3_code(div_rn(max(amax, 6.0 * uintBitsToFloat(0x3B000000u)), FP4_MAX));
        s = e4m3_value(scale);
        return;
    }
    if (p.format == 0u) s = pow2(ceil_log2(max(amax, p.fp8_floor) * p.inv_fp8));
    else s = pow2(ceil_log2(max(amax, 6.0 * uintBitsToFloat(0x00800000u)) * p.inv_fp4));
    scale = floatBitsToUint(s) >> 23;
}
// A NaN takes the CPU's codes, 0x7F under FP8 and a signed zero under FP4, which the integer division does not give.
uint code_of(float v, float s) {
    if (isnan(v)) return p.format == 0u ? 0x7Fu : (floatBitsToUint(v) >> 31) << 3;
    float q = div_rn(v, s);
    return p.format == 0u ? e4m3_code(clamp_to(q, FP8_MAX)) : e2m1_code(clamp_to(q, FP4_MAX));
}
void main() {
    uint n = format_values(p.format), lane = gl_LocalInvocationID.x, i = lane % n, id = gl_GlobalInvocationID.x;
    uint bytes = p.format == 0u ? 1u + n : 1u + n / 2u, run = 4u * n, runs = (p.dim / n + 3u) / 4u, row = 0u, v = id;
    bool live = id < p.blocks * n;
    if (p.packed != 0u) {
        row = id / run / runs;
        v = id / run % runs * run + id % run;
        live = row < p.blocks && v < p.dim;
    }
    uint at = row * p.dim + v;
    float value = live ? x[at] : 0.0;
    mags[lane] = isnan(value) ? 0.0 : abs(value);   // the CPU's fmax passes over a NaN
    for (uint w = lane; w < 66u; w += 256u) words[w] = 0u;
    barrier();
    // The block's amax in the CPU's order over its values, each lane of the block forming it alike.
    float amax = 0.0;
    for (uint j = lane - i; j < lane - i + n; ++j) amax = max(amax, mags[j]);
    uint scale;
    precise float s;
    block_scale(amax, scale, s);
    uint c = code_of(value, s);
    if (p.packed == 0u) {
        precise float q = p.format == 0u ? e4m3_value(c) * s : e2m1_value(c) * s;
        if (live) x[at] = q;
        return;
    }
    if (live) {
        uint base = lane / run * bytes * 4u + lane % run / n * bytes, b = base + 1u + (p.format == 0u ? i : i % (n / 2u));
        if (i == 0u) atomicOr(words[base / 4u], scale << (8u * (base % 4u)));
        atomicOr(words[b / 4u], c << (8u * (b % 4u) + (p.format != 0u && i >= n / 2u ? 4u : 0u)));
    }
    barrier();
    uint per = 256u / run, first = gl_WorkGroupID.x * per, w = lane % bytes, r = first + lane / bytes;
    if (lane < per * bytes && r / runs < p.blocks && r % runs * bytes + w < p.row_words) o[r / runs * p.stride + r % runs * bytes + w] = words[lane];
}
