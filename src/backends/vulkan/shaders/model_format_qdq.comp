#version 450
// One lane a block: DeepSeek-V4.1's storage formats quantized and dequantized in place as quant/model_formats.hpp does, or one lane a word of a packed row, so the CPU and the device store the same bytes.
// The block's quotients by its scale are correctly rounded by an integer division, codes come from exact comparisons, and a value is one multiply of code and scale, which needs subnormals kept.
#define LLMX_PRESERVE_F32
#include "float_controls.glsl"
layout(local_size_x = 64) in;
// Format 0 is fp8_power, 1 fp4_power and 2 fp4_e4m3; the inverse maxima and the FP8 floor come from the host as the CPU rounds them.
// With `packed` set, `blocks` counts rows of `dim` values, each packed into `row_words` words of O from word row * stride, a lane a word, and X is left as it is.
layout(push_constant) uniform P { uint blocks; uint format; float inv_fp8; float inv_fp4; float fp8_floor; uint packed; uint dim; uint stride; uint row_words; } p;
layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) buffer O { uint o[]; };
#include "model_formats.glsl"
// The block of n values from x[base]: its scale's byte and value.
void block_scale(uint base, uint n, out uint scale, out float s) {
    float amax = 0.0;
    for (uint i = 0u; i < n; ++i) amax = max(amax, abs(x[base + i]));
    if (p.format == 2u) {
        scale = e4m3_code(div_rn(max(amax, 6.0 * uintBitsToFloat(0x3B000000u)), FP4_MAX));
        s = e4m3_value(scale);
        return;
    }
    if (p.format == 0u) s = pow2(ceil_log2(max(amax, p.fp8_floor) * p.inv_fp8));
    else s = pow2(ceil_log2(max(amax, 6.0 * uintBitsToFloat(0x00800000u)) * p.inv_fp4));
    scale = floatBitsToUint(s) >> 23;
}
uint code_of(float v, float s) {
    float q = div_rn(v, s);
    return p.format == 0u ? e4m3_code(clamp_to(q, FP8_MAX)) : e2m1_code(clamp_to(q, FP4_MAX));
}
// Byte i of a packed row from x[row]: its blocks' scale byte then codes, zero past the blocks; the block's scale is kept across the word's bytes.
uint cached = 0xFFFFFFFFu, cached_code;
float cached_scale;
uint row_byte(uint row, uint i) {
    uint n = format_values(p.format), bytes = p.format == 0u ? 1u + n : 1u + n / 2u, b = i / bytes, at = i % bytes;
    if (b >= p.dim / n) return 0u;
    uint base = row + b * n;
    if (b != cached) {
        block_scale(base, n, cached_code, cached_scale);
        cached = b;
    }
    if (at == 0u) return cached_code;
    if (p.format == 0u) return code_of(x[base + at - 1u], cached_scale);
    return code_of(x[base + at - 1u], cached_scale) | code_of(x[base + at - 1u + n / 2u], cached_scale) << 4u;
}
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (p.packed != 0u) {
        if (id >= p.blocks * p.row_words) return;
        uint r = id / p.row_words, w = id % p.row_words, row = r * p.dim, v = 0u;
        for (uint j = 0u; j < 4u; ++j) v |= row_byte(row, 4u * w + j) << (8u * j);
        o[r * p.stride + w] = v;
        return;
    }
    if (id >= p.blocks) return;
    uint n = format_values(p.format);
    uint base = id * n, scale;
    precise float s;
    block_scale(base, n, scale, s);
    for (uint i = 0u; i < n; ++i) {
        uint c = code_of(x[base + i], s);
        precise float v = p.format == 0u ? e4m3_value(c) * s : e2m1_value(c) * s;
        x[base + i] = v;
    }
}
