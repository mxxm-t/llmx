#version 450
// y[r*n + o] += sum over j in order of weights[r*k + j] * part[(r*k + j)*n + o], a routed down projection's slots joining the residual (backend.hpp matmul_experts_add).
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint n; uint k; } p;
layout(set = 0, binding = 0) buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer S { float part[]; };
layout(set = 0, binding = 2) readonly buffer W { float weights[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.rows * p.n) return;
    uint r = i / p.n, o = i - r * p.n;
    float s = 0.0;
    for (uint j = 0u; j < p.k; ++j) s += weights[r * p.k + j] * part[(r * p.k + j) * p.n + o];
    y[i] += s;
}
