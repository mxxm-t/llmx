#version 450
// A routed call's entries grouped by expert for the tile kernels (matmul_tile.comp, matmul_tile_q.comp), in one workgroup.
// tab holds max_tiles tiles as (expert, first, count, 0), each at most 64 entries of one expert and unused ones with count 0, then from word 4 * max_tiles the entries in expert order, entry order within an expert.
// The order is stable, so the grouping of a set of ids is always the same.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint entries; uint n_expert; uint max_tiles; } p;
layout(set = 0, binding = 0) readonly buffer I { uint ids[]; };
layout(set = 0, binding = 1) buffer T { uint tab[]; };

const uint MAX_EXPERTS = 1024u;
shared uint count[MAX_EXPERTS];
shared uint cursor[MAX_EXPERTS];
shared uint chunk_ids[256];

void main() {
    uint t = gl_LocalInvocationID.x;
    for (uint e = t; e < p.n_expert; e += 256u) count[e] = 0u;
    barrier();
    for (uint i = t; i < p.entries; i += 256u) atomicAdd(count[ids[i]], 1u);
    barrier();
    // Each expert's first entry and first tile, walked by one thread since there are at most a thousand experts.
    if (t == 0u) {
        uint first = 0u, tile = 0u;
        for (uint e = 0u; e < p.n_expert; ++e) {
            uint c = count[e];
            cursor[e] = first;
            for (uint j = 0u; j < c; j += 64u) {
                tab[4u * tile] = e;
                tab[4u * tile + 1u] = first + j;
                tab[4u * tile + 2u] = min(64u, c - j);
                tab[4u * tile + 3u] = 0u;
                ++tile;
            }
            first += c;
        }
        for (; tile < p.max_tiles; ++tile) {
            tab[4u * tile] = 0u;
            tab[4u * tile + 1u] = 0u;
            tab[4u * tile + 2u] = 0u;
            tab[4u * tile + 3u] = 0u;
        }
    }
    barrier();
    // Placement 256 entries at a time: an entry's slot is its expert's cursor plus the earlier entries of the chunk with the same expert.
    uint order0 = 4u * p.max_tiles;
    for (uint c0 = 0u; c0 < p.entries; c0 += 256u) {
        uint i = c0 + t;
        uint id = i < p.entries ? ids[i] : 0xffffffffu;
        chunk_ids[t] = id;
        barrier();
        uint rank = 0u;
        bool last = true;
        if (id != 0xffffffffu) {
            for (uint j = 0u; j < t; ++j) rank += chunk_ids[j] == id ? 1u : 0u;
            for (uint j = t + 1u; j < 256u; ++j) if (chunk_ids[j] == id) { last = false; break; }
            tab[order0 + cursor[id] + rank] = i;
        }
        barrier();
        if (id != 0xffffffffu && last) cursor[id] += rank + 1u;
        barrier();
    }
}
