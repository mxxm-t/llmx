#version 450
// Expert routing (backend.hpp route_experts), a row a workgroup of 64 invocations, one subgroup on a 64-wide device and two on a 32-wide one (moe_route.glsl).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint n_expert; uint k; uint normalize; } p;
layout(set = 0, binding = 0) readonly buffer S { float route_scores[]; };
layout(set = 0, binding = 1) buffer I { uint route_ids[]; };
layout(set = 0, binding = 2) buffer W { float route_weights[]; };
#define ROUTE_QUARTERS 1u
#include "moe_route.glsl"
void main() { route_row(gl_WorkGroupID.x, gl_LocalInvocationID.x, 0u, true, p.n_expert, p.k, p.normalize != 0u); }
