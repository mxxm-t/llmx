#version 450
// Expert routing (backend.hpp route_experts): a workgroup per row takes the k experts of highest softmax probability, the most probable first and ties to the lower id, with their probabilities, divided by the k probabilities' sum when `normalize`.
// 64 invocations, one subgroup on a 64-wide device and two on a 32-wide one; the reductions are subgroup operations, joined through shared memory when there are two.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint n_expert; uint k; uint normalize; } p;
layout(set = 0, binding = 0) readonly buffer S { float scores[]; };
layout(set = 0, binding = 1) buffer I { uint ids[]; };
layout(set = 0, binding = 2) buffer W { float weights[]; };

const uint MAX_EXPERTS = 1024u;
const uint kHeld = 4u;   // scores an invocation holds in registers: every expert up to 256
shared float prob[MAX_EXPERTS];
shared float part_v[2];
shared uint part_i[2];
shared float chosen[256];

float group_max(float v) {
    v = subgroupMax(v);
    if (gl_NumSubgroups == 1u) return v;
    if (subgroupElect()) part_v[gl_SubgroupID] = v;
    barrier();
    float r = max(part_v[0], part_v[1]);
    barrier();
    return r;
}
float group_sum(float v) {
    v = subgroupAdd(v);
    if (gl_NumSubgroups == 1u) return v;
    if (subgroupElect()) part_v[gl_SubgroupID] = v;
    barrier();
    float r = part_v[0] + part_v[1];
    barrier();
    return r;
}
uint group_min(uint v) {
    v = subgroupMin(v);
    if (gl_NumSubgroups == 1u) return v;
    if (subgroupElect()) part_i[gl_SubgroupID] = v;
    barrier();
    uint r = min(part_i[0], part_i[1]);
    barrier();
    return r;
}

void main() {
    uint r = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = r * p.n_expert;
    // An invocation's first scores are loaded together, rather than each loop waiting on each load in turn.
    float sc[kHeld];
    for (uint q = 0u; q < kHeld; ++q) sc[q] = t + 64u * q < p.n_expert ? scores[base + t + 64u * q] : 0.0;
    float top = -1.0 / 0.0;
    for (uint q = 0u; q < kHeld; ++q)
        if (t + 64u * q < p.n_expert) top = max(top, sc[q]);
    for (uint e = t + 64u * kHeld; e < p.n_expert; e += 64u) top = max(top, scores[base + e]);
    top = group_max(top);
    float part = 0.0;
    for (uint q = 0u; q < kHeld; ++q) {
        uint e = t + 64u * q;
        if (e < p.n_expert) {
            float v = exp(sc[q] - top);
            prob[e] = v;
            part += v;
        }
    }
    for (uint e = t + 64u * kHeld; e < p.n_expert; e += 64u) {
        float v = exp(scores[base + e] - top);
        prob[e] = v;
        part += v;
    }
    float sum = group_sum(part);
    // Each invocation reads back only the experts it wrote, so no barrier is needed before the division.
    for (uint e = t; e < p.n_expert; e += 64u) prob[e] /= sum;
    for (uint j = 0u; j < p.k; ++j) {
        // The largest untaken probability, then the lowest id holding it; a taken expert holds -1, below every probability.
        float bv = -2.0;
        uint bi = 0xffffffffu;
        for (uint e = t; e < p.n_expert; e += 64u)
            if (prob[e] > bv) { bv = prob[e]; bi = e; }
        float m = group_max(bv);
        uint id = group_min(bv == m ? bi : 0xffffffffu);
        // The chosen expert belongs to invocation id % 64, which marks it and records its probability.
        if (t == id % 64u) {
            chosen[j] = m;
            prob[id] = -1.0;
            ids[r * p.k + j] = id;
        }
    }
    barrier();
    if (t == 0u) {
        float total = 0.0;
        for (uint j = 0u; j < p.k; ++j) total += chosen[j];
        for (uint j = 0u; j < p.k; ++j) weights[r * p.k + j] = p.normalize != 0u ? chosen[j] / total : chosen[j];
    }
}
