#version 450
// The fused routed step's activations (backend.hpp moe_step): the routed entries' silu(gate) * up, then the shared expert's under its row gate, as silu_mul.comp and sigmoid_mul.comp write them.
// One 16-bit twin covers all n values, a multiple of 32, so each block holds what either kernel's twin holds (xquant.glsl).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint routed; uint ff; } p;
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer G { float gate[]; };
layout(set = 0, binding = 2) readonly buffer U { float up[]; };
layout(set = 0, binding = 3) readonly buffer R { float row_gate[]; };
layout(set = 0, binding = 4) writeonly buffer Q { uint xq[]; };
#include "xquant.glsl"
#include "silu_mul.glsl"
#include "sigmoid_mul.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) {
        float v = silu_mul_value(gate[i], up[i]);
        if (i >= p.routed) v = sigmoid_scale(v, row_gate[(i - p.routed) / p.ff]);
        dst[i] = v;
        xquant_block(i, v, p.n);
    }
}
