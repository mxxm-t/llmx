#version 450
// The 16-bit twin of an activation row (xquant.glsl) for a row kernel input no producer wrote it for.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; } p;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Q { uint xq[]; };
#include "xquant.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) xquant_twin(i, x[i], p.n);
}
