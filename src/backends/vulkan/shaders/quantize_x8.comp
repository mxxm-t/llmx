#version 450
// The 8-bit twin of a batch of activation rows for the integer-dot prefill tile (matmul_tile_q.comp): one lane per value over the batch as one flat run, since a row is whole blocks of 32.
// Per block, 8 words of signed bytes in position order scaled so the largest magnitude is 127, then after every block's quants the scale and scaled sum per block.
// Blocks are ordered by block of the inner dimension, then column, so a tile step reads its 64 columns as one run.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint nin; uint nbatch; } p;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Q { uint xq[]; };

#include "xquant.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    // Every lane calls, a lane past the end with a zero, so a partial last subgroup still reduces.
    uint col = i / p.nin, kb = (i - col * p.nin) / 32u;
    xquant8_block_at(i, i < p.n ? x[i] : 0.0, p.n, 0u, kb * p.nbatch + col);
}
