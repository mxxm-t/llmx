#version 450
// dst[i] = src[i] * rsqrt(mean(src^2) + eps) * w[i], per row, over `chunks` workgroups a row.
// The sum of squares is a shared-memory tree; a subgroup reduction adds in another order and moved an HF gate result (docs/STATUS.md), so the tree stays.
// With `quant` set the rows are dense and a multiple of 32 wide, and the output's twin is written beside it (xquant.glsl).
// With one chunk dst and src may be the same buffer: every element is read before the barrier and written after it by its own lane.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
// Each of a row's `chunks` workgroups sums the whole row in the same order and writes its own 256-value chunks; the backend takes one chunk when dst and src overlap.
layout(push_constant) uniform P { uint rows; uint n; uint stride; float eps; uint quant; uint chunks; } p;
layout(set = 0, binding = 0) buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer S { float src[]; };
layout(set = 0, binding = 2) readonly buffer W { float w[]; };
layout(set = 0, binding = 3) writeonly buffer Q { uint xq[]; };
#include "xquant.glsl"
shared float red[256];
void main() {
    uint row = gl_WorkGroupID.x / p.chunks, chunk = gl_WorkGroupID.x - row * p.chunks;
    uint lid = gl_LocalInvocationID.x;
    uint base = row * p.stride;
    float s = 0.0;
    for (uint i = lid; i < p.n; i += 256u) { float v = src[base + i]; s += v * v; }
    red[lid] = s;
    barrier();
    for (uint k = 128u; k > 0u; k >>= 1u) {
        if (lid < k) red[lid] += red[lid + k];
        barrier();
    }
    float r = 1.0 / sqrt(red[0] / float(p.n) + p.eps);
    for (uint i = chunk * 256u + lid; i < p.n; i += 256u * p.chunks) {
        float v = src[base + i] * r * w[i];
        dst[base + i] = v;
        if (p.quant != 0u) xquant_twin(row * p.n + i, v, p.rows * p.n);
    }
}
