#version 450
// dst[i] = x[i] * sigmoid(g), sigmoid(g) = 1 / (1 + exp(-g)), g being element d of head h of row r's gate at r * gate_stride + h * gate_head_stride + d, where i = (r * heads + h) * dim + d.
// With `quant` 1, a row is a multiple of 32 wide and the output's 16-bit twin is written beside it (xquant.glsl).
// With `quant` 2 the integer-dot tile reads dst next, and a lane takes four values and writes the same twin a word at a time (xquant_word).
// dst may be x: each element is read and written by one lane.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint quant; uint width; uint dim; uint gate_stride; uint gate_head_stride; } p;
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) readonly buffer G { float gate[]; };
layout(set = 0, binding = 3) writeonly buffer Q { uint xq[]; };
#include "xquant.glsl"
float gated(uint i) {
    uint r = i / p.width, rem = i - r * p.width;
    uint h = rem / p.dim, d = rem - h * p.dim;
    float g = gate[r * p.gate_stride + h * p.gate_head_stride + d];
    return x[i] * (1.0 / (1.0 + exp(-g)));
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (p.quant == 2u) {
        // Every lane takes part in the shuffles; a row is whole blocks, so a block is live or not as a whole.
        bool live = i < p.n / 4u;
        vec4 v = vec4(0.0);
        if (live) {
            v = vec4(gated(4u * i), gated(4u * i + 1u), gated(4u * i + 2u), gated(4u * i + 3u));
            dst[4u * i] = v.x;
            dst[4u * i + 1u] = v.y;
            dst[4u * i + 2u] = v.z;
            dst[4u * i + 3u] = v.w;
        }
        xquant_word(v, live, i & 7u, i / 8u, p.n);
        return;
    }
    if (i < p.n) {
        float v = gated(i);
        dst[i] = v;
        if (p.quant != 0u) xquant_twin(i, v, p.n);
    }
}
