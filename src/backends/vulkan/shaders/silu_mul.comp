#version 450
// dst[i] = silu(gate[i]) * up[i], in the form the CPU uses (silu_mul.glsl).
// With `quant` 1, n is a multiple of 32 and the output's 16-bit twin is written beside it (xquant.glsl), and with `quant` 2 the integer-dot tile reads dst next and a lane writes the same twin four values a word at a time (xquant_word).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 256) in;
// LLMX_CLAMP takes silu(min(g, L)) * clamp(u, -L, L) under a limit L > 0, NaN passing through both (docs/DEEPSEEK4.md, section 4.2).
#ifdef LLMX_CLAMP
layout(push_constant) uniform P { uint n; uint quant; uint major; float limit; } p;
#else
layout(push_constant) uniform P { uint n; uint quant; uint major; } p;
#endif
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer G { float gate[]; };
layout(set = 0, binding = 2) readonly buffer U { float up[]; };
layout(set = 0, binding = 3) writeonly buffer Q { uint xq[]; };
// The same buffers four floats a load, for `quant` 2.
layout(set = 0, binding = 0) writeonly buffer D4 { vec4 dst4[]; };
layout(set = 0, binding = 1) readonly buffer G4 { vec4 gate4[]; };
layout(set = 0, binding = 2) readonly buffer U4 { vec4 up4[]; };
#include "xquant.glsl"
#include "silu_mul.glsl"
#ifdef LLMX_CLAMP
float up_of(float u) { return u < -p.limit ? -p.limit : (u > p.limit ? p.limit : u); }
float gate_of(float g) { return g > p.limit ? p.limit : g; }
vec4 up_of(vec4 u) { return vec4(up_of(u.x), up_of(u.y), up_of(u.z), up_of(u.w)); }
vec4 gate_of(vec4 g) { return vec4(gate_of(g.x), gate_of(g.y), gate_of(g.z), gate_of(g.w)); }
#else
#define up_of(u) (u)
#define gate_of(g) (g)
#endif
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (p.quant == 2u) {
        // Every lane takes part in the shuffles; n is whole blocks, so a block is live or not as a whole.
        bool live = i < p.n / 4u;
        vec4 v = vec4(0.0);
        if (live) {
            v = silu_mul_value(gate_of(gate4[i]), up_of(up4[i]));
            dst4[i] = v;
        }
        xquant_word(v, live, i & 7u, i / 8u, p.n, p.major);
        return;
    }
    if (i < p.n) {
        float v = silu_mul_value(gate_of(gate[i]), up_of(up[i]));
        dst[i] = v;
        if (p.quant != 0u) xquant_block(i, v, p.n);
    }
}
