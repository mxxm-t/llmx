#version 450
// dst[i] = silu(src[i] * scale), preserving the activation twin for a matmul that follows.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "float_controls.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint n; uint quant; uint major; float scale; } p;
layout(set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(set = 0, binding = 1) readonly buffer S { float src[]; };
layout(set = 0, binding = 2) writeonly buffer Q { uint xq[]; };
#include "xquant.glsl"
float silu(float x) { float v = x * p.scale; return v / (1.0 + exp(-v)); }
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (p.quant == 2u) {
        bool live = i < p.n / 4u;
        vec4 v = vec4(0.0);
        if (live) {
            uint b = 4u * i;
            vec4 x = vec4(src[b], src[b + 1u], src[b + 2u], src[b + 3u]) * p.scale;
            v = x / (vec4(1.0) + exp(-x));
            dst[b] = v.x; dst[b + 1u] = v.y; dst[b + 2u] = v.z; dst[b + 3u] = v.w;
        }
        xquant_word(v, live, i & 7u, i / 8u, p.n, p.major);
        return;
    }
    if (i < p.n) {
        float v = silu(src[i]);
        dst[i] = v;
        if (p.quant != 0u) xquant_block(i, v, p.n);
    }
}
