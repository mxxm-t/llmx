#version 450
// out = (1 - tanh(f)) h + tanh(g) m over rows of width floats, rows of out, h and m their own stride apart, f and g packed; out may be h or m of the same stride.
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint rows; uint width; uint os; uint hs; uint ms; } p;
layout(set = 0, binding = 0) buffer O { float o[]; };
layout(set = 0, binding = 1) readonly buffer H { float h[]; };
layout(set = 0, binding = 2) readonly buffer M { float m[]; };
layout(set = 0, binding = 3) readonly buffer F { float f[]; };
layout(set = 0, binding = 4) readonly buffer G { float g[]; };
#include "tanh.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.rows * p.width) return;
    uint r = i / p.width, d = i - r * p.width;
    const precise float y = (1.0 - tanh_of(f[i])) * h[r * p.hs + d] + tanh_of(g[i]) * m[r * p.ms + d];
    o[r * p.os + d] = y;
}
