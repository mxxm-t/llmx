#version 450
#extension GL_KHR_memory_scope_semantics : enable
#ifdef LLMX_MM
#pragma use_vulkan_memory_model
#endif
// A member's partial into slot `member` of the inbox bound as `target`.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Target { uint u[]; } target;
#include "exchange.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    uint v = floatBitsToUint(partial(pc.member, pc.epoch, i));
#ifdef LLMX_MM
    atomicStore(target.u[slot(pc.member, i)], v, LLMX_SCOPE, gl_StorageSemanticsBuffer, gl_SemanticsRelease | gl_SemanticsMakeAvailable);
#else
    target.u[slot(pc.member, i)] = v;
#endif
}
